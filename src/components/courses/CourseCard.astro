---
// src/components/courses/CourseCard.astro
// Renders a single course card for the /courses index grid.
// All data comes from the Course interface — no hardcoded content here.
import type { Course } from '../../constants/courses';

interface Props {
  course: Course;
}

const { course } = Astro.props;

// Category → gradient mapping (matches the existing brand palette)
const gradients: Record<string, string> = {
  Kids: 'from-[#047857] to-[#10b981]',
  Adult: 'from-[#134E4A] to-[#0E7490]',
  Specialist: 'from-[#831843] to-[#DB2777]',
  'All Ages': 'from-[#4C1D95] to-[#7C3AED]',
};
const gradient = course.category ? gradients[course.category] : 'from-[#047857] to-[#10b981]';

// Note: courseParam and level badge colour are not used on the card itself.
// The card links to /courses/[slug]; the CTA with ?course= param lives on [slug].astro.
---

<div
  class="course-card bg-white border border-emerald-100 rounded-3xl overflow-hidden flex flex-col hover:shadow-xl hover:-translate-y-1 hover:border-[#a7f3d0] transition-[color,background-color,border-color,box-shadow,opacity,transform] duration-300"
  data-cat={course.category ?? 'All Ages'}
>
  <!-- Coloured header banner -->
  <div class={`bg-gradient-to-br ${gradient} p-8 text-white relative`}>
    <div class="flex justify-between items-start mb-5 relative z-10">
      <span
        class="bg-white/20 border border-white/30 text-white text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full"
      >
        {course.level}
      </span>
      {
        course.highlight && (
          <span class="bg-white text-[#831843] text-[10px] font-bold px-3 py-1 rounded-full">
            {course.highlight}
          </span>
        )
      }
    </div>

    <div class="text-4xl mb-3 relative z-10" aria-hidden="true">{course.icon}</div>
    <h3 class="font-serif text-2xl font-bold mb-1 relative z-10">{course.title}</h3>
    <p class="text-[13px] text-white/75 font-medium relative z-10">{course.shortDesc}</p>
  </div>

  <!-- Body -->
  <div class="p-7 flex-1 flex flex-col">
    <!-- Metadata badges -->
    <div class="flex flex-wrap gap-2 mb-5">
      {
        course.ageRange && (
          <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#ecfdf5] border border-[#d1fae5] text-[#047857] text-xs font-bold rounded-full">
            📍 {course.ageRange}
          </span>
        )
      }
      {
        course.frequency && (
          <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#ecfdf5] border border-[#d1fae5] text-[#047857] text-xs font-bold rounded-full">
            📅 {course.frequency}
          </span>
        )
      }
      {
        course.groupSize && (
          <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#ecfdf5] border border-[#d1fae5] text-[#047857] text-xs font-bold rounded-full">
            👤 {course.groupSize}
          </span>
        )
      }
    </div>

    <!-- Features -->
    <ul class="space-y-2.5 flex-1 mb-6">
      {
        course.features.map((f) => (
          <li class="flex items-start gap-3 text-[13px] font-medium text-[#065f46]/80">
            <div class="w-5 h-5 rounded-full bg-[#ecfdf5] flex items-center justify-center text-[#047857] shrink-0 mt-0.5">
              <svg
                class="w-3 h-3"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="3"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span set:html={f} />
          </li>
        ))
      }
    </ul>

    <!-- Duration strip -->
    <div
      class="flex items-center gap-3 text-xs text-[#064e3b]/60 font-medium py-3 border-y border-emerald-50 mb-5"
    >
      <span>⏱ {course.duration}</span>
    </div>

    <!-- Price + CTA -->
    <div class="flex items-center justify-between">
      <div>
        {
          course.price ? (
            <>
              <span class="text-[11px] text-[#064e3b]/50 font-bold block mb-0.5">Price</span>
              <span class="font-serif text-lg font-bold text-[#022c22]">{course.price}</span>
            </>
          ) : (
            <a href="/tuition-fee" class="text-xs text-[#047857] font-semibold hover:underline">
              See tuition page for pricing →
            </a>
          )
        }
      </div>
      <a
        href={`/courses/${course.slug}`}
        class="px-5 py-2.5 bg-[#047857] hover:bg-[#064e3b] text-white text-sm font-bold rounded-full transition-colors shadow-sm"
        aria-label={`Learn more about ${course.title}`}
      >
        Learn more →
      </a>
    </div>
  </div>
</div>
