---
// src/components/sections/HomeHero.astro
// Pure HTML/CSS. Zero JavaScript overhead.
import { Image } from 'astro:assets';
import { SITE } from '../../constants/site';

interface Props {
  badgeText?: string;
  title?: string;
  highlightWord?: string;
  subtitle?: string;
  primaryCtaLink?: string;
  // primaryCtaText intentionally not used — CTA copy locked to "Book Your Free Class"
}

const {
  title = "Learn the Quran with",
  highlightWord = "Expert Teachers",
  subtitle = "Join our global community of learners and deepen your understanding of Islam through personalized, 1-on-1 online classes.",
  primaryCtaLink = "/funnel/signup",
} = Astro.props;
---
<section class="relative bg-[#fefdf9] overflow-hidden selection:bg-emerald-200 selection:text-emerald-950 pt-8 pb-16 md:pt-12 md:pb-24 lg:pt-12 lg:pb-32">

  
  <div class="absolute inset-0 bg-[radial-gradient(#d1fae5_1px,transparent_1px)] [background-size:24px_24px] opacity-40"></div>
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-to-r from-emerald-200/40 to-amber-200/40 blur-[100px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 md:gap-12 items-start lg:items-center">
      
      <div class="lg:col-span-7 pt-4 lg:pt-0 order-1 animate-in fade-in slide-in-from-bottom-6 duration-1000">
        
        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-emerald-100 shadow-sm mb-6">
          <svg class="w-3.5 h-3.5 text-amber-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          <span class="text-xs font-bold text-emerald-950 tracking-wide">{SITE.stats[0].number} {SITE.stats[0].label}</span>
        </div>
        
        <h1 class="text-[36px] sm:text-[40px] md:text-5xl lg:text-6xl font-extrabold tracking-tight mb-5 leading-[1.15] text-emerald-950 text-balance max-w-3xl">
          {title}
          <span class="bg-gradient-to-r from-emerald-700 via-emerald-600 to-amber-500 bg-clip-text text-transparent">{highlightWord}</span>
        </h1>
        
        <p class="text-lg sm:text-xl text-emerald-800/80 mb-8 md:mb-10 leading-relaxed max-w-2xl font-medium text-balance">
          {subtitle}
        </p>
        
        <div class="flex flex-col sm:flex-row gap-3 mb-12 lg:mb-16">
          <a href={primaryCtaLink} class="w-full sm:w-auto inline-flex justify-center items-center px-4 py-2.5 text-sm font-semibold text-white bg-emerald-700 hover:bg-emerald-800 rounded-lg shadow-lg shadow-emerald-900/10 hover:shadow-emerald-900/20 hover:-translate-y-0.5 transition-all duration-300 active:scale-95 min-h-[44px]">
            Book Your Free Class
          </a>
          <a href="#how-it-works" class="w-full sm:w-auto inline-flex justify-center items-center px-4 py-2.5 text-sm font-semibold text-emerald-950 bg-white border-2 border-emerald-200/80 hover:border-emerald-300 hover:bg-emerald-50/50 rounded-lg transition-all duration-300 min-h-[44px]">
            How It Works
          </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 border-t border-emerald-100 pt-8">

          <div class="flex items-start gap-3 bg-emerald-50/60 border border-emerald-100 rounded-xl px-4 py-3.5">
            <span class="shrink-0 mt-0.5 text-emerald-600" aria-hidden="true">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </span>
            <div>
              <div class="text-lg font-black text-emerald-950 leading-none mb-1">24/7</div>
              <div class="text-xs font-semibold text-emerald-800/60 uppercase tracking-wider">Flexible Timing</div>
            </div>
          </div>

          <div class="flex items-start gap-3 bg-emerald-50/60 border border-emerald-100 rounded-xl px-4 py-3.5">
            <span class="shrink-0 mt-0.5 text-emerald-600" aria-hidden="true">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            </span>
            <div>
              <div class="text-lg font-black text-emerald-950 leading-none mb-1">1-on-1</div>
              <div class="text-xs font-semibold text-emerald-800/60 uppercase tracking-wider">Private Classes</div>
            </div>
          </div>

          <div class="flex items-start gap-3 bg-emerald-50/60 border border-emerald-100 rounded-xl px-4 py-3.5">
            <span class="shrink-0 mt-0.5 text-emerald-600" aria-hidden="true">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            </span>
            <div>
              <div class="text-lg font-black text-emerald-950 leading-none mb-1">100%</div>
              <div class="text-xs font-semibold text-emerald-800/60 uppercase tracking-wider">Certified Tutors</div>
            </div>
          </div>

          <div class="flex items-start gap-3 bg-emerald-50/60 border border-emerald-100 rounded-xl px-4 py-3.5">
            <span class="shrink-0 mt-0.5 text-emerald-600" aria-hidden="true">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            </span>
            <div>
              <div class="text-lg font-black text-emerald-950 leading-none mb-1">All Ages</div>
              <div class="text-xs font-semibold text-emerald-800/60 uppercase tracking-wider">Ages Welcome</div>
            </div>
          </div>

        </div>

      </div>

      <div class="flex lg:col-span-5 relative h-[280px] sm:h-[400px] lg:h-[500px] items-center justify-center order-2 mt-8 lg:mt-0">
        
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-[#047857]/15 blur-[120px] rounded-full pointer-events-none"></div>
        <div class="absolute top-[30%] right-[10%] w-3/4 h-3/4 bg-[#fbbf24]/10 blur-[100px] rounded-full pointer-events-none"></div>

        <div class="relative z-10 w-[90%] lg:w-[95%] mx-auto aspect-square flex items-center justify-center">
          <Image 
            src="/images/quranific-hero.webp" 
            alt="Quranific Live Interactive Platform" 
            width={600}
            height={600}
            loading="eager"
            fetchpriority="high"
            decoding="sync"
            class="w-full h-auto max-h-full object-contain animate-hero-float drop-shadow-2xl"
          />
        </div>

      </div>
      
    </div>
  </div>
</section>

<style>
  @keyframes hero-float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-16px); }
  }
  
  .animate-hero-float {
    animation: hero-float 7s ease-in-out infinite;
    will-change: transform, filter;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-hero-float {
      animation: none !important;
      transform: translateY(0) !important;
    }
  }
</style>