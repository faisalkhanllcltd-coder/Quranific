---
// src/components/landing/LandingGuarantee.astro
import Button from '../ui/Button.astro';

interface GuaranteeCard {
  label: string;
  sub: string;
}

interface Props {
  eyebrow?: string;
  headline?: string;
  body: string[];
  cards: GuaranteeCard[];
  ctaHref: string;
  ctaLabel: string;
  layoutVariant?: 'kids-dark' | 'adults-light';
  accentColor?: 'emerald' | 'purple';
}

const {
  eyebrow = 'Our Guarantee',
  headline = 'We carry all the risk.<br />You carry none.',
  body,
  cards,
  ctaHref,
  ctaLabel,
  layoutVariant = 'kids-dark',
  accentColor = 'emerald',
} = Astro.props;

const checkColor = accentColor === 'purple' ? 'text-purple-600' : 'text-emerald-600';
---

{
  layoutVariant === 'kids-dark' ? (
    <section class="quranific-section bg-emerald-950">
      <div class="quranific-container">
        <div class="max-w-3xl mb-10">
          <p class="text-xs font-bold uppercase tracking-widest text-emerald-400 mb-4">{eyebrow}</p>
          <h2 class="font-serif text-3xl md:text-4xl font-black text-white leading-tight mb-6">
            <Fragment set:html={headline} />
          </h2>
          <div class="space-y-4 text-lg text-emerald-100/75 leading-relaxed max-w-prose">
            {body.map((p) => (
              <p set:html={p} />
            ))}
          </div>
        </div>

        <div class="grid sm:grid-cols-3 gap-4 max-w-2xl mb-10">
          {cards.map(({ label, sub }) => (
            <div class="bg-white/5 border border-white/10 rounded-xl p-4 backdrop-blur-sm">
              <p class="font-bold text-white text-sm mb-1">{label}</p>
              <p class="text-emerald-300/60 text-xs">{sub}</p>
            </div>
          ))}
        </div>

        <Button
          href={ctaHref}
          data-track-cta
          variant="secondary"
          class="px-8 py-4 text-base font-bold shadow-lg shadow-black/20"
        >
          {ctaLabel}
        </Button>
      </div>
    </section>
  ) : (
    <section class="quranific-section bg-cream-50 border-b border-emerald-50">
      <div class="quranific-container">
        <div class="grid lg:grid-cols-2 gap-12 xl:gap-20 items-center">
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-emerald-600 mb-4">
              {eyebrow}
            </p>
            <h2 class="font-serif text-3xl md:text-4xl font-black text-emerald-950 leading-tight mb-6">
              <Fragment set:html={headline} />
            </h2>
            <div class="space-y-4 text-lg text-slate-600 leading-relaxed max-w-prose">
              {body.map((p) => (
                <p set:html={p} />
              ))}
            </div>

            <div class="mt-8">
              <Button
                href={ctaHref}
                data-track-cta
                variant="secondary"
                class="px-8 py-4 text-base font-bold shadow-lg shadow-black/20"
              >
                {ctaLabel}
              </Button>
            </div>
          </div>

          <div class="space-y-3">
            {cards.map(({ label, sub }) => (
              <div class="flex items-start gap-3">
                <svg
                  class={`w-5 h-5 shrink-0 mt-0.5 ${checkColor}`}
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <div>
                  <p class="font-bold text-emerald-950 text-sm">{label}</p>
                  <p class="text-slate-400 text-xs">{sub}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}
