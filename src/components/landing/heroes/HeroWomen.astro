---
// src/components/landing/heroes/HeroWomen.astro
import Button from '../../ui/Button.astro';

interface Props {
  intent: string;
  h1: string;
  subhead: string;
}

const { intent, h1, subhead } = Astro.props;
---

<section class="relative overflow-hidden bg-emerald-950">
  <!-- Subtle dot grid -->
  <div
    class="absolute inset-0 bg-[radial-gradient(rgba(167,139,250,0.08)_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <!-- Warm purple glow — sisters-only warmth signal -->
  <div
    class="absolute top-0 right-0 w-[500px] h-[500px] bg-purple-600/10 blur-[160px] rounded-full pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-emerald-500/8 blur-[120px] rounded-full pointer-events-none"
    aria-hidden="true"
  >
  </div>

  <div class="quranific-container relative z-10 py-8">
    <!-- Ad-lander header: logo only, no nav leakage -->
    <header class="mb-14 md:mb-20 flex items-center justify-between">
      <a
        href="/"
        class="inline-flex items-center hover:opacity-80 transition-opacity focus:outline-none focus-visible:ring-2 focus-visible:ring-purple-400 rounded-lg"
      >
        <img
          src="/images/quranific-logo-gold.svg"
          alt="Quranific Logo"
          class="h-8 md:h-9 w-auto object-contain"
          loading="eager"
          decoding="async"
        />
      </a>
    </header>

    <div
      class="grid lg:grid-cols-[1fr_360px] gap-12 xl:gap-20 items-center pb-16 sm:pb-20 lg:pb-24"
    >
      <!-- Left: headline + CTAs -->
      <div>
        <!-- Sisters-only badge -->
        <div
          class="inline-flex items-center px-3.5 py-1 rounded-full text-sm font-semibold bg-purple-500/15 text-purple-200 ring-1 ring-inset ring-purple-500/30 mb-6"
        >
          Private Classes with Ustadhas
        </div>

        <!-- Dynamic H1 per intent -->
        <h1
          class="font-serif text-4xl sm:text-5xl lg:text-[3.5rem] font-black text-white leading-[1.06] tracking-tight mb-5"
        >
          {h1}
        </h1>

        <!-- Dynamic subhead per intent -->
        <p
          class="text-xl md:text-2xl text-emerald-100/70 font-medium leading-relaxed mb-8 max-w-xl"
        >
          {subhead}
        </p>

        <!-- CTAs: Hero = variant="gold" per top-funnel mapping -->
        <div class="flex flex-col sm:flex-row gap-3 mb-8">
          <Button
            href={`/funnel/signup?source=ad_women_${intent}`}
            data-track-cta
            variant="gold"
            fullWidthOnMobile
          >
            Book Your Free Class
          </Button>
        </div>

        <!-- Edge UI Trust Pills (Dark Theme - Sisters Warm Purple Glass) -->
        <ul
          class="grid grid-cols-2 lg:flex lg:flex-wrap lg:justify-start gap-2 md:gap-2.5 mt-6 w-full"
        >
          <li
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-[13px] font-semibold bg-purple-950/60 text-purple-100 border border-purple-700/40 shadow-xs w-full justify-center lg:w-auto lg:justify-start"
          >
            <!-- SVG: User Check -->
            <svg
              class="w-3.5 h-3.5 text-purple-300 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <polyline points="16 11 18 13 22 9"></polyline>
            </svg>
            100% Female Ustadhas
          </li>
          <li
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-[13px] font-semibold bg-purple-950/60 text-purple-100 border border-purple-700/40 shadow-xs w-full justify-center lg:w-auto lg:justify-start"
          >
            <!-- SVG: Lock -->
            <svg
              class="w-3.5 h-3.5 text-purple-300 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            Strict Privacy
          </li>
          <li
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-[13px] font-semibold bg-purple-950/60 text-purple-100 border border-purple-700/40 shadow-xs w-full justify-center lg:w-auto lg:justify-start"
          >
            <!-- SVG: Calendar -->
            <svg
              class="w-3.5 h-3.5 text-purple-300 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
              <line x1="16" x2="16" y1="2" y2="6"></line>
              <line x1="8" x2="8" y1="2" y2="6"></line>
              <line x1="3" x2="21" y1="10" y2="10"></line>
            </svg>
            Flexible scheduling
          </li>
          <li
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-[13px] font-semibold bg-purple-950/60 text-purple-100 border border-purple-700/40 shadow-xs w-full justify-center lg:w-auto lg:justify-start"
          >
            <!-- SVG: Shield Check -->
            <svg
              class="w-3.5 h-3.5 text-purple-300 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
            Full-month guarantee
          </li>
        </ul>
      </div>

      <!-- Right: floating privacy trust card (desktop) -->
      <div class="hidden lg:block">
        <div class="bg-white/5 border border-white/10 backdrop-blur-md shadow-xl rounded-2xl p-8">
          <div class="flex items-center gap-2 mb-5">
            <div class="w-8 h-8 rounded-full bg-purple-800/60 flex items-center justify-center">
              <svg
                class="w-4 h-4 text-purple-300"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <p class="text-xs font-bold uppercase tracking-widest text-purple-300">
              Privacy Guaranteed
            </p>
          </div>
          <ul class="space-y-5 mb-6">
            {
              [
                {
                  icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
                  text: 'Guaranteed female Ustadha — no exceptions',
                },
                {
                  icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
                  text: 'Sessions are private, 1-on-1 only',
                },
                {
                  icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
                  text: 'Learn from home — no travel required',
                },
                {
                  icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
                  text: 'Schedule around your family, 24/7',
                },
              ].map(({ icon, text }) => (
                <li class="flex items-start gap-3 text-lg text-emerald-100 font-medium leading-snug">
                  <span class="text-purple-300 mt-0.5 shrink-0" set:html={icon} />
                  {text}
                </li>
              ))
            }
          </ul>
          <div class="pt-5 border-t border-purple-700/30">
            <p class="text-sm font-semibold text-white">Trusted by sisters worldwide</p>
            <p class="text-white text-xs mt-1">
              Enrolled sisters from the UK, USA, UAE &amp; beyond
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
