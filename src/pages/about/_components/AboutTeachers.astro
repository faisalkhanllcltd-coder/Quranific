---
// src/pages/about/_components/AboutTeachers.astro
import Section from '../../../components/ui/Section.astro';
import EyebrowBadge from '../../../components/ui/EyebrowBadge.astro';
import EyebrowText from '../../../components/ui/EyebrowText.astro';

const Icons = {
  scroll: `<svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`,
};
---

<Section class="py-10 md:py-20 lg:py-32 bg-emerald-50 border-y border-emerald-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-[1.1fr_1fr] gap-10 items-end mb-16">
      <div>
        <EyebrowText class="text-emerald-700 mb-3">Our Teachers</EyebrowText>
        <h2 class="text-4xl font-bold text-emerald-950 mb-4 tracking-tight leading-tight">
          Every teacher holds a chain <br /><em
            class="font-serif italic text-emerald-700 font-medium">back to the Prophet ﷺ</em
          >
        </h2>
        <p class="text-lg text-emerald-900/80 font-medium">
          We don't just hire tutors. We select carriers of a living tradition, and make sure they
          know how to deliver it with patience.
        </p>
      </div>

      <div
        class="bg-white border border-emerald-100 rounded-2xl p-6 lg:p-8 flex gap-5 items-start shadow-sm"
      >
        <div
          class="w-14 h-14 bg-amber-50 rounded-xl border border-amber-200 flex items-center justify-center text-amber-600 shrink-0"
          set:html={Icons.scroll}
        />
        <div>
          <h3 class="text-lg font-bold text-emerald-950 mb-2">What is an Ijazah?</h3>
          <p class="text-[14px] text-emerald-900/80 font-medium leading-relaxed">
            An Ijazah is a <strong class="text-emerald-700"
              >verified chain of Quranic transmission</strong
            > connecting a teacher through an unbroken line of scholars. Every Quranific teacher holds
            a verified Ijazah before they teach their first session.
          </p>
        </div>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6 mb-12">
      <div
        class="bg-cream-50 border border-emerald-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300"
      >
        <div class="bg-gradient-to-br from-emerald-700 to-emerald-500 p-8 text-white">
          <div
            class="w-16 h-16 rounded-full bg-white/20 border-2 border-white/30 flex items-center justify-center font-serif text-2xl font-bold mb-4 shadow-inner"
            aria-hidden="true"
          >
            ف
          </div>
          <h3 class="text-xl font-bold mb-1">Ustadha Fatima K.</h3>
          <p class="text-sm text-emerald-50/80 font-medium mb-4">
            Hafiza · Ijazah in Hafs 'an 'Asim
          </p>
          <div class="flex flex-wrap gap-2">
            <EyebrowBadge class="bg-white/10 border border-white/20 text-white">
              Children's specialist
            </EyebrowBadge>
          </div>
        </div>
        <div class="p-8">
          <EyebrowText class="text-emerald-900/50 mb-4"> Specialises in </EyebrowText>
          <ul class="space-y-3 mb-6">
            <li class="flex items-center gap-3 text-[14px] font-medium text-emerald-800/80">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-700" aria-hidden="true"></span> Ages 5–12,
              beginner to intermediate
            </li>
            <li class="flex items-center gap-3 text-[14px] font-medium text-emerald-800/80">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-700" aria-hidden="true"></span> Tajweed
              fundamentals & Noorani Qaida
            </li>
          </ul>
          <p class="font-serif italic text-emerald-900 text-lg pt-6 border-t border-emerald-100">
            "Every child is a beginner exactly once. I want that experience to feel safe."
          </p>
        </div>
      </div>

      <div
        class="bg-cream-50 border border-emerald-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300"
      >
        <div class="bg-gradient-to-br from-emerald-700 to-emerald-500 p-8 text-white">
          <div
            class="w-16 h-16 rounded-full bg-white/20 border-2 border-white/30 flex items-center justify-center font-serif text-2xl font-bold mb-4 shadow-inner"
            aria-hidden="true"
          >
            م
          </div>
          <h3 class="text-xl font-bold mb-1">Ustadh Muhammad A.</h3>
          <p class="text-sm text-emerald-50/80 font-medium mb-4">
            Hafiz · Ijazah in Multiple Qira'at
          </p>
          <div class="flex flex-wrap gap-2">
            <EyebrowBadge class="bg-white/10 border border-white/20 text-white">
              Advanced Tajweed
            </EyebrowBadge>
          </div>
        </div>
        <div class="p-8">
          <EyebrowText class="text-emerald-900/50 mb-4"> Specialises in </EyebrowText>
          <ul class="space-y-3 mb-6">
            <li class="flex items-center gap-3 text-[14px] font-medium text-emerald-800/80">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-700" aria-hidden="true"></span> Ages 10+
              & adult learners
            </li>
            <li class="flex items-center gap-3 text-[14px] font-medium text-emerald-800/80">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-700" aria-hidden="true"></span> Hifz (full
              memorisation) programmes
            </li>
          </ul>
          <p class="font-serif italic text-emerald-900 text-lg pt-6 border-t border-emerald-100">
            "Tajweed isn't rules. It's the sound of a living tradition. I teach the soul of it."
          </p>
        </div>
      </div>

      <div
        class="bg-cream-50 border border-emerald-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300"
      >
        <div class="bg-gradient-to-br from-emerald-700 to-emerald-500 p-8 text-white">
          <div
            class="w-16 h-16 rounded-full bg-white/20 border-2 border-white/30 flex items-center justify-center font-serif text-2xl font-bold mb-4 shadow-inner"
            aria-hidden="true"
          >
            ز
          </div>
          <h3 class="text-xl font-bold mb-1">Ustadha Zainab R.</h3>
          <p class="text-sm text-emerald-50/80 font-medium mb-4">
            Hafiza · Child Psychology background
          </p>
          <div class="flex flex-wrap gap-2">
            <EyebrowBadge class="bg-white/10 border border-white/20 text-white">
              Special Needs
            </EyebrowBadge>
          </div>
        </div>
        <div class="p-8">
          <EyebrowText class="text-emerald-900/50 mb-4"> Specialises in </EyebrowText>
          <ul class="space-y-3 mb-6">
            <li class="flex items-center gap-3 text-[14px] font-medium text-emerald-800/80">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-700" aria-hidden="true"></span> ADHD-adapted
              lesson structure
            </li>
            <li class="flex items-center gap-3 text-[14px] font-medium text-emerald-800/80">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-700" aria-hidden="true"></span> Anxiety-sensitive
              teaching methods
            </li>
          </ul>
          <p class="font-serif italic text-emerald-900 text-lg pt-6 border-t border-emerald-100">
            "No child is difficult. Every child just needs someone who understands how they learn."
          </p>
        </div>
      </div>
    </div>

    <div class="bg-white border border-emerald-100 rounded-3xl p-8 lg:p-12 shadow-sm">
      <h3 class="text-2xl font-bold text-emerald-950 mb-10 text-center">
        How every teacher is vetted:
      </h3>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="text-center group p-4 rounded-2xl hover:bg-emerald-50/50 transition-colors">
          <div
            class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold text-xl mx-auto mb-5 group-hover:bg-emerald-700 group-hover:text-white transition-colors shadow-sm border border-emerald-100"
            aria-hidden="true"
          >
            1
          </div>
          <h4 class="font-bold text-emerald-950 text-base mb-2">Ijazah verification</h4>
          <p class="text-xs font-medium text-emerald-900/70 leading-relaxed">
            Direct authentication of unbroken Quranic transmission chains back to scholars.
          </p>
        </div>
        <div class="text-center group p-4 rounded-2xl hover:bg-emerald-50/50 transition-colors">
          <div
            class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold text-xl mx-auto mb-5 group-hover:bg-emerald-700 group-hover:text-white transition-colors shadow-sm border border-emerald-100"
            aria-hidden="true"
          >
            2
          </div>
          <h4 class="font-bold text-emerald-950 text-base mb-2">Live recitation assessment</h4>
          <p class="text-xs font-medium text-emerald-900/70 leading-relaxed">
            Rigorous evaluation of Makharij, Sifaat, and melodic precision by senior scholars.
          </p>
        </div>
        <div class="text-center group p-4 rounded-2xl hover:bg-emerald-50/50 transition-colors">
          <div
            class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold text-xl mx-auto mb-5 group-hover:bg-emerald-700 group-hover:text-white transition-colors shadow-sm border border-emerald-100"
            aria-hidden="true"
          >
            3
          </div>
          <h4 class="font-bold text-emerald-950 text-base mb-2">
            Teaching methodology and empathy interview
          </h4>
          <p class="text-xs font-medium text-emerald-900/70 leading-relaxed">
            Detailed assessment of patience, positive reinforcement, and warmth with young students.
          </p>
        </div>
        <div class="text-center group p-4 rounded-2xl hover:bg-emerald-50/50 transition-colors">
          <div
            class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold text-xl mx-auto mb-5 group-hover:bg-emerald-700 group-hover:text-white transition-colors shadow-sm border border-emerald-100"
            aria-hidden="true"
          >
            4
          </div>
          <h4 class="font-bold text-emerald-950 text-base mb-2">
            Full safeguarding check, renewed annually
          </h4>
          <p class="text-xs font-medium text-emerald-900/70 leading-relaxed">
            Comprehensive background verification and annual child-safeguarding compliance.
          </p>
        </div>
      </div>
    </div>
  </div>
</Section>
