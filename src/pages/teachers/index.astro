---
export const prerender = true;

// src/pages/teachers/index.astro
import Base from '../../layouts/Base.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';

import PageHero from '../../components/blocks/PageHero.astro';
import TeachersIjazah from './_components/TeachersIjazah.astro';
import TeachersVetting from './_components/TeachersVetting.astro';
import TeachersGenderPrivacy from './_components/TeachersGenderPrivacy.astro';
import TeachersFaculty from './_components/TeachersFaculty.astro';
import FinalCTA from '../../components/blocks/FinalCTA.astro';
import EyebrowText from '../../components/ui/EyebrowText.astro';
import Button from '../../components/ui/Button.astro';

const TEACHERS = [
  {
    name: 'Ustadha Fatima S.',
    gender: 'Female',
    title: "Alimah, M.A. in Quranic Qira'at & Islamic Studies",
    experience: '8+ Years',
    rating: '5.0',
    students: '12 Active',
    specialties: ['Child Psychology', 'Beginner Tajweed', "Women's Hifz"],
    languages: ['Arabic', 'English', 'Urdu'],
    bio: 'Specializing in early childhood Islamic education, Ustadha Fatima uses interactive, gentle methods to make young learners fall in love with the Quran.',
  },
  {
    name: 'Ustad Bilal A.',
    gender: 'Male',
    title: "Hafiz & Qari (Master's Degree)",
    experience: '12+ Years',
    rating: '4.9',
    students: '14 Active',
    specialties: ['Advanced Tajweed', "Qira'at", 'Adult Hifz'],
    languages: ['English', 'Arabic', 'Urdu'],
    bio: 'With over a decade of experience and deep academic roots, Ustad Bilal helps adult learners perfect their recitation and memorize with unbreakable retention.',
  },
  {
    name: 'Ustadha Aisha R.',
    gender: 'Female',
    title: 'Certified Hafiza & Tajweed Expert',
    experience: '5+ Years',
    rating: '5.0',
    students: '10 Active',
    specialties: ['Female Only', 'Makharij Correction', 'Islamic Studies'],
    languages: ['English', 'Urdu'],
    bio: 'Known for her incredible patience and attention to detail, Ustadha Aisha provides a safe, comfortable, and highly effective learning environment for sisters.',
  },
  {
    name: 'Ustad Omar T.',
    gender: 'Male',
    title: "Ijazah Holder in 3 Qira'at",
    experience: '10+ Years',
    rating: '4.9',
    students: '15 Active',
    specialties: ['Youth Mentorship', 'Intensive Hifz', 'Tafsir Basics'],
    languages: ['English', 'Arabic'],
    bio: 'Ustad Omar combines traditional rigor with modern relatable mentorship, making him a favorite among teenage students navigating their Quranic journey.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'Our Teachers - Quranific | Elite Quran Tutors',
  description:
    'Meet our highly vetted, Ijazah-certified Quran tutors. We offer dedicated male and female instructors specializing in Tajweed, Hifz, and child education.',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: TEACHERS.map((t, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Person',
        name: t.name,
        jobTitle: t.title,
        description: t.bio,
      },
    })),
  },
};
---

<Base
  title="Our Teachers | Elite Certified Quran Tutors"
  description="Learn from the top 1% of certified Quran scholars. Discover our rigorous vetting process and meet our dedicated male and female tutors."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" is:inline />

  <Header />

  <main class="min-h-screen bg-cream-50 selection:bg-emerald-200 selection:text-emerald-950">
    <PageHero
      eyebrow="The Top 1% of Instructors"
      title="Masters of the Word. "
      highlightWord="Mentors for Life."
      subtitle="We don't just hire tutors; we curate a global faculty of certified scholars, Hafiz, and Ijazah holders dedicated to passing down the authentic recitation of the Quran."
      primaryCtaText=""
    >
      <Fragment slot="checklist">
        <!-- Dual Call-To-Action (Revenue vs Recruitment) -->
        <div
          class="flex flex-col sm:flex-row justify-center items-center gap-4 sm:gap-6 mt-8 mb-12"
        >
          <!-- Primary CTA: Revenue/Students -->
          <Button
            href="/getting-started/signup"
            variant="primary"
            class="w-full sm:w-auto px-10 py-4 text-lg shadow-lg shadow-emerald-900/20 hover:shadow-xl transition-all"
          >
            Book Your Free Class
          </Button>

          <!-- Secondary CTA: Recruitment/Scholars -->
          <a
            href="/teachers/apply"
            class="w-full sm:w-auto px-10 py-4 text-lg font-bold text-emerald-800 bg-emerald-50/50 border-2 border-emerald-200 rounded-xl hover:bg-emerald-100 hover:border-emerald-300 transition-all text-center backdrop-blur-sm"
          >
            Join Our Faculty
          </a>
        </div>

        <div
          class="flex flex-wrap justify-center gap-6 sm:gap-12 pt-8 border-t border-emerald-900/10"
        >
          <div class="flex flex-col items-center">
            <span class="text-3xl sm:text-4xl font-black text-emerald-800 tracking-tight">100%</span
            >
            <EyebrowText class="text-emerald-600 mt-1"> Background Checked </EyebrowText>
          </div>
          <div class="w-px h-12 bg-emerald-200 hidden sm:block mt-2" aria-hidden="true"></div>
          <div class="flex flex-col items-center">
            <span class="text-3xl sm:text-4xl font-black text-emerald-800 tracking-tight">24/7</span
            >
            <EyebrowText class="text-emerald-600 mt-1"> Quality Assurance </EyebrowText>
          </div>
          <div class="w-px h-12 bg-emerald-200 hidden sm:block mt-2" aria-hidden="true"></div>
          <div class="flex flex-col items-center">
            <span class="text-3xl sm:text-4xl font-black text-emerald-800 tracking-tight"
              >Rigorous</span
            >
            <EyebrowText class="text-emerald-600 mt-1"> Vetting Process </EyebrowText>
          </div>
        </div>
      </Fragment>
    </PageHero>

    <TeachersIjazah />
    <TeachersVetting />
    <TeachersGenderPrivacy />
    <TeachersFaculty teachers={TEACHERS} />

    <!-- HIGH-CONVERSION TEACHERS CTA -->
    <FinalCTA
      eyebrow="Learn From The Best"
      heading="Ready to study with a <span class='text-[#fde68a] font-serif italic'>certified scholar?</span>"
      subhead="Don't settle for unverified tutors. Experience the clarity and precision of a dedicated, Ijazah-holding expert. Your journey to perfect recitation starts here."
    />
  </main>

  <Footer />
</Base>
