---
// src/components/blocks/HomeHero.astro
// Pure HTML/CSS. Zero JavaScript overhead.
import { Image } from 'astro:assets';

interface Props {
  title?: string;
  highlightWord?: string;
  subtitle?: string;
  primaryCtaLink?: string;
  // primaryCtaText intentionally not used — CTA copy locked to "Book Your Free Class"
}

const {
  title = 'The Quran class your child ',
  highlightWord = 'actually looks forward to.',
  subtitle = 'Join our global community of learners and deepen your understanding of Islam through personalized, 1-on-1 online classes.',
  primaryCtaLink = '/getting-started/signup',
} = Astro.props;
---

<section
  class="relative bg-cream-50 overflow-hidden selection:bg-emerald-200 selection:text-emerald-950 -mt-[72px] pt-[104px] pb-8 md:pt-[120px] md:pb-12 lg:pt-[120px] lg:pb-16"
>
  <div
    class="absolute inset-0 bg-[radial-gradient(#d1fae5_1px,transparent_1px)] [background-size:24px_24px] opacity-40"
  >
  </div>
  <div
    class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-to-r from-emerald-200/40 to-amber-200/40 blur-[100px] rounded-full pointer-events-none"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <!-- Top Section: Text (Left) and Image (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 md:gap-12 items-start lg:items-center">
      <!-- Left Column: Copy & CTA -->
      <div
        class="lg:col-span-7 pt-4 lg:pt-0 order-1 animate-in fade-in slide-in-from-bottom-6 duration-1000"
      >
        <div
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-emerald-100 shadow-sm mb-6"
        >
          <svg
            class="w-3.5 h-3.5 text-amber-500"
            fill="currentColor"
            viewBox="0 0 20 20"
            aria-hidden="true"
          >
            <path
              d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
            ></path>
          </svg>
          <span class="text-xs font-bold text-emerald-950 tracking-wide"
            >Trusted by families across the UK, US, and UAE</span
          >
        </div>

        <h1
          class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mb-5 leading-[1.15] text-emerald-950 text-balance max-w-3xl"
        >
          {title}
          <span class="bg-gradient-to-r from-emerald-600 to-gold-500 bg-clip-text text-transparent"
            >{highlightWord}</span
          >
        </h1>

        <p
          class="text-lg sm:text-xl text-emerald-800/80 mb-8 md:mb-10 leading-relaxed max-w-2xl font-medium text-balance"
        >
          {subtitle}
        </p>

        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href={primaryCtaLink}
            class="w-full sm:w-auto inline-flex justify-center items-center px-4 py-2.5 text-sm font-semibold text-white bg-emerald-700 hover:bg-emerald-800 rounded-lg shadow-lg shadow-emerald-900/10 hover:shadow-emerald-900/20 hover:-translate-y-0.5 transition-all duration-300 active:scale-95 min-h-[44px]"
          >
            Book Your Free Class
          </a>
          <a
            href="#how-it-works"
            class="w-full sm:w-auto inline-flex justify-center items-center px-4 py-2.5 text-sm font-semibold text-emerald-950 bg-white border-2 border-emerald-200/80 hover:border-emerald-300 hover:bg-emerald-50/50 rounded-lg transition-all duration-300 min-h-[44px]"
          >
            How It Works
          </a>
        </div>
      </div>

      <!-- Right Column: Image -->
      <div
        class="flex lg:col-span-5 relative w-full items-center justify-center order-2 mt-12 lg:mt-0"
      >
        <div
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-[150%] bg-emerald-700/15 blur-[120px] rounded-full pointer-events-none hidden md:block"
        >
        </div>
        <div
          class="absolute top-[30%] right-[10%] w-3/4 h-3/4 bg-amber-400/10 blur-[100px] rounded-full pointer-events-none hidden md:block"
        >
        </div>

        <div class="relative z-10 w-full max-w-[500px] lg:max-w-none mx-auto drop-shadow-2xl">
          <div class="animate-hero-float w-full flex items-center justify-center">
            <Image
              src="/images/quranific-hero.webp"
              alt="Quranific Live Interactive Platform"
              width={1000}
              height={625}
              loading="eager"
              fetchpriority="high"
              decoding="sync"
              class="w-full h-auto object-contain"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes hero-float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-16px);
    }
  }

  .animate-hero-float {
    animation: hero-float 7s ease-in-out infinite;
    will-change: transform, filter;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-hero-float {
      animation: none !important;
      transform: translateY(0) !important;
    }
  }
</style>
