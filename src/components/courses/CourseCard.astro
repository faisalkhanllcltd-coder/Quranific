---
// src/components/courses/CourseCard.astro
import type { Course } from '../../constants/courses';

interface Props {
  course: Course;
}
const { course } = Astro.props;

// Tailwind token gradients mapped to category
const gradients: Record<string, string> = {
  Kids: 'from-emerald-700 to-emerald-500',
  Adult: 'from-teal-900 to-cyan-700',
  Specialist: 'from-pink-900 to-pink-600',
  'All Ages': 'from-violet-900 to-violet-600',
};
const gradient = course.category ? gradients[course.category] : 'from-emerald-700 to-emerald-500';
---

<div
  class="bg-white border border-emerald-100 rounded-3xl overflow-hidden flex flex-col hover:shadow-xl hover:-translate-y-1 hover:border-emerald-300 transition-all duration-300"
>
  <!-- Coloured header banner -->
  <div class={`bg-gradient-to-br ${gradient} p-8 text-white relative`}>
    <div class="flex justify-between items-start mb-5 relative z-10">
      <span
        class="bg-white/20 border border-white/30 text-white text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full"
      >
        {course.level}
      </span>
      {
        course.highlight && (
          <span class="bg-white text-emerald-900 text-[10px] font-bold px-3 py-1 rounded-full">
            {course.highlight}
          </span>
        )
      }
    </div>
    <div class="text-4xl mb-3 relative z-10" aria-hidden="true">
      <svg
        class="w-10 h-10 text-white/90"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d={course.icon}></path>
      </svg>
    </div>
    <h3 class="font-serif text-2xl font-bold mb-1 relative z-10">{course.title}</h3>
    <p class="text-[13px] text-white/75 font-medium relative z-10">{course.shortDesc}</p>
  </div>

  <!-- Body (Features) -->
  <div class="p-7 pb-8 flex-1 flex flex-col">
    <ul class="space-y-3 flex-1">
      {
        course.features.map((f) => (
          <li class="flex items-start gap-3 text-[13px] font-medium text-emerald-900/80">
            <div class="w-5 h-5 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-700 shrink-0 mt-0.5">
              <svg
                class="w-3 h-3"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="3"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span set:html={f} />
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Edge-to-Edge CTA Stack (Touching Corners) -->
  <div class="mt-auto flex flex-col border-t border-emerald-50">
    <a
      href={`/funnel/signup?course=${course.slug}`}
      class="w-full flex items-center justify-center py-4 bg-emerald-700 hover:bg-emerald-800 text-white text-sm font-bold transition-colors"
      aria-label={`Book free trial class for ${course.title}`}
    >
      Book Free Trial Class
    </a>
    <a
      href={`/courses/${course.slug}`}
      class="group w-full flex items-center justify-center gap-1.5 py-4 bg-emerald-50/50 hover:bg-emerald-100 text-sm font-bold text-emerald-800 transition-colors"
      aria-label={`View details for ${course.title}`}
    >
      View Course Details
      <svg
        class="w-4 h-4 transition-transform group-hover:translate-x-1"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
        aria-hidden="true"
        ><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"
        ></path></svg
      >
    </a>
  </div>
</div>
