---
// src/pages/tuition-fee.astro
import Base from '../layouts/Base.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import PageHero from '../components/sections/PageHero.astro';

// Elite Edge SEO: Attached AggregateOffer to a specific Service entity
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Tuition Fees - Quranific',
  description:
    'Simple, honest pricing for private 1-on-1 Quran classes. No hidden fees. Full-month guarantee.',
  mainEntity: {
    '@type': 'Service',
    name: '1-on-1 Online Quran Classes',
    provider: {
      '@type': 'Organization',
      name: 'Quranific',
    },
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'USD',
      lowPrice: '33.00',
      highPrice: '89.00',
      offerCount: '3',
    },
  },
};

// Reusable SVGs mapped for zero DOM bloat
const Icons = {
  check: `<svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>`,
  xIcon: `<svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>`,
  shield: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
  chevronDown: `<svg fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" viewBox="0 0 24 24" width="20" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>`,
  sparkle: `<svg class="w-4 h-4 text-amber-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>`,
};
---

<Base
  title="Tuition Fees | Simple, Honest Pricing | Quranific"
  description="Honest pricing. Nothing hidden. Everything included. Calculate your monthly fee for private 1-on-1 Quran classes with certified scholars."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" is:inline />

  <Header />

  <main class="bg-cream-50 selection:bg-emerald-200 selection:text-emerald-950 font-sans">
    <PageHero
      eyebrow="Transparent · No hidden fees"
      title="Honest pricing. Everything included."
      highlightWord="Nothing hidden."
      subtitle="We are not going to make you read the small print. Every price you see here is the price you pay. No setup fees, no resource fees. One simple monthly amount that covers everything."
      primaryCtaText="See All Plans ↓"
      primaryCtaLink="#plans"
      secondaryCtaText="Ask about pricing"
      secondaryCtaLink="https://wa.me/923112112122"
    >
      <div slot="checklist" class="flex flex-col gap-4 mb-10">
        <div class="flex items-center gap-3 text-sm font-medium text-emerald-800">
          <div
            class="w-5 h-5 rounded-full bg-emerald-700 text-white flex items-center justify-center shrink-0"
            set:html={Icons.check}
          />
          <span
            ><strong class="text-emerald-950">First class always free</strong> (no credit card required)</span
          >
        </div>
        <div class="flex items-center gap-3 text-sm font-medium text-emerald-800">
          <div
            class="w-5 h-5 rounded-full bg-emerald-700 text-white flex items-center justify-center shrink-0"
            set:html={Icons.check}
          />
          <span
            ><strong class="text-emerald-950">Full refund</strong> if unsatisfied after your first paid
            month</span
          >
        </div>
        <div class="flex items-center gap-3 text-sm font-medium text-emerald-800">
          <div
            class="w-5 h-5 rounded-full bg-emerald-700 text-white flex items-center justify-center shrink-0"
            set:html={Icons.check}
          />
          <span
            ><strong class="text-emerald-950">Cancel any time</strong>: no lock-in, no cancellation
            fee</span
          >
        </div>
        <div class="flex items-center gap-3 text-sm font-medium text-emerald-800">
          <div
            class="w-5 h-5 rounded-full bg-emerald-700 text-white flex items-center justify-center shrink-0"
            set:html={Icons.check}
          />
          <span
            ><strong class="text-emerald-950">Sibling discounts</strong>: 10% off your second child,
            20% off your third</span
          >
        </div>
      </div>

      <div
        slot="visual"
        class="bg-white rounded-3xl shadow-xl shadow-emerald-900/5 border border-emerald-100 p-6 sm:p-8 transform lg:rotate-1 hover:rotate-0 transition-transform duration-500 animate-in fade-in slide-in-from-bottom-8 duration-700 delay-150 w-full"
      >
        <h3 class="text-xl font-bold text-emerald-950 mb-1">Calculate your monthly fee</h3>
        <p class="text-sm text-emerald-800/70 font-medium mb-6">
          See your exact cost in 30 seconds. No surprises.
        </p>

        <!-- Who is enrolling — lightweight toggle, lead data only, does not affect price -->
        <div
          class="flex items-center gap-3 mb-6 p-3 bg-emerald-50 rounded-xl border border-emerald-100"
        >
          <span class="text-xs font-bold text-emerald-800/60 uppercase tracking-wider shrink-0"
            >For:</span
          >
          <div class="flex gap-2" id="calc-who-btns">
            <button
              class="calc-who px-3 py-1.5 bg-white border border-emerald-200 rounded-lg text-xs font-bold text-emerald-900/70 hover:border-emerald-700 transition-colors"
              data-val="child"
              data-label="Child">Child</button
            >
            <button
              class="calc-who px-3 py-1.5 bg-white border border-emerald-200 rounded-lg text-xs font-bold text-emerald-900/70 hover:border-emerald-700 transition-colors"
              data-val="adult"
              data-label="Adult">Adult</button
            >
          </div>
          <span class="text-xs font-medium text-emerald-700 ml-auto" id="calc-who-val"></span>
        </div>

        <div class="space-y-5">
          <!-- Duration -->
          <div>
            <div class="flex justify-between items-center mb-3">
              <span class="text-sm font-bold text-emerald-900/60 uppercase tracking-wider"
                >Session length</span
              >
              <span class="text-sm font-bold text-emerald-700" id="calc-dur-val">–</span>
            </div>
            <div class="flex gap-2" id="calc-dur-btns">
              <button
                class="calc-btn flex-1 px-4 py-2.5 bg-cream-50 border border-emerald-200 rounded-lg text-sm font-bold text-emerald-900/70 hover:border-emerald-700 transition-colors"
                data-group="dur"
                data-val="30"
                data-label="30 min">30 min</button
              >
              <button
                class="calc-btn flex-1 px-4 py-2.5 bg-cream-50 border border-emerald-200 rounded-lg text-sm font-bold text-emerald-900/70 hover:border-emerald-700 transition-colors"
                data-group="dur"
                data-val="40"
                data-label="40 min">40 min</button
              >
            </div>
          </div>

          <!-- Sessions per week -->
          <div>
            <div class="flex justify-between items-center mb-3">
              <span class="text-sm font-bold text-emerald-900/60 uppercase tracking-wider"
                >Sessions / week</span
              >
              <span class="text-sm font-bold text-emerald-700" id="calc-sess-val">–</span>
            </div>
            <div class="flex gap-2" id="calc-sess-btns">
              <button
                class="calc-btn flex-1 px-3 py-2.5 bg-cream-50 border border-emerald-200 rounded-lg text-sm font-bold text-emerald-900/70 hover:border-emerald-700 transition-colors"
                data-group="sess"
                data-val="2"
                data-label="2×">2×</button
              >
              <button
                class="calc-btn flex-1 px-3 py-2.5 bg-cream-50 border border-emerald-200 rounded-lg text-sm font-bold text-emerald-900/70 hover:border-emerald-700 transition-colors"
                data-group="sess"
                data-val="3"
                data-label="3×">3×</button
              >
              <button
                class="calc-btn flex-1 px-3 py-2.5 bg-cream-50 border border-emerald-200 rounded-lg text-sm font-bold text-emerald-900/70 hover:border-emerald-700 transition-colors"
                data-group="sess"
                data-val="4"
                data-label="4×">4×</button
              >
              <button
                class="calc-btn flex-1 px-3 py-2.5 bg-cream-50 border border-emerald-200 rounded-lg text-sm font-bold text-emerald-900/70 hover:border-emerald-700 transition-colors"
                data-group="sess"
                data-val="5"
                data-label="5×">5×</button
              >
            </div>
          </div>

          <!-- Currency -->
          <div>
            <div class="flex justify-between items-center mb-3">
              <span class="text-sm font-bold text-emerald-900/60 uppercase tracking-wider"
                >Currency</span
              >
            </div>
            <select
              id="calc-currency-select"
              class="w-full px-4 py-2.5 bg-cream-50 border border-emerald-200 rounded-lg text-sm font-bold text-emerald-900/70 focus:outline-none focus:ring-2 focus:ring-emerald-700 focus:border-emerald-700 transition-colors appearance-none cursor-pointer"
            >
              <option value="USD">USA (USD $)</option>
              <option value="GBP">UK (GBP £)</option>
              <option value="EUR">Europe (EUR €)</option>
              <option value="AED">UAE (AED د.إ)</option>
              <option value="SGD">Singapore (SGD S$)</option>
              <option value="CAD">Canada (CAD C$)</option>
              <option value="AUD">Australia (AUD A$)</option>
              <option value="SAR">Saudi Arabia (SAR ﷼)</option>
            </select>
          </div>

          <!-- Billing cycle -->
          <div>
            <div class="flex justify-between items-center mb-3">
              <span class="text-sm font-bold text-emerald-900/60 uppercase tracking-wider"
                >Billing cycle</span
              >
              <span class="text-sm font-bold text-emerald-700" id="calc-billing-val">–</span>
            </div>
            <div class="flex gap-2" id="calc-billing-btns">
              <button
                class="calc-btn flex-1 px-3 py-2.5 bg-cream-50 border border-emerald-200 rounded-lg text-xs font-bold text-emerald-900/70 hover:border-emerald-700 transition-colors"
                data-group="billing"
                data-val="monthly"
                data-label="Monthly"
                data-discount="0">Monthly</button
              >
              <button
                class="calc-btn flex-1 px-3 py-2.5 bg-cream-50 border border-emerald-200 rounded-lg text-xs font-bold text-emerald-900/70 hover:border-emerald-700 transition-colors flex items-center justify-center gap-1"
                data-group="billing"
                data-val="sixMonth"
                data-label="6 Months"
                data-discount="0.05"
                >6 Mo <span
                  class="bg-amber-50 text-amber-600 text-[9px] px-1 py-0.5 rounded border border-amber-200"
                  >−5%</span
                ></button
              >
              <button
                class="calc-btn flex-1 px-3 py-2.5 bg-cream-50 border border-emerald-200 rounded-lg text-xs font-bold text-emerald-900/70 hover:border-emerald-700 transition-colors flex items-center justify-center gap-1"
                data-group="billing"
                data-val="annual"
                data-label="12 Months"
                data-discount="0.15"
                >12 Mo <span
                  class="bg-amber-50 text-amber-600 text-[9px] px-1 py-0.5 rounded border border-amber-200"
                  >−15%</span
                ></button
              >
            </div>
          </div>

          <div class="h-px bg-emerald-100" aria-hidden="true"></div>

          <!-- Result box -->
          <div
            class="bg-emerald-50 border border-emerald-100 rounded-2xl p-5 transition-colors duration-300"
            id="calc-result-box"
          >
            <div class="text-center text-sm font-medium text-emerald-800/70 py-2">
              Select options above to see your price
            </div>
          </div>

          <Button href="/funnel/signup" variant="primary" class="w-full mt-2" id="calc-cta-btn"
            >Book Your Free Class →</Button
          >
        </div>
      </div>
    </PageHero>

    <Section height={200} class="bg-white border-y border-emerald-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
          class="grid sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 sm:divide-x divide-emerald-100"
        >
          <div class="py-6 sm:px-6 flex items-center gap-4 hover:bg-cream-50 transition-colors">
            <div
              class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center shrink-0"
              set:html={Icons.shield}
            />
            <div>
              <div class="text-sm font-bold text-emerald-950">Full-month guarantee</div>
              <div class="text-xs font-medium text-emerald-800/70">Refund if unsatisfied</div>
            </div>
          </div>
          <div class="py-6 sm:px-6 flex items-center gap-4 hover:bg-cream-50 transition-colors">
            <div
              class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center shrink-0"
            >
              <svg
                class="w-6 h-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                ></path></svg
              >
            </div>
            <div>
              <div class="text-sm font-bold text-emerald-950">Make-up guarantee</div>
              <div class="text-xs font-medium text-emerald-800/70">Every absence replaced</div>
            </div>
          </div>
          <div class="py-6 sm:px-6 flex items-center gap-4 hover:bg-cream-50 transition-colors">
            <div
              class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center shrink-0"
              set:html={Icons.xIcon}
            />
            <div>
              <div class="text-sm font-bold text-emerald-950">No hidden fees</div>
              <div class="text-xs font-medium text-emerald-800/70">You pay what you see</div>
            </div>
          </div>
          <div class="py-6 sm:px-6 flex items-center gap-4 hover:bg-cream-50 transition-colors">
            <div
              class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center shrink-0"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                ></path></svg
              >
            </div>
            <div>
              <div class="text-sm font-bold text-emerald-950">Weekly reports</div>
              <div class="text-xs font-medium text-emerald-800/70">Included in every plan</div>
            </div>
          </div>
        </div>
      </div>
    </Section>

    <Section height={900} class="py-12 md:py-24 lg:py-32" id="plans">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="text-xs font-black tracking-widest uppercase text-emerald-700 block mb-3"
            >Tuition Plans</span
          >
          <h2 class="text-4xl lg:text-5xl font-bold text-emerald-950 mb-4 tracking-tight">
            Every plan.<br />
            <em class="font-serif italic text-emerald-700 font-medium">Your currency.</em>
          </h2>
          <p class="text-lg text-emerald-900/80 font-medium max-w-2xl mx-auto">
            Same quality at every frequency — ijazah-certified teacher, weekly reports, make-up
            guarantee. Pick the pace that fits your child. Change it any time.
          </p>
        </div>

        <!-- Plan controls: Duration + Currency -->
        <div class="flex flex-wrap items-center justify-center gap-4 mb-10">
          <!-- Duration toggle -->
          <div
            class="flex items-center gap-2 bg-white border border-emerald-100 rounded-xl px-4 py-2 shadow-sm"
          >
            <span class="text-xs font-bold text-emerald-900/50 uppercase tracking-wider shrink-0"
              >Length:</span
            >
            <div class="flex gap-2" id="plan-dur-btns">
              <button
                class="plan-btn px-3 py-1.5 bg-emerald-50 border border-emerald-200 rounded-lg text-xs font-bold text-emerald-900/70 hover:border-emerald-700 transition-colors"
                data-group="plan-dur"
                data-val="30">30 min</button
              >
              <button
                class="plan-btn px-3 py-1.5 bg-emerald-50 border border-emerald-200 rounded-lg text-xs font-bold text-emerald-900/70 hover:border-emerald-700 transition-colors"
                data-group="plan-dur"
                data-val="40">40 min</button
              >
            </div>
          </div>
          <!-- Currency select -->
          <div
            class="flex items-center gap-2 bg-white border border-emerald-100 rounded-xl px-4 py-2 shadow-sm"
          >
            <span class="text-xs font-bold text-emerald-900/50 uppercase tracking-wider shrink-0"
              >Currency:</span
            >
            <select
              id="plan-currency-select"
              class="bg-transparent text-sm font-bold text-emerald-900/80 focus:outline-none cursor-pointer pr-2"
            >
              <option value="USD">USD $</option>
              <option value="GBP">GBP £</option>
              <option value="EUR">EUR €</option>
              <option value="AED">AED د.إ</option>
              <option value="SGD">SGD S$</option>
              <option value="CAD">CAD C$</option>
              <option value="AUD">AUD A$</option>
              <option value="SAR">SAR ﷼</option>
            </select>
          </div>
        </div>

        <!-- 4-tier price cards grid -->
        <div
          class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6 mb-8 max-w-6xl mx-auto"
          id="plan-cards"
        >
          <!-- 2× / week -->
          <div
            class="bg-white rounded-2xl border border-emerald-100 flex flex-col hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300"
          >
            <div class="p-6 border-b border-emerald-50">
              <div class="text-[10px] font-bold tracking-widest uppercase text-emerald-900/40 mb-3">
                Starter
              </div>
              <h3 class="font-serif text-2xl font-bold text-emerald-950 mb-1">Light</h3>
              <p class="text-xs text-emerald-800/60 font-medium leading-relaxed mb-5">
                2 sessions/week — ideal for beginners building a regular habit.
              </p>
              <div class="flex items-baseline gap-0.5 mb-0.5">
                <span class="text-lg font-bold text-emerald-900/70" id="plan-sym-2"></span>
                <span class="font-serif text-4xl font-bold text-emerald-950" id="plan-price-2"
                  >—</span
                >
              </div>
              <div class="text-xs font-medium text-emerald-800/60" id="plan-per-2">
                select options above
              </div>
              <div
                class="mt-4 inline-flex items-center px-2.5 py-1 bg-emerald-50 border border-emerald-100 text-emerald-700 text-[10px] font-bold rounded-full"
              >
                8 sessions / month
              </div>
            </div>
            <div class="p-6 flex-1 flex flex-col">
              <div class="space-y-3 flex-1 text-sm">
                <div class="flex items-start gap-2.5">
                  <span set:html={Icons.check} /><span class="font-medium text-emerald-950"
                    >8 private 1-on-1 sessions/mo</span>
                </div>
                <div class="flex items-start gap-2.5">
                  <span set:html={Icons.check} /><span class="font-medium text-emerald-950"
                    >Same dedicated teacher</span>
                </div>
                <div class="flex items-start gap-2.5">
                  <span set:html={Icons.check} /><span class="font-medium text-emerald-950"
                    >Weekly progress report</span>
                </div>
                <div class="flex items-start gap-2.5">
                  <span set:html={Icons.check} /><span class="font-medium text-emerald-950"
                    >Make-up class guarantee</span>
                </div>
                <div class="flex items-start gap-2.5">
                  <span set:html={Icons.check} /><span class="font-medium text-emerald-950"
                    >Sit-in access anytime</span>
                </div>
              </div>
              <Button href="/funnel/signup" variant="ghost" class="w-full mt-6 text-sm"
                >Start free trial →</Button
              >
            </div>
          </div>

          <!-- 3× / week -->
          <div
            class="bg-white rounded-2xl border border-emerald-200 shadow-xl flex flex-col relative overflow-hidden ring-2 ring-emerald-700/15 hover:-translate-y-0.5 transition-all duration-300"
          >
            <div
              class="absolute top-0 left-0 right-0 bg-gradient-to-r from-emerald-700 to-emerald-500 text-center text-[10px] font-bold tracking-widest uppercase text-white py-1.5 rounded-t-[20px] flex items-center justify-center gap-1"
            >
              <span set:html={Icons.sparkle} /> Most Popular
            </div>
            <div class="p-6 border-b border-emerald-100 mt-4">
              <div class="text-[10px] font-bold tracking-widest uppercase text-emerald-900/40 mb-3">
                Growth
              </div>
              <h3 class="font-serif text-2xl font-bold text-emerald-950 mb-1">Standard</h3>
              <p class="text-xs text-emerald-800/60 font-medium leading-relaxed mb-5">
                3 sessions/week — the sweet spot for consistent, meaningful progress.
              </p>
              <div class="flex items-baseline gap-0.5 mb-0.5">
                <span class="text-lg font-bold text-emerald-900/70" id="plan-sym-3"></span>
                <span class="font-serif text-4xl font-bold text-emerald-950" id="plan-price-3"
                  >—</span
                >
              </div>
              <div class="text-xs font-medium text-emerald-800/60" id="plan-per-3">
                select options above
              </div>
              <div
                class="mt-4 inline-flex items-center px-2.5 py-1 bg-emerald-50 border border-emerald-200 text-emerald-700 text-[10px] font-bold rounded-full shadow-sm"
              >
                12 sessions / month
              </div>
            </div>
            <div class="p-6 flex-1 flex flex-col">
