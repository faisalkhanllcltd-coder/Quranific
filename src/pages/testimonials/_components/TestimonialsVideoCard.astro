---
// src/pages/testimonials/_components/TestimonialsVideoCard.astro
import Section from '../../../components/ui/Section.astro';
import EyebrowBadge from '../../../components/ui/EyebrowBadge.astro';
import EyebrowText from '../../../components/ui/EyebrowText.astro';

const Icons = {
  play: `<svg class="w-10 h-10 lg:w-12 lg:h-12 text-white ml-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>`,
};
---

<Section height={500} class="pb-10 md:pb-20 lg:pb-32 px-4 sm:px-6 relative z-10">
  <div class="max-w-5xl mx-auto">
    <div
      class="relative w-full aspect-video bg-emerald-950 rounded-[2rem] lg:rounded-[3rem] shadow-2xl border-4 border-white/60 overflow-hidden group cursor-pointer"
    >
      <div
        class="absolute inset-0 bg-gradient-to-br from-emerald-900 via-emerald-800 to-emerald-950 opacity-90 transition-transform duration-1000 group-hover:scale-105"
        aria-hidden="true"
      >
      </div>
      <div
        class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0MCIgaGVpZ2h0PSI0MCI+PHBhdGggZD0iTTAgMGg0MHY0MEgweiIgZmlsbD0ibm9uZSIvPPHBhdGggZD0iTTAgMTBoNDBNMTAgMHY0ME0wIDIwaDQwTTIwIDB2NDBNMCAzMGg0ME0zMCAwdjQwIiBzdHJva2U9InJnYmEoMjU1LDI1NSwyNTUsMC4wNSkiIHN0cm9rZS13aWR0aD0iMSIvPjwvc3ZnPg==')] opacity-40"
        aria-hidden="true"
      >
      </div>

      <div
        class="absolute bottom-0 left-1/2 -translate-x-1/2 w-64 h-64 bg-emerald-700/50 rounded-t-full blur-2xl"
        aria-hidden="true"
      >
      </div>

      <div class="absolute inset-0 flex flex-col items-center justify-center">
        <div
          class="w-20 h-20 lg:w-24 lg:h-24 bg-white/20 backdrop-blur-md rounded-full flex items-center justify-center border border-white/30 group-hover:bg-white/30 group-hover:scale-110 transition-all duration-300 shadow-2xl"
        >
          <span set:html={Icons.play} />
        </div>
        <EyebrowText class="text-white mt-6 drop-shadow-md">
          Watch The Parent Experience
        </EyebrowText>
      </div>

      <div class="absolute top-6 left-6 lg:top-8 lg:left-8 flex gap-3">
        <EyebrowBadge class="bg-amber-400 text-emerald-950 shadow-sm !rounded-md">
          Featured Story
        </EyebrowBadge>
      </div>
      <div class="absolute bottom-6 left-6 lg:bottom-8 lg:left-8">
        <h3 class="text-white font-bold text-xl lg:text-2xl drop-shadow-md">
          "It completely transformed his Tajweed."
        </h3>
        <p class="text-emerald-100/80 text-sm font-medium mt-1">Sarah & Ibrahim • London, UK</p>
      </div>
    </div>
    <div
      class="absolute -inset-10 bg-emerald-500/20 blur-[100px] rounded-[4rem] -z-10 pointer-events-none"
      aria-hidden="true"
    >
    </div>
  </div>
</Section>
