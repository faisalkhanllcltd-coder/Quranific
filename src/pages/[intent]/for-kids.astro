---
// src/pages/[intent]/for-kids.astro
import Base from '../../layouts/Base.astro';
import { SITE } from '../../constants/site';

export const prerender = true;

export function getStaticPaths() {
  return [{ params: { intent: 'quran-classes' } }, { params: { intent: 'quran-teacher' } }];
}

const { intent } = Astro.params;

type Intent = 'quran-classes' | 'quran-teacher';

const intentCopy: Record<
  Intent,
  { h1: string; subhead: string; seoTitle: string; seoDesc: string }
> = {
  'quran-classes': {
    h1: 'Fun Quran Classes for Kids — 1-on-1 Online Learning',
    subhead:
      'Certified, patient tutors run structured online Quran classes designed for children aged 4–16. Interactive lessons, flexible parent schedules, and real progress from day one.',
    seoTitle: 'Online Quran Classes for Kids | Certified 1-on-1 Tutors',
    seoDesc:
      'Enrol your child in live 1-on-1 online Quran classes. Patient, certified tutors specialising in Qaida, Tajweed, and Hifz for ages 4–16.',
  },
  'quran-teacher': {
    h1: 'Find Your Child a Personal Quran Teacher — Online & 1-on-1',
    subhead:
      "We hand-pick a certified Quran teacher matched to your child's age, level, and pace — so every session feels personalised, safe, and effective.",
    seoTitle: 'Online Quran Teacher for Kids | Hand-Picked 1-on-1 Tutors',
    seoDesc:
      "Get a dedicated online Quran teacher for your child. Certified tutors matched to your child's age and level. Book a free trial today.",
  },
};

const copy = intentCopy[intent as Intent];

// SEO Shield: canonical always resolves to the quran-classes master URL
const canonicalUrl = `${SITE.url}/quran-classes/for-kids`;

const benefits = [
  'Patient & Certified Tutors',
  'Interactive & Fun Lessons',
  'Flexible Parent Schedules',
  'Progress Tracking Dashboard',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: copy.seoTitle,
  description: copy.seoDesc,
  url: canonicalUrl,
};
---

<Base
  title={copy.seoTitle}
  description={copy.seoDesc}
  canonical={canonicalUrl}
  robots="index, follow"
>
  <!-- Noindex fallback — uncomment to pull from all search indexes if needed -->
  <!-- <meta name="robots" content="noindex, nofollow" /> -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline slot="head" />

  <main class="min-h-screen relative bg-cream-50 overflow-hidden font-sans">
    <!-- Dot Grid (Site Standard) -->
    <div
      class="absolute inset-0 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:16px_16px] opacity-30 z-0"
      aria-hidden="true"
    >
    </div>
    <!-- Glow Blob -->
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-3xl h-[600px] bg-amber-400/10 blur-[120px] rounded-full pointer-events-none z-0"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 max-w-6xl mx-auto px-6 py-8">
      <!-- Minimal Header -->
      <header class="flex justify-between items-center mb-16 md:mb-24">
        <a
          href="/"
          class="inline-flex items-center gap-2 font-serif font-black text-2xl text-emerald-950 hover:opacity-80 transition-opacity"
        >
          Quranific<span class="text-emerald-600">.</span>
        </a>
      </header>

      <!-- Hero: Intent-Matched H1 + Subhead -->
      <section class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <!-- Left: Copy & CTAs -->
        <div class="max-w-2xl">
          <span
            class="inline-block px-4 py-1.5 rounded-full bg-amber-100/80 text-amber-800 text-xs font-bold uppercase tracking-wider mb-6 border border-amber-200 shadow-sm"
          >
            ★ Parent-Approved Safeguarding
          </span>

          <!-- Dynamic H1: swapped per [intent] for 10/10 Google Ads message match -->
          <h1
            class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-emerald-950 tracking-tight leading-[1.1] mb-6"
          >
            {copy.h1}
          </h1>

          <!-- Dynamic Subhead: audience-aware, intent-matched -->
          <p class="text-lg md:text-xl text-emerald-800/80 leading-relaxed mb-10">
            {copy.subhead}
          </p>

          <div class="flex flex-col sm:flex-row items-center gap-4">
            <!-- PRIMARY CTA: source encodes intent + audience for full attribution -->
            <a
              href={`/funnel/signup?source=${intent}_kids`}
              data-track-cta
              class="w-full sm:w-auto inline-flex justify-center items-center px-8 py-4 text-[15px] font-bold rounded-full bg-emerald-600 text-white hover:bg-emerald-700 transition-colors shadow-lg shadow-emerald-900/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2"
            >
              Book Your Free Class
            </a>
            <a
              href={SITE.whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex justify-center items-center px-8 py-4 text-[15px] font-bold rounded-full bg-white text-emerald-900 border border-emerald-200 hover:bg-emerald-50 transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2"
            >
              <svg
                class="w-5 h-5 mr-2 text-[#25D366]"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
                ></path>
              </svg>
              Chat on WhatsApp
            </a>
          </div>
        </div>

        <!-- Right: Glassmorphism Trust Card -->
        <div class="relative w-full max-w-lg mx-auto lg:ml-auto">
          <div
            class="bg-white/60 backdrop-blur-md rounded-[2rem] p-8 shadow-xl border border-white/80 relative z-10"
          >
            <div class="flex items-center gap-1 mb-6 text-amber-400 text-xl" aria-hidden="true">
              ★★★★★
            </div>
            <h2 class="text-2xl font-bold text-emerald-950 mb-6">Top Rated Academy</h2>
            <ul class="space-y-4">
              {
                benefits.map((benefit) => (
                  <li class="flex items-center gap-3 text-emerald-900 font-medium">
                    <div class="flex-shrink-0 w-6 h-6 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600">
                      <svg
                        class="w-4 h-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2.5"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                    </div>
                    {benefit}
                  </li>
                ))
              }
            </ul>
            <div class="mt-8 pt-6 border-t border-emerald-100/50">
              <p class="text-sm font-semibold text-emerald-800/60 uppercase tracking-widest">
                Trusted by thousands of students globally.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Conversion Sequence: paste audience-specific body copy here -->
      <main id="conversion-sequence"></main>
    </div>
  </main>

  <!-- Attribution Preservation: forwards gclid/utm_* from the ad URL into CTA href -->
  <script is:inline>
    const attachAttribution = () => {
      const ctaButtons = document.querySelectorAll('a[data-track-cta]');
      if (!ctaButtons.length) return;
      const currentParams = new URLSearchParams(window.location.search);
      ctaButtons.forEach((button) => {
        try {
          const targetUrl = new URL(button.getAttribute('href'), window.location.origin);
          currentParams.forEach((value, key) => {
            if (!targetUrl.searchParams.has(key)) {
              targetUrl.searchParams.set(key, value);
            }
          });
          button.setAttribute('href', targetUrl.toString());
        } catch {
          // Non-fatal: attribution best-effort only
        }
      });
    };
    attachAttribution();
    document.addEventListener('astro:page-load', attachAttribution);
  </script>
</Base>
