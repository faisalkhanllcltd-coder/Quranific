---
export const prerender = true;

// src/pages/contact/index.astro
import Base from '../../layouts/Base.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import FinalCTA from '../../components/blocks/FinalCTA.astro';

import PageHero from '../../components/blocks/PageHero.astro';
import SmartContactForm from './_components/SmartContactForm.astro';
import AvailabilityTable from './_components/AvailabilityTable.astro';
import ContactFaq from './_components/ContactFaq.astro';

import { SITE } from '../../constants/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Us - Quranific | We Reply to Every Message',
  description:
    'Get in touch with the Quranific team. Contact us via email or WhatsApp for support, inquiries, or feedback.',
  mainEntity: {
    '@type': 'Organization',
    name: 'Quranific',
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: SITE.emails.support,
      availableLanguage: ['English', 'Arabic'],
    },
  },
};
---

<Base
  title="Contact Us - Quranific | We Reply to Every Message"
  description="Get in touch with the Quranific team. Contact us via email or WhatsApp for support, inquiries, or feedback."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" is:inline />
  <!-- Cloudflare Turnstile — loaded async so it never blocks rendering -->
  <script
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
    is:inline
    slot="head"></script>

  <Header />

  <main class="bg-cream-50 selection:bg-emerald-100 selection:text-emerald-900 font-sans">
    <PageHero
      eyebrow="Got Questions?"
      title="We reply to "
      highlightWord="every message within 24 hours."
      subtitle="No chatbots. No ticket queues. A real person from our team reads every message and responds with the answer you actually need, not a link to an FAQ."
      primaryCtaText=""
    >
      <Fragment slot="visual">
        <div class="flex flex-col gap-4 relative z-20 w-full max-w-md mx-auto lg:mx-0 lg:ml-auto">
          <a
            href={`https://wa.me/${(SITE.whatsappNumber || '923112112122').replace(/\D/g, '')}`}
            target="_blank"
            class="flex items-center gap-5 bg-white border border-emerald-100 rounded-2xl p-5 hover:shadow-md transition-all duration-300 group relative overflow-hidden"
          >
            <div
              class="absolute left-0 top-0 bottom-0 w-1 bg-[#25D366] scale-y-0 group-hover:scale-y-100 origin-bottom transition-transform duration-300"
              aria-hidden="true"
            >
            </div>
            <div
              class="w-12 h-12 rounded-xl bg-green-50 border border-green-200 text-green-600 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform"
              aria-hidden="true"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"
                ><path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
                ></path></svg
              >
            </div>
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-0.5">
                <h3 class="font-bold text-emerald-950 text-[15px]">WhatsApp</h3>
                <span
                  class="px-2 py-0.5 bg-green-50 border border-green-200 text-green-600 text-[10px] font-bold rounded-full"
                  >Fastest · ~12 mins</span
                >
              </div>
              <p class="text-sm font-medium text-emerald-800/70">
                For quick questions and urgent matters.
              </p>
            </div>
          </a>

          <a
            href="#contact-form"
            class="flex items-center gap-5 bg-white border border-emerald-100 rounded-2xl p-5 hover:shadow-md transition-all duration-300 group relative overflow-hidden"
          >
            <div
              class="absolute left-0 top-0 bottom-0 w-1 bg-emerald-700 scale-y-0 group-hover:scale-y-100 origin-bottom transition-transform duration-300"
              aria-hidden="true"
            >
            </div>
            <div
              class="w-12 h-12 rounded-xl bg-emerald-50 border border-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform"
              aria-hidden="true"
            >
              <svg
                width="24"
                height="24"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="2"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                ></path></svg
              >
            </div>
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-0.5">
                <h3 class="font-bold text-emerald-950 text-[15px]">Contact Form</h3>
                <span
                  class="px-2 py-0.5 bg-emerald-50 border border-emerald-100 text-emerald-700 text-[10px] font-bold rounded-full"
                  >Within 24 hrs</span
                >
              </div>
              <p class="text-sm font-medium text-emerald-800/70">
                For detailed questions and enrolment routing.
              </p>
            </div>
          </a>

          <a
            href={`mailto:${SITE.emails.support}`}
            class="flex items-center gap-5 bg-white border border-emerald-100 rounded-2xl p-5 hover:shadow-md transition-all duration-300 group relative overflow-hidden"
          >
            <div
              class="absolute left-0 top-0 bottom-0 w-1 bg-amber-500 scale-y-0 group-hover:scale-y-100 origin-bottom transition-transform duration-300"
              aria-hidden="true"
            >
            </div>
            <div
              class="w-12 h-12 rounded-xl bg-amber-50 border border-amber-200 text-amber-600 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform"
              aria-hidden="true"
            >
              <svg
                width="24"
                height="24"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="2"
                ><path
                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                ></path></svg
              >
            </div>
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-0.5">
                <h3 class="font-bold text-emerald-950 text-[15px]">Direct Email</h3>
                <span
                  class="px-2 py-0.5 bg-emerald-50 border border-emerald-100 text-emerald-700 text-[10px] font-bold rounded-full"
                  >Within 24 hrs</span
                >
              </div>
              <p class="text-sm font-medium text-emerald-800/70">{SITE.emails.support}</p>
            </div>
          </a>
        </div>
      </Fragment>
    </PageHero>
    <SmartContactForm />
    <AvailabilityTable />
    <ContactFaq />
    <FinalCTA />
  </main>

  <Footer />
</Base>
