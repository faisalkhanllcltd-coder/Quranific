---
// src/components/landing/heroes/HeroKids.astro
import Button from '../../ui/Button.astro';

interface Props {
  intent: string;
  h1: string;
  subhead: string;
}

const { intent, h1, subhead } = Astro.props;
---

<section class="relative overflow-hidden border-b border-emerald-100">
  <!-- Dot grid -->
  <div
    class="absolute inset-0 bg-[radial-gradient(#d1fae5_1px,transparent_1px)] [background-size:20px_20px] opacity-50 pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <!-- Glow blob -->
  <div
    class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[500px] bg-emerald-400/10 blur-[140px] rounded-full pointer-events-none"
    aria-hidden="true"
  >
  </div>

  <div class="quranific-container relative z-10 py-8">
    <!-- Minimal ad-lander header: logo only, no nav -->
    <header class="mb-14 md:mb-20">
      <a
        href="/"
        class="inline-flex items-center gap-1 font-serif font-black text-xl text-emerald-950 hover:opacity-70 transition-opacity"
      >
        Quranific<span class="text-emerald-600">.</span>
      </a>
    </header>

    <div class="grid lg:grid-cols-2 gap-12 xl:gap-20 items-center pb-16 sm:pb-20 lg:pb-24">
      <!-- Left: headline + CTAs -->
      <div>
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-100 border border-emerald-200 text-emerald-800 text-xs font-bold uppercase tracking-widest mb-6"
        >
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          Free First Class · No Card Required
        </div>

        <!-- Dynamic H1 -->
        <h1
          class="font-serif text-4xl sm:text-5xl lg:text-6xl font-black text-emerald-950 leading-[1.06] tracking-tight mb-5"
        >
          {h1}
        </h1>

        <!-- Dynamic Subhead -->
        <p
          class="text-xl md:text-2xl text-emerald-800/75 font-medium leading-relaxed mb-4 max-w-xl"
        >
          {subhead}
        </p>

        <!-- Price anchor -->
        <p class="text-sm font-semibold text-emerald-700/60 mb-8 uppercase tracking-wide">
          From <strong class="text-emerald-900">$40/mo</strong> ·
          <a
            href="/tuition-fee"
            class="underline underline-offset-2 hover:text-emerald-700 transition-colors"
            >Full pricing</a
          >
        </p>

        <!-- CTAs: Hero = variant="primary" per funnel mapping -->
        <div class="flex flex-col sm:flex-row gap-3 mb-8">
          <Button
            href={`/enroll/step-1?intent=${intent}`}
            data-track-cta
            variant="primary"
            class="px-8 py-4 text-base font-bold shadow-sm"
          >
            Start Free Trial
          </Button>
          <a
            href="https://wa.me/447477382348?text=Hello! I want to start a free Quran trial for my kids."
            class="bg-emerald-50 text-emerald-950 px-6 py-3 rounded-lg font-semibold flex items-center justify-center gap-2 group relative overflow-hidden transition-all duration-300 hover:scale-[1.02] active:scale-[0.98]"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div
              class="absolute inset-0 bg-white/60 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-in-out"
            >
            </div>
            <div class="relative z-10 flex items-center gap-2">
              <svg
                class="w-5 h-5 text-emerald-600"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
                ></path>
              </svg>
              Ask a question
            </div>
          </a>
        </div>

        <!-- Microtrust strip -->
        <div class="flex flex-wrap gap-x-5 gap-y-1.5 text-sm text-emerald-800/60 font-medium">
          {
            [
              '✓ No credit card',
              '✓ Cancel anytime',
              '✓ Full-month refund guarantee',
              '✓ Safeguarding-checked teachers',
            ].map((b) => <span>{b}</span>)
          }
        </div>
      </div>

      <!-- Right: Hero Image -->
      <div class="w-full mt-10 lg:mt-0 relative overflow-hidden rounded-[2rem] lg:rounded-[2.5rem]">
        <img
          src="/images/quran-classes-for-kids.webp"
          alt="Quran Classes for Kids"
          class="w-full h-auto object-cover"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>
