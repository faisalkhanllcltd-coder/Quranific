---
// src/pages/teachers/_components/TeachersGenderPrivacy.astro
import Section from '../../../components/ui/Section.astro';
import EyebrowText from '../../../components/ui/EyebrowText.astro';

const Icons = {
  checkCircle: `<svg class="w-5 h-5 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>`,
  // Scaled down to fit the new floating badge
  privacy: `<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" /></svg>`,
};
---

<Section class="py-16 lg:py-24 px-4 sm:px-6 border-b border-emerald-100 overflow-hidden">
  <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
    <!-- Text Column -->
    <div class="flex flex-col items-start max-w-xl">
      <EyebrowText class="text-emerald-700 mb-3 font-bold tracking-widest"
        >Safe &amp; Comfortable</EyebrowText
      >

      <h2
        class="text-3xl sm:text-4xl lg:text-5xl font-black text-emerald-950 mb-6 tracking-tight text-balance leading-[1.15]"
      >
        Dedicated Male & Female Instructors
      </h2>

      <p class="text-lg text-emerald-900/80 leading-relaxed font-medium mb-10 text-balance">
        We understand the importance of modesty and comfort in Islamic education. You have the
        absolute freedom to request specifically male or female tutors.
      </p>

      <div class="space-y-8">
        <div class="flex items-start gap-4">
          <div
            class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center shrink-0 mt-1 shadow-sm border border-emerald-200/50"
            aria-hidden="true"
          >
            <span set:html={Icons.checkCircle} />
          </div>
          <div>
            <h4 class="font-bold text-emerald-950 text-lg">Female Tutors for Sisters & Kids</h4>
            <p class="text-emerald-800/80 text-sm font-medium mt-1.5 leading-relaxed">
              Nurturing, patient environments ensuring absolute privacy for women and a gentle
              approach for young children.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div
            class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center shrink-0 mt-1 shadow-sm border border-emerald-200/50"
            aria-hidden="true"
          >
            <span set:html={Icons.checkCircle} />
          </div>
          <div>
            <h4 class="font-bold text-emerald-950 text-lg">Male Tutors for Brothers</h4>
            <p class="text-emerald-800/80 text-sm font-medium mt-1.5 leading-relaxed">
              Expert scholars and Hafiz-e-Quran providing rigorous, focused academic mentorship for
              boys and men.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Visual Column -->
    <div class="relative group w-full max-w-lg mx-auto lg:max-w-none lg:mx-0 mt-8 lg:mt-0">
      <!-- Ambient Glow Behind Image -->
      <div
        class="absolute inset-0 bg-gradient-to-tr from-emerald-300/30 to-teal-500/20 rounded-[2.5rem] blur-3xl transform group-hover:scale-105 transition-transform duration-700 ease-out -z-10"
        aria-hidden="true"
      >
      </div>

      <!-- Image Container -->
      <div
        class="relative w-full aspect-[4/3] sm:aspect-[16/9] lg:aspect-[4/3] rounded-[2rem] overflow-hidden border border-emerald-900/10 shadow-2xl bg-emerald-50"
      >
        <img
          src="/images/quran-teachers.webp"
          onerror="this.onerror=null;this.style.display='none';"
          alt="Dedicated Male and Female Quran Instructors"
          class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
          loading="lazy"
          decoding="async"
        />
        <!-- Inner framing shadow -->
        <div
          class="absolute inset-0 shadow-[inset_0_0_0_1px_rgba(0,0,0,0.05)] pointer-events-none"
          aria-hidden="true"
        >
        </div>
      </div>

      <!-- Floating Structural Badge (Replaces the old giant card) -->
      <div
        class="absolute -bottom-6 -left-6 sm:-left-10 bg-white p-4 pr-6 rounded-2xl shadow-xl border border-emerald-50 hidden sm:flex items-center gap-4 z-10 hover:-translate-y-1 transition-transform duration-300"
      >
        <div
          class="w-12 h-12 bg-emerald-950 text-emerald-400 rounded-full flex items-center justify-center shadow-inner"
        >
          <span set:html={Icons.privacy} />
        </div>
        <div>
          <div class="text-sm font-black text-emerald-950 uppercase tracking-widest">
            100% Privacy
          </div>
          <div class="text-xs font-bold text-emerald-700/70">Secure 1-on-1 Classes</div>
        </div>
      </div>
    </div>
  </div>
</Section>
