---
// src/pages/[intent]/for-women.astro
import Base from '../../layouts/Base.astro';
import Button from '../../components/ui/Button.astro';
import { SITE } from '../../constants/site';
import { TESTIMONIALS_DATA } from '../../constants/testimonials';

export const prerender = true;

export function getStaticPaths() {
  return [{ params: { intent: 'quran-classes' } }, { params: { intent: 'quran-teacher' } }];
}

const { intent } = Astro.params;

type Intent = 'quran-classes' | 'quran-teacher';

// ── 90/10 Split: hero copy swapped per intent for Google Ads message match ──
const intentCopy: Record<
  Intent,
  { h1: string; subhead: string; seoTitle: string; seoDesc: string }
> = {
  'quran-classes': {
    h1: 'Premium Online Quran Classes for Women',
    subhead:
      'Private, 1-on-1 online classes with certified Ustadhas. A secure, sisters-only environment — whether you are starting from zero or perfecting your Tajweed.',
    seoTitle: 'Online Quran Classes for Women | 100% Female Ustadhas | Quranific',
    seoDesc:
      'Private 1-on-1 Quran classes for women taught exclusively by certified female Ustadhas. Sisters-only environment. Flexible scheduling. First class free.',
  },
  'quran-teacher': {
    h1: 'Find a Female Quran Teacher Who Fits Your Schedule',
    subhead:
      'Match with a vetted, professional Ustadha. 100% private sessions built around your busy life. Start risk-free today.',
    seoTitle: 'Find a Female Quran Teacher Online | Vetted Ustadhas | Quranific',
    seoDesc:
      'Find a vetted female Quran teacher (Ustadha) for private 1-on-1 sessions. Sisters-only, flexible scheduling, full-month guarantee. First class free.',
  },
};

const copy = intentCopy[intent as Intent];

// SEO Shield: canonical always points to master quran-classes URL
const canonicalUrl = `${SITE.url}/quran-classes/for-women`;

// Testimonials: Amna (female, own spiritual journey) + Naseerullah Babar (daughters' experience)
const womenTestimonials = TESTIMONIALS_DATA.filter((t) =>
  ['Amna', 'Naseerullah Babar'].includes(t.name)
);

const vettingSteps = [
  {
    n: '01',
    title: 'Ijazah Verification',
    body: 'We confirm the teacher holds a valid chain of Ijazah — a certified lineage of Quranic transmission. No exceptions.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>`,
  },
  {
    n: '02',
    title: 'Live Recitation Assessment',
    body: 'Our academic team conducts a live Tajweed assessment to ensure professional, elite-level recitation.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>`,
  },
  {
    n: '03',
    title: 'Ustadha Pedagogy Interview',
    body: 'We probe specifically for empathetic, adult-teaching ability. How do they explain complex Tajweed rules to an English-speaking sister? We hire for patience, warmth, and clarity.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
  },
  {
    n: '04',
    title: 'Privacy & Professional Conduct Check',
    body: 'Every Ustadha is vetted for punctuality, professionalism, and strict adherence to privacy protocols.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>`,
  },
];

const trustPoints = [
  '100% private, sisters-only environment',
  'Learn comfortably and securely from home',
  'Reschedule classes easily when life gets busy',
  'Empathetic teachers who understand your schedule',
];

const onboardingSteps = [
  {
    n: '1',
    title: 'Book your free class.',
    body: 'No card required. Tell us your goals and your preferred schedule.',
  },
  {
    n: '2',
    title: 'Judgment-Free Assessment.',
    body: 'Meet your Ustadha. Even if you are starting from the absolute alphabet (Qaida), there is zero judgment. Your teacher simply listens to understand your starting line.',
  },
  {
    n: '3',
    title: 'Experience a real lesson.',
    body: "See exactly how the teaching style fits you. If it's not a perfect match, we will assign a different teacher — or we part ways with no hard feelings.",
  },
];

const guaranteeCards = [
  { label: 'Free first class', sub: 'No card required' },
  { label: '30-day refund', sub: 'If not satisfied, one email' },
  { label: 'Make-up guarantee', sub: 'Missed sessions rescheduled' },
];

const faqItems = [
  {
    q: 'Is it guaranteed I will have a female teacher?',
    a: 'Yes. This programme is strictly female-to-female. You will only ever be matched with a vetted, qualified Ustadha, ensuring a 100% secure and private environment.',
  },
  {
    q: 'What if I am a complete beginner?',
    a: 'A large portion of our students start from the very beginning (the Noorani Qaida). You do not need to know Arabic — our Ustadhas specialise in guiding beginners step-by-step in English.',
  },
  {
    q: 'What if my baby cries or I need to pause class?',
    a: 'We understand the realities of motherhood and busy lives. Our environment is empathetic and flexible. You can pause, step away, or reschedule easily.',
  },
  {
    q: 'How much does it cost?',
    a: 'From $40/month depending on session length and frequency. Full pricing is transparent — no hidden fees.',
    link: { text: 'See full pricing →', href: '/tuition-fee' },
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: copy.seoTitle,
  description: copy.seoDesc,
  url: canonicalUrl,
};
---

<Base
  title={copy.seoTitle}
  description={copy.seoDesc}
  robots="noindex, follow"
  canonical={canonicalUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline slot="head" />

  <div class="bg-white antialiased">
    <!-- ════════════════════════════════════════════════════════════
         § 1  HERO — Grand Slam Offer + 3-Second Hook
         Warm dark hero with purple-tinted privacy glow
         ═══════════════════════════════════════════════════════════ -->
    <section class="relative overflow-hidden bg-emerald-950">
      <!-- Subtle dot grid -->
      <div
        class="absolute inset-0 bg-[radial-gradient(rgba(167,139,250,0.08)_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"
        aria-hidden="true"
      >
      </div>
      <!-- Warm purple glow — sisters-only warmth signal -->
      <div
        class="absolute top-0 right-0 w-[500px] h-[500px] bg-purple-600/10 blur-[160px] rounded-full pointer-events-none"
        aria-hidden="true"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-emerald-500/8 blur-[120px] rounded-full pointer-events-none"
        aria-hidden="true"
      >
      </div>

      <div class="quranific-container relative z-10 py-8">
        <!-- Ad-lander header: logo only, no nav leakage -->
        <header class="mb-14 md:mb-20">
          <a
            href="/"
            class="inline-flex items-center gap-1 font-serif font-black text-xl text-white hover:opacity-70 transition-opacity"
          >
            Quranific<span class="text-emerald-400">.</span>
          </a>
        </header>

        <div
          class="grid lg:grid-cols-[1fr_360px] gap-12 xl:gap-20 items-center pb-16 sm:pb-20 lg:pb-24"
        >
          <!-- Left: headline + CTAs -->
          <div>
            <!-- Sisters-only badge -->
            <div
              class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-purple-900/60 border border-purple-700/50 text-purple-200 text-xs font-bold uppercase tracking-widest mb-6"
            >
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              100% Sisters-Only · Free First Class
            </div>

            <!-- Dynamic H1 per intent -->
            <h1
              class="font-serif text-4xl sm:text-5xl lg:text-[3.5rem] font-black text-white leading-[1.06] tracking-tight mb-5"
            >
              {copy.h1}
            </h1>

            <!-- Dynamic subhead per intent -->
            <p
              class="text-xl md:text-2xl text-emerald-100/70 font-medium leading-relaxed mb-4 max-w-xl"
            >
              {copy.subhead}
            </p>

            <!-- Price anchor -->
            <p class="text-sm font-semibold text-emerald-400/60 mb-8 uppercase tracking-wide">
              From <strong class="text-emerald-300">$40/mo</strong> ·
              <a
                href="/tuition-fee"
                class="underline underline-offset-2 hover:text-emerald-300 transition-colors"
                >Full pricing</a
              >
            </p>

            <!-- CTAs — data-track-cta for attribution script targeting -->
            <div class="flex flex-col sm:flex-row gap-3 mb-8">
              <Button
                href={`/funnel/signup?source=ad_women_${intent}`}
                data-track-cta
                variant="secondary"
                class="px-6 py-3 text-sm font-semibold shadow-lg shadow-black/20"
              >
                Book Your Free Class
              </Button>
              <Button
                href={SITE.whatsappLink}
                target="_blank"
                rel="noopener noreferrer"
                variant="ghost"
                class="px-6 py-3 text-sm font-semibold border-emerald-700 text-emerald-100 hover:bg-emerald-900"
              >
                <svg
                  class="w-5 h-5 mr-2 shrink-0 text-[#25D366]"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
                  ></path>
                </svg>
                Chat on WhatsApp
              </Button>
            </div>

            <!-- Trust strip -->
            <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-emerald-300/60 font-medium">
              {
                [
                  '✓ 100% Female Ustadhas',
                  '✓ Strict Privacy',
                  '✓ Flexible scheduling',
                  '✓ Full-month guarantee',
                ].map((b) => <span>{b}</span>)
              }
            </div>
          </div>

          <!-- Right: floating privacy trust card (desktop) -->
          <div class="hidden lg:block">
            <div
              class="bg-emerald-900/70 border border-purple-700/30 backdrop-blur-sm rounded-2xl p-8"
            >
              <div class="flex items-center gap-2 mb-5">
                <div class="w-8 h-8 rounded-full bg-purple-800/60 flex items-center justify-center">
                  <svg
                    class="w-4 h-4 text-purple-300"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  </svg>
                </div>
                <p class="text-xs font-bold uppercase tracking-widest text-purple-300">
                  Privacy Guaranteed
                </p>
              </div>
              <ul class="space-y-4 mb-6">
                {
                  [
                    { icon: '👩‍🏫', text: 'Guaranteed female Ustadha — no exceptions' },
                    { icon: '🔒', text: 'Sessions are private, 1-on-1 only' },
                    { icon: '🏠', text: 'Learn from home — no travel required' },
                    { icon: '🕐', text: 'Schedule around your family, 24/7' },
                  ].map(({ icon, text }) => (
                    <li class="flex items-start gap-3 text-sm text-emerald-100/80 font-medium leading-snug">
                      <span class="text-base leading-none mt-0.5" aria-hidden="true">
                        {icon}
                      </span>
                      {text}
                    </li>
                  ))
                }
              </ul>
              <div class="pt-5 border-t border-purple-700/30">
                <p class="text-sm font-semibold text-purple-200">Trusted by sisters worldwide</p>
                <p class="text-purple-300/50 text-xs mt-1">
                  Enrolled sisters from the UK, USA, UAE &amp; beyond
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         § 2  PROBLEM — Honest Problem / Unspoken Anxieties
         ═══════════════════════════════════════════════════════════ -->
    <section class="quranific-section bg-white border-b border-slate-100">
      <div class="quranific-container">
        <div class="max-w-3xl">
          <p class="text-xs font-bold uppercase tracking-widest text-emerald-600 mb-4">
            The Honest Problem
          </p>
          <h2
            class="font-serif text-3xl md:text-4xl font-black text-emerald-950 leading-tight mb-8"
          >
            Finding a safe, consistent learning space is harder than it should be.
          </h2>
          <div class="space-y-5 text-lg text-slate-600 leading-relaxed max-w-prose">
            <p>
              Between managing a household, a career, and daily responsibilities, finding time for
              your own Quran journey is hard enough. Mosque classes often don't fit your schedule,
              and finding a qualified, relatable female teacher online without privacy concerns can
              be daunting.
            </p>
            <p>
              You might feel like you've started too late, or worry about interruptions at home. The
              friction of just trying to find a safe, consistent learning environment stops many
              sisters from ever beginning.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         § 3  OUTCOME — Working Backwards from the Dream
         ═══════════════════════════════════════════════════════════ -->
    <section class="quranific-section bg-cream-50 border-b border-emerald-50">
      <div class="quranific-container">
        <div class="grid lg:grid-cols-2 gap-12 xl:gap-20 items-center">
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-emerald-600 mb-4">
              Six Months From Now
            </p>
            <h2
              class="font-serif text-3xl md:text-4xl font-black text-emerald-950 leading-tight mb-6"
            >
              This doesn't have to be a source of stress anymore.
            </h2>
            <div class="space-y-4 text-lg text-emerald-900/75 leading-relaxed max-w-prose">
              <p>
                Picture having a peaceful time in your week dedicated entirely to your connection
                with the Quran. You are reading fluently, without second-guessing. You understand
                the Tajweed rules, and for the first time, you feel a deep, focused spiritual
                connection in your Salah because you know exactly how to recite.
              </p>
              <p class="font-medium text-emerald-950">
                That is the goal — confidence, fluency, and peace of mind, on your schedule.
              </p>
            </div>
          </div>

          <!-- OUTCOME IMAGE placeholder -->
          <div
            class="bg-slate-200 aspect-[4/3] rounded-2xl flex items-center justify-center text-slate-500 font-medium text-sm shadow-sm"
          >
            [ASSET: Sister reading Quran peacefully — warm, aspirational lifestyle photo]
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         § 4  MECHANISM — 4-Stage Vetting + Why 1-on-1
         ═══════════════════════════════════════════════════════════ -->
    <section class="quranific-section bg-white border-b border-slate-100">
      <div class="quranific-container">
        <div class="max-w-3xl mb-12">
          <p class="text-xs font-bold uppercase tracking-widest text-emerald-600 mb-4">
            Why It Works
          </p>
          <h2 class="font-serif text-3xl md:text-4xl font-black text-emerald-950 leading-tight">
            Every Ustadha passes a 4-stage vetting process.
          </h2>
        </div>

        <ol class="grid sm:grid-cols-2 gap-5 mb-10">
          {
            vettingSteps.map(({ n, title, body, icon }) => (
              <li class="bg-cream-50 border border-slate-100 rounded-2xl p-7 shadow-sm">
                <div class="flex items-start gap-3 mb-4">
                  <div class="flex-shrink-0 w-10 h-10 rounded-full bg-purple-100 text-purple-700 flex items-center justify-center">
                    <Fragment set:html={icon} />
                  </div>
                  <span class="text-xs font-black text-slate-300 tracking-widest mt-3">{n}</span>
                </div>
                <p class="font-bold text-emerald-950 text-lg mb-2">{title}</p>
                <p class="text-slate-500 leading-relaxed text-sm">{body}</p>
              </li>
            ))
          }
        </ol>

        <!-- 1-on-1 callout: privacy + no group embarrassment -->
        <div class="bg-emerald-950 rounded-2xl p-8 max-w-3xl">
          <p class="font-bold text-purple-300 text-sm uppercase tracking-wider mb-3">
            Why 1-on-1 matters for sisters
          </p>
          <p class="text-emerald-100/85 leading-relaxed text-lg">
            <strong class="text-white">100% privacy.</strong> There is no embarrassing group reading.
            The pace is set entirely by you. Ask as many questions as you need
            <strong class="text-white">without feeling rushed.</strong>
          </p>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         § 5  VIDEO PREVIEW — The Look Inside
         ═══════════════════════════════════════════════════════════ -->
    <section class="quranific-section bg-cream-50 border-b border-emerald-50">
      <div class="quranific-container">
        <div class="max-w-3xl mb-8">
          <p class="text-xs font-bold uppercase tracking-widest text-emerald-600 mb-4">
            The Look Inside
          </p>
          <h2 class="font-serif text-2xl md:text-3xl font-black text-emerald-950 leading-tight">
            A 100% secure sisters-only learning space.
          </h2>
        </div>

        <!-- VIDEO PLACEHOLDER -->
        <!-- VISUAL: 30-second screen recording of portal — distraction-free UI, shared Mushaf, Ustadha session -->
        <div
          class="max-w-3xl bg-slate-200 aspect-video rounded-2xl flex flex-col items-center justify-center gap-3 mb-4 shadow-sm"
        >
          <div class="w-14 h-14 rounded-full bg-slate-300 flex items-center justify-center">
            <svg
              class="w-6 h-6 text-slate-500"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M8 5v14l11-7z"></path>
            </svg>
          </div>
          <p class="text-slate-500 text-sm font-medium">
            [ASSET: 30s portal screen recording — Ustadha session, distraction-free, shared Mushaf]
          </p>
        </div>
        <p class="text-slate-400 text-sm italic max-w-3xl">
          Clean, professional, and a 100% secure sisters-only learning space.
        </p>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         § 6  TRUST — Bezos Trust Engine / Zero Friction & Privacy
         ═══════════════════════════════════════════════════════════ -->
    <section class="quranific-section bg-white border-b border-slate-100">
      <div class="quranific-container">
        <div class="grid lg:grid-cols-2 gap-12 xl:gap-20 items-center">
          <ul class="space-y-4 order-2 lg:order-1">
            {
              trustPoints.map((point) => (
                <li class="flex items-start gap-3 text-base text-emerald-950 font-medium">
                  <svg
                    class="w-5 h-5 shrink-0 text-purple-600 mt-0.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  {point}
                </li>
              ))
            }
          </ul>

          <div class="order-1 lg:order-2">
            <p class="text-xs font-bold uppercase tracking-widest text-emerald-600 mb-4">
              Full Transparency
            </p>
            <h2
              class="font-serif text-3xl md:text-4xl font-black text-emerald-950 leading-tight mb-6"
            >
              Your privacy is sacred.
            </h2>
            <div class="space-y-4 text-lg text-slate-600 leading-relaxed max-w-prose">
              <p>
                Learn comfortably from home with a guaranteed female Ustadha. Work meeting ran late?
                Baby woke up? Reschedule your class directly from your portal.
              </p>
              <p>
                You control the pace, and your teacher is there to guide you with empathy — not
                judge you.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         § 7  ONBOARDING — Magic Moment: three steps
         ═══════════════════════════════════════════════════════════ -->
    <section class="quranific-section bg-emerald-950">
      <div class="quranific-container">
        <div class="max-w-3xl mb-10">
          <p class="text-xs font-bold uppercase tracking-widest text-purple-300 mb-4">
            How It Works
          </p>
          <h2 class="font-serif text-3xl md:text-4xl font-black text-white leading-tight">
            Three steps. The third one is the point.
          </h2>
        </div>

        <ol class="grid md:grid-cols-3 gap-5 max-w-5xl">
          {
            onboardingSteps.map(({ n, title, body }) => (
              <li class="bg-emerald-900/50 border border-purple-700/20 rounded-2xl p-7">
                <div class="w-10 h-10 rounded-full bg-purple-700/60 text-white font-black text-base flex items-center justify-center mb-5">
                  {n}
                </div>
