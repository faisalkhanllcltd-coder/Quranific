---
// src/components/blocks/LandingOutcome.astro

import EyebrowText from '../ui/EyebrowText.astro';

interface Props {
  eyebrow?: string;
  eyebrowClass?: string;
  headline: string;
  body: string[];
  theme?: 'dark' | 'light';
  accent?: 'emerald' | 'purple';
}

const {
  eyebrow = 'Six Months From Now',
  eyebrowClass,
  headline,
  body,
  theme = 'dark',
  accent = 'emerald',
} = Astro.props;

const isDark = theme === 'dark';
const isPurple = accent === 'purple';
const sectionBg = isDark ? 'bg-emerald-950' : 'bg-cream-50 border-b border-emerald-50';
const eyebrowColor =
  eyebrowClass || (isPurple ? 'text-purple-300' : isDark ? 'text-emerald-400' : 'text-emerald-600');
const headlineColor = isDark ? 'text-white' : 'text-emerald-950';
---

<section class={`quranific-section ${sectionBg}`}>
  <div class="quranific-container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <EyebrowText class={`mb-4 ${eyebrowColor}`}>
          {eyebrow}
        </EyebrowText>
        <h2
          class={`font-serif text-3xl md:text-4xl font-black leading-[1.1] mb-6 ${headlineColor}`}
        >
          {headline}
        </h2>

        {
          body[0] && (
            <p
              class={
                isDark
                  ? 'text-emerald-50/80 text-lg leading-relaxed mb-8'
                  : 'text-emerald-900/80 text-lg leading-relaxed mb-8'
              }
              set:html={body[0]}
            />
          )
        }

        {
          body[1] && (
            <div
              class={
                isPurple
                  ? 'relative p-5 md:p-6 rounded-2xl bg-purple-900/20 border border-purple-500/30 border-l-[3px] border-l-purple-400 shadow-2xl backdrop-blur-sm mb-8 md:mb-0'
                  : isDark
                    ? 'relative p-5 md:p-6 rounded-2xl bg-white/[0.03] border border-white/10 border-l-[3px] border-l-emerald-400 shadow-2xl backdrop-blur-sm mb-8 md:mb-0'
                    : 'relative p-5 md:p-6 rounded-2xl bg-emerald-900/[0.03] border border-emerald-900/10 border-l-[3px] border-l-emerald-600 shadow-lg backdrop-blur-sm mb-8 md:mb-0'
              }
            >
              <p
                class={
                  isDark
                    ? 'text-emerald-50/90 leading-relaxed font-medium'
                    : 'text-emerald-950 leading-relaxed font-medium'
                }
                set:html={body[1]}
              />
            </div>
          )
        }

        {
          body
            .slice(2)
            .map((p) => (
              <p
                class={
                  isDark
                    ? 'text-emerald-50/80 text-lg leading-relaxed mt-4'
                    : 'text-emerald-900/80 text-lg leading-relaxed mt-4'
                }
                set:html={p}
              />
            ))
        }
      </div>

      <div class="relative w-full flex items-center justify-center z-10">
        <div
          class="absolute -inset-4 bg-emerald-500/20 blur-[40px] md:blur-[80px] -z-10 rounded-[3rem]"
        >
        </div>
        <slot name="media" />
      </div>
    </div>
  </div>
</section>
