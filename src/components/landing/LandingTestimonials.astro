---
// src/components/landing/LandingTestimonials.astro
// Renders landing-page testimonial cards from TESTIMONIALS_DATA shape.
// Accepts a pre-filtered array — filtering stays page-level.

interface Testimonial {
  name: string;
  initials: string;
  content: string;
  locationAndRole: string;
  enrollmentTime: string;
  theme: 'light' | 'dark';
}

interface Props {
  testimonials: Testimonial[];
  eyebrow?: string;
  headline?: string;
  /** Grid column variant: 1 | 2 | 3 */
  cols?: 1 | 2 | 3;
  /** Avatar accent for light-theme cards. 'emerald' (kids/adults) or 'purple' (women) */
  avatarAccent?: 'emerald' | 'purple';
}

const {
  testimonials,
  eyebrow = 'Real Families, Real Results',
  headline = "Don't take our word for it.",
  cols = 3,
  avatarAccent = 'emerald',
} = Astro.props;

const gridClass =
  cols === 1
    ? 'max-w-xl mx-auto'
    : cols === 2
      ? 'grid md:grid-cols-2 gap-6 max-w-4xl'
      : 'grid md:grid-cols-3 gap-6 max-w-5xl';

const lightAvatar =
  avatarAccent === 'purple' ? 'bg-purple-100 text-purple-700' : 'bg-emerald-100 text-emerald-700';
---

<section class="quranific-section bg-white border-b border-emerald-50">
  <div class="quranific-container">
    <div class="max-w-3xl mb-10">
      <p class="text-xs font-bold uppercase tracking-widest text-emerald-600 mb-4">
        {eyebrow}
      </p>
      <h2 class="font-serif text-3xl md:text-4xl font-black text-emerald-950 leading-tight">
        {headline}
      </h2>
    </div>

    <div class={gridClass}>
      {
        testimonials.map((t) => (
          <figure
            class={`rounded-2xl p-8 border transition-all duration-300 hover:shadow-md ${
              t.theme === 'dark'
                ? 'bg-emerald-950 border-emerald-800 shadow-xl'
                : 'bg-white border-slate-200 shadow-sm'
            }`}
          >
            <div class="flex gap-1 mb-4" aria-hidden="true">
              {Array(5)
                .fill(null)
                .map(() => (
                  <svg class="w-4 h-4 text-gold-400" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
            </div>
            <blockquote
              class={`text-base font-medium leading-relaxed mb-6 ${
                t.theme === 'dark' ? 'text-emerald-100/90' : 'text-emerald-950'
              }`}
            >
              &ldquo;{t.content}&rdquo;
            </blockquote>
            <figcaption class="flex items-center gap-3">
              <div
                class={`w-9 h-9 rounded-full flex items-center justify-center font-bold text-xs shrink-0 ${
                  t.theme === 'dark' ? 'bg-emerald-800 text-emerald-200' : lightAvatar
                }`}
              >
                {t.initials}
              </div>
              <div>
                <p
                  class={`font-bold text-sm ${t.theme === 'dark' ? 'text-white' : 'text-emerald-950'}`}
                >
                  {t.name}
                </p>
                <p
                  class={`text-xs ${t.theme === 'dark' ? 'text-emerald-400' : 'text-emerald-600/60'}`}
                >
                  {t.locationAndRole} · {t.enrollmentTime}
                </p>
              </div>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <p class="mt-8 text-xs text-emerald-700/40 max-w-2xl leading-relaxed">
      Results may vary. All reviews are verified against active student accounts. No compensation
      was provided.
    </p>
  </div>
</section>
