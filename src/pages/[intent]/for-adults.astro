---
// src/pages/[intent]/for-adults.astro
import Base from '../../layouts/Base.astro';
import HeroAdults from './_components/HeroAdults.astro';
import LandingProblem from '../../components/blocks/LandingProblem.astro';
import LandingOutcome from '../../components/blocks/LandingOutcome.astro';
import LandingVetting from '../../components/blocks/LandingVetting.astro';
import LandingPreview from '../../components/blocks/LandingPreview.astro';
import LandingTrust from '../../components/blocks/LandingTrust.astro';
import LandingOnboarding from '../../components/blocks/LandingOnboarding.astro';
import LandingTestimonials from '../../components/blocks/LandingTestimonials.astro';
import GuaranteeSection from '../../components/blocks/GuaranteeSection.astro';
import LandingPricing from '../../components/blocks/LandingPricing.astro';
import LandingFAQ from '../../components/blocks/LandingFAQ.astro';
import LandingCTA from '../../components/blocks/LandingCTA.astro';
import LandingFooter from '../../components/blocks/LandingFooter.astro';
import StickyMobileCTA from '../../components/blocks/StickyMobileCTA.astro';
import { SITE } from '../../constants/site';
import { testimonials } from '../../data/testimonials';
import { landingAdults } from '../../data/faqs';
import { adultsVettingSteps, adultsOnboardingSteps } from '../../data/features';
import { generateWhatsAppLink } from '../../lib/helpers';

export const prerender = true;

export function getStaticPaths() {
  return [{ params: { intent: 'quran-classes' } }, { params: { intent: 'quran-teacher' } }];
}

const { intent } = Astro.params;

type Intent = 'quran-classes' | 'quran-teacher';

// ── 90/10 Split: hero swapped per intent for Google Ads message match ──────
const intentCopy: Record<
  Intent,
  { h1: string; subhead: string; seoTitle: string; seoDesc: string }
> = {
  'quran-classes': {
    h1: 'Premium Online Quran Classes for Adults',
    subhead:
      'Private, 1-on-1 online classes. Flexible scheduling and judgment-free teaching — whether you are starting from zero or perfecting your Tajweed.',
    seoTitle: 'Online Quran Classes for Adults | Private 1-on-1 | Quranific',
    seoDesc:
      'Private, 1-on-1 Quran classes for adults. Judgment-free, flexible scheduling around your busy life. Start from zero or advance your Tajweed. First class free.',
  },
  'quran-teacher': {
    h1: 'Find an Expert Quran Teacher Who Fits Your Schedule',
    subhead:
      'Match with a vetted, professional teacher. 100% private sessions built around your busy life. Start risk-free today.',
    seoTitle: 'Find a Quran Teacher for Adults | Vetted & Private | Quranific',
    seoDesc:
      'Find a vetted 1-on-1 Quran teacher for adults. Flexible, private sessions around your schedule — Tajweed, Hifz, or Quran from scratch. First class free.',
  },
};

const copy = intentCopy[intent as Intent];

// SEO Shield: canonical → master quran-classes URL regardless of intent
const canonicalUrl = `${SITE.url}/quran-classes/for-adults`;

// Testimonials: page-level filter — pre-filtered array passed to component
const adultsTestimonials = testimonials.filter((t) =>
  ['amna-de', 'naseer-uk', 'khalid-usa'].includes(t.id)
);

// Aliases for centralized data — eliminates in-page copy-paste
const vettingSteps = adultsVettingSteps;
const onboardingSteps = adultsOnboardingSteps;

// Page-specific trust points (different copy from women's/kids' pages)
const trustPoints = [
  'Strict male-to-male and female-to-female matching',
  '24/7 Student Portal for instant schedule management',
  'Distraction-free, professional learning environment',
];

const adultGuaranteeCards = [
  {
    title: 'Free first class',
    description:
      'No card required. No commitment. We match you with the right teacher before you pay a cent.',
  },
  {
    title: '30-day refund',
    description:
      'Not satisfied in your first 30 days after the trial ends? Get a full refund with one email. No forms, no chasing.',
  },
  {
    title: 'Make-up guarantee',
    description:
      'Missed a session? It gets made up, guaranteed. There are no lock-in contracts. Cancel anytime.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: copy.seoTitle,
  description: copy.seoDesc,
  url: canonicalUrl,
};
---

<Base
  title={copy.seoTitle}
  description={copy.seoDesc}
  robots="noindex, follow"
  canonical={canonicalUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline slot="head" />

  <div class="bg-cream-50 antialiased">
    <!-- § 1 HERO -->
    <HeroAdults intent={intent} h1={copy.h1} subhead={copy.subhead} />

    <!-- § 2 PROBLEM -->
    <LandingProblem
      eyebrow="The Honest Problem"
      headline="Learning as an adult feels harder than it should."
      body="Between a full-time job, family responsibilities, and an unpredictable schedule, finding a consistent time is hard enough."
      painPoints={[
        {
          title: 'Embarrassment & Pace',
          text: 'Group classes move quickly and can feel intimidating or uncomfortable if you are starting from scratch.',
        },
        {
          title: 'Mosque Availability',
          text: 'Local community programs often cater primarily to children, leaving adults with few tailored options.',
        },
        {
          title: 'Starting Friction',
          text: 'Worrying you started too late or lack basic Arabic stops most adults before they even begin.',
        },
      ]}
      ctaLabel="Discuss your goals privately on WhatsApp"
      ctaHref={generateWhatsAppLink(
        "Hi, I'm an adult interested in learning Quran and would like to discuss my options privately."
      )}
    />

    <!-- § 3 OUTCOME -->
    <LandingOutcome
      theme="dark"
      eyebrow="Six Months From Now"
      headline="This doesn't have to be a source of stress anymore."
      body={[
        'Picture having a peaceful time in your week dedicated entirely to your connection with the Quran. You are reading fluently, without second-guessing. You understand the Tajweed rules, and for the first time, you feel a deep, focused spiritual connection in your Salah because you know exactly how to recite.',
        '<span class="font-medium text-emerald-50">That is the goal — confidence, fluency, and peace of mind, on your schedule.</span>',
      ]}
    >
      <div
        slot="media"
        class="relative w-full aspect-[4/3] lg:aspect-square rounded-[2rem] overflow-hidden shadow-[0_8px_30px_rgb(0,0,0,0.4)] ring-1 ring-white/10"
      >
        <img
          src="/images/quran-classes-for-adults.webp"
          alt="Adult confidently reading the Quran"
          class="relative z-20 rounded-2xl absolute inset-0 w-full h-full object-cover hover:scale-105 transition-transform duration-700 ease-out shadow-[0_8px_30px_rgb(0,0,0,0.4)]"
          loading="lazy"
          decoding="async"
        />
        <div
          class="absolute inset-0 border border-white/10 rounded-[2rem] z-10 pointer-events-none"
        >
        </div>
      </div>
    </LandingOutcome>

    <!-- § 4 MECHANISM / VETTING -->
    <LandingVetting
      steps={vettingSteps}
      headline="Every teacher passes a 4-stage vetting process."
      eyebrow="Why It Works"
      calloutTitle="Why 1-on-1 matters for adults"
      calloutBody="<strong class='text-white'>100% privacy.</strong> There is no embarrassing group reading. The pace is set entirely by you. Ask as many questions as you need <strong class='text-white'>without feeling rushed.</strong>"
      theme="dark"
      accentColor="emerald"
    />

    <!-- § 5 LOOK INSIDE / PREVIEW -->
    <LandingPreview
      body="No complicated software or downloads. Log in from any device and connect instantly with your private tutor in a distraction-free, professional learning environment."
      eyebrow="SEAMLESS TECHNOLOGY"
      headline="A virtual classroom built for your busy schedule."
      layoutVariant="reversed"
      ctaLabel="Start Your Free Trial"
      ctaHref="/booking?source=adults_funnel"
    >
      <img
        slot="media"
        src="/images/app.quranific-quran-classes-for-adults.webp"
        alt="Quranific virtual classroom interface for adult learners"
        class="w-full h-auto object-cover object-left"
        loading="lazy"
        decoding="async"
      />
    </LandingPreview>

    <!-- § 6 TRUST / TRANSPARENCY -->
    <LandingTrust
      headline="Your learning journey is entirely private."
      body={[
        'Work meeting ran late? Reschedule your class directly from your portal. Traveling? Log in from anywhere. You control the pace, and your teacher is there to guide you — not grade you.',
      ]}
      trustPoints={trustPoints}
      accent="emerald"
      ctaLabel="Start your private journey"
      ctaHref="#pricing"
    />

    <!-- § 7 ONBOARDING -->
    <LandingOnboarding
      eyebrow="HOW IT WORKS"
      headline="Three simple steps to your first class."
      steps={onboardingSteps}
      theme="dark"
      accent="emerald"
      ctaHref={`/getting-started/signup?source=ad_adults_${intent}`}
      ctaText="Book Your Free Class"
    />

    <!-- § 8 TESTIMONIALS -->
    <LandingTestimonials
      testimonials={adultsTestimonials}
      eyebrow="Undeniable Proof"
      headline="Real students. Real results."
      cols={2}
      avatarAccent="emerald"
    />

    <!-- § 9 GUARANTEE -->
    <GuaranteeSection
      eyebrow="OUR GUARANTEE"
      headline="We carry all the risk. You carry none."
      body="Your peace of mind is built into our platform. From your first free session to your first 30 days of paid learning, you are completely protected."
      cards={adultGuaranteeCards}
      ctaHref={`/getting-started/signup?source=ad_adults_${intent}`}
      ctaLabel="Book Your Free Class"
      accentColor="emerald"
    />

    <!-- § 10 PRICING CALCULATOR -->
    <LandingPricing />

    <!-- § 11 FAQ -->
    <LandingFAQ items={landingAdults} />

    <!-- § 12 FINAL CTA -->
    <LandingCTA
      headline="Your first class is completely free."
      subhead="No credit card. No commitment. No risk.<br class='hidden md:block' />Just 30 minutes to see if it's the right fit for you."
      ctaHref={`/getting-started/signup?source=ad_adults_${intent}`}
      ctaLabel="Book Your Free Class"
    />

    <!-- § 13 COMPLIANCE FOOTER -->
    <LandingFooter />

    <!-- Footer Overlap Spacer (Mobile) -->
    <div class="h-28 md:hidden" aria-hidden="true"></div>

    <!-- Sticky Mobile CTA Bar -->
    <StickyMobileCTA
      signupHref={`/getting-started/signup?source=ad_adults_${intent || 'default'}`}
      whatsappHref={generateWhatsAppLink(
        "Hi, I'd like to start a free Quran trial for myself as an adult."
      )}
    />
  </div><!-- /bg-cream-50 -->

  <!-- ════════════════════════════════════════════════════════════
       ATTRIBUTION PRESERVATION (Client-Side — SSG Safe)
       Reads window.location.search at runtime.
       Merges inbound gclid / utm_* / fbclid into all CTA hrefs.
       Targets a[data-track-cta] selector.
       ═══════════════════════════════════════════════════════════ -->
  <script is:inline>
    const attachAttribution = () => {
      const ctaButtons = document.querySelectorAll('a[data-track-cta]');
      if (!ctaButtons.length) return;
      const currentParams = new URLSearchParams(window.location.search);
      ctaButtons.forEach((button) => {
        try {
          const targetUrl = new URL(button.getAttribute('href'), window.location.origin);
          currentParams.forEach((value, key) => {
            if (!targetUrl.searchParams.has(key)) {
              targetUrl.searchParams.set(key, value);
            }
          });
          button.setAttribute('href', targetUrl.toString());
        } catch {
          // Non-fatal: attribution best-effort only
        }
      });
    };
    attachAttribution();
    document.addEventListener('astro:page-load', attachAttribution);
  </script>

  <!-- GTM: WhatsApp & primary CTA click tracking -->
  <script is:inline>
    const attachGTM = () => {
      if (typeof window === 'undefined' || !Array.isArray(window.dataLayer)) return;
      document.querySelectorAll('a[href*="wa.me"]').forEach((el) => {
        if (el.dataset.gtmBound) return;
        el.dataset.gtmBound = '1';
        el.addEventListener('click', () => {
          window.dataLayer.push({ event: 'contact_whatsapp', source: 'for_adults_page' });
        });
      });
      document.querySelectorAll('a[href*="/getting-started/signup"]').forEach((el) => {
        if (el.dataset.gtmBound) return;
        el.dataset.gtmBound = '1';
        el.addEventListener('click', () => {
          window.dataLayer.push({ event: 'click_book_trial', source: 'for_adults_page' });
        });
      });
    };
    attachGTM();
    document.addEventListener('astro:page-load', attachGTM);
  </script>
</Base>
