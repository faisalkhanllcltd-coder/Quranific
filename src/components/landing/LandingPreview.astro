---
// src/components/landing/LandingPreview.astro

interface Props {
  eyebrow?: string;
  headline: string;
  body?: string;
  theme?: 'dark' | 'light';
  layoutVariant?: '50-50' | 'stacked';
}

const {
  eyebrow = 'Real Session Preview',
  headline,
  body,
  theme = 'dark',
  layoutVariant = '50-50',
} = Astro.props;

const sectionBg =
  theme === 'dark'
    ? 'bg-emerald-950 border-b border-emerald-800'
    : 'bg-cream-50 border-b border-emerald-50';

const eyebrowColor = theme === 'dark' ? 'text-emerald-400' : 'text-emerald-600';
const headlineColor = theme === 'dark' ? 'text-white' : 'text-emerald-950';
const bodyColor = theme === 'dark' ? 'text-emerald-300/70' : 'text-slate-400';
---

<section class={`quranific-section ${sectionBg}`}>
  <div class="quranific-container">
    {
      layoutVariant === '50-50' ? (
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <div>
            <p class={`text-xs font-bold uppercase tracking-widest mb-4 ${eyebrowColor}`}>
              {eyebrow}
            </p>
            <h2
              class={`font-serif text-2xl md:text-3xl lg:text-4xl font-black leading-tight mb-4 ${headlineColor}`}
            >
              {headline}
            </h2>
            {body && (
              <p class={`text-sm md:text-base italic max-w-prose ${bodyColor}`} set:html={body} />
            )}
          </div>

          <div>
            <slot name="media" />
          </div>
        </div>
      ) : (
        <div>
          <div class="max-w-3xl mb-8">
            <p class={`text-xs font-bold uppercase tracking-widest mb-4 ${eyebrowColor}`}>
              {eyebrow}
            </p>
            <h2 class={`font-serif text-2xl md:text-3xl font-black leading-tight ${headlineColor}`}>
              {headline}
            </h2>
          </div>

          <div class="mb-4">
            <slot name="media" />
          </div>

          {body && <p class={`text-sm italic max-w-3xl ${bodyColor}`} set:html={body} />}
        </div>
      )
    }
  </div>
</section>
