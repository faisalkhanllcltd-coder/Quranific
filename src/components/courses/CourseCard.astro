---
// src/components/courses/CourseCard.astro
import type { Course } from '../../constants/courses';

interface Props {
  course: Course;
  isPriority?: boolean;
}
const { course, isPriority = false } = Astro.props;

// VIBRANT EDTECH UI: Eye-catching, premium jewel tones.
const slugGradients: Record<string, string> = {
  'basic-qaida': 'from-emerald-600 to-teal-500',
  'quran-reading-with-tajweed': 'from-blue-600 to-cyan-600',
  'quran-memorization': 'from-indigo-600 to-violet-600',
  'advanced-tajweed-ijazah': 'from-fuchsia-700 to-pink-600',
  'arabic-language': 'from-orange-600 to-amber-500',
  'quran-translation-with-tafsir': 'from-rose-700 to-rose-500',
};

const gradient = slugGradients[course.slug] || 'from-emerald-600 to-teal-500';

// Dynamic routing for optimized background images
const imageSrc = `/images/${course.slug}.webp`;
const testFallback = '/images/basic-qaida.webp';
---

<div
  class="bg-white border border-emerald-100 rounded-3xl overflow-hidden flex flex-col hover:shadow-xl hover:-translate-y-1 hover:border-emerald-300 transition-all duration-300 group"
>
  <!-- Coloured header banner with Image Overlay Engine -->
  <div class={`bg-gradient-to-br ${gradient} p-8 text-white relative overflow-hidden`}>
    <!-- BACKGROUND IMAGE LAYER -->
    <div class="absolute inset-0 z-0">
      <img
        src={imageSrc}
        onerror={`this.onerror=null;this.src='${testFallback}';`}
        alt=""
        class="w-full h-full object-cover object-center grayscale mix-blend-overlay opacity-40 group-hover:scale-105 transition-transform duration-700 ease-out"
        aria-hidden="true"
        loading={isPriority ? 'eager' : 'lazy'}
        fetchpriority={isPriority ? 'high' : 'auto'}
        decoding={isPriority ? 'sync' : 'async'}
      />
      <!-- Pure Black Guardrail for clean text contrast -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent">
      </div>
    </div>

    <!-- FOREGROUND CONTENT -->
    <div class="flex justify-between items-start mb-6 relative z-10">
      <span
        class="bg-white/20 border border-white/30 text-white text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-full backdrop-blur-sm shadow-sm"
      >
        {course.level}
      </span>
      {
        course.highlight && (
          <span class="bg-white text-emerald-950 text-[10px] font-bold px-3 py-1 rounded-full shadow-sm">
            {course.highlight}
          </span>
        )
      }
    </div>

    <!-- Title and Description -->
    <h3 class="font-serif text-3xl font-bold mb-2 relative z-10 drop-shadow-md leading-tight">
      {course.title}
    </h3>
    <p class="text-[14px] text-white/90 font-medium relative z-10 drop-shadow-sm leading-relaxed">
      {course.shortDesc}
    </p>
  </div>

  <!-- Body (Features) -->
  <div class="p-7 pb-8 flex-1 flex flex-col relative z-10 bg-white">
    <ul class="space-y-3 flex-1">
      {
        course.features.map((f) => (
          <li class="flex items-start gap-3 text-[13px] font-medium text-emerald-900/80">
            <div class="w-5 h-5 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-700 shrink-0 mt-0.5">
              <svg
                class="w-3 h-3"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="3"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span set:html={f} />
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Edge-to-Edge CTA Stack -->
  <div class="mt-auto flex flex-col border-t border-emerald-50 relative z-10 bg-white">
    <a
      href={`/funnel/signup?course=${course.slug}`}
      class="w-full flex items-center justify-center py-4 bg-emerald-700 hover:bg-emerald-800 text-white text-sm font-bold transition-colors"
      aria-label={`Book free trial class for ${course.title}`}
    >
      Book Free Trial Class
    </a>
    <a
      href={`/courses/${course.slug}`}
      class="group w-full flex items-center justify-center gap-1.5 py-4 bg-emerald-50/50 hover:bg-emerald-100 text-sm font-bold text-emerald-800 transition-colors"
      aria-label={`View details for ${course.title}`}
    >
      View Course Details
      <svg
        class="w-4 h-4 transition-transform group-hover:translate-x-1"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
        aria-hidden="true"
        ><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"
        ></path></svg
      >
    </a>
  </div>
</div>
