---
// LandingCTA.astro
import Button from '../ui/Button.astro';

export interface Props {
  eyebrow?: string;
  headline?: string;
  subhead?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  eyebrow = 'START TODAY',
  headline = "Your child's first class is completely free.",
  subhead = 'No credit card. No commitment. No risk.<br class="hidden md:block" />Just 30 minutes to see if it\'s the right fit for your family.',
  ctaLabel = "Book Your Child's Free Class",
  ctaHref = '/booking',
} = Astro.props;
---

<section
  class="bg-emerald-950 py-20 md:py-32 relative overflow-hidden flex flex-col items-center text-center px-6"
>
  <div class="relative z-10 max-w-3xl mx-auto flex flex-col items-center">
    <span class="text-emerald-500 font-bold tracking-widest text-sm uppercase mb-4 block"
      >{eyebrow}</span
    >

    <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 text-balance">
      <Fragment set:html={headline} />
    </h2>

    <p class="text-xl text-emerald-50/80 mb-10 text-balance leading-relaxed" set:html={subhead} />

    <Button href={ctaHref} variant="gold">
      {ctaLabel}
    </Button>

    <!-- The Shield of Trust -->
    <div
      class="mt-8 flex items-center justify-center gap-2 text-emerald-500/80 text-sm font-medium"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-4 h-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
        ></path></svg
      >
      <span>No credit card required • Cancel anytime</span>
    </div>
  </div>
</section>
