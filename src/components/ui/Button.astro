---
// src/components/ui/Button.astro
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'>, Omit<HTMLAttributes<'a'>, 'type'> {
  href?: string;
  variant?: 'primary' | 'primaryDark' | 'ghost' | 'ghostDark';
  fullWidthOnMobile?: boolean;
}

const {
  href,
  variant = 'primary',
  class: className,
  type = 'button',
  fullWidthOnMobile = false,
  ...rest
} = Astro.props;

// primary     — green fill, white text. Use on LIGHT sections (cream/white bg).
// primaryDark — gold fill, white text. Use on DARK sections (emerald-950 bg).
// ghost       — transparent, thin emerald border/text. Use on LIGHT sections.
// ghostDark   — transparent, thin white border/text. Use on DARK sections —
//               this covers WhatsApp links too; the label/icon carries the
//               meaning, a second variant would just be a duplicate style.
const variants: Record<string, string> = {
  primary: 'bg-emerald-700 text-white hover:bg-emerald-800',
  primaryDark: 'bg-gold-500 text-white hover:bg-gold-600',
  ghost:
    'bg-transparent text-emerald-950 border border-emerald-200 hover:bg-emerald-50 hover:border-emerald-300',
  ghostDark:
    'bg-transparent text-white border border-white/30 hover:bg-white/10 hover:border-white/50',
};

const baseStyle =
  'inline-flex items-center justify-center px-4 py-2 text-sm font-semibold rounded-lg transition-colors duration-200 active:scale-95 min-h-[44px]';

const widthStyle = fullWidthOnMobile ? 'w-full sm:w-auto' : '';
---

{
  href ? (
    <a href={href} class:list={[baseStyle, widthStyle, variants[variant], className]} {...rest}>
      <slot />
    </a>
  ) : (
    <button
      type={type as 'button' | 'submit' | 'reset'}
      class:list={[baseStyle, widthStyle, variants[variant], className]}
      {...rest}
    >
      <slot />
    </button>
  )
}
