---
// src/components/blocks/CourseCard.astro
import type { Course } from '../../constants/courses';
import MicroTag from '../ui/MicroTag.astro';

interface Props {
  course: Course;
  isPriority?: boolean;
}
const { course, isPriority = false } = Astro.props;

// Dynamic routing for optimized background images
const imageSrc = `/images/${course.slug}.webp`;
const testFallback = '/images/basic-qaida.webp';

// Dynamic prefix mapping to eliminate repetitive "Best for" copy
const getPrefix = (slug: string) => {
  if (slug === 'basic-qaida') return 'Perfect for';
  if (slug === 'quran-reading-with-tajweed') return 'Ideal for';
  if (slug === 'quran-memorization') return 'Recommended for';
  if (slug === 'advanced-tajweed-ijazah') return 'Designed for';
  if (slug === 'quran-translation-with-tafsir') return 'Great for';
  if (slug === 'arabic-language') return 'Tailored for';
  return 'Ideal for';
};
---

<!-- FIX: Removed the buggy mb-16 margin. The parent CourseGrid now controls the spacing perfectly. -->
<div
  class="bg-white border border-emerald-100 rounded-3xl overflow-hidden flex flex-col hover:shadow-xl hover:-translate-y-1 hover:border-emerald-300 transition-all duration-300 group h-full shadow-sm"
>
  <!-- IMAGE BANNER: Text removed, heavy black gradients and CSS filters stripped for 100% image clarity -->
  <div class="relative overflow-hidden h-48 sm:h-52 bg-emerald-50 shrink-0">
    <img
      src={imageSrc}
      onerror={`this.onerror=null;this.src='${testFallback}';`}
      alt=""
      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
      aria-hidden="true"
      loading={isPriority ? 'eager' : 'lazy'}
      fetchpriority={isPriority ? 'high' : 'auto'}
      decoding={isPriority ? 'sync' : 'async'}
    />
    <!-- Subtle inner shadow to frame the image cleanly against the white card -->
    <div
      class="absolute inset-0 shadow-[inset_0_0_0_1px_rgba(0,0,0,0.05)] pointer-events-none"
      aria-hidden="true"
    >
    </div>
  </div>

  <!-- Middle Content Body (Edge UI) -->
  <div class="p-5 sm:p-6 flex-grow flex flex-col bg-white">
    <!-- Badge moved from image overlay to directly above the title -->
    <div class="flex items-center gap-2 mb-4">
      {
        course.bestFor ? (
          <MicroTag class="bg-gold-50/95 border border-emerald-200/50 text-gold-700 shadow-sm whitespace-nowrap overflow-hidden text-ellipsis flex-shrink">
            <span class="font-medium opacity-90">{getPrefix(course.slug)}:</span>{' '}
            <span class="font-bold">{course.bestFor}</span>
          </MicroTag>
        ) : (
          <MicroTag class="bg-gold-50/95 border border-emerald-200/50 text-gold-700 shadow-sm whitespace-nowrap flex-shrink-0">
            {course.level}
          </MicroTag>
        )
      }
    </div>

    <h3 class="text-xl font-bold text-emerald-950 mb-1 leading-tight">
      {course.title}
    </h3>

    {
      course.cardHook && (
        <p class="text-[13px] font-bold text-gold-600 mb-2.5 tracking-wide">{course.cardHook}</p>
      )
    }

    <p class="text-sm text-emerald-800/80 leading-relaxed mb-4">
      {course.cardDesc || course.shortDesc}
    </p>

    {
      course.cardOutcomes && course.cardOutcomes.length > 0 && (
        <ul class="mb-6 space-y-2 flex-grow">
          {course.cardOutcomes.map((outcome) => (
            <li class="flex items-start text-[13px] text-emerald-900/90 leading-snug font-medium">
              <svg
                class="w-4 h-4 text-emerald-500 mr-2 flex-shrink-0 mt-0.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span>{outcome}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <!-- Edge-to-Edge CTA Stack -->
  <div class="mt-auto flex flex-col border-t border-emerald-50 relative z-10 bg-white shrink-0">
    <a
      href={`/getting-started/signup?course=${course.slug}`}
      class="w-full flex items-center justify-center py-4 bg-emerald-700 hover:bg-emerald-800 text-white text-sm font-bold transition-colors"
      aria-label={`Book free trial class for ${course.title}`}
    >
      Book Free Trial Class
    </a>
    <a
      href={`/courses/${course.slug}`}
      class="group w-full flex items-center justify-center gap-1.5 py-4 bg-emerald-50/50 hover:bg-emerald-100 text-sm font-bold text-emerald-800 transition-colors"
      aria-label={`View details for ${course.title}`}
    >
      View Course Details
      <svg
        class="w-4 h-4 transition-transform group-hover:translate-x-1"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
        aria-hidden="true"
        ><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"
        ></path></svg
      >
    </a>
  </div>
</div>
