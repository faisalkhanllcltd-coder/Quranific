---
// src/pages/about/_components/AboutVision.astro
import Section from '../../../components/ui/Section.astro';
import Button from '../../../components/ui/Button.astro';
import EyebrowText from '../../../components/ui/EyebrowText.astro';
---

<Section class="py-12 md:py-24 lg:py-32 bg-emerald-950 relative overflow-hidden">
  <div
    class="absolute bottom-[-10%] right-[-5%] font-serif text-[200px] font-black text-white/5 leading-none pointer-events-none select-none"
    aria-hidden="true"
  >
    Vision
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
    <EyebrowText class="text-emerald-400 mb-4">Where We're Going</EyebrowText>
    <h2
      class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-[1.1] tracking-tight mb-8"
    >
      Every Muslim child, <br />
      <em class="font-serif italic text-amber-400 font-medium">reciting with love.</em>
    </h2>
    <p
      class="text-lg sm:text-xl text-emerald-100/80 font-medium leading-relaxed mb-10 max-w-2xl mx-auto"
    >
      We are building a future where no child grows up without access to a kind, qualified, and
      consistent Quran teacher—wherever they live. That is the only roadmap that matters to us.
    </p>
    <div class="flex justify-center">
      <Button href="/getting-started/signup" variant="primaryDark">
        Be Part of This Mission →
      </Button>
    </div>
  </div>
</Section>
