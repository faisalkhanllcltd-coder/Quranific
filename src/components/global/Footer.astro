---
// src/components/global/Footer.astro
// Global Footer — static HTML/CSS, edge-cacheable, minimal JS (newsletter only).
import { SITE, FOOTER_NAVIGATION } from '../../constants/site';

const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    label: 'Facebook',
    href: SITE.social.facebook,
    svg: '<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 10v4h3v7h4v-7h3l1-4h-4v-2a1 1 0 0 1 1-1h3v-4h-3a5 5 0 0 0-5 5v2h-3"/>',
  },
  {
    label: 'Instagram',
    href: SITE.social.instagram,
    svg: '<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 8a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4h-8a4 4 0 0 1-4-4z"/><path d="M9 12a3 3 0 1 0 6 0a3 3 0 1 0-6 0"/><path d="M16.5 7.5v.01"/>',
  },
  {
    label: 'TikTok',
    href: SITE.social.tiktok,
    svg: '<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 12a4 4 0 1 0 4 4v-12a5 5 0 0 0 5 5"/>',
  },
  {
    // TODO(owner): confirm real YouTube channel URL before publishing
    label: 'YouTube',
    href: SITE.social.youtube,
    svg: '<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M2 8a4 4 0 0 1 4-4h12a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4h-12a4 4 0 0 1-4-4v-8z"/><path d="M10 9l5 3l-5 3z"/>',
  },
] as const;

const linkClass = "text-emerald-300/55 hover:text-white transition-colors duration-200 text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded-sm";
const headingClass = "text-emerald-500 font-semibold tracking-[0.2em] uppercase text-[11px] mb-5";
---

<footer class="relative bg-emerald-ink pt-20 pb-10 overflow-hidden">
  <!-- hairline accent + soft glow, desktop only (mobile GPU cost avoided) -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 max-w-md w-full h-px bg-gradient-to-r from-transparent via-emerald-500/40 to-transparent" aria-hidden="true"></div>
  <div class="hidden md:block absolute -top-32 left-1/2 -translate-x-1/2 w-96 h-72 bg-emerald-500/[0.07] blur-3xl rounded-full" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid grid-cols-2 md:grid-cols-6 gap-x-8 gap-y-12">

      <!-- Brand column — real anchor, not a floating tagline -->
      <div class="col-span-2 flex flex-col gap-6">
        <a href="/" class="inline-flex items-center gap-2.5 w-fit focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 rounded-lg">
          <img
            src="/images/quranific-logo-gold.svg"
            alt="Quranific — Home"
            width="160"
            height="40"
            loading="lazy"
            decoding="async"
            class="h-9 w-auto object-contain"
          />
        </a>
        <p class="text-emerald-200/50 text-sm leading-relaxed max-w-xs">
          One teacher, one child, one path to loving the Quran.
        </p>
        <div class="flex gap-2">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.label}
              class="w-9 h-9 rounded-lg border border-emerald-800/60 flex items-center justify-center text-emerald-400/70 hover:text-white hover:border-emerald-600 hover:bg-emerald-900/50 transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={social.svg}
              />
            </a>
          ))}
        </div>
      </div>

      <div>
        <h3 class={headingClass}>Academy</h3>
        <ul class="space-y-3.5">
          {FOOTER_NAVIGATION.academy.map((link) => (
            <li><a href={link.href} class={linkClass}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class={headingClass}>Learn</h3>
        <ul class="space-y-3.5">
          {FOOTER_NAVIGATION.learn.map((link) => (
            <li><a href={link.href} class={linkClass}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class={headingClass}>Trust</h3>
        <ul class="space-y-3.5">
          {FOOTER_NAVIGATION.trust.map((link) => (
            <li><a href={link.href} class={linkClass}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class={headingClass}>Legal</h3>
        <ul class="space-y-3.5">
          {FOOTER_NAVIGATION.legal.map((link) => (
            <li><a href={link.href} class={linkClass}>{link.label}</a></li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Newsletter — real card treatment, not a flat inline row -->
    <div class="mt-16 pt-10 border-t border-emerald-900/50">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 bg-emerald-950/40 border border-emerald-900/60 rounded-2xl px-6 py-6 md:px-8 md:py-7">
        <div>
          <h3 class="text-white font-semibold text-base mb-1">Stay updated</h3>
          <p class="text-emerald-200/50 text-sm">Quranic insights and offers, straight to your inbox.</p>
        </div>
        <form
          id="newsletter-form"
          action="/api/newsletter"
          method="POST"
          class="flex flex-col w-full md:w-auto md:min-w-96"
          aria-label="Newsletter signup"
        >
          <div class="flex w-full">
            <label for="footer-email" class="sr-only">Email address</label>
            <input
              id="footer-email"
              type="email"
              name="email"
              placeholder="Email address"
              required
              autocomplete="email"
              class="w-full bg-emerald-ink border border-emerald-800/70 text-white placeholder-emerald-500/40 rounded-l-lg px-4 py-3 text-sm focus:outline-none focus:border-amber-500 transition-colors disabled:opacity-50"
            />
            <button
              id="newsletter-submit-btn"
              type="submit"
              class="bg-amber-500 hover:bg-amber-400 text-emerald-950 font-semibold px-5 py-3 rounded-r-lg text-sm transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-white min-h-[44px] whitespace-nowrap disabled:opacity-80 disabled:cursor-not-allowed"
            >
              Join
            </button>
          </div>
          <div class="cf-turnstile mt-3" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}></div>
          <div id="newsletter-message" class="mt-2 text-xs font-medium hidden"></div>
        </form>
      </div>
    </div>

    <!-- Copyright bar — does real work instead of sitting empty -->
    <div class="mt-10 flex items-center justify-center sm:justify-start">
      <p class="text-xs text-emerald-300/35 font-medium text-center sm:text-left">&copy; {currentYear} {SITE.name}. All rights reserved.</p>
    </div>

  </div>
</footer>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('newsletter-form') as HTMLFormElement;
    const btn = document.getElementById('newsletter-submit-btn') as HTMLButtonElement;
    const input = document.getElementById('footer-email') as HTMLInputElement;
    const message = document.getElementById('newsletter-message');

    if (!form || !btn || !input || !message || form.dataset.bound) return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const originalBtnText = btn.innerText;
      btn.innerText = 'Wait...';
      btn.disabled = true;
      input.disabled = true;
      message.className = 'mt-2 text-xs font-medium hidden';

      try {
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        if (!data['cf-turnstile-response']) {
          throw new Error('Please complete the security check');
        }

        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        const result = await response.json().catch((): { error?: string } => ({}));

        if (!response.ok) {
            if (response.status === 400) {
              const errorText = ((result as { error?: string }).error || '').toLowerCase();
              if (errorText.includes('duplicate') || errorText.includes('already') || errorText.includes('exists')) {
                throw new Error('DUPLICATE_EMAIL');
              }
            }
            throw new Error((result as { error?: string }).error || 'Subscription failed');
        }

        btn.innerText = 'Joined ✓';
        btn.classList.replace('bg-amber-500', 'bg-emerald-600');
        btn.classList.replace('hover:bg-amber-400', 'hover:bg-emerald-500');
        btn.classList.replace('text-emerald-950', 'text-white');
        input.value = '';
        input.placeholder = 'JazakAllah Khair!';

        message.textContent = "Welcome to the family! Check your inbox.";
        message.className = 'mt-2 text-xs font-medium text-emerald-400 block';

      } catch (error: unknown) {
        console.error('Newsletter error:', error);
        const errMsg = error instanceof Error ? error.message : '';

        if (errMsg === 'DUPLICATE_EMAIL') {
          btn.innerText = 'Joined ✓';
          message.textContent = "You're already subscribed! Check your inbox.";
          message.className = 'mt-2 text-xs font-medium text-amber-400 block';
        } else {
          btn.innerText = originalBtnText;
          btn.disabled = false;
          input.disabled = false;
          message.textContent = errMsg || "Network error. Please try again.";
          message.className = 'mt-2 text-xs font-medium text-red-400 block';
        }
      }
    });
  });
</script>