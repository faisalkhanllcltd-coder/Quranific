---
// src/components/landing/LandingVetting.astro

interface VettingStep {
  n?: string;
  title: string;
  body: string;
  icon: string;
}

interface Props {
  eyebrow?: string;
  headline?: string;
  steps: VettingStep[];
  calloutTitle: string;
  calloutBody: string;
  theme?: 'gold' | 'dark';
  accentColor?: 'emerald' | 'purple';
}

const {
  eyebrow = 'Why It Works',
  headline = 'Every teacher passes a 4-stage vetting process.',
  steps,
  calloutTitle,
  calloutBody,
  theme = 'gold',
  accentColor = 'emerald',
} = Astro.props;

const iconBg =
  accentColor === 'purple' ? 'bg-purple-100 text-purple-700' : 'bg-emerald-100 text-emerald-700';

const calloutWrapper =
  theme === 'gold'
    ? 'bg-gold-50 border border-gold-200 rounded-2xl p-7 max-w-3xl'
    : 'bg-emerald-950 border border-white/10 backdrop-blur-md shadow-xl rounded-2xl p-8 max-w-3xl';

const calloutTitleColor =
  theme === 'gold'
    ? 'text-gold-700 font-bold text-base mb-2'
    : accentColor === 'purple'
      ? 'text-purple-300 font-bold text-sm uppercase tracking-wider mb-3'
      : 'text-emerald-300 font-bold text-sm uppercase tracking-wider mb-3';

const calloutBodyColor =
  theme === 'gold'
    ? 'text-gold-700/80 leading-relaxed'
    : 'text-emerald-100/85 leading-relaxed text-lg';
---

<section class="quranific-section bg-white border-b border-emerald-50">
  <div class="quranific-container">
    <div class="max-w-3xl mb-12">
      <p class="text-xs font-bold uppercase tracking-widest text-emerald-600 mb-4">
        {eyebrow}
      </p>
      <h2 class="font-serif text-3xl md:text-4xl font-black text-emerald-950 leading-tight">
        {headline}
      </h2>
    </div>

    <ol class="grid sm:grid-cols-2 gap-6 mb-10">
      {
        steps.map(({ title, body, icon }) => (
          <li class="bg-white border border-slate-200 shadow-sm hover:shadow-md transition-all duration-300 rounded-2xl p-8">
            <div class="flex items-center gap-4 mb-4">
              <div
                class={`flex-shrink-0 w-10 h-10 rounded-full flex items-center justify-center ${iconBg}`}
              >
                <Fragment set:html={icon} />
              </div>
            </div>
            <p class="font-bold text-emerald-950 text-lg mb-2">{title}</p>
            <p class="text-emerald-800/70 leading-relaxed text-base">{body}</p>
          </li>
        ))
      }
    </ol>

    <div class={calloutWrapper}>
      <p class={calloutTitleColor}>{calloutTitle}</p>
      <p class={calloutBodyColor} set:html={calloutBody} />
    </div>
  </div>
</section>
