---
// src/layouts/Base.astro
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../constants/site';
import CookieBanner from '../components/blocks/CookieBanner.svelte';

/* THE ELITE 3-FONT SYSTEM (Self-Hosted, Zero Latency) */
import '@fontsource-variable/inter';
import '@fontsource/merriweather/400.css';
import '@fontsource/merriweather/700.css';
import '@fontsource/merriweather/900.css';
import '@fontsource/amiri/400.css';
import '@fontsource/amiri/700.css';

/* Vite ?url imports: Resolves content-hashed public paths at build time.
   Preloading these eliminates FOUT/CLS.
*/
import interVarUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import merriweather700Url from '@fontsource/merriweather/files/merriweather-latin-700-normal.woff2?url';
import merriweather400Url from '@fontsource/merriweather/files/merriweather-latin-400-normal.woff2?url';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  lang?: string;
  dir?: 'ltr' | 'rtl';
  ogType?: string;
  twitterCard?: string;
  robots?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
}

const {
  title = SITE.title,
  description = SITE.description,
  image = SITE.defaultImage,
  canonical,
  lang = 'en',
  dir = 'ltr',
  ogType = 'website',
  twitterCard = 'summary_large_image',
  robots = 'index, follow',
  ogImageWidth = 1200,
  ogImageHeight = 630,
} = Astro.props;

// Mathematically pure canonical routing
const siteBase = (Astro.site?.href ?? SITE.url).replace(/\/$/, '');
const rawCanonical = canonical ?? new URL(Astro.url.pathname, siteBase).href;
const canonicalURL =
  rawCanonical.replace(siteBase, '').length > 1 ? rawCanonical.replace(/\/$/, '') : rawCanonical;
const socialImageURL = image.startsWith('http') ? image : new URL(image, siteBase).href;

// Read edge-detected connection speed from Cloudflare via Astro Locals safely
const isSlow: boolean = Astro.locals?.isSlowConnection ?? false;

// Global Base Entity Schema
const baseSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      description: SITE.description,
      publisher: {
        '@id': `${SITE.url}/#organization`,
      },
    },
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: SITE.url,
      logo: {
        '@type': 'ImageObject',
        url: `${SITE.url}/images/logo.png`,
      },
      sameAs: Object.values(SITE.social),
    },
  ],
};
---

<!doctype html>
<html lang={lang} dir={dir} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <!--
      Consent Mode v2 — Universal Safe Default.
      This snippet is INTENTIONALLY bucket-agnostic and renders byte-identical
      for every visitor regardless of country. It is safe under shared edge cache
      and safe on prerendered routes (no server branching, no per-user data).

      The per-visitor bucket upgrade (granting consent for US/AU/etc.) happens
      asynchronously via /api/consent-bucket fetch in the Phase 4 inline script
      below. See CONSENT_AGENT_STATE.md Phase R1 for the full rationale.

      wait_for_update: 500ms — Consent Mode holds tag firing for this window,
      giving the async fetch time to resolve before GTM tags execute.
      If fetch does not resolve within 500ms, tags proceed with denied defaults.
      This is the fail-safe trade: occasional analytics miss on fast grant-by-default
      visitors on slow connections, in exchange for never leaking a grant to an EU visitor.
    -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        // eslint-disable-next-line prefer-rest-params
        window.dataLayer.push(arguments);
      }
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        personalization_storage: 'denied',
        security_storage: 'granted',
        wait_for_update: 500,
      });
    </script>

    <!-- Google Tag Manager — runs AFTER consent defaults are set above -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        const f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-5CJMMJ29');
    </script>
    <!-- End Google Tag Manager -->

    <!-- SPA Router Analytics Transponder -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      document.addEventListener('astro:page-load', function () {
        window.dataLayer.push({
          event: 'virtual_page_view',
          page_path: window.location.pathname,
          page_title: document.title,
        });
      });
    </script>
    <meta name="google-site-verification" content="OH8wACNBZwBOLjyKjNHeZwKNWZD8McISfhN9wpQu0aE" />

    <link rel="preload" as="font" type="font/woff2" href={interVarUrl} crossorigin="anonymous" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={merriweather700Url}
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={merriweather400Url}
      crossorigin="anonymous"
    />

    <link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin />
    <script
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
      is:inline
      data-astro-rerun></script>
    <script is:inline data-astro-rerun>
      document.addEventListener('astro:page-load', () => {
        if (typeof turnstile !== 'undefined') {
          const widgets = document.querySelectorAll('.cf-turnstile');
          widgets.forEach((widget) => {
            if (!widget.hasChildNodes()) {
              turnstile.render(widget, {
                sitekey: widget.getAttribute('data-sitekey'),
                theme: widget.getAttribute('data-theme') || 'light',
              });
            }
          });
        }
      });
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_AR' : 'en_US'} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={title} />

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:site" content="@quranific_" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={title} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png" />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/icons/site.webmanifest" />

    <script type="application/ld+json" set:html={JSON.stringify(baseSchema)} is:inline />

    <slot name="head" />

    {
      !isSlow && (
        <script
          type="speculationrules"
          is:inline
          set:html={`{
        "prerender": [
          {
            "eagerness": "moderate",
            "source": "list",
            "urls": ["/getting-started/signup", "/courses", "/tuition-fee"]
          }
        ]
      }`}
        />
      )
    }

    <ClientRouter />
  </head>
  <body
    class="bg-[#fefdf9] font-sans text-emerald-950 antialiased selection:bg-emerald-200 selection:text-emerald-950 flex flex-col min-h-screen"
    style="padding-bottom: env(safe-area-inset-bottom);"
  >
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-5CJMMJ29"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->

    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-white focus:text-emerald-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded-br-lg"
      >Skip to main content</a
    >
    <slot />
    {
      isSlow && (
        <div class="hidden" aria-hidden="true" data-connection="slow">
          Low-data mode active
        </div>
      )
    }

    <!--
      Cookie Banner SSR Shell.
      Hidden by default via `consent-banner-hidden` CSS class (set in SSR HTML).
      The Phase 4 async script below reveals it only when:
        a) cf_consent_v1 cookie is absent (first visit)
        b) /api/consent-bucket returns STRICT or MODERATE (not NONE)
      NONE-bucket visitors with no GPC get a silent gtag update grant, no banner shown.
    -->
    <div
      id="cookie-banner-root"
      class="consent-banner-hidden"
      aria-live="polite"
      aria-label="Cookie consent"
    >
      <CookieBanner client:idle />
    </div>

    <!--
      Phase 4 — Consent Upgrade Script (async, non-blocking).
      Architecture rationale: the consent DEFAULT is always denied (set above in <head>).
      This script handles two paths:

      PATH A — Returning visitor (cookie present):
        Read cf_consent_v1, parse stored choice, fire gtag('consent','update') immediately.
        No fetch needed. Banner stays hidden.

      PATH B — First visit (no cookie):
        Fetch /api/consent-bucket (SSR endpoint, never cached, always per-request).
        On response:
          - STRICT or GPC → leave defaults as denied. Reveal banner (user must choose).
          - MODERATE → call gtag update with analytics granted, ads denied. Reveal banner
            (user can manage, but analytics already active per PIPEDA/CCPA opt-out model).
          - NONE → call gtag update with all granted. Keep banner hidden (silent, no consent needed).
        On fetch error → fail safe: leave denied, reveal banner (user can choose).

      GRANT MAP values match getConsentDefaults() in src/lib/consent.ts — keep in sync.
    -->
    <script is:inline>
      (function () {
        const COOKIE_NAME = 'cf_consent_v1';

        // ── Cookie helpers ────────────────────────────────────────────────────
        function readCookie(name) {
          const parts = document.cookie.split(';');
          for (let i = 0; i < parts.length; i++) {
            const part = parts[i].trim();
            if (part.indexOf(name + '=') === 0) {
              return part.substring(name.length + 1);
            }
          }
          return null;
        }

        // ── gtag shorthand (already defined above in <head>) ─────────────────
        function g(cmd, params) {
          if (typeof gtag === 'function') gtag('consent', cmd, params);
        }

        // ── Grant maps ───────────────────────────────────────────────────────
        const GRANT_ALL = {
          ad_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted',
          analytics_storage: 'granted',
          functionality_storage: 'granted',
          personalization_storage: 'granted',
          security_storage: 'granted',
        };
        const GRANT_MODERATE = {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'granted',
          functionality_storage: 'granted',
          personalization_storage: 'denied',
          security_storage: 'granted',
        };
        const DENY_ALL = {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          functionality_storage: 'granted',
          personalization_storage: 'denied',
          security_storage: 'granted',
        };

        function revealBanner(bucket) {
          // Store on window so client:idle Svelte component can read on mount
          // even if it hydrates AFTER this event fires (race prevention)
          window.__resolvedBucket = bucket;
          const el = document.getElementById('cookie-banner-root');
          if (el) {
            el.classList.remove('consent-banner-hidden');
            // Also dispatch event for the case component is already mounted
            el.dispatchEvent(
              new CustomEvent('consent-bucket', { detail: { bucket: bucket }, bubbles: true })
            );
          }
        }

        function applyStoredChoice(cookieValue) {
          // Format: "BUCKET:choice" e.g. "STRICT:accepted", "MODERATE:rejected"
          const parts = cookieValue.split(':');
          const bucket = parts[0];
          const choice = parts[1];
          if (choice === 'accepted') {
            if (bucket === 'NONE') g('update', GRANT_ALL);
            else if (bucket === 'MODERATE') g('update', GRANT_MODERATE);
            else g('update', GRANT_ALL); // STRICT:accepted = explicit accept-all
          } else {
            g('update', DENY_ALL); // rejected = deny non-essential
          }
          // Banner stays hidden — user already chose
        }

        // ── PATH A: returning visitor ─────────────────────────────────────────
        const existingCookie = readCookie(COOKIE_NAME);
        if (existingCookie) {
          applyStoredChoice(existingCookie);
          return; // done — no fetch, no banner
        }

        // ── PATH B: first visit — fetch bucket and act ───────────────────────
        fetch('/api/consent-bucket', { credentials: 'omit', cache: 'no-store' })
          .then(function (r) {
            return r.json();
          })
          .then(function (data) {
            const bucket = data.bucket || 'STRICT';
            const hasGPC = !!data.hasGPC;

            if (bucket === 'NONE' && !hasGPC) {
              // Silent grant — no banner
              g('update', GRANT_ALL);
            } else if (bucket === 'MODERATE' && !hasGPC) {
              // Analytics granted, ads denied, show banner for explicit opt-in/out
              g('update', GRANT_MODERATE);
              revealBanner(bucket);
            } else {
              // STRICT or GPC — leave denied, show banner
              revealBanner(bucket);
            }
          })
          .catch(function () {
            // Fetch failed — fail safe: leave denied, show banner so user can choose
            revealBanner('STRICT');
          });
      })();
    </script>
  </body>
</html>
