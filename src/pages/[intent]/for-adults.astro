---
// src/pages/[intent]/for-adults.astro
import Base from '../../layouts/Base.astro';
import HeroAdults from '../../components/landing/heroes/HeroAdults.astro';
import LandingProblem from '../../components/landing/LandingProblem.astro';
import LandingOutcome from '../../components/landing/LandingOutcome.astro';
import LandingVetting from '../../components/landing/LandingVetting.astro';
import LandingPreview from '../../components/landing/LandingPreview.astro';
import LandingTrust from '../../components/landing/LandingTrust.astro';
import LandingOnboarding from '../../components/landing/LandingOnboarding.astro';
import LandingTestimonials from '../../components/landing/LandingTestimonials.astro';
import LandingGuarantee from '../../components/landing/LandingGuarantee.astro';
import LandingFAQ from '../../components/landing/LandingFAQ.astro';
import LandingFinalCTA from '../../components/landing/LandingFinalCTA.astro';
import StickyMobileCTA from '../../components/landing/StickyMobileCTA.astro';
import { SITE } from '../../constants/site';
import { TESTIMONIALS_DATA } from '../../constants/testimonials';

export const prerender = true;

export function getStaticPaths() {
  return [{ params: { intent: 'quran-classes' } }, { params: { intent: 'quran-teacher' } }];
}

const { intent } = Astro.params;

type Intent = 'quran-classes' | 'quran-teacher';

// ── 90/10 Split: hero swapped per intent for Google Ads message match ──────
const intentCopy: Record<
  Intent,
  { h1: string; subhead: string; seoTitle: string; seoDesc: string }
> = {
  'quran-classes': {
    h1: 'Premium Online Quran Classes for Adults',
    subhead:
      'Private, 1-on-1 online classes. Flexible scheduling and judgment-free teaching — whether you are starting from zero or perfecting your Tajweed.',
    seoTitle: 'Online Quran Classes for Adults | Private 1-on-1 | Quranific',
    seoDesc:
      'Private, 1-on-1 Quran classes for adults. Judgment-free, flexible scheduling around your busy life. Start from zero or advance your Tajweed. First class free.',
  },
  'quran-teacher': {
    h1: 'Find an Expert Quran Teacher Who Fits Your Schedule',
    subhead:
      'Match with a vetted, professional teacher. 100% private sessions built around your busy life. Start risk-free today.',
    seoTitle: 'Find a Quran Teacher for Adults | Vetted & Private | Quranific',
    seoDesc:
      'Find a vetted 1-on-1 Quran teacher for adults. Flexible, private sessions around your schedule — Tajweed, Hifz, or Quran from scratch. First class free.',
  },
};

const copy = intentCopy[intent as Intent];

// SEO Shield: canonical → master quran-classes URL regardless of intent
const canonicalUrl = `${SITE.url}/quran-classes/for-adults`;

// Testimonials: page-level filter — pre-filtered array passed to component
const adultsTestimonials = TESTIMONIALS_DATA.filter((t) =>
  ['Amna', 'Naseerullah Babar'].includes(t.name)
);

const vettingSteps = [
  {
    n: '01',
    title: 'Ijazah Verification',
    body: 'We confirm the teacher holds a valid chain of Ijazah — a certified lineage of Quranic transmission. No exceptions.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>`,
  },
  {
    n: '02',
    title: 'Live Recitation Assessment',
    body: 'Our academic team conducts a live Tajweed assessment to ensure professional, elite-level recitation.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>`,
  },
  {
    n: '03',
    title: 'Adult Pedagogy Interview',
    body: 'We probe specifically for adult-teaching ability. How do they explain complex Tajweed rules to an English-speaking professional? We hire for patience, logic, and clarity — not rote repetition.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
  },
  {
    n: '04',
    title: 'Professional Conduct Check',
    body: 'Every teacher is vetted for punctuality, professionalism, and strict privacy standards.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`,
  },
];

const trustPoints = [
  '100% private, 1-on-1 sessions',
  'Strict male-to-male and female-to-female matching available',
  'Reschedule classes easily when life gets busy',
  'Distraction-free, professional learning environment',
];

const onboardingSteps = [
  {
    n: '1',
    title: 'Book your free class.',
    body: 'No card required. Tell us your goals and your preferred schedule.',
  },
  {
    n: '2',
    title: 'Judgment-Free Assessment.',
    body: 'Meet your teacher. Even if you are starting from the absolute alphabet (Qaida), there is zero judgment. The teacher simply listens to understand your starting line.',
  },
  {
    n: '3',
    title: 'Experience a real lesson.',
    body: "See exactly how the teaching style fits you. If it's not a perfect match, we will assign a different teacher — or we part ways with no hard feelings.",
  },
];

const guaranteeCards = [
  { label: 'Free first class', sub: 'No card required' },
  { label: '30-day refund', sub: 'If not satisfied, one email' },
  { label: 'Make-up guarantee', sub: 'Missed sessions rescheduled' },
];

const faqItems = [
  {
    q: "Am I too old to start, or what if I don't know Arabic?",
    a: 'You are never too old. A large portion of our adult students start from the very beginning (the Noorani Qaida). You do not need to know Arabic — our teachers specialise in guiding beginners step-by-step in English.',
  },
  {
    q: 'How much does it cost?',
    a: 'From $40/month depending on session length and frequency. Full pricing is transparent — no hidden fees.',
    link: { text: 'See full pricing →', href: '/tuition-fee' },
  },
  {
    q: 'Can I request a specific gender for my teacher?',
    a: 'Absolutely. We offer strict male-to-male and female-to-female matching for absolute comfort and privacy.',
  },
  {
    q: 'What if my schedule changes every week?',
    a: 'Classes run 24/7 across time zones. You can easily adjust your schedule or reschedule individual sessions when work or family commitments come up.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: copy.seoTitle,
  description: copy.seoDesc,
  url: canonicalUrl,
};
---

<Base
  title={copy.seoTitle}
  description={copy.seoDesc}
  robots="noindex, follow"
  canonical={canonicalUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline slot="head" />

  <div class="bg-cream-50 antialiased">
    <!-- § 1 HERO -->
    <HeroAdults intent={intent} h1={copy.h1} subhead={copy.subhead} />

    <!-- § 2 PROBLEM -->
    <LandingProblem
      eyebrow="The Honest Problem"
      headline="Learning as an adult feels harder than it should."
      paragraphs={[
        'Between a full-time job, family responsibilities, and an unpredictable schedule, finding a consistent time is hard enough. Group classes can feel embarrassing if you are a beginner, and local mosques often cater mostly to children.',
        "You might feel like you've started too late, or that your basic Arabic isn't good enough to even begin. The friction of just getting started stops most people from ever trying.",
      ]}
    />

    <!-- § 3 OUTCOME -->
    <LandingOutcome
      theme="dark"
      eyebrow="Six Months From Now"
      headline="This doesn't have to be a source of stress anymore."
      body={[
        'Picture having a peaceful time in your week dedicated entirely to your connection with the Quran. You are reading fluently, without second-guessing. You understand the Tajweed rules, and for the first time, you feel a deep, focused spiritual connection in your Salah because you know exactly how to recite.',
        '<span class="font-medium text-emerald-50">That is the goal — confidence, fluency, and peace of mind, on your schedule.</span>',
      ]}
    >
      <div
        slot="media"
        class="relative w-full aspect-[4/3] lg:aspect-square rounded-[2rem] overflow-hidden shadow-[0_8px_30px_rgb(0,0,0,0.4)] ring-1 ring-white/10"
      >
        <img
          src="/images/quran-classes-for-adults.webp"
          alt="Adult confidently reading the Quran"
          class="relative z-20 rounded-2xl absolute inset-0 w-full h-full object-cover hover:scale-105 transition-transform duration-700 ease-out shadow-[0_8px_30px_rgb(0,0,0,0.4)]"
          loading="lazy"
          decoding="async"
        />
        <div
          class="absolute inset-0 border border-white/10 rounded-[2rem] z-10 pointer-events-none"
        >
        </div>
      </div>
    </LandingOutcome>

    <!-- § 4 MECHANISM / VETTING -->
    <LandingVetting
      steps={vettingSteps}
      headline="Every teacher passes a 4-stage vetting process."
      eyebrow="Why It Works"
      calloutTitle="Why 1-on-1 matters for adults"
      calloutBody="<strong class='text-white'>100% privacy.</strong> There is no embarrassing group reading. The pace is set entirely by you. Ask as many questions as you need <strong class='text-white'>without feeling rushed.</strong>"
      theme="dark"
      accentColor="emerald"
    />

    <!-- § 5 LOOK INSIDE / PREVIEW -->
    <LandingPreview
      eyebrow="The Look Inside"
      headline="Clean, professional, and completely private."
      body="Clean, professional, and private. This is what a real class looks like."
      theme="light"
      layoutVariant="stacked"
    >
      <div
        slot="media"
        class="max-w-3xl bg-slate-100 border border-slate-200 aspect-video rounded-2xl flex flex-col items-center justify-center gap-3 mb-4 shadow-sm"
      >
        <div class="w-14 h-14 rounded-full bg-slate-200 flex items-center justify-center">
          <svg
            class="w-6 h-6 text-slate-400"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M8 5v14l11-7z"></path>
          </svg>
        </div>
        <p class="text-slate-400 text-sm font-medium">Session preview coming soon</p>
      </div>
    </LandingPreview>

    <!-- § 6 TRUST / TRANSPARENCY -->
    <LandingTrust
      headline="Your learning journey is entirely private."
      body={[
        'Work meeting ran late? Reschedule your class directly from your portal. Traveling? Log in from anywhere. You control the pace, and your teacher is there to guide you — not grade you.',
      ]}
      trustPoints={trustPoints}
      accent="emerald"
      reversed={true}
    />

    <!-- § 7 ONBOARDING -->
    <LandingOnboarding
      headline="Three steps. The third one changes everything."
      steps={onboardingSteps}
      theme="dark"
      accent="emerald"
    />

    <!-- § 8 TESTIMONIALS -->
    <LandingTestimonials
      testimonials={adultsTestimonials}
      eyebrow="Undeniable Proof"
      headline="Real students. Real results."
      cols={2}
      avatarAccent="emerald"
    />

    <!-- § 9 GUARANTEE -->
    <LandingGuarantee
      layoutVariant="adults-light"
      eyebrow="Our Guarantee"
      headline="We carry all the risk.<br />You carry none."
      body={[
        '<strong class="text-emerald-950">Your first class is free.</strong> No card required. No commitment.',
        "If you continue and you're not satisfied after your first full paid month — for <em>any</em> reason — you get a full refund. No forms, no chasing. One email.",
        '<strong class="text-emerald-950">Missed a session?</strong> It gets made up, guaranteed. There\'s no lock-in contract. Cancel any time.',
      ]}
      cards={guaranteeCards}
      ctaHref={`/funnel/signup?source=ad_adults_${intent}`}
      ctaLabel="Book Your Free Class"
      accentColor="emerald"
    />

    <!-- § 10 FAQ -->
    <LandingFAQ items={faqItems} />

    <!-- § 11 FINAL CTA -->
    <LandingFinalCTA
      headline="One free class.<br />No card. No risk."
      subhead="A professional teacher matched to your goals. A full-month guarantee if you continue. That's what's waiting on the other side of one click."
      ctaHref={`/funnel/signup?source=ad_adults_${intent}`}
      ctaLabel="Book Your Free Class"
      showWhatsapp={true}
      accent="emerald"
    />

    <!-- Footer Overlap Spacer (Mobile) -->
    <div class="h-28 md:hidden" aria-hidden="true"></div>

    <!-- Sticky Mobile CTA Bar -->
    <StickyMobileCTA
      signupHref={`/funnel/signup?source=ad_adults_${intent}`}
      whatsappHref={SITE.whatsappLink}
    />
  </div><!-- /bg-cream-50 -->

  <!-- ════════════════════════════════════════════════════════════
       ATTRIBUTION PRESERVATION (Client-Side — SSG Safe)
       Reads window.location.search at runtime.
       Merges inbound gclid / utm_* / fbclid into all CTA hrefs.
       Targets a[data-track-cta] selector.
       ═══════════════════════════════════════════════════════════ -->
  <script is:inline>
    const attachAttribution = () => {
      const ctaButtons = document.querySelectorAll('a[data-track-cta]');
      if (!ctaButtons.length) return;
      const currentParams = new URLSearchParams(window.location.search);
      ctaButtons.forEach((button) => {
        try {
          const targetUrl = new URL(button.getAttribute('href'), window.location.origin);
          currentParams.forEach((value, key) => {
            if (!targetUrl.searchParams.has(key)) {
              targetUrl.searchParams.set(key, value);
            }
          });
          button.setAttribute('href', targetUrl.toString());
        } catch {
          // Non-fatal: attribution best-effort only
        }
      });
    };
    attachAttribution();
    document.addEventListener('astro:page-load', attachAttribution);
  </script>
</Base>
