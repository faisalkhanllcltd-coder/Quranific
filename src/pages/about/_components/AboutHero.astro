---
// src/pages/about/_components/AboutHero.astro
import Section from '../../../components/ui/Section.astro';
---

<Section
  height={600}
  class="relative pt-16 md:pt-32 pb-10 md:pb-20 lg:pt-48 lg:pb-32 px-4 sm:px-6 lg:px-8"
>
  <div
    class="absolute top-[-10%] right-[-5%] w-[600px] h-[600px] bg-amber-500/10 rounded-full blur-[100px] pointer-events-none"
  >
  </div>
  <div
    class="absolute bottom-[10%] left-[-10%] w-[500px] h-[500px] bg-emerald-700/10 rounded-full blur-[100px] pointer-events-none"
  >
  </div>

  <div
    class="max-w-7xl mx-auto grid lg:grid-cols-[1.1fr_1fr] gap-12 lg:gap-20 items-center relative z-10"
  >
    <div class="max-w-2xl">
      <div
        class="inline-flex items-center gap-2 px-4 py-1.5 bg-emerald-50 border border-emerald-100 text-emerald-700 text-sm font-bold uppercase tracking-widest rounded-full mb-8 shadow-sm"
      >
        Our Story
      </div>

      <h1
        class="text-5xl lg:text-6xl lg:leading-[1.1] font-bold text-emerald-950 tracking-tight mb-8"
      >
        We built this because <br />
        <em class="font-serif italic text-emerald-700 font-medium">we felt the same guilt</em><br />
        you do.
      </h1>

      <p class="text-lg text-emerald-900/80 font-medium leading-relaxed mb-10 max-w-xl">
        Quranific didn't begin as a business idea. It began as a father's late-night realisation
        that his child was growing up without the one thing he had promised to give them. This is
        the honest story of why we exist, and where we're going.
      </p>

      <div class="flex flex-wrap gap-8 lg:gap-12">
        <div>
          <div class="font-serif text-xl font-bold text-emerald-700 mb-1 leading-tight">
            Trusted by families
          </div>
          <div class="text-sm font-semibold text-emerald-900/60 uppercase tracking-wide">
            across the UK, US, and UAE
          </div>
        </div>
        <div>
          <div class="font-serif text-4xl font-bold text-emerald-700 mb-1">22</div>
          <div class="text-sm font-semibold text-emerald-900/60 uppercase tracking-wide">
            Countries
          </div>
        </div>
        <div>
          <div class="font-serif text-4xl font-bold text-emerald-700 mb-1">2021</div>
          <div class="text-sm font-semibold text-emerald-900/60 uppercase tracking-wide">
            Year founded
          </div>
        </div>
      </div>
    </div>

    <div class="bg-emerald-950 rounded-3xl p-10 lg:p-12 relative overflow-hidden shadow-2xl">
      <div
        class="absolute bottom-[-10%] right-[-10%] w-[200px] h-[200px] bg-white/5 rounded-full blur-xl pointer-events-none"
      >
      </div>
      <div
        class="absolute top-[-5%] left-[-5%] w-[120px] h-[120px] bg-amber-500/10 rounded-full blur-xl pointer-events-none"
      >
      </div>

      <div
        class="font-serif text-[80px] leading-[0.5] text-white/10 mb-4 font-black"
        aria-hidden="true"
      >
        "
      </div>
      <p class="font-serif text-2xl italic text-white/95 leading-relaxed mb-10 relative z-10">
        My son was seven. He could name every Marvel superhero but couldn't recite Al-Fatiha. I had
        no one to blame. The mosque was far, the classes were harsh, and I kept saying 'next month.'
        So I stopped waiting and built what I needed.
      </p>

      <div class="flex items-center gap-4 relative z-10 pt-6 border-t border-white/10">
        <div
          class="w-14 h-14 rounded-full bg-white/10 border border-white/20 flex items-center justify-center font-serif text-2xl text-white font-bold shrink-0"
        >
          ع
        </div>
        <div>
          <div class="font-bold text-white text-lg">Faisal Khan</div>
          <div class="text-sm text-emerald-100/60 font-medium">Founder & CEO, Quranific</div>
        </div>
      </div>
    </div>
  </div>
</Section>
