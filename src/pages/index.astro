---
export const prerender = true;

// src/pages/index.astro
import Base from '../layouts/Base.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import PageHero from '../components/blocks/PageHero.astro';
import { Image } from 'astro:assets';
import TestimonialGrid from './_home-components/TestimonialGrid.astro';
import { testimonials } from '../data/testimonials';
import FAQAccordion from '../components/blocks/FAQAccordion.astro';
import { faqs } from '../data/faqs';
import FinalCTA from '../components/blocks/FinalCTA.astro';
import PainPoints from './_home-components/PainPoints.astro';
import QuranificDifference from './_home-components/QuranificDifference.astro';
import HowItWorks from './_home-components/HowItWorks.astro';
import { howTo } from '../data/howTo';

import { SITE } from '../constants/site';

// Elite Edge SEO: Deep Semantic JSON-LD
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': ['WebSite', 'EducationalOrganization'],
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${SITE.url}/courses?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      url: SITE.whatsappLink,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.home.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to start learning Quran with Quranific',
    description: 'Start your personalized 1-on-1 online Quran classes in three simple steps.',
    step: howTo.map((step, index) => ({
      '@type': 'HowToStep',
      position: index + 1,
      name: step.name,
      text: step.text,
    })),
  },
];
---

<Base title={SITE.title} description={SITE.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <Header />

  <main
    id="main-content"
    class="bg-cream-50 selection:bg-emerald-200 selection:text-emerald-950 font-sans"
  >
    <PageHero
      eyebrow="Trusted by UK, US & UAE families"
      title="The Quran class your child "
      highlightWord="actually looks forward to."
      subtitle="Join our global community of learners and deepen your understanding of Islam through personalized, 1-on-1 online classes."
      primaryCtaText="Book Your Free Class"
      primaryCtaLink="/getting-started/signup"
      secondaryCtaText="How It Works"
      secondaryCtaLink="#how-it-works"
    >
      <Fragment slot="visual">
        <div class="w-full max-w-[500px] lg:max-w-none mx-auto drop-shadow-2xl">
          <div class="animate-hero-float w-full flex items-center justify-center">
            <Image
              src="/images/quranific-hero.webp"
              alt="Quranific Live Interactive Platform"
              width={1000}
              height={625}
              loading="eager"
              fetchpriority="high"
              decoding="sync"
              class="w-full h-auto object-contain"
            />
          </div>
        </div>
      </Fragment>
    </PageHero>

    <PainPoints />

    <QuranificDifference />

    <TestimonialGrid testimonials={testimonials} />

    <HowItWorks />

    <FAQAccordion questions={faqs.home} />

    <FinalCTA />
  </main>

  <Footer />
</Base>

<style>
  @keyframes hero-float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-16px);
    }
  }

  .animate-hero-float {
    animation: hero-float 7s ease-in-out infinite;
    will-change: transform, filter;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-hero-float {
      animation: none !important;
      transform: translateY(0) !important;
    }
  }
</style>
