---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import { SITE } from '../../constants/site';

const CONTACT_INFO = {
  email: SITE.emails.support,
  whatsapp: SITE.whatsappNumber || '923112112122',
};

const Icons = {
  wa: `<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>`,
};
---

<!-- ─── SMART CONTACT FORM ─────────────────────────────────────────────── -->
<Section height={900} class="py-12 md:py-24 bg-white border-y border-emerald-50" id="contact-form">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-[1fr_1.4fr] gap-12 lg:gap-20 items-start">
      <div class="lg:sticky lg:top-32">
        <span class="text-xs font-black tracking-widest uppercase text-emerald-700 block mb-3"
          >Send a Message</span
        >
        <h2
          class="text-3xl lg:text-4xl font-bold text-emerald-950 mb-4 tracking-tight leading-tight"
        >
          Tell us what you need.<br /><em class="font-serif italic text-emerald-700 font-medium"
            >We will sort it.</em
          >
        </h2>
        <p class="text-[15px] text-emerald-800/80 font-medium mb-10 leading-relaxed">
          Select the topic that best describes your question and the form will adapt to collect
          exactly what we need to give you a useful answer.
        </p>

        <div class="text-[11px] font-bold tracking-widest uppercase text-emerald-900/50 mb-3">
          What's your question about?
        </div>
        <div class="space-y-2.5 mb-10">
          <!-- E-3 FIX: Added aria-pressed to all topic buttons. JS updates them on click. -->
          <button
            class="w-full flex items-center gap-4 bg-emerald-50 border-2 border-emerald-700 rounded-xl p-3 text-left transition-all duration-300 topic-btn"
            data-topic="enrol"
            aria-pressed="true"
          >
            <div
              class="w-10 h-10 rounded-lg bg-white border border-emerald-100 flex items-center justify-center text-lg shrink-0 topic-icon"
              aria-hidden="true"
            >
              🎓
            </div>
            <div>
              <div class="font-bold text-emerald-950 text-sm">Enrolling a child</div><div
                class="text-[12px] font-medium text-emerald-800/70"
              >
                Free trial, first steps, course selection
              </div>
            </div>
          </button>
          <button
            class="w-full flex items-center gap-4 bg-cream-50 border border-emerald-100 rounded-xl p-3 text-left hover:border-emerald-700 hover:bg-emerald-50 transition-all duration-300 topic-btn"
            data-topic="existing"
            aria-pressed="false"
          >
            <div
              class="w-10 h-10 rounded-lg bg-white border border-emerald-50 flex items-center justify-center text-lg shrink-0 topic-icon"
              aria-hidden="true"
            >
              📊
            </div>
            <div>
              <div class="font-bold text-emerald-950 text-sm">I'm an existing parent</div><div
                class="text-[12px] font-medium text-emerald-800/70"
              >
                Progress, teacher, schedule, billing
              </div>
            </div>
          </button>
          <button
            class="w-full flex items-center gap-4 bg-cream-50 border border-emerald-100 rounded-xl p-3 text-left hover:border-emerald-700 hover:bg-emerald-50 transition-all duration-300 topic-btn"
            data-topic="adult"
            aria-pressed="false"
          >
            <div
              class="w-10 h-10 rounded-lg bg-white border border-emerald-50 flex items-center justify-center text-lg shrink-0 topic-icon"
              aria-hidden="true"
            >
              🧑
            </div>
            <div>
              <div class="font-bold text-emerald-950 text-sm">Adult learning</div><div
                class="text-[12px] font-medium text-emerald-800/70"
              >
                Tajweed fix, private lessons
              </div>
            </div>
          </button>
          <button
            class="w-full flex items-center gap-4 bg-cream-50 border border-emerald-100 rounded-xl p-3 text-left hover:border-emerald-700 hover:bg-emerald-50 transition-all duration-300 topic-btn"
            data-topic="teacher"
            aria-pressed="false"
          >
            <div
              class="w-10 h-10 rounded-lg bg-white border border-emerald-50 flex items-center justify-center text-lg shrink-0 topic-icon"
              aria-hidden="true"
            >
              📜
            </div>
            <div>
              <div class="font-bold text-emerald-950 text-sm">Teaching at Quranific</div><div
                class="text-[12px] font-medium text-emerald-800/70"
              >
                Applications, vetting, joining
              </div>
            </div>
          </button>
          <button
            class="w-full flex items-center gap-4 bg-cream-50 border border-emerald-100 rounded-xl p-3 text-left hover:border-emerald-700 hover:bg-emerald-50 transition-all duration-300 topic-btn"
            data-topic="other"
            aria-pressed="false"
          >
            <div
              class="w-10 h-10 rounded-lg bg-white border border-emerald-50 flex items-center justify-center text-lg shrink-0 topic-icon"
              aria-hidden="true"
            >
              💬
            </div>
            <div>
              <div class="font-bold text-emerald-950 text-sm">Something else</div><div
                class="text-[12px] font-medium text-emerald-800/70"
              >
                Press, partnerships, general enquiry
              </div>
            </div>
          </button>
        </div>

        <div class="bg-emerald-50 border border-emerald-100 rounded-2xl p-6">
          <div
            class="font-bold text-emerald-700 text-sm mb-3 flex items-center gap-2"
            aria-hidden="true"
          >
            ⏱ Our response promise
          </div>
          <div class="space-y-2">
            <div class="flex items-center gap-2 text-[13px] font-medium text-emerald-800/80">
              <span class="w-1.5 h-1.5 bg-emerald-700 rounded-full" aria-hidden="true"
              ></span>WhatsApp: average 12 minutes
            </div>
            <div class="flex items-center gap-2 text-[13px] font-medium text-emerald-800/80">
              <span class="w-1.5 h-1.5 bg-emerald-700 rounded-full" aria-hidden="true"
              ></span>Contact form: within 24 hours
            </div>
            <div class="flex items-center gap-2 text-[13px] font-medium text-emerald-800/80">
              <span class="w-1.5 h-1.5 bg-emerald-700 rounded-full" aria-hidden="true"></span>We
              reply to <strong class="text-emerald-950">every</strong> message: no exceptions
            </div>
          </div>
        </div>
      </div>

      <div
        class="bg-cream-50 border border-emerald-100 rounded-3xl p-8 lg:p-10 shadow-xl shadow-emerald-900/5"
      >
        <div id="form-content">
          <h3 class="font-bold text-xl text-emerald-950 mb-1" id="form-dynamic-title">
            Enrol a child or book a free trial
          </h3>
          <p class="text-[13px] font-medium text-emerald-800/70 mb-8" id="form-dynamic-sub">
            Fill in the details below and we will get back to you within 24 hours with everything
            you need to get started.
          </p>

          <!--
            E-1 FIX: form now has action="/api/contact" and method="POST".
            The JS submit handler intercepts, appends the Turnstile token, and
            sends as JSON — same contract the API expects.
          -->
          <form class="space-y-5" id="smart-form" action="/api/contact" method="POST" novalidate>
            <div class="grid sm:grid-cols-2 gap-5">
              <div>
                <label
                  for="fc-name"
                  class="block text-xs font-bold uppercase tracking-wider text-emerald-900/60 mb-2"
                  >Your Name <span class="text-amber-500">*</span></label
                >
                <input
                  type="text"
                  id="fc-name"
                  name="fc-name"
                  autocomplete="name"
                  class="w-full px-4 py-3 text-sm bg-white border border-emerald-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-700 focus:border-transparent placeholder:text-emerald-900/20 font-medium"
                  placeholder="Your full name"
                  required
                />
              </div>
              <div>
                <label
                  for="fc-email"
                  class="block text-xs font-bold uppercase tracking-wider text-emerald-900/60 mb-2"
                  >Email Address <span class="text-amber-500">*</span></label
                >
                <input
                  type="email"
                  id="fc-email"
                  name="fc-email"
                  autocomplete="email"
                  class="w-full px-4 py-3 text-sm bg-white border border-emerald-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-700 focus:border-transparent placeholder:text-emerald-900/20 font-medium"
                  placeholder="you@example.com"
                  required
                />
              </div>
            </div>

            <div>
              <label
                for="fc-whatsapp"
                class="block text-xs font-bold uppercase tracking-wider text-emerald-900/60 mb-2"
                >WhatsApp Number (Preferred)</label
              >
              <input
                type="tel"
                id="fc-whatsapp"
                name="fc-whatsapp"
                autocomplete="tel"
                class="w-full px-4 py-3 text-sm bg-white border border-emerald-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-700 focus:border-transparent placeholder:text-emerald-900/20 font-medium"
                placeholder="+44 7700 000000"
              />
            </div>

            <div id="dynamic-child-field">
              <label
                for="fc-level"
                class="block text-xs font-bold uppercase tracking-wider text-emerald-900/60 mb-2"
                >Child's age and current level</label
              >
              <select
                id="fc-level"
                name="fc-level"
                class="w-full px-4 py-3 text-sm bg-white border border-emerald-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-700 focus:border-transparent font-medium appearance-none cursor-pointer text-emerald-950"
              >
                <option value="">Select age and level</option>
                <option>Age 4–6 · Complete beginner</option>
                <option>Age 7–9 · Complete beginner</option>
                <option>Age 7–9 · Can read some Arabic</option>
                <option>Age 10–12 · Complete beginner</option>
                <option>Age 10–12 · Can read Arabic</option>
                <option>Age 13–14 · Any level</option>
              </select>
            </div>

            <div>
              <label
                for="fc-message"
                class="block text-xs font-bold uppercase tracking-wider text-emerald-900/60 mb-2"
                >Your question or message <span class="text-amber-500">*</span></label
              >
              <textarea
                id="fc-message"
                name="fc-message"
                class="w-full px-4 py-3 text-sm bg-white border border-emerald-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-700 focus:border-transparent placeholder:text-emerald-900/20 font-medium min-h-[120px] resize-y"
                placeholder="What would you like to know about enrolling or booking a free trial?"
                required></textarea>
            </div>

            <!--
              E-2 FIX: Changed from <div> to <button type="button"> with role="checkbox"
              and aria-checked so keyboard and screen-reader users can activate it.
            -->
            <button
              type="button"
              id="urgency-toggle"
              role="checkbox"
              aria-checked="false"
              class="w-full flex items-center gap-4 bg-white border border-emerald-200 rounded-xl p-4 cursor-pointer hover:bg-amber-50 hover:border-amber-200 transition-all duration-300 text-left"
            >
              <div class="text-xl shrink-0" aria-hidden="true">🚨</div>
              <div class="flex-1">
                <div class="font-bold text-emerald-950 text-sm">This is urgent</div>
                <div class="text-[12px] font-medium text-emerald-800/70">
                  Tick this and we will prioritise your message for a 2-hour reply
                </div>
              </div>
              <div
                class="w-6 h-6 rounded-full border-2 border-emerald-200 bg-cream-50 flex items-center justify-center text-transparent font-bold text-xs transition-colors shrink-0"
                id="urgency-check"
                aria-hidden="true"
              >
                ✓
              </div>
            </button>

            <!-- Cloudflare Turnstile widget (token is appended to the JSON payload by the submit handler) -->
            <div
              class="cf-turnstile"
              data-sitekey="0x4AAAAAAD-QWQWhupcuvhbK"
              id="smart-form-turnstile"
              aria-label="Security check"
            >
            </div>

            <Button type="submit" variant="primary" class="w-full mt-2" id="form-submit-btn"
              >Send message →</Button
            >
            <p class="text-center text-[11px] text-emerald-900/40 font-medium mt-4">
              Your message is confidential. We do not share your information with anyone.
            </p>
          </form>
        </div>

        <div id="form-success" class="hidden text-center py-10 px-4">
          <div
            class="w-20 h-20 bg-emerald-50 rounded-full flex items-center justify-center text-emerald-700 text-4xl mx-auto mb-6"
            aria-hidden="true"
          >
            ✓
          </div>
          <h3 class="font-serif text-3xl font-bold text-emerald-950 mb-3">Message received.</h3>
          <p
            class="text-[15px] text-emerald-800/80 font-medium leading-relaxed max-w-sm mx-auto mb-6"
          >
            We will reply to <strong class="text-emerald-950" id="success-email-display"
              >your email</strong
            > within 24 hours. If your matter is urgent, WhatsApp us directly for a faster response.
          </p>
          <!-- F-1 FIX: Reference ID is now generated client-side with crypto.randomUUID() or a date-based fallback. No more fake static #QRF-2025-XXXX. -->
          <div
            class="inline-block bg-emerald-50 text-emerald-700 text-xs font-bold px-4 py-2 rounded-full mb-8"
            id="success-ref-display"
          >
          </div>
          <a
            href={`https://wa.me/${CONTACT_INFO.whatsapp.replace(/\D/g, '')}`}
            target="_blank"
            class="flex items-center justify-center gap-2 w-full max-w-sm mx-auto px-6 py-4 bg-[#25D366] text-white font-bold rounded-xl hover:bg-[#128C7E] transition-all duration-300 shadow-md"
          >
            <Fragment set:html={Icons.wa} /> Need it faster? WhatsApp us
          </a>
        </div>
      </div>
    </div>
  </div>
</Section>

<script>
  document.addEventListener('astro:page-load', () => {
    // --- 2. SMART FORM TOPIC SWITCHER ---
    const topicCopy: Record<string, { title: string; sub: string; msg: string }> = {
      enrol: {
        title: 'Enrol a child or book a free trial',
        sub: 'Fill in the details below and we will get back to you within 24 hours with everything you need to get started.',
        msg: 'What would you like to know about enrolling or booking a free trial?',
      },
      existing: {
        title: 'Message for existing parents',
        sub: 'If you are already enrolled, we can help with your schedule, teacher, progress, or billing.',
        msg: 'What can we help you with today?',
      },
      adult: {
        title: 'Adult learning enquiry',
        sub: 'Our adult programmes are 100% private and built around your schedule. Tell us more.',
        msg: 'Tell us about your learning goals or current level.',
      },
      teacher: {
        title: 'Teaching at Quranific',
        sub: 'We review every teacher application personally. Tell us about your qualifications.',
        msg: 'Tell us about your ijazah, teaching experience, and availability.',
      },
      other: {
        title: 'General enquiry',
        sub: 'Press, partnerships, scholarship applications, or anything else: we read every message.',
        msg: 'What is your enquiry about?',
      },
    };

    // E-3 FIX: Topic buttons with aria-pressed management
    document.querySelectorAll<HTMLButtonElement>('.topic-btn').forEach((btn) => {
      if ((btn as HTMLElement).dataset.bound) return;
      (btn as HTMLElement).dataset.bound = 'true';

      btn.addEventListener('click', function (this: HTMLButtonElement) {
        // Reset all buttons
        document.querySelectorAll<HTMLButtonElement>('.topic-btn').forEach((b) => {
          b.classList.remove('bg-emerald-50', 'border-emerald-700', 'border-2');
          b.classList.add('bg-cream-50', 'border-emerald-100');
          b.setAttribute('aria-pressed', 'false'); // E-3 FIX
          const icon = b.querySelector('.topic-icon');
          if (icon) {
            icon.classList.remove('border-emerald-100');
            icon.classList.add('border-emerald-50');
          }
        });

        // Activate clicked button
        this.classList.remove('bg-cream-50', 'border-emerald-100');
        this.classList.add('bg-emerald-50', 'border-2', 'border-emerald-700');
        this.setAttribute('aria-pressed', 'true'); // E-3 FIX
        const thisIcon = this.querySelector('.topic-icon');
        if (thisIcon) {
          thisIcon.classList.replace('border-emerald-50', 'border-emerald-100');
        }

        const topic = this.getAttribute('data-topic');
        if (topic && topicCopy[topic]) {
          const copy = topicCopy[topic];

          const titleEl = document.getElementById('form-dynamic-title');
          if (titleEl) titleEl.textContent = copy.title;

          const subEl = document.getElementById('form-dynamic-sub');
          if (subEl) subEl.textContent = copy.sub;

          const msgEl = document.getElementById('fc-message') as HTMLTextAreaElement;
          if (msgEl) msgEl.placeholder = copy.msg;

          const childSection = document.getElementById('dynamic-child-field');
          if (childSection) {
            childSection.style.display =
              topic === 'enrol' || topic === 'existing' ? 'block' : 'none';
          }
        }
      });
    });

    // --- 3. URGENCY TOGGLE (E-2 FIX) ---
    // Now a <button role="checkbox"> — aria-checked is toggled for screen readers
    const urgencyToggle = document.getElementById('urgency-toggle') as HTMLButtonElement | null;
    if (urgencyToggle && !(urgencyToggle as HTMLElement).dataset.bound) {
      (urgencyToggle as HTMLElement).dataset.bound = 'true';

      urgencyToggle.addEventListener('click', () => {
        const isNowUrgent = urgencyToggle.getAttribute('aria-checked') !== 'true';
        urgencyToggle.setAttribute('aria-checked', isNowUrgent ? 'true' : 'false'); // E-2 FIX

        const check = document.getElementById('urgency-check');
        if (isNowUrgent) {
          urgencyToggle.classList.add('bg-amber-50', 'border-amber-200');
          urgencyToggle.classList.remove('border-emerald-200');
          if (check) {
            check.classList.replace('bg-cream-50', 'bg-amber-500');
            check.classList.replace('border-emerald-200', 'border-amber-500');
            check.classList.replace('text-transparent', 'text-white');
          }
        } else {
          urgencyToggle.classList.remove('bg-amber-50', 'border-amber-200');
          urgencyToggle.classList.add('border-emerald-200');
          if (check) {
            check.classList.replace('bg-amber-500', 'bg-cream-50');
            check.classList.replace('border-amber-500', 'border-emerald-200');
            check.classList.replace('text-white', 'text-transparent');
          }
        }
      });
    }

    // --- 4. SMART FORM SUBMIT (E-1 FIX) ---
    // Form now has action="/api/contact". The handler reads the Turnstile token
    // and sends the full payload as JSON — matching the updated contact API contract.
    const smartForm = document.getElementById('smart-form') as HTMLFormElement | null;
    if (smartForm && !(smartForm as HTMLElement).dataset.bound) {
      (smartForm as HTMLElement).dataset.bound = 'true';

      smartForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const submitBtn = document.getElementById('form-submit-btn') as HTMLButtonElement;
        const originalBtnText = submitBtn.innerText;
        submitBtn.innerText = 'Sending…';
        submitBtn.disabled = true;

        try {
          // Split name into first/last for the API schema
          const nameInput = (document.getElementById('fc-name') as HTMLInputElement).value.trim();
          const nameParts = nameInput.split(' ');
          const firstName = nameParts[0] || '';
          const lastName = nameParts.length > 1 ? nameParts.slice(1).join(' ') : 'N/A';

          const email = (document.getElementById('fc-email') as HTMLInputElement).value.trim();
          const whatsapp = (
            document.getElementById('fc-whatsapp') as HTMLInputElement
          ).value.trim();

          const levelSelect = document.getElementById('fc-level') as unknown as HTMLSelectElement;
          const level = levelSelect && levelSelect.offsetParent !== null ? levelSelect.value : '';

          const rawMessage = (
            document.getElementById('fc-message') as HTMLTextAreaElement
          ).value.trim();
          const isUrgent = urgencyToggle?.getAttribute('aria-checked') === 'true';

          // Build a comprehensive message string
          let fullMessage = rawMessage;
          if (whatsapp) fullMessage = `Provided WhatsApp: ${whatsapp}\n\n${fullMessage}`;
          if (level) fullMessage = `Child Level Context: ${level}\n\n${fullMessage}`;
          if (isUrgent) fullMessage = `🚨 URGENT PRIORITY 🚨\n\n${fullMessage}`;

          // Read the Turnstile token from the widget
          const turnstileInput = smartForm.querySelector<HTMLInputElement>(
            '[name="cf-turnstile-response"]'
          );
          const turnstileToken = turnstileInput?.value ?? '';

          if (!turnstileToken) {
            submitBtn.innerText = originalBtnText;
            submitBtn.disabled = false;
            alert('Please complete the security check before submitting.');
            return;
          }

          const response = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              firstName,
              lastName,
              email,
              message: fullMessage,
              'cf-turnstile-response': turnstileToken,
            }),
          });

          if (!response.ok) {
            const errData = await response.json().catch((): { error?: string } => ({}));
            throw new Error((errData as { error?: string }).error || 'Submission failed');
          }

          // F-1 FIX: Generate a real client-side reference ID using crypto.randomUUID()
          // with a date-based fallback for older browsers.
          const refId =
            typeof crypto !== 'undefined' && crypto.randomUUID
              ? 'QRF-' + crypto.randomUUID().toUpperCase().slice(0, 8)
              : 'QRF-' + new Date().getFullYear() + '-' + Math.floor(1000 + Math.random() * 9000);

          // Swap to success state
          smartForm.style.display = 'none';
          const titleEl = document.getElementById('form-dynamic-title');
          if (titleEl) titleEl.style.display = 'none';
          const subEl = document.getElementById('form-dynamic-sub');
          if (subEl) subEl.style.display = 'none';

          const successEmail = document.getElementById('success-email-display');
          if (successEmail) successEmail.textContent = email;

          const successRef = document.getElementById('success-ref-display');
          if (successRef) successRef.textContent = `Ref: ${refId}`; // F-1 FIX

          const successBlock = document.getElementById('form-success');
          if (successBlock) successBlock.classList.remove('hidden');
        } catch (error: unknown) {
          console.error(error);
          submitBtn.innerText = originalBtnText;
          submitBtn.disabled = false;
          const msg = error instanceof Error ? error.message : 'Network error.';
          alert(`We encountered an error: ${msg}\n\nPlease try again or reach out via WhatsApp.`);
        }
      });
    }
  });
</script>
