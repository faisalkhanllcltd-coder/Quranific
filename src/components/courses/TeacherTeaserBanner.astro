---
// src/components/courses/TeacherTeaserBanner.astro
// Full-width CTA banner linking to /teachers. No hardcoded teacher profiles — just
// trust signals and a single strong call-to-action.

const vettingSteps = [
  { icon: '📜', label: 'Ijazah verification' },
  { icon: '🎙️', label: 'Live recitation test' },
  { icon: '🧑‍🏫', label: 'Teaching methodology interview' },
  { icon: '🛡️', label: 'Safeguarding check' },
];
---

<section
  class="py-16 md:py-24 bg-emerald-950 relative overflow-hidden"
  aria-labelledby="teacher-teaser-heading"
>
  <!-- Decorative radial glows -->
  <div
    class="absolute -top-32 -left-32 w-96 h-96 bg-emerald-500/10 rounded-full blur-[120px] pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute -bottom-32 -right-32 w-96 h-96 bg-amber-400/10 rounded-full blur-[120px] pointer-events-none"
    aria-hidden="true"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-[1fr_auto] gap-10 lg:gap-16 items-center">
      <!-- Left: copy block -->
      <div>
        <span
          class="inline-flex items-center gap-2 px-3 py-1.5 bg-emerald-900/60 border border-emerald-800 text-emerald-300 text-[11px] font-bold uppercase tracking-widest rounded-full mb-6"
        >
          Your Teachers
        </span>

        <h2
          id="teacher-teaser-heading"
          class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-5 tracking-tight leading-tight text-balance"
        >
          Learn from globally
          <em class="font-serif italic text-amber-300 font-medium">certified scholars.</em>
        </h2>

        <p class="text-lg text-emerald-100/75 font-medium mb-10 max-w-2xl leading-relaxed">
          Every Quranific teacher holds a verified Ijazah — an unbroken chain of transmission
          connecting them to the Prophet&nbsp;ﷺ through named scholars across centuries. Beyond
          that, each teacher passes a strict 4-stage vetting process before teaching a single
          student.
        </p>

        <!-- Vetting steps -->
        <ul
          class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-10"
          aria-label="Our teacher vetting process"
        >
          {
            vettingSteps.map((step) => (
              <li class="flex flex-col items-center text-center gap-2 bg-emerald-900/40 border border-emerald-800/60 rounded-2xl p-4 backdrop-blur-sm">
                <span class="text-2xl" aria-hidden="true">
                  {step.icon}
                </span>
                <span class="text-[12px] font-bold text-emerald-100/80 leading-snug">
                  {step.label}
                </span>
              </li>
            ))
          }
        </ul>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/teachers"
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-amber-400 hover:bg-amber-300 text-emerald-950 font-bold rounded-xl transition-all duration-200 shadow-xl shadow-amber-400/20 text-[15px] group"
          >
            Meet Our Teachers
            <svg
              class="w-4 h-4 group-hover:translate-x-1 transition-transform"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"
              ></path>
            </svg>
          </a>
          <a
            href="/funnel/signup"
            class="inline-flex items-center justify-center px-8 py-4 bg-transparent border-2 border-emerald-700 hover:bg-emerald-900 text-white font-bold rounded-xl transition-colors duration-200 text-[15px]"
          >
            Book a Free Trial Class
          </a>
        </div>
      </div>

      <!-- Right: trust credential card (desktop only) -->
      <div class="hidden lg:flex flex-col items-center justify-center shrink-0">
        <div
          class="bg-emerald-900/50 border border-emerald-700/50 rounded-3xl p-8 text-center w-64 backdrop-blur-sm shadow-2xl"
        >
          <div class="text-5xl mb-4" aria-hidden="true">📜</div>
          <div class="font-serif text-5xl font-bold text-white mb-1">100%</div>
          <div class="text-sm font-bold text-emerald-300/70 uppercase tracking-widest mb-6">
            Ijazah-Certified
          </div>
          <div class="w-full h-px bg-emerald-800 mb-6" aria-hidden="true"></div>
          <blockquote class="font-serif italic text-emerald-100/70 text-[14px] leading-relaxed">
            "We do not hire tutors. We select carriers of a living tradition."
          </blockquote>
        </div>
      </div>
    </div>
  </div>
</section>
