---
// src/components/landing/LandingOnboarding.astro
import Button from '../ui/Button.astro';

interface Step {
  n?: string;
  title: string;
  body: string;
}

interface Props {
  eyebrow?: string;
  headline: string;
  steps: Step[];
  /** 'light' = bg-emerald-50 (kids), 'dark' = bg-emerald-950 (adults/women) */
  theme?: 'light' | 'dark';
  /** Accent color for step circle. 'emerald' (default) or 'purple' (women) */
  accent?: 'emerald' | 'purple';
  ctaText?: string;
  ctaHref?: string;
}

const {
  eyebrow = 'How It Works',
  headline,
  steps,
  theme = 'light',
  accent = 'emerald',
  ctaText = 'Book Your Free Class',
  ctaHref = '/book',
} = Astro.props;

const isPurple = accent === 'purple';
const sectionBg = theme === 'dark' ? 'bg-emerald-950' : 'bg-emerald-50 border-b border-emerald-100';
const eyebrowColor =
  theme === 'dark'
    ? isPurple
      ? 'text-purple-300'
      : 'text-emerald-400'
    : isPurple
      ? 'text-purple-600'
      : 'text-emerald-600';
const headlineColor = theme === 'dark' ? 'text-white' : 'text-emerald-950';

const ctaVariant = theme === 'dark' ? 'gold' : 'emerald';

const card3Border = isPurple
  ? 'border-purple-200 bg-purple-50/80'
  : 'border-emerald-200 bg-emerald-50/80';
const card3StepColor = isPurple ? 'text-purple-600' : 'text-emerald-600';
---

<section class={`quranific-section ${sectionBg}`}>
  <div class="quranific-container">
    <div class="max-w-3xl mx-auto text-center flex flex-col items-center mb-12 md:mb-16">
      <p class={`text-xs font-bold uppercase tracking-widest mb-4 ${eyebrowColor}`}>{eyebrow}</p>
      <h2
        class={`font-serif text-3xl md:text-4xl font-black leading-tight text-balance ${headlineColor}`}
      >
        {headline}
      </h2>
    </div>

    <ol class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 w-full items-stretch">
      {
        steps.map(({ n, title, body }, index) => {
          const isCard3 = index === 2;
          const cardClasses = isCard3
            ? `relative flex flex-col h-full p-6 md:p-8 rounded-2xl border ${card3Border} shadow-md`
            : 'relative flex flex-col h-full p-6 md:p-8 rounded-2xl border border-slate-100 bg-white shadow-sm';
          const stepBadgeClasses = isCard3
            ? `text-[10px] font-bold tracking-widest ${card3StepColor} uppercase mb-4 block`
            : 'text-[10px] font-bold tracking-widest text-slate-500 uppercase mb-4 block';

          return (
            <li class={cardClasses}>
              <span class={stepBadgeClasses}>Step {String(n || index + 1).padStart(2, '0')}</span>
              <h3 class="text-lg md:text-xl font-bold text-slate-900 mb-3">{title}</h3>
              <p class="text-slate-600 text-sm md:text-base leading-relaxed">{body}</p>
            </li>
          );
        })
      }
    </ol>

    <div class="mt-12 md:mt-16 flex justify-center w-full">
      <Button href={ctaHref} variant={ctaVariant}>
        {ctaText}
      </Button>
    </div>
  </div>
</section>
