---
// src/components/blocks/LandingTrust.astro
import Button from '../ui/Button.astro';

interface Props {
  eyebrow?: string;
  headline: string;
  body: string | string[];
  trustPoints: string[];
  /** 'emerald' (kids/adults) or 'purple' (women) */
  accent?: 'emerald' | 'purple';
  /** Reverse column order: false = text-left list-right (kids/adults), true = list-left text-right */
  reversed?: boolean;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  eyebrow = 'Full Transparency',
  headline,
  body,
  trustPoints,
  accent = 'emerald',
  reversed = false,
  ctaLabel,
  ctaHref,
} = Astro.props;

const isPurple = accent === 'purple';
const eyebrowColor = isPurple ? 'text-purple-700' : 'text-emerald-500';
const headlineColor = isPurple ? 'text-purple-950' : 'text-slate-900';
const bodyColor = isPurple ? 'text-purple-900/80' : 'text-slate-600';
const listTextColor = isPurple ? 'text-purple-950' : 'text-slate-700';
const iconContainerBg = isPurple
  ? 'bg-purple-50 text-purple-600'
  : 'bg-emerald-50 text-emerald-600';

const paragraphs = Array.isArray(body) ? body : [body];
---

<section class="quranific-section bg-emerald-50/30 border-b border-emerald-50">
  <div class="quranific-container">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16 items-start">
      <!-- Text column -->
      <div class:list={[reversed ? 'order-1 md:order-2' : '']}>
        <span class={`font-bold tracking-widest text-sm uppercase mb-3 block ${eyebrowColor}`}>
          {eyebrow}
        </span>
        <h2 class:list={['text-3xl md:text-4xl font-bold mb-6 text-balance', headlineColor]}>
          {headline}
        </h2>
        <div class="space-y-4">
          {
            paragraphs.map((p) => (
              <p class:list={['text-lg leading-relaxed', bodyColor]} set:html={p} />
            ))
          }
        </div>

        {
          ctaLabel && ctaHref && (
            <div class="mt-8">
              <Button href={ctaHref} variant={isPurple ? 'ghost' : 'primary'}>
                {ctaLabel}
              </Button>
            </div>
          )
        }
      </div>

      <!-- List column -->
      <div
        class:list={['space-y-6 md:space-y-8 flex flex-col', reversed ? 'order-2 md:order-1' : '']}
      >
        {
          trustPoints.map((point) => (
            <div class="flex items-start gap-4">
              <div class={`flex-shrink-0 mt-1 ${iconContainerBg} p-1.5 rounded-full`}>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <p class:list={['text-base md:text-lg leading-relaxed', listTextColor]}>{point}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
