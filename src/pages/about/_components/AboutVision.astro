---
// src/pages/about/_components/AboutVision.astro
import Section from '../../../components/ui/Section.astro';
import Button from '../../../components/ui/Button.astro';
---

<Section height={800} class="py-12 md:py-24 lg:py-32 bg-emerald-950 relative overflow-hidden">
  <div
    class="absolute bottom-[-10%] right-[-5%] font-serif text-[200px] font-black text-white/5 leading-none pointer-events-none select-none"
    aria-hidden="true"
  >
    Vision
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-[1.2fr_1fr] gap-16 lg:gap-24 items-center">
      <div>
        <span class="text-xs font-bold tracking-[0.2em] uppercase text-emerald-500/50 block mb-4"
          >Where We're Going</span
        >
        <h2 class="text-4xl lg:text-6xl font-bold text-white leading-[1.1] tracking-tight mb-8">
          Every Muslim child,<br />
          <em class="font-serif italic text-amber-400 font-medium">everywhere in the world,</em><br
          />
          reciting with love.
        </h2>
        <p class="text-lg text-emerald-100/70 font-medium leading-relaxed mb-10 max-w-xl">
          We are building toward a future where no Muslim child grows up without access to a kind,
          qualified, and consistent Quran teacher, regardless of where in the world they live.
        </p>
        <Button href="/getting-started/signup" variant="primaryDark">
          Be Part of This Mission →
        </Button>
      </div>

      <div class="relative pl-4 sm:pl-0">
        <div
          class="absolute left-[15px] sm:left-[23px] top-[40px] bottom-0 w-0.5 bg-gradient-to-b from-white/20 to-transparent"
          aria-hidden="true"
        >
        </div>

        <div class="space-y-10">
          <div class="flex gap-6 relative">
            <div
              class="w-8 h-8 sm:w-12 sm:h-12 rounded-full bg-emerald-700 text-white border-2 border-white/20 flex items-center justify-center font-bold text-sm shrink-0 shadow-md"
              aria-hidden="true"
            >
              ✓
            </div>
            <div>
              <div class="text-xs font-bold text-white/40 uppercase tracking-widest mb-1">
                2021–2022
              </div>
              <h3 class="text-lg font-bold text-white/90 mb-1">Launch & early families</h3>
              <p class="text-sm text-emerald-100/50 font-medium">
                First 500 families across 8 countries. Core model proven.
              </p>
            </div>
          </div>

          <div class="flex gap-6 relative">
            <div
              class="w-8 h-8 sm:w-12 sm:h-12 rounded-full bg-emerald-700 text-white border-2 border-white/20 flex items-center justify-center font-bold text-sm shrink-0 shadow-md"
              aria-hidden="true"
            >
              ✓
            </div>
            <div>
              <div class="text-xs font-bold text-white/40 uppercase tracking-widest mb-1">
                2023–2024
              </div>
              <h3 class="text-lg font-bold text-white/90 mb-1">Scale & formalise</h3>
              <p class="text-sm text-emerald-100/50 font-medium">
                Trusted by families across the UK, US, and UAE. 22 countries. Vetting programme.
                Adult learning launched.
              </p>
            </div>
          </div>

          <div class="flex gap-6 relative group">
            <div
              class="w-8 h-8 sm:w-12 sm:h-12 rounded-full bg-amber-500 text-white border-2 border-amber-200 flex items-center justify-center font-bold text-sm shrink-0 shadow-lg shadow-amber-500/30"
              aria-hidden="true"
            >
              →
            </div>
            <div>
              <div class="text-xs font-bold text-amber-200 uppercase tracking-widest mb-1">
                2025 and Now
              </div>
              <h3 class="text-lg font-bold text-white mb-1">Mobile app & Hifz programme</h3>
              <p class="text-sm text-emerald-100/80 font-medium">
                Dedicated app for parents. Full Hifz curriculum launching soon.
              </p>
            </div>
          </div>

          <div class="flex gap-6 relative">
            <div
              class="w-8 h-8 sm:w-12 sm:h-12 rounded-full bg-white/5 border-2 border-white/10 text-white/30 flex items-center justify-center font-bold text-sm shrink-0"
              aria-hidden="true"
            >
              ◦
            </div>
            <div>
              <div class="text-xs font-bold text-white/30 uppercase tracking-widest mb-1">2026</div>
              <h3 class="text-lg font-bold text-white/60 mb-1">10,000 families milestone</h3>
              <p class="text-sm text-emerald-100/40 font-medium">French, Malay, German support.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Section>
