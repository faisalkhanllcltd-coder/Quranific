---
export const prerender = true;

// src/pages/courses/[slug].astro
import Page from '../../layouts/Page.astro';
import TeacherTeaserBanner from '../../components/blocks/TeacherTeaserBanner.astro';
import CoursesFAQ from '../../components/blocks/CoursesFAQ.astro';
import FAQAccordion from '../../components/blocks/FAQAccordion.astro';
import FinalCTA from '../../components/blocks/FinalCTA.astro';

import PageHero from '../../components/blocks/PageHero.astro';
import CourseBentoFacts from './_components/CourseBentoFacts.astro';
import CourseWhyWho from './_components/CourseWhyWho.astro';
import CourseCurriculum from './_components/CourseCurriculum.astro';
import CoursePricingSection from './_components/CoursePricingSection.astro';

import { courses } from '../../constants/courses';

export function getStaticPaths() {
  return courses.map((course) => ({
    params: { slug: course.slug },
    props: { course },
  }));
}

const { course } = Astro.props;

if (!course) {
  return Astro.redirect('/404');
}

// Pre-compute related courses for the SEO linking block
const relatedCourses = course.relatedSlugs
  .map((slug) => courses.find((c) => c.slug === slug))
  .filter((c): c is (typeof courses)[number] => c !== undefined);

const imageSrc = `/images/${course.slug}.webp`;
const testFallback = '/images/basic-qaida.webp';

// Generate JSON-LD Schema
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: course.title,
  description: course.longDesc,
  provider: {
    '@type': 'Organization',
    name: 'Quranific',
    sameAs: 'https://quranific.com',
  },
  typicalAgeRange: course.ageRange,
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'Online',
    courseWorkload: course.duration,
    offers: {
      '@type': 'Offer',
      availability: 'https://schema.org/InStock',
      price: '40.00',
      priceCurrency: 'USD',
      url: 'https://quranific.com/tuition-fee',
    },
  },
};
---

<Page description={course.shortDesc} title={`${course.title} | Quranific`} image={imageSrc}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />

  <!-- layout="split" locks the grid to 50/50 text-to-image ratio -->
  <PageHero
    layout="split"
    eyebrow={course.level || 'Online Course'}
    title={course.title}
    subtitle={course.shortDesc}
    primaryCtaText="Book Free Trial Class"
    primaryCtaLink={`/getting-started/signup?course=${course.slug}`}
    secondaryCtaText="Calculate Monthly Fee"
    secondaryCtaLink={`#calc-heading-${course.slug}`}
  >
    <Fragment slot="visual">
      <!-- Edge UI Image Optimization: Dynamically shifts aspect ratios across breakpoints to prevent clipping while maximizing screen real estate -->
      <div
        class="relative w-full aspect-video sm:aspect-[4/3] lg:aspect-square rounded-[2rem] overflow-hidden shadow-2xl border border-emerald-100 bg-emerald-50 group"
      >
        <img
          src={imageSrc}
          onerror={`this.onerror=null;this.src='${testFallback}';`}
          alt={`Learn ${course.title}`}
          class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
          fetchpriority="high"
          loading="eager"
          decoding="sync"
        />
        <div
          class="absolute inset-0 shadow-[inset_0_0_0_1px_rgba(0,0,0,0.05)] pointer-events-none"
          aria-hidden="true"
        >
        </div>
      </div>
    </Fragment>
  </PageHero>

  <CourseBentoFacts course={course} />
  <CourseWhyWho course={course} />
  <CourseCurriculum course={course} />
  <CoursePricingSection course={course} />

  <TeacherTeaserBanner hideCta={true} />

  {
    course.courseFaqs && course.courseFaqs.length > 0 ? (
      <FAQAccordion
        questions={course.courseFaqs}
        eyebrow="COURSE QUESTIONS"
        title={`Frequently Asked Questions about ${course.shortTitle || course.title}`}
        subtitle="Everything you need to know about this course and how lessons work."
      />
    ) : (
      <CoursesFAQ />
    )
  }

  {
    relatedCourses.length > 0 && (
      <section
        aria-label="Related Courses"
        class="quranific-section bg-emerald-50/50 border-t border-emerald-100"
      >
        <div class="quranific-container">
          <p class="eyebrow-pill text-emerald-600 mb-5">Continue Learning</p>
          <h2 class="text-2xl md:text-3xl font-black text-emerald-950 tracking-tight mb-8">
            Related Courses
          </h2>
          <div class="flex flex-wrap gap-4">
            {relatedCourses.map((related) => (
              <a
                href={`/courses/${related.slug}`}
                class="group flex items-center gap-3 px-6 py-4 bg-white rounded-2xl border border-emerald-100 shadow-sm hover:border-emerald-300 hover:shadow-md transition-all duration-200 text-left"
              >
                <div class="flex flex-col">
                  <span class="text-sm font-bold text-emerald-950 group-hover:text-emerald-700 transition-colors">
                    {related.title}
                  </span>
                  <span class="text-xs text-emerald-700/60 font-medium mt-0.5">
                    {related.level} · {related.ageRange}
                  </span>
                </div>
                <svg
                  class="w-4 h-4 text-emerald-400 group-hover:text-emerald-600 shrink-0 transition-colors"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <FinalCTA />
</Page>
