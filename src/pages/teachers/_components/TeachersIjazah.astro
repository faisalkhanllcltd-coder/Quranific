---
// src/pages/teachers/_components/TeachersIjazah.astro
import Section from '../../../components/ui/Section.astro';

const Icons = {
  ijazah: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477-4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>`,
};
---

<Section height={400} class="py-16 bg-white border-b border-emerald-50 px-4 sm:px-6">
  <div
    class="max-w-5xl mx-auto bg-emerald-50 rounded-3xl p-8 lg:p-12 border border-emerald-100 flex flex-col md:flex-row items-center gap-8 lg:gap-12"
  >
    <div
      class="w-24 h-24 shrink-0 bg-amber-50 text-amber-600 rounded-full flex items-center justify-center border-4 border-white shadow-sm"
      aria-hidden="true"
    >
      <span set:html={Icons.ijazah} />
    </div>
    <div>
      <h2 class="text-2xl font-bold text-emerald-950 mb-2">
        The Gold Standard: What is an Ijazah?
      </h2>
      <p class="text-emerald-900/80 font-medium leading-relaxed">
        Many of our teachers hold an <strong>Ijazah</strong>. This is the highest traditional
        certification in Quranic recitation, verifying that the teacher's recitation is flawless and
        connected through an unbroken chain of transmission directly back to the Prophet Muhammad
        (ﷺ). When you learn with Quranific, you learn the authentic, preserved word of Allah.
      </p>
    </div>
  </div>
</Section>
