---
// src/pages/about/_components/AboutCta.astro
import Section from '../../../components/ui/Section.astro';
import Button from '../../../components/ui/Button.astro';
---

<Section
  height={500}
  class="py-12 md:py-24 lg:py-32 bg-emerald-700 text-center relative overflow-hidden"
>
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-emerald-500 rounded-full blur-[150px] opacity-30 pointer-events-none"
  >
  </div>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 relative z-10">
    <div
      class="inline-flex items-center gap-2 px-4 py-1.5 bg-white/10 border border-white/20 text-white text-xs font-bold uppercase tracking-widest rounded-full mb-8 backdrop-blur-sm"
    >
      Zero risk · First class free
    </div>

    <h2 class="text-5xl lg:text-6xl font-bold text-white mb-6 tracking-tight">
      You've read our story.<br />
      <em class="font-serif italic text-amber-200 font-medium">Now start yours.</em>
    </h2>

    <p
      class="text-lg lg:text-xl text-emerald-50/90 font-medium mb-10 leading-relaxed max-w-2xl mx-auto"
    >
      Your child's first class is completely free. No credit card. No commitment. Just 30 minutes
      with a teacher who genuinely cares.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-6">
      <Button
        href="/getting-started/signup"
        variant="primaryDark"
        class="w-full sm:w-auto px-10 py-5 text-lg"
      >
        Book Your Free Class
      </Button>
      <Button
        href="https://wa.me/923112112122"
        target="_blank"
        variant="ghostDark"
        class="w-full sm:w-auto"
      >
        Ask Us Anything
      </Button>
    </div>
    <p class="text-sm font-semibold text-emerald-100/60">
      First class free · Full refund in month 1 · Cancel anytime
    </p>
  </div>
</Section>
