---
// src/pages/[intent]/for-kids.astro
import Base from '../../layouts/Base.astro';
import HeroKids from '../../components/landing/heroes/HeroKids.astro';
import LandingProblem from '../../components/landing/LandingProblem.astro';
import LandingOutcome from '../../components/landing/LandingOutcome.astro';
import LandingVetting from '../../components/landing/LandingVetting.astro';
import LandingPreview from '../../components/landing/LandingPreview.astro';
import LandingTrust from '../../components/landing/LandingTrust.astro';
import LandingOnboarding from '../../components/landing/LandingOnboarding.astro';
import LandingTestimonials from '../../components/landing/LandingTestimonials.astro';
import LandingGuarantee from '../../components/landing/LandingGuarantee.astro';
import LandingFAQ from '../../components/landing/LandingFAQ.astro';
import LandingFinalCTA from '../../components/landing/LandingFinalCTA.astro';
import { SITE } from '../../constants/site';
import { TESTIMONIALS_DATA } from '../../constants/testimonials';

export const prerender = true;

export function getStaticPaths() {
  return [{ params: { intent: 'quran-classes' } }, { params: { intent: 'quran-teacher' } }];
}

const { intent } = Astro.params;

type Intent = 'quran-classes' | 'quran-teacher';

// 90/10 Split: dynamic hero copy per intent, everything else static
const intentCopy: Record<
  Intent,
  { h1: string; subhead: string; seoTitle: string; seoDesc: string }
> = {
  'quran-classes': {
    h1: 'A Quran Class Your Child Actually Looks Forward To',
    subhead:
      "1-on-1 online classes for kids, taught by vetted teachers who know how to hold a child's attention. First class free.",
    seoTitle: 'Online Quran Classes for Kids | 1-on-1, Vetted Teachers | Quranific',
    seoDesc:
      '1-on-1 online Quran classes for kids with vetted, patient teachers. Tajweed, Qaida, and Hifz. First class free — no card required.',
  },
  'quran-teacher': {
    h1: 'Find a Quran Teacher Your Child Actually Connects With',
    subhead:
      'Every teacher passes a 4-stage vetting process before meeting your child. Match with the right one, risk-free, starting with a free first class.',
    seoTitle: 'Find a Quran Teacher for Kids | Vetted, 1-on-1, Online | Quranific',
    seoDesc:
      "Find a vetted 1-on-1 Quran teacher for your child. 4-stage vetting, safeguarding-checked, matched to your child's level. First class free.",
  },
};

const copy = intentCopy[intent as Intent];

// SEO Shield: canonical always points to master quran-classes URL
const canonicalUrl = `${SITE.url}/quran-classes/for-kids`;

// Testimonials: page-level filter — pre-filtered array passed to component
const kidsTestimonials = TESTIMONIALS_DATA.filter((t) =>
  ['Amna', 'Saleem Al Mustarshid', 'Naseerullah Babar'].includes(t.name)
);

const vettingSteps = [
  {
    n: '01',
    title: 'Ijazah Verification',
    body: 'We confirm the teacher holds a valid chain of Ijazah — a certified lineage of Quranic transmission. No exceptions.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>`,
  },
  {
    n: '02',
    title: 'Live Recitation Assessment',
    body: 'Our academic team conducts a live Tajweed assessment. Not a CV review — an actual recitation, evaluated to professional standards.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>`,
  },
  {
    n: '03',
    title: 'Teaching Methodology Interview',
    body: "We probe specifically for child-teaching ability: how do they explain a concept when a child doesn't understand? How do they keep an 8-year-old engaged after 15 minutes? Concrete answers only.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    n: '04',
    title: 'Full Safeguarding Check',
    body: 'Every teacher completes a formal safeguarding background check before they ever meet a student. This is non-negotiable and renewed annually.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>`,
  },
];

const trustPoints = [
  'Progress updates on request — always included, no extra fee',
  'Sit in on any session, announced or unannounced',
  'Direct teacher contact from your first class onward',
  'Safeguarding checks renewed annually — not a one-time box-tick',
];

const onboardingSteps = [
  {
    n: '1',
    title: 'Book your free class — no card required.',
    body: "Tell us your child's age, current Quran level, and when you're free. That's all we need to match you with the right teacher.",
  },
  {
    n: '2',
    title: 'Meet your teacher and start where your child is.',
    body: 'No placement test. No pressure. In the first session, the teacher listens before they teach — understanding where your child is starting from, what they enjoy, and how they learn.',
  },
  {
    n: '3',
    title: 'Watch your child want to come back for the next one.',
    body: "That's the whole point of the trial: not a sales pitch, a real first lesson. If your child isn't engaged, we'll find a better match — or we part ways, no hard feelings.",
  },
];

const guaranteeCards = [
  { label: 'Free first class', sub: 'No card required' },
  { label: '30-day refund', sub: 'If not satisfied, one email' },
  { label: 'Make-up guarantee', sub: 'Missed sessions rescheduled' },
];

const faqItems = [
  {
    q: 'How much does it cost?',
    a: 'From $40/month depending on session length and how often your child meets their teacher. Full pricing is transparent — no hidden fees.',
    link: { text: 'See full pricing →', href: '/tuition-fee' },
  },
  {
    q: 'What if I have more than one child?',
    a: "Sibling discounts apply automatically: 10% off your second child, 20% off your third. No need to ask — it's applied at checkout.",
  },
  {
    q: "What if the schedule doesn't fit?",
    a: 'Classes run 24/7 across time zones. You set the frequency, and you can adjust it any time — no penalty, no process.',
  },
  {
    q: 'What happens if we wait?',
    a: "Nothing happens to us. But the earlier a child starts building a real relationship with Tajweed, the more natural it becomes. Patterns formed young are patterns that last. The free trial costs nothing to find out if now's the right time.",
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: copy.seoTitle,
  description: copy.seoDesc,
  url: canonicalUrl,
};
---

<Base
  title={copy.seoTitle}
  description={copy.seoDesc}
  robots="noindex, follow"
  canonical={canonicalUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline slot="head" />

  <div class="bg-cream-50 antialiased">
    <!-- § 1 HERO -->
    <HeroKids intent={intent} h1={copy.h1} subhead={copy.subhead} />

    <!-- § 2 PROBLEM -->
    <LandingProblem
      eyebrow="The Honest Problem"
      headline="Finding a good Quran teacher is harder than it should be."
      paragraphs={[
        "Between school, homework, and everything else, finding time for a proper Quran teacher is hard enough. Finding a <em>good</em> one — patient, qualified, actually able to hold a child's attention — is harder.",
        'Group classes move too fast or too slow. Local tutors are booked solid or hard to vet. And screen time already feels like enough of a battle without adding another video call your child dreads.',
      ]}
    />

    <!-- § 3 OUTCOME -->
    <LandingOutcome
      theme="dark"
      eyebrow="Six Months From Now"
      headline="This doesn't have to be a chore anymore."
      body={[
        'Picture your child reading with real confidence — not sounding out letters painfully, but recognizing patterns, applying Tajweed naturally, and actually wanting to show you what they practiced.',
        "That's the actual goal: a child who feels capable, not pressured. Not rushing to finish a checklist, but building a connection with the Quran that outlasts their lessons.",
      ]}
    >
      <div
        slot="media"
        class="relative w-full aspect-[4/3] lg:aspect-square rounded-[2rem] overflow-hidden shadow-2xl ring-1 ring-white/10"
      >
        <img
          src="/images/quran-teacher-for-kids.webp"
          alt="Child confidently reciting Quran with online teacher"
          class="absolute inset-0 w-full h-full object-cover hover:scale-105 transition-transform duration-700 ease-out"
          loading="lazy"
          decoding="async"
        />
        <div
          class="absolute inset-0 border border-white/10 rounded-[2rem] z-10 pointer-events-none"
        >
        </div>
      </div>
    </LandingOutcome>

    <!-- § 4 MECHANISM / VETTING -->
    <LandingVetting
      steps={vettingSteps}
      headline="Every teacher passes a 4-stage vetting process."
      eyebrow="Why It Works"
      calloutTitle="Why 1-on-1 matters for kids specifically"
      calloutBody="Group Zoom classes fail children because one teacher cannot actually <em>see</em> one child. In a group, the pace is set by the slowest or fastest kid — not yours. Every Quranific session is 1-on-1, every time, so <strong class='text-gold-800'>the pace is set by your child</strong>."
      theme="gold"
      accentColor="emerald"
    />

    <!-- § 5 LOOK INSIDE / PREVIEW -->
    <LandingPreview
      eyebrow="Real Session Preview"
      headline="See what a real class looks like."
      body="This is what a real class looks like — not a demo."
      theme="dark"
      layoutVariant="50-50"
    >
      <div
        slot="media"
        class="relative w-full aspect-video rounded-[2rem] overflow-hidden shadow-2xl ring-1 ring-white/10 group cursor-pointer"
      >
        <img
          src="/images/app.quranific-quran-classes-for-kids.webp"
          alt="Real class session preview"
          class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out opacity-90 group-hover:opacity-100"
          loading="lazy"
          decoding="async"
        />
        <div
          class="absolute inset-0 border border-white/10 rounded-[2rem] z-10 pointer-events-none"
        >
        </div>
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-20">
          <div
            class="w-16 h-16 bg-emerald-500/90 rounded-full flex items-center justify-center backdrop-blur-md shadow-lg group-hover:bg-emerald-400 transition-colors duration-300 ring-4 ring-emerald-500/30"
          >
            <svg class="w-8 h-8 text-white translate-x-0.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"></path>
            </svg>
          </div>
        </div>
      </div>
    </LandingPreview>

    <!-- § 6 TRUST / TRANSPARENCY -->
    <LandingTrust
      headline="You don't need to hover over every session."
      body={[
        'Ask your teacher for a progress update any time. Nothing is hidden, nothing is locked behind a subscription tier.',
        'Every teacher is safeguarding-checked before they ever meet your child, and <strong class="text-emerald-950">you can sit in on any class, any time — no notice needed.</strong>',
      ]}
      trustPoints={trustPoints}
      accent="emerald"
      reversed={false}
    />

    <!-- § 7 ONBOARDING -->
    <LandingOnboarding
      headline="Three steps. The third one is the point."
      steps={onboardingSteps}
      theme="light"
      accent="emerald"
    />

    <!-- § 8 TESTIMONIALS -->
    <LandingTestimonials
      testimonials={kidsTestimonials}
      eyebrow="Real Families, Real Results"
      headline="Don't take our word for it."
      cols={3}
      avatarAccent="emerald"
    />

    <!-- § 9 GUARANTEE -->
    <LandingGuarantee
      layoutVariant="kids-dark"
      eyebrow="Our Guarantee"
      headline="We carry all the risk.<br />You carry none."
      body={[
        '<strong class="text-white">Your first class is free.</strong> No card required. No commitment.',
        "If you continue and you're not satisfied after your first full paid month — for <em>any</em> reason — you get a full refund. No forms, no chasing. One email.",
        '<strong class="text-white">Missed a session?</strong> It gets made up, guaranteed. There\'s no lock-in contract. Cancel any time.',
      ]}
      cards={guaranteeCards}
      ctaHref={`/enroll/step-1?intent=${intent}`}
      ctaLabel="Start Free Trial"
    />

    <!-- § 10 FAQ -->
    <LandingFAQ items={faqItems} />

    <!-- § 11 FINAL CTA -->
    <LandingFinalCTA
      headline="One free class. No card. No risk."
      subhead="A vetted teacher matched to your child. A full-month guarantee if you continue. That's what's waiting on the other side of one click."
      ctaHref={`/funnel/signup?source=ad_kids_${intent}`}
      ctaLabel="Book Your Child's Free Class"
      showWhatsapp={false}
      accent="emerald"
    />
  </div><!-- /bg-cream-50 -->

  <!-- ════════════════════════════════════════════════════════════
       ATTRIBUTION PRESERVATION (Client-Side — SSG Safe)
       Reads window.location.search at runtime.
       Merges inbound gclid / utm_* / fbclid into all CTA hrefs.
       Targets a[data-track-cta] selector.
       ═══════════════════════════════════════════════════════════ -->
  <script is:inline>
    const attachAttribution = () => {
      const ctaButtons = document.querySelectorAll('a[data-track-cta]');
      if (!ctaButtons.length) return;
      const currentParams = new URLSearchParams(window.location.search);
      ctaButtons.forEach((button) => {
        try {
          const targetUrl = new URL(button.getAttribute('href'), window.location.origin);
          currentParams.forEach((value, key) => {
            if (!targetUrl.searchParams.has(key)) {
              targetUrl.searchParams.set(key, value);
            }
          });
          button.setAttribute('href', targetUrl.toString());
        } catch {
          // Non-fatal: attribution best-effort only
        }
      });
    };
    attachAttribution();
    document.addEventListener('astro:page-load', attachAttribution);
  </script>
</Base>
