---
// src/components/landing/LandingPreview.astro
import Button from '../ui/Button.astro';

interface Props {
  eyebrow?: string;
  headline?: string;
  body?: string;
  theme?: 'dark' | 'light';
  layoutVariant?: '50-50' | 'stacked' | 'reversed';
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  eyebrow = 'Inside the Virtual Classroom',
  headline = 'It’s just your child, their teacher, and the Quran.',
  body = 'Watch your child settle into class peacefully, not frustrated by disconnected virtual rooms, but stepping into a thoughtful learning environment where they feel completely supported.',
  theme = 'dark',
  layoutVariant = '50-50',
  ctaLabel,
  ctaHref,
} = Astro.props;

const sectionBg =
  theme === 'dark'
    ? 'bg-emerald-950 border-b border-emerald-800'
    : 'bg-cream-50 border-b border-emerald-50';

const eyebrowColor = theme === 'dark' ? 'text-emerald-400' : 'text-emerald-600';
const headlineColor = theme === 'dark' ? 'text-white' : 'text-emerald-950';
const bodyColor = theme === 'dark' ? 'text-emerald-50/80' : 'text-slate-600';
---

<section class={`quranific-section ${sectionBg}`}>
  <div class="quranific-container">
    {
      layoutVariant === '50-50' || layoutVariant === 'reversed' ? (
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <div
            class={`flex flex-col justify-center ${layoutVariant === 'reversed' ? 'lg:order-last' : ''}`}
          >
            <p class={`text-sm font-bold uppercase tracking-widest mb-4 ${eyebrowColor}`}>
              {eyebrow}
            </p>
            <h2
              class={`font-serif text-2xl md:text-3xl lg:text-4xl font-black leading-tight mb-4 text-balance ${headlineColor}`}
            >
              {headline}
            </h2>
            {body && (
              <p class={`text-lg leading-relaxed max-w-prose ${bodyColor}`} set:html={body} />
            )}
            {ctaLabel && ctaHref && (
              <div class="mt-8">
                <Button href={ctaHref} variant="orange">
                  {ctaLabel}
                </Button>
              </div>
            )}
          </div>

          <div
            class={`flex items-center justify-center w-full ${layoutVariant === 'reversed' ? 'lg:order-first' : ''}`}
          >
            <slot name="media" />
          </div>
        </div>
      ) : (
        <div>
          <div class="max-w-3xl mb-8">
            <p class={`text-sm font-bold uppercase tracking-widest mb-4 ${eyebrowColor}`}>
              {eyebrow}
            </p>
            <h2
              class={`font-serif text-2xl md:text-3xl font-black leading-tight text-balance ${headlineColor}`}
            >
              {headline}
            </h2>
          </div>

          <div class="mb-6">
            <slot name="media" />
          </div>

          {body && <p class={`text-lg max-w-3xl leading-relaxed ${bodyColor}`} set:html={body} />}
          {ctaLabel && ctaHref && (
            <div class="mt-8">
              <Button href={ctaHref} variant="orange">
                {ctaLabel}
              </Button>
            </div>
          )}
        </div>
      )
    }
  </div>
</section>
