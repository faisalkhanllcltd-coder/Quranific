---
// src/layouts/Funnel.astro
import Base from './Base.astro';
import EyebrowText from '../components/ui/EyebrowText.astro';
import { testimonials } from '../data/testimonials';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Complete your registration for Quranific.' } = Astro.props;
---

<Base title={title} description={description} robots="noindex, nofollow">
  <!--
    B-2 FIX: Cloudflare Turnstile widget script loaded once at the layout level.
    Using async defer so it never blocks the main thread. The is:inline directive
    suppresses the Astro 4000 warning since this is a third-party script.
  -->
  <script
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
    is:inline
    slot="head"></script>

  <div class="flex flex-col lg:flex-row min-h-screen bg-[#fefdf9] w-full">
    <aside
      aria-label="Brand panel"
      class="lg:w-[clamp(32%,35vw,45%)] bg-emerald-950 relative flex flex-row lg:flex-col justify-between items-center lg:items-stretch lg:sticky lg:top-0 lg:h-screen overflow-hidden shadow-md lg:shadow-2xl z-20 py-3 px-5 lg:p-0 shrink-0"
    >
      <div
        class="absolute -top-32 -left-32 w-96 h-96 bg-emerald-500/20 rounded-full blur-3xl pointer-events-none hidden lg:block"
        aria-hidden="true"
      >
      </div>

      <div
        class="relative z-10 lg:p-8 xl:p-10 flex justify-between items-center lg:items-start lg:flex-col w-full"
      >
        <a
          href="/"
          class="group transition-transform active:scale-95 inline-block focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 rounded"
        >
          <img
            src="/images/quranific-logo-gold.svg"
            alt="Quranific"
            width="160"
            height="40"
            class="h-7 sm:h-8 lg:h-9 w-auto object-contain drop-shadow-sm"
          />
        </a>

        <div
          class="lg:hidden flex items-center gap-1.5 text-emerald-100 text-[10px] sm:text-xs font-bold px-3 py-1.5 rounded-full bg-emerald-900/50 border border-emerald-800"
          aria-label="Secure checkout"
        >
          <svg
            class="w-3 h-3 text-emerald-400"
            fill="currentColor"
            viewBox="0 0 20 20"
            aria-hidden="true"
            ><path
              fill-rule="evenodd"
              d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z"
              clip-rule="evenodd"></path></svg
          >
          Secure
        </div>
      </div>

      <div
        class="relative z-10 hidden lg:flex flex-col p-8 xl:p-10 mt-auto overflow-y-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        <blockquote class="mb-8">
          <p class="text-2xl xl:text-3xl font-serif font-bold text-white mb-4 leading-snug">
            "The best among you are those who learn the Quran and teach it."
          </p>
          <footer class="flex items-center gap-4 text-emerald-300/60">
            <div class="h-px bg-emerald-800 flex-grow" aria-hidden="true"></div>
            <cite class="not-italic">
              <EyebrowText class="inline">Sahih Al-Bukhari</EyebrowText>
            </cite>
          </footer>
        </blockquote>

        <div class="flex flex-col gap-4">
          {
            testimonials.slice(0, 2).map((review) => (
              <div class="bg-emerald-900/40 border border-emerald-800/50 p-4 xl:p-5 rounded-xl backdrop-blur-sm">
                <div class="flex items-center gap-1 mb-2 text-amber-400 text-xs" aria-hidden="true">
                  ★★★★★
                </div>
                <p class="text-emerald-100 text-sm leading-relaxed mb-2">"{review.quote}"</p>
                <p class="text-xs font-bold text-emerald-400">— {review.name}</p>
              </div>
            ))
          }
        </div>
      </div>
    </aside>

    <main
      class="flex-1 flex items-start lg:items-center justify-center p-4 py-8 sm:p-8 lg:p-12 relative z-10 min-h-[calc(100vh-60px)] lg:min-h-screen"
    >
      <div class="w-full max-w-md mx-auto">
        <slot />
      </div>
    </main>
  </div>
</Base>
