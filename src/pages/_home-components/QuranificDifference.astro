---
// src/components/blocks/QuranificDifference.astro
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import { SITE } from '../../constants/site';
import EyebrowBadge from '../../components/ui/EyebrowBadge.astro';
import EyebrowText from '../../components/ui/EyebrowText.astro';

const CheckIcon = `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>`;
const XIcon = `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>`;
---

<Section
  height={900}
  class="py-10 md:py-20 lg:py-32 bg-cream-50"
  aria-labelledby="difference-heading"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 max-w-3xl mx-auto">
      <EyebrowBadge class="bg-emerald-50 border border-emerald-100 text-emerald-700 mb-6">
        The Quranific Difference
      </EyebrowBadge>
      <h2
        id="difference-heading"
        class="text-4xl lg:text-5xl font-semibold text-emerald-950 mb-6 tracking-tight"
      >
        This isn't how it <em class="text-emerald-700 not-italic">used to be taught.</em>
      </h2>
      <p class="text-lg text-emerald-900/80 font-medium">
        We built everything from scratch around one question: what does a child actually need to
        fall in love with the Quran, not just recite it out of fear?
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 lg:gap-10 mb-20 max-w-5xl mx-auto">
      <div class="bg-white border border-red-100 rounded-3xl overflow-hidden shadow-sm">
        <div class="bg-red-50/80 px-6 py-5 border-b border-red-100 flex items-center gap-3">
          <div
            class="w-7 h-7 rounded-full bg-red-200 text-red-700 flex items-center justify-center shrink-0"
            aria-hidden="true"
            set:html={XIcon}
          />
          <h3>
            <EyebrowText class="text-red-950"> Traditional Academy </EyebrowText>
          </h3>
        </div>
        <ul class="p-6 space-y-4" role="list">
          <li class="flex gap-4 items-start">
            <svg
              class="w-5 h-5 shrink-0 text-red-900/40 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
              ></path></svg
            ><p class="text-[15px] font-medium text-red-950/70">
              Crowded group classes. Your child is one of many.
            </p>
          </li>
          <li class="flex gap-4 items-start">
            <svg
              class="w-5 h-5 shrink-0 text-red-900/40 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"
              ></path></svg
            ><p class="text-[15px] font-medium text-red-950/70">
              Harsh correction methods that create fear, not love.
            </p>
          </li>
          <li class="flex gap-4 items-start">
            <svg
              class="w-5 h-5 shrink-0 text-red-900/40 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
              ></path></svg
            ><p class="text-[15px] font-medium text-red-950/70">
              Teacher rotations. Your child never builds a bond.
            </p>
          </li>
          <li class="flex gap-4 items-start">
            <svg
              class="w-5 h-5 shrink-0 text-red-900/40 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path></svg
            ><p class="text-[15px] font-medium text-red-950/70">
              No progress reports. You have no idea how they're doing.
            </p>
          </li>
          <li class="flex gap-4 items-start">
            <svg
              class="w-5 h-5 shrink-0 text-red-900/40 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"
              ></path></svg
            ><p class="text-[15px] font-medium text-red-950/70">
              Missed class? It's gone. No make-ups.
            </p>
          </li>
          <li class="flex gap-4 items-start">
            <svg
              class="w-5 h-5 shrink-0 text-red-900/40 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path></svg
            ><p class="text-[15px] font-medium text-red-950/70">
              Rigid fixed schedules: works for them, not for you.
            </p>
          </li>
        </ul>
      </div>

      <div
        class="bg-white border border-emerald-700 rounded-3xl overflow-hidden shadow-2xl shadow-emerald-900/10 relative"
      >
        <div
          class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-700 to-amber-500"
          aria-hidden="true"
        >
        </div>
        <div class="bg-emerald-50 px-6 py-5 border-b border-emerald-100 flex items-center gap-3">
          <div
            class="w-7 h-7 rounded-full bg-emerald-700 text-white flex items-center justify-center shrink-0"
            aria-hidden="true"
            set:html={CheckIcon}
          />
          <h3>
            <EyebrowText class="text-emerald-950">
              {SITE.name}
            </EyebrowText>
          </h3>
        </div>
        <ul class="p-6 space-y-4" role="list">
          <li class="flex gap-4 items-start">
            <svg
              class="w-5 h-5 shrink-0 text-emerald-700 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg
            ><p class="text-[15px] font-bold text-emerald-950">
              1-on-1 private sessions: 100% of the teacher's attention.
            </p>
          </li>
          <li class="flex gap-4 items-start">
            <svg
              class="w-5 h-5 shrink-0 text-emerald-700 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
              ></path></svg
            ><p class="text-[15px] font-bold text-emerald-950">
              Positive reinforcement only. Patience is our non-negotiable.
            </p>
          </li>
          <li class="flex gap-4 items-start">
            <svg
              class="w-5 h-5 shrink-0 text-emerald-700 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"
              ></path></svg
            ><p class="text-[15px] font-bold text-emerald-950">
              Same dedicated teacher, every session, every month.
            </p>
          </li>
          <li class="flex gap-4 items-start">
            <svg
              class="w-5 h-5 shrink-0 text-emerald-700 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
              ></path></svg
            ><p class="text-[15px] font-bold text-emerald-950">
              On-demand progress reports available anytime.
            </p>
          </li>
          <li class="flex gap-4 items-start">
            <svg
              class="w-5 h-5 shrink-0 text-emerald-700 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
              ></path></svg
            ><p class="text-[15px] font-bold text-emerald-950">
              Guaranteed make-up for every missed class.
            </p>
          </li>
          <li class="flex gap-4 items-start">
            <svg
              class="w-5 h-5 shrink-0 text-emerald-700 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg
            ><p class="text-[15px] font-bold text-emerald-950">
              You pick the time: mornings, evenings, weekends.
            </p>
          </li>
        </ul>

        <div
          class="bg-emerald-950 rounded-2xl p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
        >
          <div>
            <div class="text-white font-bold text-[15px] mb-1">Ready to start your journey?</div>
            <div class="text-emerald-100/70 text-[13px] font-medium">First class is free.</div>
          </div>
          <Button href="/getting-started/signup" variant="primaryDark" class="w-full sm:w-auto">
            Start Trial →
          </Button>
        </div>
      </div>
    </div>
  </div>
</Section>
