---
// src/components/landing/LandingFAQ.astro

interface FaqItem {
  q: string;
  a: string;
  link?: { text: string; href: string };
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<section class="py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6 md:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Left Column: Sticky Anchor (CRO optimized) -->
      <div class="lg:col-span-4 lg:sticky lg:top-32 flex flex-col items-start">
        <span class="text-emerald-500 font-bold tracking-widest text-sm uppercase mb-3 block"
          >COMMON QUESTIONS</span
        >
        <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6 text-balance">
          Clear answers.
        </h2>
        <p class="text-slate-500 text-lg">
          Have a question we didn't cover? <a
            href="/contact"
            target="_blank"
            rel="noopener noreferrer"
            class="text-emerald-600 font-semibold hover:text-emerald-700 hover:underline transition-colors"
            >Contact our support team.</a
          >
        </p>
      </div>

      <!-- Right Column: The Open Grid FAQ (CRO optimized) -->
      <div class="lg:col-span-8">
        <dl class="flex flex-col space-y-8 divide-y divide-slate-100">
          {
            items.map((item) => (
              <div class="pt-8 first:pt-0 flex flex-col items-start">
                <dt class="text-xl md:text-2xl font-bold text-slate-900 mb-4">{item.q}</dt>
                <dd class="text-lg text-slate-600 leading-relaxed">
                  {item.a}
                  {item.link && (
                    <a
                      href={item.link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-block mt-3 text-emerald-600 font-bold hover:text-emerald-700 hover:underline transition-colors"
                    >
                      {item.link.text}
                    </a>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
