---
// src/components/landing/heroes/HeroAdults.astro
import Button from '../../ui/Button.astro';
import { SITE } from '../../../constants/site';

interface Props {
  intent: string;
  h1: string;
  subhead: string;
}

const { intent, h1, subhead } = Astro.props;
---

<section class="relative overflow-hidden bg-emerald-950">
  <!-- Subtle grid texture -->
  <div
    class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.03)_1px,transparent_1px)] [background-size:48px_48px] pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <!-- Glow -->
  <div
    class="absolute top-0 right-0 w-[600px] h-[400px] bg-emerald-600/10 blur-[150px] rounded-full pointer-events-none"
    aria-hidden="true"
  >
  </div>

  <div class="quranific-container relative z-10 py-8">
    <!-- Ad-lander header: logo only -->
    <header class="mb-14 md:mb-20 flex items-center justify-between">
      <a
        href="/"
        class="inline-flex items-center hover:opacity-80 transition-opacity focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 rounded-lg"
      >
        <img
          src="/images/quranific-logo-gold.svg"
          alt="Quranific Logo"
          class="h-8 md:h-9 w-auto object-contain"
          loading="eager"
          decoding="async"
        />
      </a>
    </header>

    <div
      class="grid lg:grid-cols-[1fr_380px] gap-12 xl:gap-20 items-center pb-16 sm:pb-20 lg:pb-24"
    >
      <!-- Left: headline + CTAs -->
      <div>
        <div
          class="inline-flex items-center px-3.5 py-1 rounded-full text-sm font-semibold bg-emerald-500/15 text-emerald-300 ring-1 ring-inset ring-emerald-500/30 mb-6"
        >
          Professional 1-on-1 Tutoring
        </div>

        <!-- Dynamic H1 per intent -->
        <h1
          class="font-serif text-4xl sm:text-5xl lg:text-[3.5rem] font-black text-white leading-[1.06] tracking-tight mb-5"
        >
          {h1}
        </h1>

        <!-- Dynamic subhead per intent -->
        <p
          class="text-xl md:text-2xl text-emerald-100/70 font-medium leading-relaxed mb-8 max-w-xl"
        >
          {subhead}
        </p>

        <!-- CTAs: Hero = variant="primary" per top-funnel mapping -->
        <div class="flex flex-col sm:flex-row gap-3 mb-8">
          <Button
            href={`/funnel/signup?source=ad_adults_${intent}`}
            data-track-cta
            variant="primary"
            class="px-8 py-4 text-base font-bold shadow-sm"
          >
            Book Your Free Class
          </Button>
          <Button
            href={SITE.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            variant="whatsapp"
            fullWidthOnMobile
            data-track-cta
          >
            <svg
              class="w-5 h-5 shrink-0"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
              ></path>
            </svg>
            Chat on WhatsApp
          </Button>
        </div>

        <!-- Edge UI Trust Pills (Dark Theme - Premium Emerald Glass) -->
        <ul
          class="grid grid-cols-2 lg:flex lg:flex-wrap lg:justify-start gap-2 md:gap-2.5 mt-6 w-full"
        >
          <li
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-[13px] font-semibold bg-emerald-900/60 text-emerald-100 border border-emerald-700/50 shadow-xs w-full justify-center lg:w-auto lg:justify-start"
          >
            <!-- SVG: Smile / Judgment-free -->
            <svg
              class="w-3.5 h-3.5 text-emerald-400 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
              <line x1="9" x2="9.01" y1="9" y2="9"></line>
              <line x1="15" x2="15.01" y1="9" y2="9"></line>
            </svg>
            Judgment-free
          </li>
          <li
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-[13px] font-semibold bg-emerald-900/60 text-emerald-100 border border-emerald-700/50 shadow-xs w-full justify-center lg:w-auto lg:justify-start"
          >
            <!-- SVG: Calendar -->
            <svg
              class="w-3.5 h-3.5 text-emerald-400 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
              <line x1="16" x2="16" y1="2" y2="6"></line>
              <line x1="8" x2="8" y1="2" y2="6"></line>
              <line x1="3" x2="21" y1="10" y2="10"></line>
            </svg>
            Flexible scheduling
          </li>
          <li
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-[13px] font-semibold bg-emerald-900/60 text-emerald-100 border border-emerald-700/50 shadow-xs w-full justify-center lg:w-auto lg:justify-start"
          >
            <!-- SVG: Shield Check -->
            <svg
              class="w-3.5 h-3.5 text-emerald-400 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
            Full-month guarantee
          </li>
          <li
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-[13px] font-semibold bg-emerald-900/60 text-emerald-100 border border-emerald-700/50 shadow-xs w-full justify-center lg:w-auto lg:justify-start"
          >
            <!-- SVG: User Check -->
            <svg
              class="w-3.5 h-3.5 text-emerald-400 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <polyline points="16 11 18 13 22 9"></polyline>
            </svg>
            Male &amp; Female Hafiz
          </li>
        </ul>
      </div>

      <!-- Right: floating credential card (desktop) -->
      <div class="hidden lg:block">
        <div class="bg-white/5 border border-white/10 backdrop-blur-md shadow-xl rounded-2xl p-8">
          <p class="text-xs font-bold uppercase tracking-widest text-emerald-400 mb-5">
            Why professionals choose us
          </p>
          <ul class="space-y-5">
            {
              [
                {
                  icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
                  text: '100% private — no group classes, no awkward reading aloud',
                },
                {
                  icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
                  text: 'Schedule 24/7 — evenings, weekends, lunch breaks',
                },
                {
                  icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.51"/></svg>`,
                  text: 'Reschedule any class directly from your portal',
                },
                {
                  icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
                  text: 'Start from zero — no Arabic required',
                },
              ].map(({ icon, text }) => (
                <li class="flex items-start gap-3 text-lg text-emerald-100 font-medium leading-snug">
                  <span class="text-emerald-400 mt-0.5 shrink-0" set:html={icon} />
                  {text}
                </li>
              ))
            }
          </ul>
          <div class="mt-6 pt-6 border-t border-emerald-700/40">
            <p class="text-sm font-semibold text-white">
              Trusted by working professionals worldwide
            </p>
            <p class="text-emerald-50 text-xs mt-1">
              Enrolled adults from the UK, USA, UAE &amp; beyond
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
