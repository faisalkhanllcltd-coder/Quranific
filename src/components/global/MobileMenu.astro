---
// src/components/global/MobileMenu.astro
// Pure HTML/Tailwind with Vanilla JS. Zero hydration cost.
import { SITE, MOBILE_NAVIGATION } from '../../constants/site';
---

<div class="lg:hidden">
  <button
    id="mobile-menu-toggle"
    type="button"
    aria-label="Open navigation menu"
    aria-expanded="false"
    aria-controls="mobile-menu-drawer"
    class="text-emerald-950 p-2 min-h-[44px] min-w-[44px] flex items-center justify-center focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 hover:bg-emerald-50 rounded-lg transition-colors"
  >
    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>

  <div
    id="mobile-menu-overlay"
    class="fixed inset-0 z-[60] invisible overflow-hidden bg-emerald-950/20 backdrop-blur-sm transition-opacity duration-300 opacity-0"
  >
    <div
      id="mobile-menu-drawer"
      role="dialog"
      aria-modal="true"
      aria-label="Navigation menu"
      inert
      class="absolute inset-y-0 right-0 w-full sm:w-80 bg-[#fefdf9] transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col pt-6 px-4 sm:px-6 shadow-2xl will-change-transform"
    >
      <div class="flex items-center justify-between mb-12">
        <a
          href="/"
          class="flex items-center focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 rounded-lg"
        >
          <img
            src="/images/quranific-logo-green.svg"
            alt="Quranific — Home"
            width="160"
            height="40"
            loading="eager"
            decoding="async"
            class="h-8 w-auto object-contain drop-shadow-sm"
          />
        </a>
        <button
          id="mobile-menu-close"
          type="button"
          aria-label="Close navigation menu"
          class="text-emerald-950 p-2 bg-emerald-50 rounded-full hover:bg-emerald-100 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 min-h-[44px] min-w-[44px] flex items-center justify-center"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <nav aria-label="Mobile navigation" class="flex flex-col gap-6 text-center mt-4">
        {
          MOBILE_NAVIGATION.map((item) => (
            <a
              href={item.href}
              class="text-3xl font-black text-emerald-950 hover:text-emerald-700 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 rounded py-1"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="mt-auto pb-12 flex flex-col gap-4">
        <a
          href={SITE.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full text-center py-2.5 font-semibold text-emerald-900 bg-emerald-50 rounded-xl border border-emerald-100 hover:bg-emerald-100 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 min-h-[44px] flex items-center justify-center"
        >
          WhatsApp Support
        </a>
        <a
          href="/funnel/signup"
          class="w-full text-center py-2.5 font-semibold text-white bg-emerald-700 rounded-xl shadow-lg hover:bg-emerald-800 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white min-h-[44px] flex items-center justify-center"
        >
          Sign up now
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  let mobileMenuAbortController: AbortController | null = null;

  function initMobileMenu(): void {
    mobileMenuAbortController?.abort();
    mobileMenuAbortController = new AbortController();
    const { signal } = mobileMenuAbortController;

    const overlay = document.getElementById('mobile-menu-overlay');
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const closeBtn = document.getElementById('mobile-menu-close');
    const drawer = document.getElementById('mobile-menu-drawer');

    if (!toggleBtn || !closeBtn || !drawer || !overlay) return;

    // ASTRO SAFE PORTAL: Move to root body to escape Header transform contexts
    if (overlay.parentNode !== document.body) {
      document.body.appendChild(overlay);
    }

    // Cleanup: Destroy the portaled overlay before Astro swaps the page to prevent ghost duplicates
    document.addEventListener(
      'astro:before-swap',
      () => {
        if (overlay.parentNode === document.body) {
          overlay.remove();
        }
      },
      { signal }
    );

    const FOCUSABLE = 'a[href]:not([tabindex="-1"]), button:not([disabled]):not([tabindex="-1"])';
    function getFocusables(): HTMLElement[] {
      return Array.from(drawer!.querySelectorAll<HTMLElement>(FOCUSABLE));
    }

    function openMenu(e?: Event): void {
      if (e) {
        e.preventDefault();
        e.stopPropagation(); // Stop event bubbling storm
      }

      // 1. Remove display: none to inject into render tree
      overlay!.classList.remove('invisible');
      drawer!.removeAttribute('inert');

      // 2. Force hardware paint recalculation before animating
      void drawer!.offsetWidth;

      // 3. Trigger GPU-accelerated slide and fade
      overlay!.classList.remove('opacity-0');
      drawer!.classList.remove('translate-x-full');
      drawer!.classList.add('translate-x-0');

      // 4. Stricter iOS scroll lock
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';

      toggleBtn!.setAttribute('aria-expanded', 'true');
      closeBtn!.focus();
    }

    function closeMenu(e?: Event): void {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }

      overlay!.classList.add('opacity-0');
      drawer!.classList.add('translate-x-full');
      drawer!.classList.remove('translate-x-0');

      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';

      toggleBtn!.setAttribute('aria-expanded', 'false');
      drawer!.setAttribute('inert', '');

      // Fixed 300ms timeout matching Tailwind classes. No layout thrashing!
      setTimeout(() => {
        overlay!.classList.add('invisible');
        toggleBtn!.focus();
      }, 300);
    }

    // Keyboard Trap
    drawer.addEventListener(
      'keydown',
      (e: KeyboardEvent) => {
        if (e.key === 'Escape') return closeMenu();
        if (e.key !== 'Tab') return;

        const focusables = getFocusables();
        if (focusables.length === 0) return;

        const first = focusables[0];
        const last = focusables[focusables.length - 1];

        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      },
      { signal }
    );

    // Click outside to close (Attached directly to overlay, heavily optimized)
    overlay.addEventListener(
      'click',
      (e: MouseEvent) => {
        if (e.target === overlay) closeMenu(e);
      },
      { signal }
    );

    toggleBtn.addEventListener('click', openMenu, { signal });
    closeBtn.addEventListener('click', closeMenu, { signal });

    // Close automatically if a link inside the drawer is clicked
    const links = drawer.querySelectorAll('a');
    links.forEach((link) => {
      link.addEventListener('click', () => closeMenu(), { signal });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileMenu);
  } else {
    initMobileMenu();
  }
  document.addEventListener('astro:page-load', initMobileMenu);
</script>
