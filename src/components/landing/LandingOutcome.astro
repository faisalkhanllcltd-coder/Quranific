---
// src/components/landing/LandingOutcome.astro

interface Props {
  eyebrow?: string;
  headline: string;
  body: string[];
  theme?: 'dark' | 'light';
}

const { eyebrow = 'Six Months From Now', headline, body, theme = 'light' } = Astro.props;

const sectionBg = theme === 'dark' ? 'bg-emerald-950' : 'bg-cream-50 border-b border-emerald-50';
const eyebrowColor = theme === 'dark' ? 'text-emerald-400' : 'text-emerald-600';
const headlineColor = theme === 'dark' ? 'text-white' : 'text-emerald-950';
const bodyColor = theme === 'dark' ? 'text-emerald-100/85' : 'text-emerald-900/75';
---

<section class={`quranific-section ${sectionBg}`}>
  <div class="quranific-container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <p class={`text-xs font-bold uppercase tracking-widest mb-4 ${eyebrowColor}`}>
          {eyebrow}
        </p>
        <h2
          class={`font-serif text-3xl md:text-4xl font-black leading-[1.1] mb-6 ${headlineColor}`}
        >
          {headline}
        </h2>
        <div class={`space-y-4 text-lg leading-relaxed max-w-prose ${bodyColor}`}>
          {body.map((p) => <p set:html={p} />)}
        </div>
      </div>

      <div>
        <slot name="media" />
      </div>
    </div>
  </div>
</section>
