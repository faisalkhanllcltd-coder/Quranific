---
// src/components/blocks/PainPoints.astro
import EyebrowBadge from '../../components/ui/EyebrowBadge.astro';
---

<section class="py-10 md:py-20 lg:py-32 bg-emerald-950 relative" aria-labelledby="pain-heading">
  <div class="absolute inset-0 overflow-hidden pointer-events-none -z-10" aria-hidden="true">
    <div
      class="absolute top-0 right-0 w-[600px] h-[600px] border border-white/5 rounded-full -translate-y-1/4 translate-x-1/4"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 w-[800px] h-[800px] border border-white/5 rounded-full translate-y-1/4 -translate-x-1/4"
    >
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-[1fr_1.4fr] gap-12 lg:gap-20 items-start relative">
      <div class="self-start lg:sticky lg:top-32">
        <EyebrowBadge
          class="bg-white/5 border border-white/10 text-emerald-300 mb-6 backdrop-blur-sm"
        >
          You are not alone
        </EyebrowBadge>
        <h2
          id="pain-heading"
          class="text-4xl lg:text-5xl lg:leading-tight font-medium text-white mb-6 tracking-tight"
        >
          We know <em class="text-amber-500 not-italic">exactly</em> how you feel.
        </h2>
        <p class="text-lg text-emerald-100/70 font-medium leading-relaxed">
          These are the real thoughts of parents who found Quranific, before they found us.
        </p>
      </div>

      <div class="flex flex-col gap-6">
        <blockquote
          class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 relative overflow-hidden group hover:bg-white/10 transition-colors duration-300 ease-in-out"
        >
          <div
            class="absolute left-0 top-0 bottom-0 w-1 bg-amber-500 scale-y-0 group-hover:scale-y-100 origin-bottom transition-transform duration-300 ease-in-out"
            aria-hidden="true"
          >
          </div>
          <p class="text-xl md:text-2xl font-serif italic text-white/95 mb-4 leading-relaxed">
            "The local mosque is 40 minutes away, the class has 30 kids in it, and my son comes home
            more scared of Quran than connected to it."
          </p>
          <footer class="text-sm font-bold text-emerald-400/60 uppercase tracking-widest">
            — A father in Manchester, 2 children
          </footer>
        </blockquote>

        <blockquote
          class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 relative overflow-hidden group hover:bg-white/10 transition-colors duration-300 ease-in-out"
        >
          <div
            class="absolute left-0 top-0 bottom-0 w-1 bg-amber-500 scale-y-0 group-hover:scale-y-100 origin-bottom transition-transform duration-300 ease-in-out"
            aria-hidden="true"
          >
          </div>
          <p class="text-xl md:text-2xl font-serif italic text-white/95 mb-4 leading-relaxed">
            "We tried two other online academies. The teachers kept changing, the quality was
            inconsistent, and my daughter just stopped caring."
          </p>
          <footer class="text-sm font-bold text-emerald-400/60 uppercase tracking-widest">
            — A mother in Houston, daughter aged 9
          </footer>
        </blockquote>

        <blockquote
          class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 relative overflow-hidden group hover:bg-white/10 transition-colors duration-300 ease-in-out"
        >
          <div
            class="absolute left-0 top-0 bottom-0 w-1 bg-amber-500 scale-y-0 group-hover:scale-y-100 origin-bottom transition-transform duration-300 ease-in-out"
            aria-hidden="true"
          >
          </div>
          <p class="text-xl md:text-2xl font-serif italic text-white/95 mb-4 leading-relaxed">
            "I keep telling myself we'll start properly next month. My son is 12 now. I can't let
            another year pass."
          </p>
          <footer class="text-sm font-bold text-emerald-400/60 uppercase tracking-widest">
            — A father in Dubai, son aged 12
          </footer>
        </blockquote>
      </div>
    </div>
  </div>
</section>
