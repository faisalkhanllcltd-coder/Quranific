---
// src/components/global/Footer.astro
// Global Footer — static HTML/CSS, edge-cacheable, minimal JS (newsletter only).
import { SITE, FOOTER_NAVIGATION } from '../../constants/site';
import EyebrowText from '../ui/EyebrowText.astro';
import { Image } from 'astro:assets';
import logoGold from '../../assets/images/quranific-logo-gold.svg';

const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    label: 'Facebook',
    href: SITE.social.facebook,
  },
  {
    label: 'Instagram',
    href: SITE.social.instagram,
  },
  {
    label: 'TikTok',
    href: SITE.social.tiktok,
  },
  {
    label: 'Pinterest',
    href: SITE.social.pinterest,
  },
  {
    label: 'X',
    href: SITE.social.x,
  },
] as const;

const SOCIAL_ICONS: Record<string, string> = {
  Facebook:
    '<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 10v4h3v7h4v-7h3l1-4h-4v-2a1 1 0 0 1 1-1h3v-4h-3a5 5 0 0 0-5 5v2h-3"/>',
  Instagram:
    '<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 8a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4h-8a4 4 0 0 1-4-4z"/><path d="M9 12a3 3 0 1 0 6 0a3 3 0 1 0-6 0"/><path d="M16.5 7.5v.01"/>',
  TikTok:
    '<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 12a4 4 0 1 0 4 4v-12a5 5 0 0 0 5 5"/>',
  YouTube:
    '<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M2 8a4 4 0 0 1 4-4h12a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4h-12a4 4 0 0 1-4-4v-8z"/><path d="M10 9l5 3l-5 3z"/>',
  Pinterest:
    '<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 20l4 -9"/><path d="M10.7 14c.437 1.263 1.43 2 2.55 2c2.071 0 3.75 -1.554 3.75 -4a5 5 0 1 0 -9.7 1.7"/><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"/>',
  X: '<path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/>',
};

const linkClass =
  'text-emerald-300/80 hover:text-white transition-colors duration-200 text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded-sm';
const headingClass = 'text-emerald-500 mb-5';
---

<footer class="relative bg-emerald-ink pt-20 pb-10 overflow-hidden">
  <!-- hairline accent + soft glow, desktop only (mobile GPU cost avoided) -->
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 max-w-md w-full h-px bg-gradient-to-r from-transparent via-emerald-500/40 to-transparent"
    aria-hidden="true"
  >
  </div>
  <div
    class="hidden md:block absolute -top-32 left-1/2 -translate-x-1/2 w-96 h-72 bg-emerald-500/[0.07] blur-3xl rounded-full"
    aria-hidden="true"
  >
  </div>

  <div class="relative quranific-container">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-x-8 gap-y-12">
      <!-- Brand column — real anchor, not a floating tagline -->
      <div class="col-span-2 flex flex-col gap-6">
        <a
          href="/"
          class="inline-flex items-center gap-2.5 w-fit focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 rounded-lg"
        >
          <Image
            src={logoGold}
            alt="Quranific — Home"
            width={160}
            height={40}
            loading="lazy"
            decoding="async"
            class="h-9 w-auto object-contain"
          />
        </a>
        <p class="text-emerald-200/50 text-sm leading-relaxed max-w-xs">
          One teacher, one child, one path to loving the Quran.
        </p>
        <div class="flex gap-2">
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.label}
                class="w-9 h-9 rounded-lg border border-emerald-800/60 flex items-center justify-center text-emerald-400/70 hover:text-white hover:border-emerald-600 hover:bg-emerald-900/50 transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={SOCIAL_ICONS[social.label]}
                />
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <EyebrowText class={headingClass}>Discover</EyebrowText>
        <ul class="space-y-3.5">
          {
            FOOTER_NAVIGATION.discover.map((link) => (
              <li>
                <a href={link.href} class={linkClass}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <EyebrowText class={headingClass}>Community</EyebrowText>
        <ul class="space-y-3.5">
          {
            FOOTER_NAVIGATION.community.map((link) => (
              <li>
                <a href={link.href} class={linkClass}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <EyebrowText class={headingClass}>Legal</EyebrowText>
        <ul class="space-y-3.5">
          {
            FOOTER_NAVIGATION.legal.map((link) => (
              <li>
                <a href={link.href} class={linkClass}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Newsletter — real card treatment, not a flat inline row -->
    <div class="mt-16 pt-10 border-t border-emerald-900/50">
      <div
        class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 bg-emerald-950/40 border border-emerald-900/60 rounded-2xl px-6 py-6 md:px-8 md:py-7"
      >
        <div>
          <h3 class="text-white font-semibold text-base mb-1">Stay updated</h3>
          <p class="text-emerald-200/80 text-sm">
            Quranic insights and offers, straight to your inbox.
          </p>
        </div>
        <form
          id="newsletter-form"
          action="/api/newsletter"
          method="POST"
          class="flex flex-col w-full md:w-auto md:min-w-96"
          aria-label="Newsletter signup"
        >
          <div class="flex w-full">
            <label for="footer-email" class="sr-only">Email address</label>
            <input
              id="footer-email"
              type="email"
              name="email"
              placeholder="Email address"
              required
              autocomplete="email"
              class="w-full bg-emerald-ink border border-emerald-800/70 text-white placeholder-emerald-500/40 rounded-l-lg px-4 py-3 text-sm focus:outline-none focus:border-amber-500 transition-colors disabled:opacity-50"
            />
            <button
              id="newsletter-submit-btn"
              type="submit"
              class="bg-amber-500 hover:bg-amber-400 text-emerald-950 font-semibold px-5 py-3 rounded-r-lg text-sm transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-white min-h-[44px] whitespace-nowrap disabled:opacity-80 disabled:cursor-not-allowed"
            >
              Join
            </button>
          </div>
          <!-- Turnstile container: unconstrained so interactive challenge can show -->
          <div
            id="newsletter-turnstile"
            data-sitekey={SITE.turnstileSiteKey}
            style="min-height: 0; overflow: visible;"
          >
          </div>
          <div id="newsletter-message" class="mt-2 text-xs font-medium hidden"></div>
        </form>
      </div>
    </div>

    <!-- Copyright bar -->
    <div class="mt-10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-emerald-300/75 font-medium text-center sm:text-left">
        &copy; {currentYear}
        {SITE.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<script>
  // F1: Footer newsletter with lazy-loaded Turnstile (interaction-only, explicit execution)
  // api.js is loaded once on first focusin/pointerdown of the email input, reusing
  // window.turnstile if already loaded by another form on the page.

  interface TurnstileApi {
    render: (container: HTMLElement | string, options: Record<string, unknown>) => string;
    reset: (widgetId?: string) => void;
    remove: (widgetId?: string) => void;
    execute: (widgetId?: string) => void;
  }
  declare global {
    interface Window {
      turnstile?: TurnstileApi;
    }
  }

  const TURNSTILE_API = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
  const TOKEN_TIMEOUT_MS = 15000;

  let turnstileWidgetId: string | null = null;
  let turnstileToken: string | null = null;
  let apiLoaded = false;
  let apiLoading = false;

  function getSiteKey(): string {
    const container = document.getElementById('newsletter-turnstile');
    return container?.dataset.sitekey || '';
  }

  function loadTurnstileApi(): Promise<void> {
    return new Promise((resolve, reject) => {
      if (apiLoaded && typeof window.turnstile !== 'undefined') {
        resolve();
        return;
      }
      if (typeof window.turnstile !== 'undefined') {
        apiLoaded = true;
        resolve();
        return;
      }
      if (apiLoading) {
        const check = setInterval(() => {
          if (typeof window.turnstile !== 'undefined') {
            clearInterval(check);
            apiLoaded = true;
            resolve();
          }
        }, 50);
        return;
      }

      const existingScript = document.querySelector<HTMLScriptElement>(
        'script[src*="challenges.cloudflare.com/turnstile"]'
      );
      if (existingScript) {
        apiLoading = true;
        existingScript.addEventListener('load', () => {
          apiLoaded = true;
          apiLoading = false;
          resolve();
        });
        existingScript.addEventListener('error', () => {
          apiLoading = false;
          reject(new Error('Failed to load Turnstile'));
        });
        return;
      }

      apiLoading = true;
      const script = document.createElement('script');
      script.src = TURNSTILE_API;
      script.async = true;
      script.defer = true;
      script.onload = () => {
        apiLoaded = true;
        apiLoading = false;
        resolve();
      };
      script.onerror = () => {
        apiLoading = false;
        reject(new Error('Failed to load Turnstile'));
      };
      document.head.appendChild(script);
    });
  }

  function renderTurnstile(): void {
    const container = document.getElementById('newsletter-turnstile');
    if (!container || turnstileWidgetId !== null || typeof window.turnstile === 'undefined') return;

    const sitekey = getSiteKey();
    if (!sitekey) return;

    turnstileWidgetId = window.turnstile.render(container, {
      sitekey,
      appearance: 'interaction-only',
      execution: 'execute',
      callback: (token: string) => {
        turnstileToken = token;
      },
      'error-callback': () => {
        turnstileToken = null;
      },
      'expired-callback': () => {
        turnstileToken = null;
      },
    });
  }

  function executeAndWaitForToken(): Promise<string> {
    return new Promise((resolve, reject) => {
      if (turnstileToken) {
        resolve(turnstileToken);
        return;
      }

      const container = document.getElementById('newsletter-turnstile');
      if (!container || typeof window.turnstile === 'undefined' || turnstileWidgetId === null) {
        reject(new Error('Turnstile not ready'));
        return;
      }

      // Set up a one-time callback override to capture the token
      let resolved = false;
      const originalCallback = (token: string) => {
        if (!resolved) {
          resolved = true;
          turnstileToken = token;
          resolve(token);
        }
      };

      const timer = setTimeout(() => {
        if (!resolved) {
          resolved = true;
          reject(new Error('timeout'));
        }
      }, TOKEN_TIMEOUT_MS);

      // Re-render with the callback wired to our resolver
      if (turnstileWidgetId !== null) {
        window.turnstile.remove(turnstileWidgetId);
        turnstileWidgetId = null;
      }

      const sitekey = getSiteKey();
      turnstileWidgetId = window.turnstile.render(container, {
        sitekey,
        appearance: 'interaction-only',
        execution: 'execute',
        callback: (token: string) => {
          clearTimeout(timer);
          originalCallback(token);
        },
        'error-callback': () => {
          clearTimeout(timer);
          if (!resolved) {
            resolved = true;
            reject(new Error('error'));
          }
        },
      });

      // Execute immediately
      if (turnstileWidgetId !== null) {
        window.turnstile.execute(turnstileWidgetId);
      }
    });
  }

  function initFooterNewsletter() {
    const form = document.getElementById('newsletter-form') as HTMLFormElement;
    const btn = document.getElementById('newsletter-submit-btn') as HTMLButtonElement;
    const input = document.getElementById('footer-email') as HTMLInputElement;
    const message = document.getElementById('newsletter-message');

    if (!form || !btn || !input || !message || form.dataset.bound) return;
    form.dataset.bound = 'true';

    // Reset state on page load
    turnstileWidgetId = null;
    turnstileToken = null;
    apiLoaded = typeof window.turnstile !== 'undefined';
    apiLoading = false;

    // Lazy-load Turnstile on first interaction with the email input
    async function ensureTurnstileReady() {
      try {
        await loadTurnstileApi();
        renderTurnstile();
      } catch {
        // Non-fatal: form still submits, server will reject without token
      }
    }

    input.addEventListener('focusin', ensureTurnstileReady, { once: true });
    input.addEventListener('pointerdown', ensureTurnstileReady, { once: true });
    input.addEventListener('focus', ensureTurnstileReady, { once: true });
    input.addEventListener('touchstart', ensureTurnstileReady, { once: true });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const originalBtnText = btn.innerText;
      btn.innerText = 'Wait...';
      btn.disabled = true;
      message.className = 'mt-2 text-xs font-medium hidden';

      let token = turnstileToken;

      try {
        // Ensure Turnstile is loaded and rendered
        await loadTurnstileApi();
        renderTurnstile();

        if (!token) {
          // Execute and wait up to 15s for the callback
          try {
            token = await executeAndWaitForToken();
          } catch {
            message.textContent = 'Please complete the security check and try again.';
            message.className = 'mt-2 text-xs font-medium text-red-400 block';
            btn.innerText = originalBtnText;
            btn.disabled = false;
            // Reset widget for next attempt
            if (turnstileWidgetId !== null && typeof window.turnstile !== 'undefined') {
              window.turnstile.reset(turnstileWidgetId);
            }
            turnstileToken = null;
            return;
          }
        }

        input.disabled = true;

        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: input.value,
            'cf-turnstile-response': token,
          }),
        });

        const result = await response.json().catch((): { error?: string } => ({}));

        // Reset token after use (tokens are single-use)
        turnstileToken = null;
        if (turnstileWidgetId !== null && typeof window.turnstile !== 'undefined') {
          window.turnstile.reset(turnstileWidgetId);
        }

        if (!response.ok) {
          throw new Error((result as { error?: string }).error || 'Subscription failed');
        }

        btn.innerText = 'Check your inbox';
        btn.classList.replace('bg-amber-500', 'bg-emerald-600');
        btn.classList.replace('hover:bg-amber-400', 'hover:bg-emerald-500');
        btn.classList.replace('text-emerald-950', 'text-white');
        input.value = '';
        input.placeholder = 'JazakAllah Khair!';

        message.textContent = 'Check your inbox to confirm your subscription.';
        message.className = 'mt-2 text-xs font-medium text-emerald-400 block';
      } catch (error: unknown) {
        console.error('Newsletter error:', error);
        const errMsg = error instanceof Error ? error.message : '';

        btn.innerText = originalBtnText;
        btn.disabled = false;
        input.disabled = false;
        message.textContent = errMsg || 'Network error. Please try again.';
        message.className = 'mt-2 text-xs font-medium text-red-400 block';
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFooterNewsletter);
  } else {
    initFooterNewsletter();
  }
  document.addEventListener('astro:page-load', initFooterNewsletter);
</script>
