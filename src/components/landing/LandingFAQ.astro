---
// src/components/landing/LandingFAQ.astro

interface FaqItem {
  q?: string;
  question?: string;
  a?: string;
  answer?: string;
  link?: { text: string; href: string };
}

interface Props {
  items: FaqItem[];
  eyebrow?: string;
  headline?: string;
  accent?: 'emerald' | 'purple';
}

const {
  items,
  eyebrow = 'COMMON QUESTIONS',
  headline = 'Clear answers.',
  accent = 'emerald',
} = Astro.props;

const isPurple = accent === 'purple';
const eyebrowColor = isPurple ? 'text-purple-600' : 'text-emerald-600';
const headlineColor = isPurple ? 'text-purple-950' : 'text-slate-900';
const descriptionColor = isPurple ? 'text-purple-900/80' : 'text-slate-500';
const linkColor = isPurple
  ? 'text-purple-700 hover:text-purple-900'
  : 'text-emerald-600 hover:text-emerald-700';
const questionColor = isPurple ? 'text-purple-950' : 'text-slate-900';
---

<section class="py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6 md:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Left Column: Sticky Anchor (CRO optimized) -->
      <div class="lg:col-span-4 lg:sticky lg:top-32 flex flex-col items-start">
        <span class:list={['font-bold tracking-widest text-sm uppercase mb-3 block', eyebrowColor]}>
          {eyebrow}
        </span>
        <h2 class:list={['text-4xl md:text-5xl font-bold mb-6 text-balance', headlineColor]}>
          {headline}
        </h2>
        <p class:list={['text-lg leading-relaxed', descriptionColor]}>
          Have a question we didn't cover? <a
            href="/contact"
            target="_blank"
            rel="noopener noreferrer"
            class:list={['font-semibold hover:underline transition-colors', linkColor]}
            >Contact our support team.</a
          >
        </p>
      </div>

      <!-- Right Column: The Open Grid FAQ (CRO optimized) -->
      <div class="lg:col-span-8">
        <dl class="flex flex-col space-y-8 divide-y divide-slate-100">
          {
            items.map((item) => (
              <div class="pt-8 first:pt-0 flex flex-col items-start">
                <dt class:list={['text-xl md:text-2xl font-bold mb-4', questionColor]}>
                  {item.q || item.question}
                </dt>
                <dd class="text-lg text-slate-600 leading-relaxed">
                  {item.a || item.answer}
                  {item.link && (
                    <a
                      href={item.link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class:list={[
                        'inline-block mt-3 font-bold hover:underline transition-colors',
                        linkColor,
                      ]}
                    >
                      {item.link.text}
                    </a>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
