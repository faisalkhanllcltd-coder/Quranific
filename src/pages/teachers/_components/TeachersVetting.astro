---
// src/pages/teachers/_components/TeachersVetting.astro
import Section from '../../../components/ui/Section.astro';

const Icons = {
  vet1: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
  vet2: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" /></svg>`,
  vet3: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>`,
};

const VETTING_PROCESS = [
  {
    step: '01',
    title: 'Verified Credentials',
    desc: "Every teacher must hold a verified Ijazah and a Master's degree in Arabic or Islamic Studies.",
    icon: Icons.vet1,
  },
  {
    step: '02',
    title: 'Recitation & Teaching Assessment',
    desc: 'A live teaching simulation with a senior scholar to assess Tajweed, pedagogy, and patience.',
    icon: Icons.vet2,
  },
  {
    step: '03',
    title: 'Internal Training Program',
    desc: 'All teachers must successfully pass a rigorous internal training program before teaching students.',
    icon: Icons.vet3,
  },
];
---

{/* FIX: Removed rigid height={800} constraint */}
<Section class="py-16 md:py-20 lg:py-32 px-4 sm:px-6 bg-emerald-950 relative overflow-hidden">
  <div
    class="absolute inset-0 opacity-10 bg-[radial-gradient(#10b981_1px,transparent_1px)] [background-size:16px_16px]"
    aria-hidden="true"
  >
  </div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="text-center mb-12 md:mb-16 max-w-3xl mx-auto">
      <h2 class="text-3xl lg:text-5xl font-black text-white mb-6 tracking-tight text-balance">
        How We Select Our Teachers
      </h2>
      <p class="text-lg text-emerald-100/80 font-medium text-balance">
        Only those who pass our exhaustive evaluation and internal training are allowed to teach our
        students.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        VETTING_PROCESS.map((process) => (
          <div class="bg-emerald-900/50 backdrop-blur-sm border border-emerald-800 rounded-3xl p-6 sm:p-8 hover:bg-emerald-800/80 transition-all duration-300">
            <div class="flex items-center justify-between mb-6">
              <div
                class="w-14 h-14 bg-emerald-800/80 text-amber-400 rounded-2xl flex items-center justify-center shadow-inner ring-1 ring-emerald-700/50"
                aria-hidden="true"
              >
                <span set:html={process.icon} />
              </div>
              {/* FIX: Adjusted contrast from text-emerald-950/40 to text-white/10 so numbers are actually visible as watermarks */}
              <span class="text-5xl font-black text-white/10 tracking-tighter" aria-hidden="true">
                {process.step}
              </span>
            </div>
            <h3 class="text-xl sm:text-2xl font-bold text-white mb-3 leading-tight">
              {process.title}
            </h3>
            <p class="text-emerald-100/70 font-medium leading-relaxed text-sm sm:text-base">
              {process.desc}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</Section>
