# QURANIFIC ENVIRONMENT VARIABLES BLUEPRINT (Cloudflare Worker)
# RESEND_API_KEY needs Contacts access (Full access)
RESEND_API_KEY=""

# (Optional) RESEND_AUDIENCE_ID is optional, a Segment ID copied from Resend > Segments (not an old Audience ID); leave unset if unsure
# RESEND_AUDIENCE_ID=""

# Cloudflare Turnstile (Required)
# Generate at: https://dash.cloudflare.com/?to=/:account/turnstile
# TURNSTILE_SITE_KEY goes in src/constants/site.ts (public)
# TURNSTILE_SECRET_KEY goes here (private)
TURNSTILE_SECRET_KEY=""

# (Optional) Legacy fallback name for backwards compatibility
# TURNSTILE_SECRET=""

# ADMIN_EMAIL defaults to the personal Gmail in SITE.emails.admin and must never be admin@quranific.com
ADMIN_EMAIL="faisalkhan.llc.ltd@gmail.com"

# JWT_SECRET (Required): Random 256-bit string.
# Newsletter tokens use a separate key derived from JWT_SECRET with HMAC-SHA256, session tokens use JWT_SECRET directly.
# Rotating JWT_SECRET also invalidates every newsletter confirm/unsubscribe link already emailed.
JWT_SECRET=""

# INTERNAL_WORKER_SECRET (Required): Shared secret for Bearer-token authentication between workers
INTERNAL_WORKER_SECRET=""

# ALARM_ADMIN_TOKEN (alarm worker only): protects /force-run and /resend-log; set with: npx wrangler secret put ALARM_ADMIN_TOKEN -c alarm-worker/wrangler.toml
ALARM_ADMIN_TOKEN=""

SITE="http://localhost:4321"
PROD=false

# Optional Alert Webhook URL (Discord, Slack, etc.)
# ALERT_WEBHOOK_URL=""

# GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
# GA4_API_SECRET=""

