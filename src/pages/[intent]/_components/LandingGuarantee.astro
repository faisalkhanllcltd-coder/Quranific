---
// src/components/blocks/LandingGuarantee.astro
import Button from '../../../components/ui/Button.astro';
import EyebrowText from '../../../components/ui/EyebrowText.astro';

export interface GuaranteeCard {
  title?: string;
  label?: string;
  description?: string;
  sub?: string;
  icon?: string;
}

interface Props {
  eyebrow?: string;
  headline?: string;
  body?: string | string[];
  cards?: GuaranteeCard[];
  ctaHref?: string;
  ctaLabel?: string;
  layoutVariant?: 'kids-dark' | 'adults-light';
  accentColor?: 'emerald' | 'purple';
}

const defaultCards: GuaranteeCard[] = [
  {
    title: 'Free first class',
    description:
      'No card required. No commitment. We match your child with the right teacher before you pay a cent.',
    icon: 'clock',
  },
  {
    title: '30-day refund',
    description:
      'Not satisfied in your first 30 days after the trial ends? Get a full refund with one email. No forms, no chasing.',
    icon: 'shield',
  },
  {
    title: 'Make-up guarantee',
    description:
      'Missed a session? It gets made up, guaranteed. There are no lock-in contracts. Cancel anytime.',
    icon: 'sync',
  },
];

const {
  eyebrow = 'OUR GUARANTEE',
  headline = 'We carry all the risk. You carry none.',
  body = 'Your peace of mind is built into our platform. From your first free session to your first 30 days of paid learning, you are completely protected.',
  cards,
  ctaHref = '/booking',
  ctaLabel = 'Book Your Free Class',
  accentColor = 'emerald',
} = Astro.props;

const isPurple = accentColor === 'purple';
const eyebrowColor = isPurple ? 'text-purple-400' : 'text-emerald-400';
const iconBg = isPurple ? 'bg-purple-900/50 text-purple-400' : 'bg-emerald-900/50 text-emerald-400';
const bodyText = Array.isArray(body) ? body.join(' ') : body;
const cardsToRender = cards || defaultCards;
---

<section class="quranific-section bg-emerald-950">
  <div class="quranific-container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center max-w-7xl mx-auto">
      <!-- Left Column (Copy & CTA) -->
      <div class="flex flex-col items-start">
        <EyebrowText class={`mb-3 ${eyebrowColor}`}>
          {eyebrow}
        </EyebrowText>
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6 text-balance">
          <Fragment set:html={headline} />
        </h2>
        <p class="text-emerald-50/80 text-lg leading-relaxed mb-8" set:html={bodyText} />
        <!-- Standardized Sitewide CTA -->
        <Button href={ctaHref} variant="primaryDark">
          {ctaLabel}
        </Button>
      </div>

      <!-- Right Column (Premium Glassmorphism Trust Stack) -->
      <div class="flex flex-col space-y-4 md:space-y-5">
        {
          cardsToRender.map((card, idx) => (
            <div class="relative bg-white/5 border border-white/10 rounded-2xl p-6 flex items-start gap-5 hover:bg-white/10 transition-colors duration-300">
              <div class={`flex-shrink-0 mt-1 ${iconBg} p-2.5 rounded-full`}>
                {idx === 0 ? (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-6 h-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                    />
                  </svg>
                ) : idx === 1 ? (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-6 h-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                    />
                  </svg>
                ) : (
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-6 h-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                    />
                  </svg>
                )}
              </div>
              <div>
                <h4 class="text-xl font-bold text-white mb-1">{card.title || card.label}</h4>
                <p class="text-emerald-50/70 text-base leading-relaxed">
                  {card.description || card.sub}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
