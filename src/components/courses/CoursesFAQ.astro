---
// src/components/courses/CoursesFAQ.astro
// Accordion FAQ section for the courses page.
// Data from faqs.courses in src/data/faqs.ts.
// Uses the same <details>/<summary> pattern as FAQAccordion.astro for consistency.
import { faqs } from '../../data/faqs';

const questions = faqs.courses;
---

<section
  class="py-16 md:py-24 lg:py-32 bg-[#fefdf9]"
  id="courses-faq"
  aria-labelledby="courses-faq-heading"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-[1fr_1.4fr] gap-12 lg:gap-20 items-start">
      <!-- Left: section header + guarantee card (sticky on desktop) -->
      <div class="self-start lg:sticky lg:top-32">
        <div
          class="inline-flex items-center justify-center gap-2 px-3 py-1.5 bg-emerald-50 border border-emerald-100 text-emerald-800 text-[11px] font-bold uppercase tracking-widest rounded-full mb-6"
        >
          Course Questions
        </div>

        <h2
          id="courses-faq-heading"
          class="text-4xl lg:text-5xl font-black text-emerald-950 mb-5 tracking-tight leading-tight text-balance"
        >
          Everything you need<br class="hidden sm:block" />
          <span class="text-emerald-700 font-serif italic">to decide with confidence.</span>
        </h2>

        <p class="text-lg text-emerald-900/70 font-medium mb-10 text-balance">
          These are the real questions parents ask us before enrolling. We have answered each one
          honestly and completely.
        </p>

        <!-- Guarantee card -->
        <div
          class="bg-white border border-emerald-100 rounded-3xl p-6 sm:p-8 shadow-xl shadow-emerald-900/5"
        >
          <div
            class="w-12 h-12 bg-emerald-50 rounded-xl flex items-center justify-center text-emerald-700 mb-6 border border-emerald-100/50"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path>
            </svg>
          </div>
          <h3 class="font-bold text-xl text-emerald-950 mb-3">Our Full-Month Guarantee</h3>
          <p class="text-[15px] text-emerald-900/80 font-medium leading-relaxed">
            If after your first full paid month you are not completely satisfied, for any reason, we
            will refund you in full. No questions, no forms, no chasing. Just send one email.
          </p>
        </div>
      </div>

      <!-- Right: accordion -->
      <div class="space-y-4">
        {
          questions.map((item) => (
            <details class="group bg-white border border-emerald-100 rounded-2xl [&_summary::-webkit-details-marker]:hidden shadow-sm">
              <summary
                aria-expanded="false"
                class="flex items-center justify-between cursor-pointer p-4 sm:p-6 font-semibold text-emerald-950 text-base sm:text-[17px] select-none"
                style="-webkit-tap-highlight-color: transparent;"
              >
                {item.question}
                <span
                  class="transition-transform duration-300 group-open:rotate-180 bg-emerald-50 text-emerald-700 p-2 rounded-full border border-emerald-100 shrink-0 ml-4"
                  aria-hidden="true"
                >
                  <svg
                    fill="none"
                    height="16"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                    width="16"
                  >
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </span>
              </summary>
              <div
                class="text-emerald-900/80 text-sm sm:text-[15px] font-medium leading-relaxed px-4 sm:px-6 pb-4 sm:pb-6"
                set:html={item.answer}
              />
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Sync aria-expanded on all <details> in this section after open/close.
  function initCoursesFAQ(): void {
    document.querySelectorAll<HTMLDetailsElement>('#courses-faq details').forEach((details) => {
      const summary = details.querySelector<HTMLElement>('summary');
      if (!summary) return;
      summary.setAttribute('aria-expanded', String(details.open));
      details.addEventListener('toggle', () => {
        summary.setAttribute('aria-expanded', String(details.open));
      });
    });
  }
  document.addEventListener('astro:page-load', initCoursesFAQ);
</script>
