---
export const prerender = true;

// src/pages/testimonials/index.astro
import Base from '../../layouts/Base.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';

import PageHero from '../../components/blocks/PageHero.astro';
import TestimonialsVideoCard from './_components/TestimonialsVideoCard.astro';
import TestimonialsGrid from './_components/TestimonialsGrid.astro';
import TestimonialsCta from './_components/TestimonialsCta.astro';
import EyebrowText from '../../components/ui/EyebrowText.astro';

import { testimonials as unifiedTestimonials } from '../../data/testimonials';

// Map unified Testimonial interface to the shape TestimonialsGrid expects.
// Additional real reviews that aren't in the unified 6 can be appended here.
const TESTIMONIALS = [
  ...unifiedTestimonials.map((t) => ({
    name: t.name,
    role: 'Verified Student',
    location: t.details,
    text: t.quote,
    rating: 5,
  })),
  // Real reviews received via support channels — not yet in unified data/testimonials.ts
  {
    name: 'Usama Meer',
    role: 'Verified Parent & Student',
    location: 'Saudi Arabia',
    text: 'Two of my daughters are studying Quran with Quranific and we have great experience with them. Their customer support is extraordinary. They always work with you and resolve any issues. I myself am also learning Tajweed and translation through one of their teachers. I recommended Quranific to many of my friends.',
    rating: 5,
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Quranific',
  url: 'https://quranific.com',
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: '542' },
  review: TESTIMONIALS.map((t) => ({
    '@type': 'Review',
    author: {
      '@type': 'Person',
      name: t.name,
    },
    reviewRating: {
      '@type': 'Rating',
      ratingValue: t.rating,
      bestRating: '5',
    },
    reviewBody: t.text,
  })),
};
---

<Base
  title="Testimonials | Success Stories from Quranific Students"
  description="Read real stories and reviews from parents and students worldwide who have transformed their Quran reading and Tajweed with Quranific."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" is:inline />

  <Header />

  <main
    class="min-h-screen bg-cream-50 selection:bg-emerald-200 selection:text-emerald-950 overflow-hidden"
  >
    <PageHero
      eyebrow="Trusted Worldwide"
      title="Don't just take "
      highlightWord="our word for it."
      subtitle="Discover how families on every continent are building meaningful, lifelong connections with the Holy Quran through our dedicated tutors."
    >
      <Fragment slot="checklist">
        <div class="flex flex-wrap justify-center gap-8 lg:gap-16 mt-6">
          <div class="text-center">
            <div class="text-4xl font-black text-emerald-800 mb-1">4.9/5</div>
            <EyebrowText class="text-emerald-600/70"> Rated by parents </EyebrowText>
          </div>
          <div class="w-px h-16 bg-emerald-100 hidden sm:block" aria-hidden="true"></div>
          <div class="text-center flex flex-col justify-center">
            <div class="text-4xl font-black text-emerald-800 mb-1">3,000+</div>
            <EyebrowText class="text-emerald-600/70 mt-2"> Students in 22 Countries </EyebrowText>
          </div>
        </div>
      </Fragment>
    </PageHero>
    <TestimonialsVideoCard />
    <TestimonialsGrid testimonials={TESTIMONIALS} />
    <TestimonialsCta />
  </main>

  <Footer />
</Base>
