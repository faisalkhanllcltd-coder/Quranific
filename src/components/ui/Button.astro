---
// src/components/ui/Button.astro
import type { HTMLAttributes } from 'astro/types';

// Accepts all standard <a> and <button> attributes (target, rel, aria-label, etc.)
interface Props extends HTMLAttributes<'button'>, Omit<HTMLAttributes<'a'>, 'type'> {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'white' | 'emerald' | 'gold' | 'whatsapp';
  fullWidthOnMobile?: boolean;
}

const {
  href,
  variant = 'primary',
  class: className,
  type = 'button',
  fullWidthOnMobile = false,
  ...rest
} = Astro.props;

const variants: Record<string, string> = {
  // Canonical brand variants
  emerald:
    'bg-emerald-700 text-white hover:bg-emerald-800 shadow-md hover:shadow-emerald-900/20 hover:-translate-y-0.5',
  gold: 'bg-amber-500 text-white hover:bg-amber-400 shadow-md hover:shadow-amber-500/20 hover:-translate-y-0.5',
  whatsapp:
    'bg-transparent text-white border-2 border-white/40 hover:bg-white/10 hover:-translate-y-0.5',
  white: 'bg-white text-emerald-950 hover:bg-emerald-50 shadow-md hover:-translate-y-0.5',
  // Backward-compat aliases
  primary:
    'bg-emerald-700 text-white hover:bg-emerald-800 shadow-md hover:shadow-emerald-900/20 hover:-translate-y-0.5',
  secondary:
    'bg-amber-500 text-white hover:bg-amber-400 shadow-md hover:shadow-amber-500/20 hover:-translate-y-0.5',
  ghost:
    'bg-transparent text-emerald-950 border-2 border-emerald-100 hover:border-emerald-200 hover:bg-emerald-50',
};

const baseStyle =
  'inline-flex justify-center items-center px-4 py-2.5 text-sm font-semibold rounded-lg transition-all duration-300 active:scale-95 text-center min-h-[44px]';

const widthStyle = fullWidthOnMobile ? 'w-full sm:w-auto' : '';
---

{
  href ? (
    <a
      href={href}
      class:list={[baseStyle, widthStyle, variants[variant] || variants.primary, className]}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type as 'button' | 'submit' | 'reset'}
      class:list={[baseStyle, widthStyle, variants[variant] || variants.primary, className]}
      {...rest}
    >
      <slot />
    </button>
  )
}
