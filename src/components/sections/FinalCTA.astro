---
// src/components/sections/FinalCTA.astro
import { SITE } from '../../constants/site';

const Icons = {
  shield: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" /></svg>`,
  calendar: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>`,
  chart: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>`,
  unlock: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5V6.75a4.5 4.5 0 119 0v3.75M3.75 21.75h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H3.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>`,
};
---

<section
  class="py-12 md:py-24 lg:py-32 bg-[#047857] relative overflow-hidden text-center"
  aria-labelledby="final-cta-heading"
>
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-[400px] h-[400px] md:w-[800px] md:h-[800px] bg-[#10b981] rounded-full blur-[80px] md:blur-[120px] opacity-20 pointer-events-none -translate-y-1/2"
    aria-hidden="true"
  >
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 relative z-10">
    <div
      class="inline-flex items-center gap-2 px-4 py-1.5 bg-white/10 border border-white/20 text-white text-xs font-bold uppercase tracking-widest rounded-full mb-8 backdrop-blur-sm"
    >
      Guaranteed 1-on-1 Focus
    </div>

    <h2
      id="final-cta-heading"
      class="text-4xl sm:text-5xl lg:text-6xl font-semibold text-white mb-6 tracking-tight leading-tight text-balance"
    >
      Your child's first class
      <span class="text-[#fde68a] font-serif italic">is completely free.</span>
    </h2>

    <p
      class="text-xl text-emerald-100/90 font-medium mb-12 max-w-xl mx-auto leading-relaxed text-balance"
    >
      No credit card. No commitment. No risk.<br class="hidden sm:block" />
      Just 30 minutes to see if it's the right fit for your family.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
      <a
        href="/funnel/signup"
        class="group w-full sm:w-auto inline-flex justify-center items-center gap-2 px-6 py-3 bg-white text-[#047857] hover:bg-[#ecfdf5] font-bold rounded-lg transition-all duration-300 shadow-xl shadow-emerald-900/30 text-[15px] min-h-[44px]"
      >
        Book Your Free Class
        <svg
          class="w-5 h-5 text-[#047857] group-hover:translate-x-1 transition-transform duration-300"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
          aria-hidden="true"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path></svg
        >
      </a>

      <a
        href={SITE.whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="group w-full sm:w-auto inline-flex justify-center items-center gap-2 px-6 py-3 bg-transparent border-2 border-emerald-200/50 text-white hover:bg-white/10 hover:border-white/80 font-semibold rounded-lg transition-all duration-300 text-[15px] min-h-[44px]"
      >
        <svg
          class="w-5 h-5 text-[#25D366] group-hover:text-white transition-colors"
          fill="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
          ><path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
          ></path></svg
        >
        Chat on WhatsApp
      </a>
    </div>

    <!-- 4-Point Trust Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto">
      <!-- Card 1 -->
      <div
        class="flex items-center gap-4 p-4 lg:p-5 rounded-2xl bg-white/10 border border-white/20 backdrop-blur-sm text-left hover:bg-white/15 transition-colors duration-300"
      >
        <div class="text-emerald-300 shrink-0" set:html={Icons.shield} />
        <div class="flex flex-col">
          <span class="text-white font-bold text-[16px] leading-tight mb-0.5">100% Risk-Free</span>
          <span class="text-emerald-100/70 text-[10px] font-bold uppercase tracking-widest"
            >Full-Month Guarantee</span
          >
        </div>
      </div>

      <!-- Card 2 -->
      <div
        class="flex items-center gap-4 p-4 lg:p-5 rounded-2xl bg-white/10 border border-white/20 backdrop-blur-sm text-left hover:bg-white/15 transition-colors duration-300"
      >
        <div class="text-emerald-300 shrink-0" set:html={Icons.calendar} />
        <div class="flex flex-col">
          <span class="text-white font-bold text-[16px] leading-tight mb-0.5"
            >Flexible Schedule</span
          >
          <span class="text-emerald-100/70 text-[10px] font-bold uppercase tracking-widest"
            >Guaranteed Make-ups</span
          >
        </div>
      </div>

      <!-- Card 3 -->
      <div
        class="flex items-center gap-4 p-4 lg:p-5 rounded-2xl bg-white/10 border border-white/20 backdrop-blur-sm text-left hover:bg-white/15 transition-colors duration-300"
      >
        <div class="text-emerald-300 shrink-0" set:html={Icons.chart} />
        <div class="flex flex-col">
          <span class="text-white font-bold text-[16px] leading-tight mb-0.5">Track Progress</span>
          <span class="text-emerald-100/70 text-[10px] font-bold uppercase tracking-widest"
            >On-Demand Reports</span
          >
        </div>
      </div>

      <!-- Card 4 -->
      <div
        class="flex items-center gap-4 p-4 lg:p-5 rounded-2xl bg-white/10 border border-white/20 backdrop-blur-sm text-left hover:bg-white/15 transition-colors duration-300"
      >
        <div class="text-emerald-300 shrink-0" set:html={Icons.unlock} />
        <div class="flex flex-col">
          <span class="text-white font-bold text-[16px] leading-tight mb-0.5">Zero Contracts</span>
          <span class="text-emerald-100/70 text-[10px] font-bold uppercase tracking-widest"
            >Cancel Any Time</span
          >
        </div>
      </div>
    </div>
  </div>
</section>
