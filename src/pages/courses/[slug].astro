---
// src/pages/courses/[slug].astro
import Page from '../../layouts/Page.astro';
import TeacherTeaserBanner from '../../components/blocks/TeacherTeaserBanner.astro';
import CoursesFAQ from '../../components/blocks/CoursesFAQ.astro';
import FAQAccordion from '../../components/blocks/FAQAccordion.astro';
import FinalCTA from '../../components/blocks/FinalCTA.astro';

import PageHero from '../../components/blocks/PageHero.astro';
import CourseBentoFacts from './_components/CourseBentoFacts.astro';
import CourseWhyWho from './_components/CourseWhyWho.astro';
import CourseCurriculum from './_components/CourseCurriculum.astro';
import CoursePricingSection from './_components/CoursePricingSection.astro';

import { courses } from '../../constants/courses';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Enforce SSR and Edge Middleware execution by extracting the dynamic param
const { slug } = Astro.params;
const course = courses.find((c) => c.slug === slug);

if (!course) {
  return Astro.redirect('/404');
}

// Pre-compute related courses for the SEO linking block
const relatedCourses = course.relatedSlugs
  .map((s) => courses.find((c) => c.slug === s))
  .filter((c): c is (typeof courses)[number] => c !== undefined);

// OG image stays as a static public/ path string — needed as an absolute URL for social crawlers
const ogImageSrc = `/images/${course.slug}.webp`;

// Build-time glob: resolves all course images at compile time, eliminating runtime fallbacks
const courseImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/*.webp',
  { eager: true }
);

const targetPath = `/src/assets/images/${course.slug}.webp`;
const fallbackPath = '/src/assets/images/basic-qaida.webp';
const optimizedImage = (courseImages[targetPath] ?? courseImages[fallbackPath]).default;

// Generate JSON-LD Schemas (Course + FAQ)
const jsonLdSchemas = [];

// 1. Core Course Schema
jsonLdSchemas.push({
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: course.title,
  description: course.longDesc || course.shortDesc,
  provider: {
    '@type': 'Organization',
    name: 'Quranific',
    sameAs: 'https://quranific.com',
  },
  typicalAgeRange: course.ageRange,
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'Online',
    courseWorkload: course.duration,
    offers: {
      '@type': 'Offer',
      availability: 'https://schema.org/InStock',
      price: '40.00',
      priceCurrency: 'USD',
      url: `https://quranific.com/courses/${course.slug}`,
    },
  },
});

// 2. Dynamic FAQPage Schema for Rich Snippets
if (course.courseFaqs && course.courseFaqs.length > 0) {
  jsonLdSchemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: course.courseFaqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        // Strip HTML from answers for strict JSON-LD compliance
        text: faq.answer.replace(/<[^>]*>?/gm, ''),
      },
    })),
  });
}
---

<Page description={course.shortDesc} title={`${course.title} | Quranific`} image={ogImageSrc}>
  <!-- slot="head" forces this script into the <head> of Page.astro where Google expects it -->
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(jsonLdSchemas)}
    is:inline
  />

  <!-- layout="split" locks the grid to 50/50 text-to-image ratio -->
  <PageHero
    layout="split"
    eyebrow={course.level || 'Online Course'}
    title={course.title}
    subtitle={course.shortDesc}
    primaryCtaText="Book Free Trial Class"
    primaryCtaLink={`/getting-started/signup?course=${course.slug}`}
    secondaryCtaText="Calculate Monthly Fee"
    secondaryCtaLink={`#calc-heading-${course.slug}`}
  >
    <Fragment slot="visual">
      <!-- Edge UI Image Optimization: Dynamically shifts aspect ratios across breakpoints to prevent clipping while maximizing screen real estate -->
      <div
        class="relative w-full aspect-video sm:aspect-[4/3] lg:aspect-square rounded-[2rem] overflow-hidden shadow-2xl border border-emerald-100 bg-emerald-50 group"
      >
        <Image
          src={optimizedImage}
          alt={`Learn ${course.title}`}
          class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
          fetchpriority="high"
          loading="eager"
          decoding="sync"
        />
        <div
          class="absolute inset-0 shadow-[inset_0_0_0_1px_rgba(0,0,0,0.05)] pointer-events-none"
          aria-hidden="true"
        >
        </div>
      </div>
    </Fragment>
  </PageHero>

  <CourseBentoFacts course={course} />
  <CourseWhyWho course={course} />
  <CourseCurriculum course={course} />
  <CoursePricingSection course={course} />

  <TeacherTeaserBanner hideCta={true} />

  {
    course.courseFaqs && course.courseFaqs.length > 0 ? (
      <FAQAccordion
        questions={course.courseFaqs}
        eyebrow="COURSE QUESTIONS"
        title={`Frequently Asked Questions about ${course.shortTitle || course.title}`}
        subtitle="Everything you need to know about this course and how lessons work."
      />
    ) : (
      <CoursesFAQ />
    )
  }

  {
    relatedCourses.length > 0 && (
      <section
        aria-label="Related Courses"
        class="py-8 bg-emerald-50/40 border-t border-emerald-100/60"
      >
        <div class="quranific-container flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 text-sm">
          <span class="font-bold text-emerald-950 shrink-0">Related Courses:</span>
          <nav aria-label="Related courses" class="flex flex-wrap items-center gap-x-4 gap-y-2">
            {relatedCourses.map((related, idx) => (
              <span class="inline-flex items-center gap-4">
                <a
                  href={`/courses/${related.slug}`}
                  class="font-medium text-emerald-800 hover:text-emerald-950 hover:underline transition-colors"
                >
                  {related.title}
                </a>
                {idx < relatedCourses.length - 1 && (
                  <span class="text-emerald-300 select-none" aria-hidden="true">
                    •
                  </span>
                )}
              </span>
            ))}
          </nav>
        </div>
      </section>
    )
  }

  <FinalCTA />
</Page>
