---
// src/components/landing/LandingProblem.astro
import Button from '../ui/Button.astro';

interface Props {
  eyebrow?: string;
  headline: string;
  body: string;
  painPoints: {
    title: string;
    text: string;
  }[];
  ctaLabel?: string;
  ctaHref?: string;
}

const { eyebrow, headline, body, painPoints, ctaLabel, ctaHref } = Astro.props;
---

<section class="quranific-section bg-white border-b border-emerald-50">
  <div class="quranific-container">
    <div class="max-w-3xl mx-auto text-center flex flex-col items-center mb-12">
      {
        eyebrow && (
          <p class="text-xs font-bold uppercase tracking-widest text-emerald-600 mb-4">{eyebrow}</p>
        )
      }
      <h2
        class="font-serif text-3xl md:text-4xl font-black text-emerald-950 leading-[1.1] mb-6 text-balance"
      >
        {headline}
      </h2>
      <p
        class="text-lg text-emerald-900/75 leading-relaxed max-w-2xl mx-auto text-balance"
        set:html={body}
      />
    </div>

    <!-- 3-Column Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {
        painPoints.map((point) => (
          <div class="relative flex flex-col p-6 rounded-2xl bg-white border border-emerald-100/80 shadow-xs transition-all hover:shadow-sm hover:border-emerald-200">
            <div class="flex items-center justify-center w-10 h-10 rounded-full bg-emerald-50/80 mb-4 shrink-0">
              <svg
                class="w-5 h-5 text-emerald-800/40"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{point.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{point.text}</p>
          </div>
        ))
      }
    </div>

    {
      ctaLabel && ctaHref && (
        <div class="mt-12 flex justify-center">
          <Button href={ctaHref} variant="white">
            {ctaLabel}
          </Button>
        </div>
      )
    }
  </div>
</section>
