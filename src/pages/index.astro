---
// src/pages/index.astro
import Base from '../layouts/Base.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import TestimonialGrid from '../components/sections/TestimonialGrid.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import PainPoints from '../components/sections/PainPoints.astro';
import QuranificDifference from '../components/sections/QuranificDifference.astro';
import HowItWorks, { howTo } from '../components/sections/HowItWorks.astro';
import AdultCTA from '../components/sections/AdultCTA.astro';

import { SITE } from '../constants/site';

const PAGE_CONTENT = {
  hero: {
    badgeText: 'Now enrolling · Limited spots',
    title: 'The Quran class your child',
    highlightWord: 'actually looks forward to.',
    subtitle:
      'No crowded mosque classes. No harsh methods. No guilt. Just a gentle, qualified teacher, one child, and 30 minutes that might change everything.',
    primaryCtaText: 'Book Your Free Class',
    primaryCtaLink: '/funnel/signup',
  },
  faq: [
    {
      question: 'What if my child misses a class?',
      answer:
        'Every single missed class has a guaranteed make-up session. No exceptions, no expiry.',
    },
    {
      question: "Is my child's session safe and private?",
      answer:
        'Every session is strictly 1-on-1, conducted on a private, secure video link. Sessions are never recorded without explicit parental consent.',
    },
    {
      question: "What if it doesn't work for us?",
      answer:
        'The first class is completely free, no credit card needed. If you join and are not satisfied within your first paid month, we refund every penny.',
    },
  ],
};

// Elite Edge SEO: Deep Semantic JSON-LD
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': ['WebSite', 'EducationalOrganization'],
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${SITE.url}/courses?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      url: SITE.whatsappLink,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: PAGE_CONTENT.faq.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to start learning Quran with Quranific',
    description: 'Start your personalized 1-on-1 online Quran classes in three simple steps.',
    step: howTo.map((step, index) => ({
      '@type': 'HowToStep',
      position: index + 1,
      name: step.name,
      text: step.text,
    })),
  },
];
---

<Base title={SITE.title} description={SITE.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <Header />

  <main
    id="main-content"
    class="bg-cream-50 selection:bg-emerald-200 selection:text-emerald-950 font-sans"
  >
    <HomeHero
      title={PAGE_CONTENT.hero.title}
      highlightWord={PAGE_CONTENT.hero.highlightWord}
      subtitle={PAGE_CONTENT.hero.subtitle}
      primaryCtaLink={PAGE_CONTENT.hero.primaryCtaLink}
    />

    <PainPoints />

    <QuranificDifference />

    <TestimonialGrid />

    <HowItWorks />

    <FAQAccordion />

    <AdultCTA />

    <FinalCTA />
  </main>

  <Footer />
</Base>
