---
// src/components/landing/LandingTrust.astro

interface Props {
  headline: string;
  body: string[];
  trustPoints: string[];
  /** 'emerald' (kids/adults) or 'purple' (women) */
  accent?: 'emerald' | 'purple';
  /** Reverse column order: false = text-left list-right (kids), true = list-left text-right (adults/women) */
  reversed?: boolean;
}

const { headline, body, trustPoints, accent = 'emerald', reversed = false } = Astro.props;

const checkColor = accent === 'purple' ? 'text-purple-600' : 'text-emerald-600';
---

<section class="quranific-section bg-white border-b border-emerald-50">
  <div class="quranific-container">
    <div class="grid lg:grid-cols-2 gap-12 xl:gap-20 items-center">
      <!-- Text column -->
      <div class:list={[reversed ? 'order-1 lg:order-2' : '']}>
        <p class="text-xs font-bold uppercase tracking-widest text-emerald-600 mb-4">
          Full Transparency
        </p>
        <h2 class="font-serif text-3xl md:text-4xl font-black text-emerald-950 leading-tight mb-6">
          {headline}
        </h2>
        <div class="space-y-4 text-lg text-emerald-900/75 leading-relaxed max-w-prose">
          {body.map((p) => <p set:html={p} />)}
        </div>
      </div>

      <!-- List column -->
      <ul class:list={['space-y-5', reversed ? 'order-2 lg:order-1' : '']}>
        {
          trustPoints.map((point) => (
            <li class="flex items-start gap-3 text-lg text-slate-700 font-medium">
              <svg
                class={`w-5 h-5 shrink-0 mt-0.5 ${checkColor}`}
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              {point}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
