---
// src/pages/about/_components/AboutMission.astro
import Section from '../../../components/ui/Section.astro';
import EyebrowText from '../../../components/ui/EyebrowText.astro';
---

<Section
  class="py-12 md:py-24 lg:py-32 bg-emerald-950 relative overflow-hidden text-left md:text-center"
>
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] border border-white/5 rounded-full pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] border border-white/10 rounded-full pointer-events-none"
    aria-hidden="true"
  >
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 relative z-10">
    <EyebrowText class="text-amber-500 mb-8">Our Mission</EyebrowText>

    <p
      class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium italic text-white leading-tight lg:leading-tight tracking-tight mb-16 text-balance mx-auto"
    >
      To ensure every Muslim child grows up with a <strong
        class="text-amber-400 not-italic font-bold">genuine love for the Quran</strong
      >, not a fear of it.
    </p>

    <!-- Updated justify-start md:justify-center to match the responsive text alignment -->
    <div class="flex flex-wrap items-center justify-start md:justify-center gap-3 lg:gap-4">
      <div
        class="inline-flex items-center gap-2.5 bg-white/5 border border-white/10 px-5 py-2.5 rounded-full text-sm font-semibold text-emerald-50 backdrop-blur-sm shadow-sm"
      >
        <svg
          class="w-5 h-5 text-amber-500"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
          ></path>
        </svg>
        Empathy-led teaching
      </div>

      <div
        class="inline-flex items-center gap-2.5 bg-white/5 border border-white/10 px-5 py-2.5 rounded-full text-sm font-semibold text-emerald-50 backdrop-blur-sm shadow-sm"
      >
        <svg
          class="w-5 h-5 text-amber-500"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
          ></path>
        </svg>
        Zero financial risk
      </div>

      <div
        class="inline-flex items-center gap-2.5 bg-white/5 border border-white/10 px-5 py-2.5 rounded-full text-sm font-semibold text-emerald-50 backdrop-blur-sm shadow-sm"
      >
        <svg
          class="w-5 h-5 text-amber-500"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 12a3 3 0 11-6 0 3 3 0 016 0zM2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
          ></path>
        </svg>
        Full parent transparency
      </div>

      <div
        class="inline-flex items-center gap-2.5 bg-white/5 border border-white/10 px-5 py-2.5 rounded-full text-sm font-semibold text-emerald-50 backdrop-blur-sm shadow-sm"
      >
        <svg
          class="w-5 h-5 text-amber-500"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
        One dedicated teacher, no rotating rosters
      </div>
    </div>
  </div>
</Section>
