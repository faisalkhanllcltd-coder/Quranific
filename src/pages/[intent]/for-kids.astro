---
// src/pages/[intent]/for-kids.astro
import Base from '../../layouts/Base.astro';
import Button from '../../components/ui/Button.astro';
import { SITE } from '../../constants/site';
import { TESTIMONIALS_DATA } from '../../constants/testimonials';

export const prerender = true;

export function getStaticPaths() {
  return [{ params: { intent: 'quran-classes' } }, { params: { intent: 'quran-teacher' } }];
}

const { intent } = Astro.params;

type Intent = 'quran-classes' | 'quran-teacher';

// 90/10 Split: dynamic hero copy per intent, everything else static
const intentCopy: Record<
  Intent,
  { h1: string; subhead: string; seoTitle: string; seoDesc: string }
> = {
  'quran-classes': {
    h1: 'A Quran Class Your Child Actually Looks Forward To',
    subhead:
      "1-on-1 online classes for kids, taught by vetted teachers who know how to hold a child's attention. First class free.",
    seoTitle: 'Online Quran Classes for Kids | 1-on-1, Vetted Teachers | Quranific',
    seoDesc:
      '1-on-1 online Quran classes for kids with vetted, patient teachers. Tajweed, Qaida, and Hifz. First class free — no card required.',
  },
  'quran-teacher': {
    h1: 'Find a Quran Teacher Your Child Actually Connects With',
    subhead:
      'Every teacher passes a 4-stage vetting process before meeting your child. Match with the right one, risk-free, starting with a free first class.',
    seoTitle: 'Find a Quran Teacher for Kids | Vetted, 1-on-1, Online | Quranific',
    seoDesc:
      "Find a vetted 1-on-1 Quran teacher for your child. 4-stage vetting, safeguarding-checked, matched to your child's level. First class free.",
  },
};

const copy = intentCopy[intent as Intent];

// SEO Shield: canonical always points to master quran-classes URL
const canonicalUrl = `${SITE.url}/quran-classes/for-kids`;

// Testimonials: all 3 targeted entries — child engagement + teacher trust
const kidsTestimonials = TESTIMONIALS_DATA.filter((t) =>
  ['Amna', 'Saleem Al Mustarshid', 'Naseerullah Babar'].includes(t.name)
);

const vettingSteps = [
  {
    n: '01',
    title: 'Ijazah Verification',
    body: 'We confirm the teacher holds a valid chain of Ijazah — a certified lineage of Quranic transmission. No exceptions.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>`,
  },
  {
    n: '02',
    title: 'Live Recitation Assessment',
    body: 'Our academic team conducts a live Tajweed assessment. Not a CV review — an actual recitation, evaluated to professional standards.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>`,
  },
  {
    n: '03',
    title: 'Teaching Methodology Interview',
    body: "We probe specifically for child-teaching ability: how do they explain a concept when a child doesn't understand? How do they keep an 8-year-old engaged after 15 minutes? Concrete answers only.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  },
  {
    n: '04',
    title: 'Full Safeguarding Check',
    body: 'Every teacher completes a formal safeguarding background check before they ever meet a student. This is non-negotiable and renewed annually.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>`,
  },
];

const trustPoints = [
  'Progress updates on request — always included, no extra fee',
  'Sit in on any session, announced or unannounced',
  'Direct teacher contact from your first class onward',
  'Safeguarding checks renewed annually — not a one-time box-tick',
];

const onboardingSteps = [
  {
    n: '1',
    title: 'Book your free class — no card required.',
    body: "Tell us your child's age, current Quran level, and when you're free. That's all we need to match you with the right teacher.",
  },
  {
    n: '2',
    title: 'Meet your teacher and start where your child is.',
    body: 'No placement test. No pressure. In the first session, the teacher listens before they teach — understanding where your child is starting from, what they enjoy, and how they learn.',
  },
  {
    n: '3',
    title: 'Watch your child want to come back for the next one.',
    body: "That's the whole point of the trial: not a sales pitch, a real first lesson. If your child isn't engaged, we'll find a better match — or we part ways, no hard feelings.",
  },
];

const guaranteeCards = [
  { label: 'Free first class', sub: 'No card required' },
  { label: '30-day refund', sub: 'If not satisfied, one email' },
  { label: 'Make-up guarantee', sub: 'Missed sessions rescheduled' },
];

const faqItems = [
  {
    q: 'How much does it cost?',
    a: 'From $40/month depending on session length and how often your child meets their teacher. Full pricing is transparent — no hidden fees.',
    link: { text: 'See full pricing →', href: '/tuition-fee' },
  },
  {
    q: 'What if I have more than one child?',
    a: "Sibling discounts apply automatically: 10% off your second child, 20% off your third. No need to ask — it's applied at checkout.",
  },
  {
    q: "What if the schedule doesn't fit?",
    a: 'Classes run 24/7 across time zones. You set the frequency, and you can adjust it any time — no penalty, no process.',
  },
  {
    q: 'What happens if we wait?',
    a: "Nothing happens to us. But the earlier a child starts building a real relationship with Tajweed, the more natural it becomes. Patterns formed young are patterns that last. The free trial costs nothing to find out if now's the right time.",
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: copy.seoTitle,
  description: copy.seoDesc,
  url: canonicalUrl,
};
---

<Base
  title={copy.seoTitle}
  description={copy.seoDesc}
  robots="noindex, follow"
  canonical={canonicalUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline slot="head" />

  <div class="bg-cream-50 antialiased">
    <!-- ════════════════════════════════════════════════════════════
         § 1  HERO
         Split layout: copy left, trust card right (desktop)
         ═══════════════════════════════════════════════════════════ -->
    <section class="relative overflow-hidden border-b border-emerald-100">
      <!-- Dot grid -->
      <div
        class="absolute inset-0 bg-[radial-gradient(#d1fae5_1px,transparent_1px)] [background-size:20px_20px] opacity-50 pointer-events-none"
        aria-hidden="true"
      >
      </div>
      <!-- Glow blob -->
      <div
        class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[500px] bg-emerald-400/10 blur-[140px] rounded-full pointer-events-none"
        aria-hidden="true"
      >
      </div>

      <div class="quranific-container relative z-10 py-8">
        <!-- Minimal ad-lander header: logo only, no nav -->
        <header class="mb-14 md:mb-20">
          <a
            href="/"
            class="inline-flex items-center gap-1 font-serif font-black text-xl text-emerald-950 hover:opacity-70 transition-opacity"
          >
            Quranific<span class="text-emerald-600">.</span>
          </a>
        </header>

        <div
          class="grid lg:grid-cols-[1fr_400px] gap-12 xl:gap-20 items-center pb-16 sm:pb-20 lg:pb-24"
        >
          <!-- Left: headline + CTAs -->
          <div>
            <div
              class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-100 border border-emerald-200 text-emerald-800 text-xs font-bold uppercase tracking-widest mb-6"
            >
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              Free First Class · No Card Required
            </div>

            <!-- Dynamic H1 -->
            <h1
              class="font-serif text-4xl sm:text-5xl lg:text-6xl font-black text-emerald-950 leading-[1.06] tracking-tight mb-5"
            >
              {copy.h1}
            </h1>

            <!-- Dynamic Subhead -->
            <p
              class="text-xl md:text-2xl text-emerald-800/75 font-medium leading-relaxed mb-4 max-w-xl"
            >
              {copy.subhead}
            </p>

            <!-- Price anchor -->
            <p class="text-sm font-semibold text-emerald-700/60 mb-8 uppercase tracking-wide">
              From <strong class="text-emerald-900">$40/mo</strong> ·
              <a
                href="/tuition-fee"
                class="underline underline-offset-2 hover:text-emerald-700 transition-colors"
                >Full pricing</a
              >
            </p>

            <!-- CTAs — use Button component for site consistency -->
            <div class="flex flex-col sm:flex-row gap-3 mb-8">
              <Button
                href={`/funnel/signup?source=ad_kids_${intent}`}
                data-track-cta
                variant="primary"
                class="px-6 py-3 text-sm font-semibold shadow-lg shadow-emerald-900/10"
              >
                Book Your Child's Free Class
              </Button>
              <Button
                href={SITE.whatsappLink}
                target="_blank"
                rel="noopener noreferrer"
                variant="ghost"
                class="px-6 py-3 text-sm font-semibold"
              >
                <svg
                  class="w-5 h-5 mr-2 shrink-0 text-[#25D366]"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
                  ></path>
                </svg>
                Chat on WhatsApp
              </Button>
            </div>

            <!-- Microtrust strip -->
            <div class="flex flex-wrap gap-x-5 gap-y-1.5 text-sm text-emerald-800/60 font-medium">
              {
                [
                  '✓ No credit card',
                  '✓ Cancel anytime',
                  '✓ Full-month refund guarantee',
                  '✓ Safeguarding-checked teachers',
                ].map((b) => <span>{b}</span>)
              }
            </div>
          </div>

          <!-- Right: floating trust card -->
          <div class="hidden lg:block">
            <div class="bg-white border border-emerald-100 rounded-2xl shadow-xl p-8">
              <div class="flex gap-1 mb-3" aria-hidden="true">
                {
                  Array(5)
                    .fill(null)
                    .map(() => (
                      <svg
                        class="w-5 h-5 text-gold-400"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                    ))
                }
              </div>
              <p class="text-sm font-semibold text-emerald-950 mb-0.5">
                Trusted by families worldwide
              </p>
              <p class="text-sm text-emerald-700/60 mb-6">
                Verified enrolled families across 20+ countries
              </p>

              <div class="space-y-3 border-t border-emerald-50 pt-6">
                <p class="text-sm font-semibold text-emerald-950">Trusted by families worldwide</p>
                <p class="text-sm text-emerald-700/60">UK · USA · UAE · Australia · Canada</p>
                <p class="text-sm text-emerald-700/60">
                  Vetted teachers · 4-stage vetting · Safeguarding-checked
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         § 2  PROBLEM — Acknowledge the friction before selling
         ═══════════════════════════════════════════════════════════ -->
    <section class="quranific-section bg-white border-b border-emerald-50">
      <div class="quranific-container">
        <div class="max-w-3xl">
          <p class="text-xs font-bold uppercase tracking-widest text-emerald-600 mb-4">
            The Honest Problem
          </p>
          <h2
            class="font-serif text-3xl md:text-4xl font-black text-emerald-950 leading-tight mb-8"
          >
            Finding a good Quran teacher is harder than it should be.
          </h2>
          <div class="space-y-5 text-lg text-emerald-900/75 leading-relaxed">
            <p>
              Between school, homework, and everything else, finding time for a proper Quran teacher
              is hard enough. Finding a <em>good</em> one — patient, qualified, actually able to hold
              a child's attention — is harder.
            </p>
            <p>
              Group classes move too fast or too slow. Local tutors are booked solid or hard to vet.
              And screen time already feels like enough of a battle without adding another video
              call your child dreads.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         § 3  OUTCOME — Paint the picture before the mechanism
         ═══════════════════════════════════════════════════════════ -->
    <section class="quranific-section bg-emerald-950">
      <div class="quranific-container">
        <div class="max-w-3xl">
          <p class="text-xs font-bold uppercase tracking-widest text-emerald-400 mb-4">
            Six Months From Now
          </p>
          <h2 class="font-serif text-3xl md:text-4xl font-black text-white leading-tight mb-6">
            This doesn't have to be a chore anymore.
          </h2>
          <p class="text-xl text-emerald-100/85 leading-relaxed mb-4">
            Picture your child reading with real confidence, correcting their own Tajweed,
            <strong class="text-white">asking to show you what they learned</strong> instead of being
            reminded to log on.
          </p>
          <p class="text-lg text-emerald-100/65 leading-relaxed">
            That's the actual goal — not attendance. Understanding.
          </p>
        </div>

        <!-- OUTCOME IMAGE placeholder -->
        <div
          class="mt-10 max-w-2xl bg-emerald-900/50 border border-emerald-700/30 rounded-2xl aspect-[16/7] flex items-center justify-center text-emerald-400/50 text-sm font-medium"
        >
          [ASSET: Outcome/aspiration photo — child reading Quran confidently]
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         § 4  MECHANISM — 4-Stage Vetting + Why 1-on-1
         ═══════════════════════════════════════════════════════════ -->
    <section class="quranific-section bg-white border-b border-emerald-50">
      <div class="quranific-container">
        <div class="max-w-3xl mb-12">
          <p class="text-xs font-bold uppercase tracking-widest text-emerald-600 mb-4">
            Why It Works
          </p>
          <h2 class="font-serif text-3xl md:text-4xl font-black text-emerald-950 leading-tight">
            Every teacher passes a 4-stage vetting process.
          </h2>
        </div>

        <ol class="grid sm:grid-cols-2 gap-6 mb-10">
          {
            vettingSteps.map(({ title, body, icon }) => (
              <li class="bg-cream-50 border border-emerald-100 rounded-2xl p-7">
                <div class="flex items-center gap-4 mb-4">
                  <div class="flex-shrink-0 w-10 h-10 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center">
                    <Fragment set:html={icon} />
                  </div>
                </div>
                <p class="font-bold text-emerald-950 text-lg mb-2">{title}</p>
                <p class="text-emerald-800/70 leading-relaxed text-base">{body}</p>
              </li>
            ))
          }
        </ol>

        <!-- Why 1-on-1 callout -->
        <div class="bg-gold-50 border border-gold-200 rounded-2xl p-7 max-w-3xl">
          <p class="font-bold text-gold-700 text-base mb-2">
            Why 1-on-1 matters for kids specifically
          </p>
          <p class="text-gold-700/80 leading-relaxed">
            Group Zoom classes fail children because one teacher cannot actually <em>see</em> one child.
            In a group, the pace is set by the slowest or fastest kid — not yours. Every Quranific session
            is 1-on-1, every time, so <strong class="text-gold-800"
              >the pace is set by your child</strong
            >.
          </p>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         § 5  VIDEO PREVIEW — Social proof via real session footage
         ═══════════════════════════════════════════════════════════ -->
    <section class="quranific-section bg-emerald-950 border-b border-emerald-800">
      <div class="quranific-container">
        <div class="max-w-3xl mb-8">
          <p class="text-xs font-bold uppercase tracking-widest text-emerald-400 mb-4">
            Real Session Preview
          </p>
          <h2 class="font-serif text-2xl md:text-3xl font-black text-white leading-tight">
            See what a real class looks like.
          </h2>
        </div>

        <!-- VIDEO PLACEHOLDER -->
        <!-- VISUAL: 30-45 second screen recording of live session — tutor shared Mushaf, child webcam reacting -->
        <div
          class="max-w-3xl bg-emerald-900/60 border border-emerald-700/40 rounded-2xl aspect-video flex flex-col items-center justify-center gap-3 mb-4"
        >
          <div class="w-14 h-14 rounded-full bg-emerald-700/50 flex items-center justify-center">
            <svg
              class="w-7 h-7 text-emerald-300"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M8 5v14l11-7z"></path>
            </svg>
          </div>
          <p class="text-emerald-400/60 text-sm font-medium">
            [ASSET: 30-45s live session recording — tutor + student webcam]
          </p>
        </div>
        <p class="text-emerald-300/60 text-sm italic max-w-3xl">
          This is what a real class looks like — not a demo.
        </p>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         § 6  TRUST / TRANSPARENCY — Remove hidden-cost anxiety
         ═══════════════════════════════════════════════════════════ -->
    <section class="quranific-section bg-white border-b border-emerald-50">
      <div class="quranific-container">
        <div class="grid lg:grid-cols-2 gap-12 xl:gap-20 items-center">
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-emerald-600 mb-4">
              Full Transparency
            </p>
            <h2
              class="font-serif text-3xl md:text-4xl font-black text-emerald-950 leading-tight mb-6"
            >
              You don't need to hover over every session.
            </h2>
            <p class="text-lg text-emerald-900/75 leading-relaxed mb-4">
              Ask your teacher for a progress update any time. Nothing is hidden, nothing is locked
              behind a subscription tier.
            </p>
            <p class="text-lg text-emerald-900/75 leading-relaxed">
              Every teacher is safeguarding-checked before they ever meet your child, and
              <strong class="text-emerald-950">
                you can sit in on any class, any time — no notice needed.</strong
              >
            </p>
          </div>

          <ul class="space-y-4">
            {
              trustPoints.map((point) => (
                <li class="flex items-start gap-3 text-base text-emerald-950 font-medium">
                  <svg
                    class="w-5 h-5 shrink-0 text-emerald-600 mt-0.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  {point}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         § 7  ONBOARDING — Make the first step feel trivially small
         ═══════════════════════════════════════════════════════════ -->
    <section class="quranific-section bg-emerald-50 border-b border-emerald-100">
      <div class="quranific-container">
        <div class="max-w-3xl mb-10">
          <p class="text-xs font-bold uppercase tracking-widest text-emerald-600 mb-4">
            How It Works
          </p>
          <h2 class="font-serif text-3xl md:text-4xl font-black text-emerald-950 leading-tight">
            Three steps. The third one is the point.
          </h2>
        </div>

        <ol class="grid md:grid-cols-3 gap-6 max-w-5xl">
          {
            onboardingSteps.map(({ n, title, body }) => (
              <li class="bg-white border border-emerald-100 rounded-2xl p-7 shadow-sm">
                <div class="w-10 h-10 rounded-full bg-emerald-600 text-white font-black text-base flex items-center justify-center mb-5">
                  {n}
                </div>
                <p class="font-bold text-emerald-950 text-lg leading-snug mb-3">{title}</p>
                <p class="text-emerald-800/65 leading-relaxed text-sm">{body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════════
         § 8  TESTIMONIALS — Specific proof, specific names
         Imported from src/constants/testimonials.ts
         ═══════════════════════════════════════════════════════════ -->
