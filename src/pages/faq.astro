---
// src/pages/faq.astro
import Base from '../layouts/Base.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import { faqs } from '../data/faqs';

const tabCategories = [
  { id: 'home', label: 'Top Questions' },
  { id: 'pricing', label: 'Pricing & Refunds' },
  { id: 'courses', label: 'Curriculum' },
  { id: 'teachers', label: 'Our Teachers' },
  { id: 'safeguarding', label: 'Safety & Privacy' },
  { id: 'technical', label: 'Technical' },
  { id: 'general', label: 'General' },
];

// --- 110% SEO: DYNAMIC GOOGLE FAQ SCHEMA ---
// This automatically transforms your array into Google's required Rich Snippet format.
const allFaqs = Object.values(faqs).flat();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFaqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer.replace(/<[^>]*>?/gm, ''), // Strips HTML tags just for the schema
    },
  })),
};

const Icons = {
  support: `<svg class="w-8 h-8 text-emerald-950" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>`,
};
---

<Base
  title="Frequently Asked Questions | Quranific"
  description="Got questions about learning the Quran online? Find answers about our tutors, pricing, scheduling, and our 1-month money-back guarantee."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" is:inline />

  <Header />

  <main
    class="min-h-screen bg-gradient-to-b from-cream-50 to-white selection:bg-emerald-200 selection:text-emerald-950 overflow-hidden pt-16 md:pt-32 pb-12 md:pb-24 lg:pt-40 lg:pb-32"
  >
    <div
      class="absolute top-0 right-1/4 w-[800px] h-[500px] bg-emerald-500/5 rounded-full blur-[120px] pointer-events-none"
      aria-hidden="true"
    >
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
      <div
        class="text-center mb-16 lg:mb-20 animate-in fade-in slide-in-from-bottom-6 duration-1000"
      >
        <span
          class="inline-flex items-center gap-2 px-4 py-1.5 bg-emerald-50 text-emerald-800 text-xs font-bold tracking-widest uppercase rounded-full mb-6 border border-emerald-100 shadow-sm"
        >
          Support Center
        </span>

        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-black text-emerald-950 mb-6 tracking-tighter leading-tight text-balance"
        >
          Got Questions?<br />We've Got Answers.
        </h1>

        <p
          class="text-lg text-emerald-800/80 font-medium max-w-xl mx-auto leading-relaxed text-balance"
        >
          Everything you need to know about starting your Quranic journey, our elite tutors, and how
          our platform works.
        </p>
      </div>

      <Section
        height={800}
        class="animate-in fade-in slide-in-from-bottom-8 duration-700 delay-150"
      >
        {/* TAB BUTTONS */}
        <div class="flex overflow-x-auto gap-2 no-scrollbar mb-8 pb-2">
          {
            tabCategories.map((category) => (
              <button
                data-tab-target={category.id}
                class={`whitespace-nowrap px-6 py-2.5 rounded-full font-semibold text-sm transition-colors border ${
                  category.id === 'home'
                    ? 'bg-emerald-600 text-white border-emerald-600'
                    : 'bg-white text-emerald-900 border-emerald-200 hover:bg-emerald-50'
                }`}
              >
                {category.label}
              </button>
            ))
          }
        </div>

        {/* TAB PANELS */}
        <div>
          {
            tabCategories.map((category) => (
              <div data-tab-panel={category.id} class={category.id === 'home' ? 'block' : 'hidden'}>
                <FAQAccordion hideLeftColumn={true} questions={faqs[category.id] || []} />
              </div>
            ))
          }
        </div>
      </Section>

      <Section
        height={300}
        class="max-w-3xl mx-auto mt-20 lg:mt-24 animate-in fade-in slide-in-from-bottom-8 duration-700 delay-300"
      >
        <div
          class="bg-gradient-to-br from-emerald-900 to-emerald-950 rounded-3xl p-8 lg:p-12 text-center shadow-xl border border-emerald-800 relative overflow-hidden flex flex-col items-center"
        >
          <div
            class="w-16 h-16 bg-amber-400 rounded-full flex items-center justify-center mb-6 shadow-inner relative z-10"
            aria-hidden="true"
          >
            <span set:html={Icons.support} />
          </div>

          <h2 class="text-2xl lg:text-3xl font-bold text-white mb-3 relative z-10">
            Still have a question?
          </h2>
          <p class="text-emerald-100/80 mb-8 font-medium max-w-md relative z-10">
            Our support team is available 24/7 to help you figure out the best learning path for
            your family.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 relative z-10 w-full sm:w-auto">
            <Button href="/contact" variant="primaryDark" class="w-full sm:w-auto">
              Contact Support
            </Button>
            <Button href="/funnel/signup" variant="ghostDark" class="w-full sm:w-auto">
              Book Your Free Class
            </Button>
          </div>

          <div
            class="absolute top-0 right-0 w-64 h-64 bg-emerald-500/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none"
            aria-hidden="true"
          >
          </div>
        </div>
      </Section>
    </div>
  </main>

  <Footer />

  <script is:inline>
    // Lightweight Tab Switching Logic
    document.addEventListener('astro:page-load', () => {
      const tabs = document.querySelectorAll('[data-tab-target]');
      const panels = document.querySelectorAll('[data-tab-panel]');

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const targetId = tab.getAttribute('data-tab-target');

          // Reset all tabs to inactive state
          tabs.forEach((t) => {
            t.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600');
            t.classList.add(
              'bg-white',
              'text-emerald-900',
              'border-emerald-200',
              'hover:bg-emerald-50'
            );
          });

          // Set clicked tab to active state
          tab.classList.remove(
            'bg-white',
            'text-emerald-900',
            'border-emerald-200',
            'hover:bg-emerald-50'
          );
          tab.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');

          // Hide all panels
          panels.forEach((p) => p.classList.add('hidden'));

          // Show the target panel
          const targetPanel = document.querySelector(`[data-tab-panel="${targetId}"]`);
          if (targetPanel) {
            targetPanel.classList.remove('hidden');
          }
        });
      });
    });
  </script>
</Base>
