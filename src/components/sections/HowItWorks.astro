---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';

export const howTo = [
  {
    name: 'Book your free class',
    text: "Fill in a short form: your child's age, level, and your preferred time slots. No credit card. Takes 2 minutes.",
  },
  {
    name: 'We match the perfect teacher',
    text: "Our team hand-selects a teacher based on your child's age, personality notes, and level. Within 24 hours, you'll receive their profile and a confirmed session time.",
  },
  {
    name: 'Watch them fall in love',
    text: "Your child joins their private session on a secure link. You'll receive a progress report after every class. Most parents notice a difference within the first two weeks.",
  },
];

const CheckIcon = `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>`;
---

<Section
  height={800}
  class="py-10 md:py-20 lg:py-32 bg-white border-b border-emerald-50"
  id="how-it-works"
  aria-labelledby="how-it-works-heading"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 overflow-hidden">
    <div class="grid lg:grid-cols-[1.1fr_1fr] gap-12 lg:gap-16 items-center">
      <div class="min-w-0">
        <div
          class="inline-flex items-center justify-center gap-2 px-4 py-1.5 bg-emerald-50 border border-emerald-100 text-emerald-700 text-[11px] font-bold uppercase tracking-widest rounded-full mb-6"
        >
          Three Simple Steps
        </div>
        <h2
          id="how-it-works-heading"
          class="text-4xl lg:text-5xl font-semibold text-emerald-950 mb-6 tracking-tight leading-tight"
        >
          Starting is <br /><em class="text-emerald-700 not-italic">simpler than you think.</em>
        </h2>
        <p class="text-lg text-emerald-900/80 font-medium mb-12 max-w-lg">
          From booking to first lesson in under 24 hours. No paperwork. No long commitments. No
          anxiety.
        </p>

        <ol class="space-y-10 relative" role="list">
          <div
            class="absolute left-[1.375rem] top-[3rem] bottom-[3rem] w-0.5 bg-gradient-to-b from-emerald-200 to-transparent hidden sm:block"
            aria-hidden="true"
          >
          </div>

          {
            howTo.map((step, idx) => (
              <li class="flex gap-6 relative z-10 group">
                <div
                  class="w-12 h-12 rounded-full border-2 border-emerald-200 bg-white text-emerald-700 font-bold flex items-center justify-center shrink-0 transition-colors duration-300 ease-in-out group-hover:bg-emerald-700 group-hover:text-white group-hover:border-emerald-700"
                  aria-hidden="true"
                >
                  {idx + 1}
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="font-bold text-xl text-emerald-950 mb-2">{step.name}</h3>
                  <p class="text-[15px] font-medium text-emerald-800/80 leading-relaxed mb-3">
                    {step.text}
                  </p>
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-emerald-50 text-emerald-700 text-[11px] font-bold uppercase tracking-wider rounded-full">
                    <svg
                      class="w-3.5 h-3.5"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                      />
                    </svg>
                    {idx === 0 ? '2 minutes' : idx === 1 ? 'Within 24 hours' : 'From week 1'}
                  </span>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <div
        class="bg-cream-50 border border-emerald-100 rounded-[2rem] p-6 sm:p-8 shadow-xl shadow-emerald-900/5 w-full min-w-0"
        aria-label="Sample weekly schedule for Yusuf, age 9"
      >
        <div class="text-[11px] font-bold uppercase tracking-widest text-emerald-900/60 mb-6">
          This week's schedule: Yusuf, age 9
        </div>
        <ul class="space-y-3 mb-8" role="list">
          <li
            class="bg-white border border-emerald-100 rounded-2xl p-4 flex items-center gap-4 transition-colors hover:border-emerald-200"
          >
            <div
              class="w-12 text-center text-xs font-bold text-emerald-900/40 shrink-0"
              aria-hidden="true"
            >
              MON
            </div>
            <div
              class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold shrink-0"
              aria-hidden="true"
              set:html={CheckIcon}
            />
            <div class="flex-1 min-w-0">
              <div class="font-bold text-emerald-950 text-sm truncate">Taj Session</div>
              <div class="text-[13px] font-medium text-emerald-800/70 truncate">
                Ustadha Fatima · 4:30 PM
              </div>
            </div>
            <div
              class="hidden sm:block px-2.5 py-1 bg-emerald-50 text-emerald-700 text-[10px] font-bold rounded-full border border-emerald-200"
            >
              Done
            </div>
          </li>

          <li
            class="bg-white border border-emerald-100 rounded-2xl p-4 flex items-center gap-4 transition-colors hover:border-emerald-200"
          >
            <div
              class="w-12 text-center text-xs font-bold text-emerald-900/40 shrink-0"
              aria-hidden="true"
            >
              WED
            </div>
            <div
              class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold shrink-0"
              aria-hidden="true"
              set:html={CheckIcon}
            />
            <div class="flex-1 min-w-0">
              <div class="font-bold text-emerald-950 text-sm truncate">Memorisation</div>
              <div class="text-[13px] font-medium text-emerald-800/70 truncate">
                Ustadha Fatima · 4:30 PM
              </div>
            </div>
            <div
              class="hidden sm:block px-2.5 py-1 bg-emerald-50 text-emerald-700 text-[10px] font-bold rounded-full border border-emerald-200"
            >
              Done
            </div>
          </li>

          <li
            class="bg-emerald-700/5 border-2 border-emerald-700 rounded-2xl p-4 flex items-center gap-4 relative shadow-sm"
          >
            <div
              class="w-12 text-center text-xs font-bold text-emerald-700 shrink-0"
              aria-hidden="true"
            >
              FRI
            </div>
            <div
              class="w-10 h-10 rounded-xl bg-emerald-700 text-white flex items-center justify-center shrink-0 relative"
              aria-hidden="true"
            >
              <span class="absolute -top-1 -right-1 flex h-3 w-3">
                <span class="relative inline-flex rounded-full h-3 w-3 bg-amber-500"></span>
              </span>
              <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
                ></path></svg
              >
            </div>
            <div class="flex-1 min-w-0">
              <div class="font-bold text-emerald-950 text-sm truncate">Revision</div>
              <div class="text-[13px] font-medium text-emerald-800/70 truncate">
                Ustadha Fatima · 4:30 PM
              </div>
            </div>
            <div
              class="hidden sm:block px-2.5 py-1 bg-[#f0fdf4] text-[#16a34a] border border-[#bbf7d0] text-[10px] font-bold rounded-full"
            >
              Live
            </div>
          </li>

          <li
            class="bg-white border border-emerald-100 border-dashed rounded-2xl p-4 flex items-center gap-4"
          >
            <div
              class="w-12 text-center text-xs font-bold text-emerald-900/40 shrink-0"
              aria-hidden="true"
            >
              SAT
            </div>
            <div
              class="w-10 h-10 rounded-xl bg-white border border-emerald-100 text-emerald-700 flex items-center justify-center shrink-0"
              aria-hidden="true"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                ></path></svg
              >
            </div>
            <div class="flex-1 min-w-0">
              <div class="font-bold text-emerald-950 text-sm truncate">Make-up class</div>
              <div class="text-[13px] font-medium text-emerald-800/70 truncate">
                For Monday's session
              </div>
            </div>
          </li>
        </ul>

        <div
          class="bg-emerald-950 rounded-2xl p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
        >
          <div class="min-w-0">
            <div class="text-white font-bold text-[15px] mb-1">Ready to build this?</div>
            <div class="text-emerald-100/70 text-[13px] font-medium">First class is free.</div>
          </div>
          <Button href="/funnel/signup" variant="secondary" class="w-full sm:w-auto">
            Start Trial →
          </Button>
        </div>
      </div>
    </div>
  </div>
</Section>
