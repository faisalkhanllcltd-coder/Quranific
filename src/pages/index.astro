---
// src/pages/index.astro
import Base from '../layouts/Base.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import HomeHero from '../components/sections/HomeHero.astro';
import TestimonialGrid from '../components/sections/TestimonialGrid.astro';
import { testimonials } from '../data/testimonials';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import { faqs } from '../data/faqs';
import FinalCTA from '../components/sections/FinalCTA.astro';
import PainPoints from '../components/sections/PainPoints.astro';
import QuranificDifference from '../components/sections/QuranificDifference.astro';
import HowItWorks, { howTo } from '../components/sections/HowItWorks.astro';

import { SITE } from '../constants/site';

const PAGE_CONTENT = {
  hero: {
    badgeText: 'Now enrolling · Limited spots',
    title: 'The Quran class your child',
    highlightWord: 'actually looks forward to.',
    subtitle:
      'No crowded mosque classes. No harsh methods. No guilt. Just a gentle, qualified teacher, one child, and 30 minutes that might change everything.',
    primaryCtaText: 'Book Your Free Class',
    primaryCtaLink: '/funnel/signup',
  },
};

// Elite Edge SEO: Deep Semantic JSON-LD
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': ['WebSite', 'EducationalOrganization'],
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${SITE.url}/courses?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      url: SITE.whatsappLink,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.home.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'How to start learning Quran with Quranific',
    description: 'Start your personalized 1-on-1 online Quran classes in three simple steps.',
    step: howTo.map((step, index) => ({
      '@type': 'HowToStep',
      position: index + 1,
      name: step.name,
      text: step.text,
    })),
  },
];
---

<Base title={SITE.title} description={SITE.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <Header />

  <main
    id="main-content"
    class="bg-cream-50 selection:bg-emerald-200 selection:text-emerald-950 font-sans"
  >
    <HomeHero
      title={PAGE_CONTENT.hero.title}
      highlightWord={PAGE_CONTENT.hero.highlightWord}
      subtitle={PAGE_CONTENT.hero.subtitle}
      primaryCtaLink={PAGE_CONTENT.hero.primaryCtaLink}
    />

    <PainPoints />

    <QuranificDifference />

    <TestimonialGrid testimonials={testimonials} />

    <HowItWorks />

    <FAQAccordion questions={faqs.home} />

    <FinalCTA />
  </main>

  <Footer />
</Base>
