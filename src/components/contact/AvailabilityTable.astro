---
import Section from '../ui/Section.astro';

const Icons = {
  wa: `<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>`,
  mail: `<svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
  form: `<svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`,
};
---

<!-- ─── AVAILABILITY TABLE ─────────────────────────────────────────────── -->
<Section height={500} class="py-12 md:py-24 bg-white border-y border-emerald-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-[1.2fr_1fr] gap-16 lg:gap-20 items-start">
      <div>
        <span class="text-xs font-black tracking-widest uppercase text-emerald-700 block mb-3"
          >Availability</span
        >
        <h2
          class="text-3xl lg:text-4xl font-bold text-emerald-950 mb-4 tracking-tight leading-tight"
        >
          When you can <em class="font-serif italic text-emerald-700 font-medium"
            >expect a reply.</em
          >
        </h2>
        <p class="text-[15px] text-emerald-800/80 font-medium mb-8 max-w-md">
          We are a remote-first team spread across multiple timezones. This means someone is almost
          always online, but here is the honest breakdown.
        </p>

        <div class="border border-emerald-100 rounded-2xl overflow-hidden mb-6" id="utc-table">
          <div
            class="flex justify-between items-center px-6 py-4 border-b border-emerald-50 bg-cream-50"
            data-day="Monday"
          >
            <div class="font-bold text-emerald-950 text-sm flex items-center gap-3">
              Monday <span
                class="hidden px-2 py-0.5 bg-emerald-700 text-white text-[10px] uppercase tracking-widest rounded-full today-badge"
                >Today</span
              >
            </div>
            <div class="text-[13px] font-medium text-green-600">7:00 AM – 10:00 PM UTC</div>
          </div>
          <div
            class="flex justify-between items-center px-6 py-4 border-b border-emerald-50 bg-white"
            data-day="Tuesday"
          >
            <div class="font-bold text-emerald-950 text-sm flex items-center gap-3">
              Tuesday <span
                class="hidden px-2 py-0.5 bg-emerald-700 text-white text-[10px] uppercase tracking-widest rounded-full today-badge"
                >Today</span
              >
            </div>
            <div class="text-[13px] font-medium text-green-600">7:00 AM – 10:00 PM UTC</div>
          </div>
          <div
            class="flex justify-between items-center px-6 py-4 border-b border-emerald-50 bg-cream-50"
            data-day="Wednesday"
          >
            <div class="font-bold text-emerald-950 text-sm flex items-center gap-3">
              Wednesday <span
                class="hidden px-2 py-0.5 bg-emerald-700 text-white text-[10px] uppercase tracking-widest rounded-full today-badge"
                >Today</span
              >
            </div>
            <div class="text-[13px] font-medium text-green-600">7:00 AM – 10:00 PM UTC</div>
          </div>
          <div
            class="flex justify-between items-center px-6 py-4 border-b border-emerald-50 bg-white"
            data-day="Thursday"
          >
            <div class="font-bold text-emerald-950 text-sm flex items-center gap-3">
              Thursday <span
                class="hidden px-2 py-0.5 bg-emerald-700 text-white text-[10px] uppercase tracking-widest rounded-full today-badge"
                >Today</span
              >
            </div>
            <div class="text-[13px] font-medium text-green-600">7:00 AM – 10:00 PM UTC</div>
          </div>
          <div
            class="flex justify-between items-center px-6 py-4 border-b border-emerald-50 bg-cream-50"
            data-day="Friday"
          >
            <div class="font-bold text-emerald-950 text-sm flex items-center gap-3">
              Friday <span
                class="hidden px-2 py-0.5 bg-emerald-700 text-white text-[10px] uppercase tracking-widest rounded-full today-badge"
                >Today</span
              >
            </div>
            <div class="text-[13px] font-medium text-green-600">7am–1pm · 3pm–10pm UTC</div>
          </div>
          <div
            class="flex justify-between items-center px-6 py-4 border-b border-emerald-50 bg-white"
            data-day="Saturday"
          >
            <div class="font-bold text-emerald-950 text-sm flex items-center gap-3">
              Saturday <span
                class="hidden px-2 py-0.5 bg-emerald-700 text-white text-[10px] uppercase tracking-widest rounded-full today-badge"
                >Today</span
              >
            </div>
            <div class="text-[13px] font-medium text-green-600">8:00 AM – 8:00 PM UTC</div>
          </div>
          <div
            class="flex justify-between items-center px-6 py-4 bg-cream-50 opacity-60"
            data-day="Sunday"
          >
            <div class="font-bold text-emerald-950 text-sm flex items-center gap-3">
              Sunday <span
                class="hidden px-2 py-0.5 bg-emerald-700 text-white text-[10px] uppercase tracking-widest rounded-full today-badge"
                >Today</span
              >
            </div>
            <div class="text-[13px] font-medium text-emerald-900">Closed · Catch-up only</div>
          </div>
        </div>

        <div
          class="bg-emerald-50 border border-emerald-100 rounded-xl p-5 text-[13px] text-emerald-900/80 font-medium"
        >
          <strong class="text-emerald-700">Not sure what UTC means for you?</strong> UK is UTC+0. UAE
          is UTC+4. USA East Coast is UTC-5. Australia is UTC+11.
        </div>
      </div>

      <div
        class="bg-cream-50 border border-emerald-100 rounded-[2rem] p-8 lg:p-10 shadow-xl shadow-emerald-900/5"
      >
        <h3 class="font-bold text-lg text-emerald-950 mb-1">Response time by channel</h3>
        <!-- F-2 FIX: Changed "Based on actual response data across the last 90 days" to an honest description. -->
        <p class="text-[13px] text-emerald-900/60 font-medium mb-8">
          Based on our team's operational targets
        </p>

        <div class="space-y-4 mb-8">
          <div class="bg-white border border-emerald-100 rounded-xl p-4 flex items-center gap-4">
            <div
              class="w-10 h-10 rounded-lg bg-green-50 border border-green-200 text-green-600 flex items-center justify-center shrink-0"
              aria-hidden="true"
            >
              <Fragment set:html={Icons.wa} />
            </div>
            <div class="flex-1">
              <div class="font-bold text-emerald-950 text-sm mb-1">WhatsApp</div>
              <div class="text-[11px] text-emerald-900/60 font-medium mb-2">
                Target: 12 minutes · Max: 1 hour
              </div>
              <div class="h-1.5 w-full bg-gray-100 rounded-full overflow-hidden">
                <div class="h-full bg-green-600 rounded-full w-[15%]"></div>
              </div>
            </div>
          </div>

          <div class="bg-white border border-emerald-100 rounded-xl p-4 flex items-center gap-4">
            <div
              class="w-10 h-10 rounded-lg bg-emerald-50 border border-emerald-100 text-emerald-700 flex items-center justify-center shrink-0"
              aria-hidden="true"
            >
              <Fragment set:html={Icons.form} />
            </div>
            <div class="flex-1">
              <div class="font-bold text-emerald-950 text-sm mb-1">Contact Form</div>
              <div class="text-[11px] text-emerald-900/60 font-medium mb-2">
                Target: 4 hours · Max: 24 hours
              </div>
              <div class="h-1.5 w-full bg-gray-100 rounded-full overflow-hidden">
                <div class="h-full bg-emerald-700 rounded-full w-[40%]"></div>
              </div>
            </div>
          </div>

          <div class="bg-white border border-emerald-100 rounded-xl p-4 flex items-center gap-4">
            <div
              class="w-10 h-10 rounded-lg bg-amber-50 border border-amber-200 text-amber-600 flex items-center justify-center shrink-0"
              aria-hidden="true"
            >
              <Fragment set:html={Icons.mail} />
            </div>
            <div class="flex-1">
              <div class="font-bold text-emerald-950 text-sm mb-1">Email</div>
              <div class="text-[11px] text-emerald-900/60 font-medium mb-2">
                Target: 8 hours · Max: 24 hours
              </div>
              <div class="h-1.5 w-full bg-gray-100 rounded-full overflow-hidden">
                <div class="h-full bg-amber-500 rounded-full w-[70%]"></div>
              </div>
            </div>
          </div>
        </div>

        <div
          class="bg-emerald-700 rounded-xl p-5 text-[13px] text-emerald-50/90 font-medium leading-relaxed"
        >
          <strong class="block text-white text-[15px] mb-1"
            >Our commitment: no message goes unanswered</strong
          >
          We reply to every single message we receive, including messages that arrive on Sundays, during
          Ramadan, and during holidays.
        </div>
      </div>
    </div>
  </div>
</Section>

<script>
  document.addEventListener('astro:page-load', () => {
    // --- 5. UTC TODAY HIGHLIGHTER ---
    const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    const today = days[new Date().getUTCDay()];

    document.querySelectorAll('#utc-table > div').forEach((row) => {
      if (row.getAttribute('data-day') === today) {
        const badge = row.querySelector('.today-badge');
        if (badge) badge.classList.remove('hidden');
        row.classList.remove('bg-white', 'bg-cream-50');
        row.classList.add('bg-green-50');
      }
    });
  });
</script>
