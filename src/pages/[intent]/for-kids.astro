---
// src/pages/[intent]/for-kids.astro
import Base from '../../layouts/Base.astro';
import HeroKids from './_components/HeroKids.astro';
import LandingProblem from '../../components/blocks/LandingProblem.astro';
import LandingOutcome from '../../components/blocks/LandingOutcome.astro';
import LandingVetting from '../../components/blocks/LandingVetting.astro';
import LandingPreview from '../../components/blocks/LandingPreview.astro';
import LandingTrust from '../../components/blocks/LandingTrust.astro';
import LandingOnboarding from '../../components/blocks/LandingOnboarding.astro';
import LandingTestimonials from '../../components/blocks/LandingTestimonials.astro';
import GuaranteeSection from '../../components/blocks/GuaranteeSection.astro';
import LandingPricing from '../../components/blocks/LandingPricing.astro';
import LandingFAQ from '../../components/blocks/LandingFAQ.astro';
import LandingCTA from '../../components/blocks/LandingCTA.astro';
import LandingFooter from '../../components/blocks/LandingFooter.astro';
import StickyMobileCTA from '../../components/blocks/StickyMobileCTA.astro';
import { SITE } from '../../constants/site';
import { Image } from 'astro:assets';
import teacherForKidsImg from '../../assets/images/quran-teacher-for-kids.webp';
import appKidsImg from '../../assets/images/app.quranific-quran-classes-for-kids.webp';
import { testimonials } from '../../data/testimonials';
import { faqs } from '../../data/faqs';
import { kidsVettingSteps, kidsTrustPoints, kidsOnboardingSteps } from '../../data/features';
import { generateWhatsAppLink } from '../../lib/helpers';

export const prerender = true;

export function getStaticPaths() {
  return [{ params: { intent: 'quran-classes' } }, { params: { intent: 'quran-teacher' } }];
}

const { intent } = Astro.params;

type Intent = 'quran-classes' | 'quran-teacher';

// 90/10 Split: dynamic hero copy per intent, everything else static
const intentCopy: Record<
  Intent,
  { h1: string; highlightWord: string; subhead: string; seoTitle: string; seoDesc: string }
> = {
  'quran-classes': {
    h1: 'The Quran class your child ',
    highlightWord: 'actually looks forward to.',
    subhead:
      "1-on-1 online classes for kids, taught by vetted teachers who know how to hold a child's attention. First class free.",
    seoTitle: 'Online Quran Classes for Kids | 1-on-1, Vetted Teachers | Quranific',
    seoDesc:
      '1-on-1 online Quran classes for kids with vetted, patient teachers. Tajweed, Qaida, and Hifz. First class free — no card required.',
  },
  'quran-teacher': {
    h1: 'Find a Quran teacher your child ',
    highlightWord: 'actually connects with.',
    subhead:
      'Every teacher passes a 4-stage vetting process before meeting your child. Match with the right one, risk-free, starting with a free first class.',
    seoTitle: 'Find a Quran Teacher for Kids | Vetted, 1-on-1, Online | Quranific',
    seoDesc:
      "Find a vetted 1-on-1 Quran teacher for your child. 4-stage vetting, safeguarding-checked, matched to your child's level. First class free.",
  },
};

const copy = intentCopy[intent as Intent];

// SEO Shield: canonical always points to master quran-classes URL
const canonicalUrl = `${SITE.url}/quran-classes/for-kids`;

// Testimonials: page-level filter — pre-filtered array passed to component
const kidsTestimonials = testimonials.filter((t) =>
  ['amna-de', 'saleem-uae', 'naseer-uk'].includes(t.id)
);

// Aliases for centralized data — eliminates in-page copy-paste
const vettingSteps = kidsVettingSteps;
const trustPoints = kidsTrustPoints;
const onboardingSteps = kidsOnboardingSteps;

const faqItems = (faqs.landingKids || []).map((item) => ({
  q: item.question,
  a: item.answer,
  link: item.link,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: copy.seoTitle,
  description: copy.seoDesc,
  url: canonicalUrl,
};
---

<Base
  title={copy.seoTitle}
  description={copy.seoDesc}
  robots="noindex, follow"
  canonical={canonicalUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline slot="head" />

  <div class="bg-cream-50 antialiased">
    <!-- § 1 HERO -->
    <HeroKids
      intent={intent as Intent}
      h1={copy.h1}
      highlightWord={copy.highlightWord}
      subhead={copy.subhead}
    />

    <!-- § 2 PROBLEM -->
    <LandingProblem
      eyebrow="The Honest Problem"
      headline="Finding a good Quran teacher is harder than it should be."
      body="Between school, homework, and everything else, finding time for a proper Quran teacher is hard enough. Finding a <em>good</em> one — patient, qualified, actually able to hold a child's attention — is harder."
      painPoints={[
        {
          title: 'Group Classes',
          text: 'Move too fast or too slow, making it impossible for your child to learn at their natural pace.',
        },
        {
          title: 'Local Tutors',
          text: 'Often booked solid, inconsistent, or frustratingly hard to properly vet for safeguarding.',
        },
        {
          title: 'Screen Time',
          text: 'Feels like enough of a daily battle without adding another boring video call your child dreads.',
        },
      ]}
      ctaLabel="Discuss your child's needs on WhatsApp"
      ctaHref={generateWhatsAppLink(
        "Hi, I'm looking for a better Quran teacher for my child and would like to discuss my options."
      )}
    />

    <!-- § 3 OUTCOME -->
    <LandingOutcome
      theme="dark"
      eyebrow="Six Months From Now"
      headline="This doesn't have to be a chore anymore."
      body={[
        'Picture your child reading with real confidence — not sounding out letters painfully, but recognizing patterns, applying Tajweed naturally, and actually wanting to show you what they practiced.',
        "That's the actual goal: a child who feels capable, not pressured. Not rushing to finish a checklist, but building a connection with the Quran that outlasts their lessons.",
      ]}
    >
      <div
        slot="media"
        class="relative w-full aspect-[4/3] lg:aspect-square rounded-[2rem] overflow-hidden shadow-[0_8px_30px_rgb(0,0,0,0.4)] ring-1 ring-white/10"
      >
        <Image
          src={teacherForKidsImg}
          alt="Child confidently reciting Quran with online teacher"
          class="relative z-20 rounded-2xl absolute inset-0 w-full h-full object-cover hover:scale-105 transition-transform duration-700 ease-out shadow-[0_8px_30px_rgb(0,0,0,0.4)]"
          loading="lazy"
          decoding="async"
        />
        <div
          class="absolute inset-0 border border-white/10 rounded-[2rem] z-10 pointer-events-none"
        >
        </div>
      </div>
    </LandingOutcome>

    <!-- § 4 MECHANISM / VETTING -->
    <LandingVetting
      steps={vettingSteps}
      headline="Every teacher passes a 4-stage vetting process."
      eyebrow="Why It Works"
      calloutTitle="Why 1-on-1 matters for kids specifically"
      calloutBody="Group Zoom classes fail children because one teacher cannot actually <em>see</em> one child. In a group, the pace is set by the slowest or fastest kid — not yours. Every Quranific session is 1-on-1, every time, so <strong class='text-emerald-950'>the pace is set by your child</strong>."
      theme="gold"
      accentColor="emerald"
    />

    <!-- § 5 LOOK INSIDE / PREVIEW -->
    <LandingPreview
      eyebrow="Inside the Virtual Classroom"
      headline="It’s just your child, their teacher, and the Quran."
      body="Watch your child settle into class peacefully, not frustrated by disconnected virtual rooms, but stepping into a thoughtful learning environment where they feel completely supported."
      theme="dark"
      layoutVariant="50-50"
      ctaLabel="Start Your Free Trial"
      ctaHref="/booking?source=kids_funnel"
    >
      <div
        slot="media"
        class="relative w-full rounded-2xl overflow-hidden border border-white/10 shadow-[0_20px_50px_rgba(0,0,0,0.5)] bg-white/5"
      >
        <Image
          src={appKidsImg}
          alt="Real class session preview"
          class="w-full h-auto object-cover transform transition-transform hover:scale-[1.02] duration-700 ease-out"
          loading="lazy"
          decoding="async"
        />
      </div>
    </LandingPreview>

    <!-- § 6 TRUST / TRANSPARENCY -->
    <LandingTrust
      eyebrow="Full Transparency"
      headline="You don't need to hover over every session."
      body="Trusting someone else with your child's Quran education takes a leap of faith. So we don't ask you to just take our word for it. Here is exactly what you get from day one—nothing hidden, and absolutely nothing locked behind a premium subscription tier."
      trustPoints={trustPoints}
      accent="emerald"
      reversed={false}
    />

    <!-- § 7 ONBOARDING -->
    <LandingOnboarding
      headline="Three steps. The third one is the point."
      steps={onboardingSteps}
      theme="light"
      accent="emerald"
      ctaHref="/booking?source=kids_funnel"
    />

    <!-- § 8 TESTIMONIALS -->
    <LandingTestimonials
      testimonials={kidsTestimonials}
      eyebrow="Real Families, Real Results"
      headline="Don't take our word for it."
      cols={3}
      avatarAccent="emerald"
    />

    <!-- § 9 GUARANTEE -->
    <GuaranteeSection
      eyebrow="OUR GUARANTEE"
      headline="We carry all the risk. You carry none."
      body="Your peace of mind is built into our platform. From your first free session to your first 30 days of paid learning, you are completely protected."
      ctaHref={`/enroll/step-1?intent=${intent}`}
      ctaLabel="Book Your Free Class"
      accentColor="emerald"
    />

    <!-- § 10 PRICING CALCULATOR -->
    <LandingPricing />

    <!-- § 11 FAQ -->
    <LandingFAQ items={faqItems} />

    <!-- § 12 FINAL CTA -->
    <LandingCTA
      ctaHref={`/getting-started/signup?source=ad_kids_${intent}`}
      ctaLabel="Book Your Child's Free Class"
    />

    <!-- § 13 COMPLIANCE FOOTER -->
    <LandingFooter />

    <!-- Footer Overlap Spacer (Mobile) -->
    <div class="h-28 md:hidden" aria-hidden="true"></div>

    <!-- Sticky Mobile CTA Bar -->
    <StickyMobileCTA
      signupHref={`/getting-started/signup?source=ad_kids_${intent}`}
      whatsappHref={generateWhatsAppLink("Hi, I'd like to start a free Quran trial for my child.")}
    />
  </div><!-- /bg-cream-50 -->

  <!-- ════════════════════════════════════════════════════════════
       ATTRIBUTION PRESERVATION (Client-Side — SSG Safe)
       Reads window.location.search at runtime.
       Merges inbound gclid / utm_* / fbclid into all CTA hrefs.
       Targets a[data-track-cta] selector.
       ═══════════════════════════════════════════════════════════ -->
  <script is:inline>
    const attachAttribution = () => {
      const ctaButtons = document.querySelectorAll('a[data-track-cta]');
      if (!ctaButtons.length) return;
      const currentParams = new URLSearchParams(window.location.search);
      ctaButtons.forEach((button) => {
        try {
          const targetUrl = new URL(button.getAttribute('href'), window.location.origin);
          currentParams.forEach((value, key) => {
            if (!targetUrl.searchParams.has(key)) {
              targetUrl.searchParams.set(key, value);
            }
          });
          button.setAttribute('href', targetUrl.toString());
        } catch {
          // Non-fatal: attribution best-effort only
        }
      });
    };
    attachAttribution();
    document.addEventListener('astro:page-load', attachAttribution);
  </script>

  <!-- GTM: WhatsApp & primary CTA click tracking -->
  <script is:inline>
    const attachGTM = () => {
      if (typeof window === 'undefined' || !Array.isArray(window.dataLayer)) return;
      document.querySelectorAll('a[href*="wa.me"]').forEach((el) => {
        if (el.dataset.gtmBound) return;
        el.dataset.gtmBound = '1';
        el.addEventListener('click', () => {
          window.dataLayer.push({ event: 'contact_whatsapp', source: 'for_kids_page' });
        });
      });
      document.querySelectorAll('a[href*="/getting-started/signup"]').forEach((el) => {
        if (el.dataset.gtmBound) return;
        el.dataset.gtmBound = '1';
        el.addEventListener('click', () => {
          window.dataLayer.push({ event: 'click_book_trial', source: 'for_kids_page' });
        });
      });
    };
    attachGTM();
    document.addEventListener('astro:page-load', attachGTM);
  </script>
</Base>
