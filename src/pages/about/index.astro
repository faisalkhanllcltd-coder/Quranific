---
export const prerender = true;

// src/pages/about/index.astro
import Base from '../../layouts/Base.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';

import AboutOriginStory from './_components/AboutOriginStory.astro';
import AboutMission from './_components/AboutMission.astro';
import AboutPrinciples from './_components/AboutPrinciples.astro';
import AboutTeachers from './_components/AboutTeachers.astro';
import AboutTeam from './_components/AboutTeam.astro';
import AboutVision from './_components/AboutVision.astro';
import PageHero from '../../components/blocks/PageHero.astro';
import FinalCTA from '../../components/blocks/FinalCTA.astro';
import EyebrowText from '../../components/ui/EyebrowText.astro';

// Elite Edge SEO: Upgraded to AboutPage schema for Google E-E-A-T verification
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'Quranific',
      url: 'https://quranific.com',
      logo: 'https://quranific.com/logo.png',
      description:
        'A community of masters, not just teachers. Making authentic Quran education accessible worldwide through live 1-on-1 online classes.',
      foundingDate: '2021',
      founder: {
        '@type': 'Person',
        name: 'Faisal Khan',
      },
    },
    {
      '@type': 'AboutPage',
      name: 'About Quranific - Our Story & Mission',
      description:
        "Here, every instructor is an academy unto themselves. Learn about Quranific's story, mission, and certified Ijazah-holding teachers.",
      publisher: {
        '@id': 'https://quranific.com/#organization',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://quranific.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'About Us',
          item: 'https://quranific.com/about',
        },
      ],
    },
  ],
};
---

<Base
  title="About Us - Quranific | A Community of Masters, Not Just Teachers"
  description="Here, every instructor is an academy unto themselves. Learn about Quranific's story, mission, and certified Ijazah-holding teachers."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" is:inline />

  <Header />

  <main class="font-sans bg-cream-50 selection:bg-emerald-100 selection:text-emerald-900">
    <PageHero
      eyebrow="Our Story"
      title="A community of masters, "
      highlightWord="not just teachers."
      subtitle="Here, every instructor is an academy unto themselves. We built Quranific to bridge a massive gap in online Islamic education: tech platforms that didn't understand the tradition, and traditional academies that lacked reliable technology. We brought them together."
      primaryCtaText=""
    >
      <Fragment slot="checklist">
        <div class="flex flex-wrap gap-8 lg:gap-12 items-center mt-6">
          <div class="max-w-xs">
            <div class="font-serif text-lg font-bold text-emerald-700 mb-1 leading-tight">
              Trusted by families
            </div>
            <EyebrowText class="text-emerald-900/60 leading-relaxed">
              across the UK, US, and UAE.
            </EyebrowText>
          </div>
          <div>
            <div class="font-serif text-4xl font-bold text-emerald-700 mb-1">2021</div>
            <EyebrowText class="text-emerald-900/60"> Year Founded </EyebrowText>
          </div>
        </div>
      </Fragment>

      <Fragment slot="visual">
        <!-- Kept mt-10 so it doesn't crush the navigation -->
        <div
          class="bg-emerald-950 rounded-[2rem] p-8 sm:p-10 relative overflow-hidden shadow-2xl w-full max-w-[500px] mx-auto lg:ml-auto mt-10 lg:mt-0 mb-8 lg:mb-0"
        >
          <div
            class="absolute bottom-[-10%] right-[-10%] w-[200px] h-[200px] bg-white/5 rounded-full blur-2xl pointer-events-none"
          >
          </div>
          <div
            class="absolute top-[-5%] left-[-5%] w-[120px] h-[120px] bg-gold-500/10 rounded-full blur-2xl pointer-events-none"
          >
          </div>

          <!-- Styled Quote Mark -->
          <div
            class="font-serif text-[80px] leading-[0.5] text-emerald-500/20 mb-6 font-black"
            aria-hidden="true"
          >
            "
          </div>

          <!-- FIX: 22px on mobile, 14px on desktop -->
          <div
            class="font-serif text-[22px] lg:text-[14px] italic text-white/95 leading-relaxed relative z-10 space-y-4 mb-8"
          >
            <p>
              I spent years formally training as an Islamic scholar, proofreading complex classical
              texts in Hadith, Fiqh, and Tafsir. But as my career in software engineering grew, I
              noticed a massive disconnect in how the Quran was being taught online.
            </p>
            <p class="text-white/80">
              Families abroad were looking for authentic teachers, but the platforms connecting them
              were chaotic. Local classes were overcrowded, and online options were plagued by
              dropped calls, rotating tutors, and zero accountability. I didn't want to just
              complain about the standard of online Islamic education. I wanted to build the
              infrastructure to fix it.
            </p>
          </div>

          <!-- Refined Author Footer -->
          <div class="flex items-center gap-4 relative z-10 pt-6 border-t border-emerald-800/50">
            <div
              class="w-12 h-12 rounded-full bg-emerald-900 border border-emerald-700/50 flex items-center justify-center font-serif text-xl text-gold-400 font-bold shrink-0 shadow-inner"
            >
              ف
            </div>
            <div>
              <div class="font-bold text-white text-base">Faisal Khan</div>
              <div
                class="text-[13px] text-emerald-300/70 font-medium uppercase tracking-wider mt-0.5"
              >
                Founder & CEO
              </div>
            </div>
          </div>
        </div>
      </Fragment>
    </PageHero>
    <AboutOriginStory />
    <AboutMission />
    <AboutPrinciples />
    <AboutTeachers />
    <AboutTeam />
    <AboutVision />
    <FinalCTA />
  </main>

  <Footer />
</Base>
