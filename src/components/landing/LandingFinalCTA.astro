---
// src/components/landing/LandingFinalCTA.astro
import Button from '../ui/Button.astro';
import { SITE } from '../../constants/site';

interface Props {
  eyebrow?: string;
  headline: string;
  subhead: string;
  ctaHref: string;
  ctaLabel: string;
  /** Show WhatsApp secondary button */
  showWhatsapp?: boolean;
  /** Eyebrow/footer text accent color. 'emerald' or 'purple' */
  accent?: 'emerald' | 'purple';
}

const {
  eyebrow = "What's Waiting",
  headline,
  subhead,
  ctaHref,
  ctaLabel,
  showWhatsapp = false,
  accent = 'emerald',
} = Astro.props;

const eyebrowColor = accent === 'purple' ? 'text-purple-300' : 'text-emerald-400';
---

<section class="quranific-section bg-emerald-950">
  <div class="quranific-container">
    <div class="max-w-2xl">
      <p class={`text-xs font-bold uppercase tracking-widest mb-4 ${eyebrowColor}`}>
        {eyebrow}
      </p>
      <h2
        class="font-serif text-2xl md:text-3xl font-black text-white leading-[1.1] mb-6 max-w-2xl mx-auto"
      >
        <Fragment set:html={headline} />
      </h2>
      <p class="text-xl text-emerald-100/75 leading-relaxed mb-4 max-w-2xl mx-auto">
        {subhead}
      </p>
      <p class="text-sm text-emerald-400/60 mb-10">
        From <strong class="text-emerald-300">$40/mo</strong> ·
        <a
          href="/tuition-fee"
          class="underline underline-offset-2 hover:text-emerald-300 transition-colors"
          >Full pricing</a
        >
      </p>

      <div class:list={['flex gap-4', showWhatsapp ? 'flex-col sm:flex-row' : '']}>
        <Button href={ctaHref} data-track-cta variant="orange">
          {ctaLabel}
        </Button>

        {
          showWhatsapp && (
            <Button
              href={SITE.whatsappLink}
              target="_blank"
              rel="noopener noreferrer"
              variant="whatsapp"
            >
              Ask a question first
            </Button>
          )
        }
      </div>

      <p class="mt-6 text-emerald-400/40 text-sm">
        No credit card · Cancel anytime · Full refund if unsatisfied
      </p>
    </div>
  </div>
</section>
