---
// src/components/landing/LandingPricing.astro
import PricingCalculator from '../fees/PricingCalculator.svelte';
---

<section class="py-16 md:py-24 bg-slate-50">
  <div class="max-w-7xl mx-auto px-6 md:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Left Column: Sticky Context & Value Prop -->
      <div class="lg:col-span-4 lg:sticky lg:top-32 flex flex-col items-start">
        <span class="text-emerald-500 font-bold tracking-widest text-sm uppercase mb-3 block"
          >TRANSPARENT PRICING</span
        >
        <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6 text-balance">
          See your exact cost in 30 seconds.
        </h2>
        <p class="text-slate-600 text-lg leading-relaxed">
          Use the calculator to set your schedule. What you see is exactly what you pay. No hidden
          setup fees, and no long-term lock-ins.
        </p>
      </div>

      <!-- Right Column: The Interactive Calculator -->
      <div class="lg:col-span-8 w-full">
        <!-- CRITICAL: client:visible is required to hydrate the Svelte component in Astro -->
        <PricingCalculator client:visible />
      </div>
    </div>
  </div>
</section>
