---
// src/pages/faq/_components/FaqSupportCard.astro
import Section from '../../../components/ui/Section.astro';
import Button from '../../../components/ui/Button.astro';

const Icons = {
  support: `<svg class="w-8 h-8 text-emerald-950" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>`,
};
---

<Section
  height={300}
  class="max-w-3xl mx-auto mt-20 lg:mt-24 animate-in fade-in slide-in-from-bottom-8 duration-700 delay-300"
>
  <div
    class="bg-gradient-to-br from-emerald-900 to-emerald-950 rounded-3xl p-8 lg:p-12 text-center shadow-xl border border-emerald-800 relative overflow-hidden flex flex-col items-center"
  >
    <div
      class="w-16 h-16 bg-amber-400 rounded-full flex items-center justify-center mb-6 shadow-inner relative z-10"
      aria-hidden="true"
    >
      <span set:html={Icons.support} />
    </div>

    <h2 class="text-2xl lg:text-3xl font-bold text-white mb-3 relative z-10">
      Still have a question?
    </h2>
    <p class="text-emerald-100/80 mb-8 font-medium max-w-md relative z-10">
      Our support team is available 24/7 to help you figure out the best learning path for your
      family.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 relative z-10 w-full sm:w-auto">
      <Button href="/contact" variant="primaryDark" class="w-full sm:w-auto">
        Contact Support
      </Button>
      <Button href="/getting-started/signup" variant="ghostDark" class="w-full sm:w-auto">
        Book Your Free Class
      </Button>
    </div>

    <div
      class="absolute top-0 right-0 w-64 h-64 bg-emerald-500/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none"
      aria-hidden="true"
    >
    </div>
  </div>
</Section>
