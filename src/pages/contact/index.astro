---
export const prerender = true;

// src/pages/contact/index.astro
import Base from '../../layouts/Base.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import FinalCTA from '../../components/blocks/FinalCTA.astro';

import PageHero from '../../components/blocks/PageHero.astro';
import SmartContactForm from './_components/SmartContactForm.astro';
import ContactFaq from './_components/ContactFaq.astro';

import { SITE } from '../../constants/site';

const Icons = {
  wa: `<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>`,
  mail: `<svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
  form: `<svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Us - Quranific | We Reply to Every Message',
  description:
    'Get in touch with the Quranific team. Contact us via email or WhatsApp for support, inquiries, or feedback.',
  mainEntity: {
    '@type': 'Organization',
    name: 'Quranific',
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: SITE.emails.support,
      availableLanguage: ['English', 'Arabic'],
    },
  },
};
---

<Base
  title="Contact Us - Quranific | We Reply to Every Message"
  description="Get in touch with the Quranific team. Contact us via email or WhatsApp for support, inquiries, or feedback."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" is:inline />
  <script
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
    is:inline
    slot="head"></script>

  <Header />

  <main
    class="bg-cream-50 selection:bg-emerald-100 selection:text-emerald-900 font-sans"
    id="contact-main"
  >
    <PageHero
      layout="split"
      eyebrow="Lightning Fast"
      title="We reply to "
      highlightWord="every message within 5 minutes."
      subtitle="We operate a remote-first team positioned globally to ensure there is always a real human ready to assist you. No ticket queues, no automated bots—just immediate, helpful answers."
      primaryCtaText=""
    >
      <Fragment slot="visual">
        <!-- FIX: Replaced lg:ml-auto with lg:mx-auto to center it within its column, and bumped width to 28rem for perfect proportion -->
        <div
          class="bg-white/40 backdrop-blur-sm border border-emerald-100 rounded-[2rem] p-6 lg:p-8 shadow-xl shadow-emerald-900/5 w-full max-w-[28rem] mx-auto lg:mx-auto"
        >
          <h3 class="font-bold text-lg text-emerald-950 mb-1">Response time by channel</h3>
          <p class="text-[13px] text-emerald-900/60 font-medium mb-6">
            Based on our team's strict operational targets
          </p>

          <div class="space-y-3 mb-6">
            <!-- WhatsApp Routing Card -->
            <a
              href={`https://wa.me/${(SITE.whatsappNumber || '923112112122').replace(/\D/g, '')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 bg-white border border-emerald-100 rounded-xl p-4 hover:shadow-lg hover:border-green-300 transition-all duration-300 group relative overflow-hidden"
            >
              <div
                class="absolute left-0 top-0 bottom-0 w-1 bg-green-500 scale-y-0 group-hover:scale-y-100 origin-bottom transition-transform duration-300"
                aria-hidden="true"
              >
              </div>
              <div
                class="w-10 h-10 rounded-lg bg-green-50 border border-green-200 text-green-600 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform"
                aria-hidden="true"
              >
                <Fragment set:html={Icons.wa} />
              </div>
              <div class="flex-1">
                <div
                  class="font-bold text-emerald-950 text-[14px] mb-0.5 group-hover:text-green-700 transition-colors"
                >
                  WhatsApp
                </div>
                <div class="text-[11px] text-emerald-900/60 font-bold mb-2">
                  Target: 3 mins <span class="mx-1 font-normal">·</span> Max: 10 mins
                </div>
                <div class="h-1 w-full bg-emerald-50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-green-500 rounded-full w-[10%] shadow-[0_0_10px_rgba(34,197,94,0.4)]"
                  >
                  </div>
                </div>
              </div>
            </a>

            <!-- Contact Form Routing Card -->
            <a
              href="#contact-form"
              class="flex items-center gap-4 bg-white border border-emerald-100 rounded-xl p-4 hover:shadow-lg hover:border-emerald-300 transition-all duration-300 group relative overflow-hidden"
            >
              <div
                class="absolute left-0 top-0 bottom-0 w-1 bg-emerald-600 scale-y-0 group-hover:scale-y-100 origin-bottom transition-transform duration-300"
                aria-hidden="true"
              >
              </div>
              <div
                class="w-10 h-10 rounded-lg bg-emerald-50 border border-emerald-100 text-emerald-700 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform"
                aria-hidden="true"
              >
                <Fragment set:html={Icons.form} />
              </div>
              <div class="flex-1">
                <div
                  class="font-bold text-emerald-950 text-[14px] mb-0.5 group-hover:text-emerald-700 transition-colors"
                >
                  Contact Form
                </div>
                <div class="text-[11px] text-emerald-900/60 font-bold mb-2">
                  Target: 10 mins <span class="mx-1 font-normal">·</span> Max: 1 hour
                </div>
                <div class="h-1 w-full bg-emerald-50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-emerald-600 rounded-full w-[25%] shadow-[0_0_10px_rgba(5,150,105,0.3)]"
                  >
                  </div>
                </div>
              </div>
            </a>

            <!-- Direct Email Routing Card -->
            <a
              href={`mailto:${SITE.emails.support}`}
              class="flex items-center gap-4 bg-white border border-emerald-100 rounded-xl p-4 hover:shadow-lg hover:border-amber-300 transition-all duration-300 group relative overflow-hidden"
            >
              <div
                class="absolute left-0 top-0 bottom-0 w-1 bg-amber-500 scale-y-0 group-hover:scale-y-100 origin-bottom transition-transform duration-300"
                aria-hidden="true"
              >
              </div>
              <div
                class="w-10 h-10 rounded-lg bg-amber-50 border border-amber-200 text-amber-600 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform"
                aria-hidden="true"
              >
                <Fragment set:html={Icons.mail} />
              </div>
              <div class="flex-1">
                <div
                  class="font-bold text-emerald-950 text-[14px] mb-0.5 group-hover:text-amber-600 transition-colors"
                >
                  Direct Email
                </div>
                <div class="text-[11px] text-emerald-900/60 font-bold mb-2">
                  Target: 1 hour <span class="mx-1 font-normal">·</span> Max: 3 hours
                </div>
                <div class="h-1 w-full bg-emerald-50 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-amber-500 rounded-full w-[45%] shadow-[0_0_10px_rgba(245,158,11,0.3)]"
                  >
                  </div>
                </div>
              </div>
            </a>
          </div>

          <div
            class="bg-emerald-950 rounded-xl p-5 text-[12px] sm:text-[13px] text-emerald-50/90 font-medium leading-relaxed shadow-inner"
          >
            <strong class="block text-white text-[14px] mb-1.5 tracking-wide">
              Our strict commitment
            </strong>
            We reply to every single message we receive, including inquiries submitted on Sundays, during
            Ramadan, and across all major holidays.
          </div>
        </div>
      </Fragment>
    </PageHero>

    <SmartContactForm />
    <ContactFaq />

    <FinalCTA
      eyebrow="We're Here to Help"
      heading="Ready to start your <span class='text-[#fde68a] font-serif italic'>Quranic journey?</span>"
      subhead="If you have any remaining questions, drop us a line above. If you are ready to begin, book your free evaluation today."
    />
  </main>

  <Footer />
</Base>

<style is:global>
  @media (min-width: 1024px) {
    #contact-main > section:first-of-type > div > div:first-child {
      position: sticky;
      top: 8rem;
      align-self: start;
    }
  }
</style>
