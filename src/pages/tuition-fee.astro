---
// src/pages/tuition-fee.astro
import Base from '../layouts/Base.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import PageHero from '../components/sections/PageHero.astro';
import TuitionPlans from '../components/sections/TuitionPlans.astro';
import SiblingDiscount from '../components/sections/SiblingDiscount.astro';
import WhatsIncluded from '../components/sections/WhatsIncluded.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import { faqs } from '../data/faqs';

// Elite Edge SEO: Attached AggregateOffer to a specific Service entity
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Tuition Fees - Quranific',
  description:
    'Simple, honest pricing for private 1-on-1 Quran classes. No hidden fees. Full-month guarantee.',
  mainEntity: {
    '@type': 'Service',
    name: '1-on-1 Online Quran Classes',
    provider: {
      '@type': 'Organization',
      name: 'Quranific',
    },
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'USD',
      lowPrice: '40.00',
      highPrice: '80.00',
      offerCount: '8',
    },
  },
};
---

<Base
  title="Tuition Fees | Simple, Honest Pricing | Quranific"
  description="Honest pricing. Nothing hidden. Everything included. Calculate your monthly fee for private 1-on-1 Quran classes with certified scholars."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" is:inline />

  <Header />

  <main class="bg-cream-50 selection:bg-emerald-200 selection:text-emerald-950 font-sans">
    <PageHero
      eyebrow="SIMPLE & PREDICTABLE"
      title="Premium tuition. "
      highlightWord="One simple monthly fee."
      subtitle="Your dedicated tutor, premium platform access, and all learning materials, included in one flat rate. Cancel anytime."
      bottomPadding={false}
    />

    <TuitionPlans />

    <SiblingDiscount />
    <WhatsIncluded />

    <FAQAccordion
      questions={faqs.pricing}
      eyebrow="Pricing Questions"
      title="Every question "
      highlightWord="answered honestly."
      subtitle="These are the real questions parents ask before paying. We have answered every one without spin."
    />
  </main>

  <Footer />
</Base>
