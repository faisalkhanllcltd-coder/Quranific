---
export const prerender = true;

// src/pages/safeguarding.astro
import Base from '../layouts/Base.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Safeguarding Policy - Quranific',
  description: 'Quranific child safeguarding and protection policy.',
};
---

<Base
  title="Safeguarding Policy | Quranific"
  description="How Quranific protects the safety and wellbeing of children in our online learning environment."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" is:inline />

  <Header />

  <main
    class="bg-cream-50 min-h-screen selection:bg-emerald-100 selection:text-emerald-900 font-sans pb-32"
  >
    <div
      class="pt-16 md:pt-32 pb-12 lg:pt-40 lg:pb-16 px-4 sm:px-6 border-b border-emerald-100 bg-white"
    >
      <div class="quranific-container">
        <span
          class="inline-flex items-center gap-2 px-4 py-1.5 bg-emerald-50 border border-emerald-100 text-emerald-700 text-xs font-bold uppercase tracking-widest rounded-full mb-6"
        >
          Trust &amp; Safety
        </span>
        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-black text-emerald-950 tracking-tight mb-6"
        >
          Safeguarding Policy
        </h1>
        <p class="text-lg text-emerald-700/80 font-medium max-w-3xl"></p>
      </div>
    </div>

    <div class="quranific-container pt-16 space-y-20">
      <section>
        <h2 class="text-2xl font-bold text-emerald-950 mb-6">1. Purpose &amp; Scope</h2>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-emerald-950 mb-6">2. Designated Safeguarding Lead</h2>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-emerald-950 mb-6">3. Safer Recruitment</h2>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-emerald-950 mb-6">4. Online Safety During Classes</h2>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-emerald-950 mb-6">5. Reporting a Concern</h2>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-emerald-950 mb-6">6. Data &amp; Privacy for Minors</h2>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-emerald-950 mb-6">7. Review &amp; Updates</h2>
      </section>
    </div>
  </main>

  <Footer />
</Base>
