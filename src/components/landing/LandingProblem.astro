---
// src/components/landing/LandingProblem.astro

interface Props {
  eyebrow: string;
  headline: string;
  paragraphs: string[];
}

const { eyebrow, headline, paragraphs } = Astro.props;
---

<section class="quranific-section bg-white border-b border-emerald-50">
  <div class="quranific-container">
    <div class="max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-widest text-emerald-600 mb-4">
        {eyebrow}
      </p>
      <h2 class="font-serif text-3xl md:text-4xl font-black text-emerald-950 leading-[1.1] mb-8">
        {headline}
      </h2>
      <div class="space-y-5 text-lg text-emerald-900/75 leading-relaxed max-w-prose">
        {paragraphs.map((p) => <p set:html={p} />)}
      </div>
    </div>
  </div>
</section>
