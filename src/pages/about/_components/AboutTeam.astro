---
// src/pages/about/_components/AboutTeam.astro
import Section from '../../../components/ui/Section.astro';
import EyebrowText from '../../../components/ui/EyebrowText.astro';
import { LEADERSHIP } from '../../../data/team';

// Avatar Arabic letters and gradients for leadership
const avatarStyles: Record<string, { letter: string; gradient: string; textClass: string }> = {
  'faisal-khan': {
    letter: 'ف',
    gradient: 'from-emerald-700 to-emerald-500',
    textClass: 'text-emerald-700',
  },
  imranullah: {
    letter: 'ع',
    gradient: 'from-teal-700 to-teal-500',
    textClass: 'text-teal-700',
  },
  'hakeem-sadi': {
    letter: 'ح',
    gradient: 'from-amber-600 to-amber-400',
    textClass: 'text-amber-600',
  },
};

// Generate Person schema for the executive leadership team
const teamSchema = LEADERSHIP.map((member) => ({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: member.name,
  jobTitle: member.title,
  description: member.bio,
  worksFor: {
    '@type': 'Organization',
    name: 'Quranific',
    sameAs: 'https://quranific.com',
  },
}));
---

<!-- Injects JSON-LD schema so Google parses all team members as verified Persons -->
<script type="application/ld+json" set:html={JSON.stringify(teamSchema)} is:inline />

<Section class="py-10 md:py-20 lg:py-32 bg-cream-50 border-t border-emerald-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 max-w-2xl mx-auto">
      <EyebrowText class="text-emerald-700 mb-3">The Team</EyebrowText>
      <h2 class="text-4xl font-bold text-emerald-950 mb-6 tracking-tight">
        A community of leaders, <br /><em class="font-serif italic text-emerald-700 font-medium"
          >educators, and scholars.</em
        >
      </h2>
      <p class="text-lg text-emerald-900/80 font-medium">
        We are scholars, educators, and technologists united by a shared amanah to deliver
        authentic, empathetic Quran education.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16 max-w-5xl mx-auto">
      {
        LEADERSHIP.map((member) => {
          const style = avatarStyles[member.id] || {
            letter: member.name.charAt(0),
            gradient: 'from-emerald-700 to-emerald-500',
            textClass: 'text-emerald-700',
          };
          return (
            <div class="bg-white border border-emerald-100 rounded-3xl p-6 sm:p-8 text-center shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col items-center">
              <div
                class={`w-20 h-20 rounded-full bg-gradient-to-br ${style.gradient} flex items-center justify-center text-white font-serif text-3xl mx-auto mb-5 shadow-inner`}
                aria-hidden="true"
              >
                {style.letter}
              </div>
              <h3 class="text-xl font-bold text-emerald-950 mb-1">{member.name}</h3>
              <EyebrowText class={`${style.textClass} mb-4`}>{member.title}</EyebrowText>
              <p class="text-[13px] text-emerald-900/80 font-medium leading-relaxed">
                {member.bio}
              </p>
            </div>
          );
        })
      }
    </div>
  </div>
</Section>
