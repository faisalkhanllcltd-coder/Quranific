---
// src/pages/teachers/_components/TeachersHero.astro
const Icons = {
  heroBadge: `<svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
};
---

<section
  class="pt-8 sm:pt-12 md:pt-16 pb-12 md:pb-16 lg:pb-20 px-4 sm:px-6 relative overflow-hidden border-b border-emerald-100"
>
  <div
    class="absolute top-0 right-0 w-[600px] h-[600px] bg-emerald-500/5 rounded-full blur-[120px] pointer-events-none"
    aria-hidden="true"
  >
  </div>

  <div
    class="max-w-4xl mx-auto text-center relative z-10 animate-in fade-in slide-in-from-bottom-8 duration-1000"
  >
    <span
      class="inline-flex items-center gap-2 px-4 py-2 bg-emerald-50 text-emerald-800 text-xs font-bold tracking-widest uppercase rounded-full mb-8 border border-emerald-100 shadow-sm"
    >
      <span set:html={Icons.heroBadge} aria-hidden="true" />
      The Top 1% of Instructors
    </span>

    <h1
      class="text-5xl md:text-6xl lg:text-7xl font-black text-emerald-950 mb-6 tracking-tighter leading-[1.1] text-balance"
    >
      Masters of the Word. <br /> Mentors for Life.
    </h1>

    <p
      class="text-lg lg:text-xl text-emerald-800/80 font-medium max-w-2xl mx-auto leading-relaxed text-balance mb-10"
    >
      We don't just hire tutors; we curate a global faculty of certified scholars, Hafiz, and Ijazah
      holders dedicated to passing down the authentic recitation of the Quran.
    </p>

    <div class="flex flex-wrap justify-center gap-4 sm:gap-8">
      <div class="flex flex-col items-center">
        <span class="text-3xl font-black text-emerald-800">100%</span>
        <span class="text-xs font-bold text-emerald-600 uppercase tracking-wider"
          >Background Checked</span
        >
      </div>
      <div class="w-px h-12 bg-emerald-200 hidden sm:block" aria-hidden="true"></div>
      <div class="flex flex-col items-center">
        <span class="text-3xl font-black text-emerald-800">24/7</span>
        <span class="text-xs font-bold text-emerald-600 uppercase tracking-wider"
          >Quality Assurance</span
        >
      </div>
      <div class="w-px h-12 bg-emerald-200 hidden sm:block" aria-hidden="true"></div>
      <div class="flex flex-col items-center">
        <span class="text-3xl font-black text-emerald-800">Rigorous</span>
        <span class="text-xs font-bold text-emerald-600 uppercase tracking-wider"
          >Vetting Process</span
        >
      </div>
    </div>
  </div>
</section>
