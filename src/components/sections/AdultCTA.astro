---
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import { SITE } from '../../constants/site';

const adultCta = {
  badge: 'For Adults',
  title: 'Fix your Tajweed. No embarrassment. No class.',
  description:
    'Private 1-on-1 sessions designed for working adults who want to improve their recitation without the awkwardness of a group setting. Your teacher only knows your name.',
  btnText: 'Book Adult Trial Class →',
};
---

<Section
  height={300}
  class="py-12 md:py-20 bg-emerald-950 border-y border-emerald-900"
  aria-labelledby="adult-cta-heading"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-8 lg:gap-16">
      <div class="flex-1 text-center lg:text-left">
        <div
          class="inline-flex items-center justify-center gap-2 px-3 py-1 bg-white/5 border border-white/10 text-emerald-300 text-[11px] font-bold uppercase tracking-widest rounded-full mb-6 backdrop-blur-sm"
        >
          {adultCta.badge}
        </div>
        <h2 id="adult-cta-heading" class="text-3xl font-semibold text-white mb-4">
          {adultCta.title}
        </h2>
        <p
          class="text-[16px] text-emerald-100/70 font-medium max-w-2xl lg:mx-0 mx-auto leading-relaxed"
        >
          {adultCta.description}
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-4 shrink-0 w-full lg:w-auto">
        <Button
          href="/funnel/signup?type=adult"
          variant="white"
          class="w-full sm:w-auto text-base font-bold shadow-lg"
        >
          {adultCta.btnText}
        </Button>

        <a
          href={SITE.whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-200 hover:text-white transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 rounded whitespace-nowrap min-h-[44px] px-2"
          aria-label="Ask a question on WhatsApp"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true"
            ><path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
            ></path></svg
          >
          Ask a Question
        </a>
      </div>
    </div>
  </div>
</Section>
