---
export const prerender = true;

// src/pages/testimonials/index.astro
import Base from '../../layouts/Base.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';

import PageHero from '../../components/blocks/PageHero.astro';
import TestimonialsGrid from './_components/TestimonialsGrid.astro';
import TestimonialsCta from './_components/TestimonialsCta.astro';

import { testimonials } from '../../data/testimonials';

// Map unified Testimonial interface to the shape TestimonialsGrid expects (sliced to exactly 6).
const TESTIMONIALS = testimonials.slice(0, 6).map((t) => ({
  name: t.name,
  role: 'Verified Student',
  location: t.details,
  text: t.quote,
  rating: 5,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Quranific',
  url: 'https://quranific.com',
  review: TESTIMONIALS.map((t) => ({
    '@type': 'Review',
    author: {
      '@type': 'Person',
      name: t.name,
    },
    reviewRating: {
      '@type': 'Rating',
      ratingValue: t.rating,
      bestRating: '5',
    },
    reviewBody: t.text,
  })),
};
---

<Base
  title="Testimonials | Success Stories from Quranific Students"
  description="Read real stories and reviews from parents and students worldwide who have transformed their Quran reading and Tajweed with Quranific."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" is:inline />

  <Header />

  <main
    class="min-h-screen bg-cream-50 selection:bg-emerald-200 selection:text-emerald-950 overflow-hidden"
  >
    <PageHero
      eyebrow="Trusted Worldwide"
      title="Don't just take "
      highlightWord="our word for it."
      subtitle="Discover how families on every continent are building meaningful, lifelong connections with the Holy Quran through our dedicated tutors."
    />
    <TestimonialsGrid testimonials={TESTIMONIALS} />
    <TestimonialsCta />
  </main>

  <Footer />
</Base>
