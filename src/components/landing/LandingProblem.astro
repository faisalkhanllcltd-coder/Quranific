---
// src/components/landing/LandingProblem.astro
import Button from '../ui/Button.astro';

interface Props {
  eyebrow?: string;
  headline: string;
  body: string;
  painPoints: Array<{ title: string; description?: string; text?: string }>;
  ctaLabel?: string;
  ctaHref?: string;
  accent?: 'emerald' | 'purple';
}

const { eyebrow, headline, body, painPoints, ctaLabel, ctaHref, accent = 'emerald' } = Astro.props;

const isPurple = accent === 'purple';
const eyebrowColor = isPurple ? 'text-purple-700' : 'text-emerald-600';
const iconBgColor = isPurple ? 'bg-purple-50' : 'bg-emerald-50';
const iconTextColor = isPurple ? 'text-purple-600' : 'text-emerald-500';
const titleColor = isPurple ? 'text-purple-950' : 'text-emerald-950';
const descColor = isPurple ? 'text-purple-900/80' : 'text-emerald-800/80';
const btnBorderColor = isPurple ? 'border-purple-200' : 'border-emerald-200';
const btnTextColor = isPurple ? 'text-purple-700' : 'text-emerald-700';
const btnHoverColor = isPurple ? 'hover:bg-purple-50' : 'hover:bg-emerald-50';
---

<section class="quranific-section bg-white border-b border-emerald-50">
  <div class="quranific-container">
    <div
      class="max-w-3xl mx-auto text-left md:text-center flex flex-col items-start md:items-center mb-12"
    >
      {
        eyebrow && (
          <p class:list={['text-xs font-bold uppercase tracking-widest mb-4', eyebrowColor]}>
            {eyebrow}
          </p>
        )
      }
      <h2
        class="font-serif text-3xl md:text-4xl font-black text-emerald-950 leading-[1.1] mb-6 text-balance"
      >
        {headline}
      </h2>
      <p
        class="text-lg text-emerald-900/75 leading-relaxed max-w-2xl mx-auto text-balance"
        set:html={body}
      />
    </div>

    <!-- 3-Column Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {
        painPoints.map((point) => (
          <div class="relative flex flex-col p-8 rounded-2xl bg-white shadow-[0_4px_20px_-4px_rgba(0,0,0,0.05)] transition-all hover:shadow-[0_8px_30px_-4px_rgba(0,0,0,0.08)]">
            <div
              class:list={[
                'w-12 h-12 rounded-full flex items-center justify-center mb-6 shrink-0',
                iconBgColor,
                iconTextColor,
              ]}
            >
              <svg
                class="w-5 h-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </div>
            <h3 class:list={['text-lg font-bold mb-2', titleColor]}>{point.title}</h3>
            <p class:list={['text-sm leading-relaxed', descColor]}>
              {point.text || point.description}
            </p>
          </div>
        ))
      }
    </div>

    {
      ctaLabel && ctaHref && (
        <div class="mt-12 flex justify-center">
          <Button
            href={ctaHref}
            variant="white"
            class:list={[btnBorderColor, btnTextColor, btnHoverColor]}
          >
            {ctaLabel}
          </Button>
        </div>
      )
    }
  </div>
</section>
