---
// src/pages/teachers/_components/TeachersFaculty.astro
import Section from '../../../components/ui/Section.astro';

export interface Teacher {
  name: string;
  gender: string;
  title: string;
  experience: string;
  rating: string;
  students: string;
  specialties: string[];
  languages: string[];
  bio: string;
}

interface Props {
  teachers: Teacher[];
}

const { teachers } = Astro.props;

const Icons = {
  star: `<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>`,
};
---

<Section height={900} class="py-10 md:py-20 lg:py-32 px-4 sm:px-6">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16 max-w-3xl mx-auto">
      <h2 class="text-3xl lg:text-5xl font-black text-emerald-950 mb-6 tracking-tight">
        Meet Our Featured Faculty
      </h2>
      <p class="text-lg text-emerald-800/80 font-medium">
        A small glimpse into the elite scholars, pedagogues, and mentors waiting to guide you.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-8">
      {
        teachers.map((teacher) => (
          <div class="bg-white rounded-3xl border border-emerald-100 shadow-sm hover:shadow-lg transition-all duration-300 p-6 sm:p-8 flex flex-col sm:flex-row gap-6 sm:gap-8 group">
            <div class="flex flex-col items-center shrink-0">
              <div
                class="w-24 h-24 rounded-full bg-gradient-to-br from-emerald-100 to-emerald-200 border-4 border-white shadow-md flex items-center justify-center text-emerald-800 text-3xl font-black tracking-tighter mb-4 group-hover:scale-105 transition-transform"
                aria-hidden="true"
              >
                {teacher.name.split(' ')[1][0]}
              </div>
              <div class="flex items-center gap-1 text-amber-500 mb-1">
                <span set:html={Icons.star} aria-hidden="true" />
                <span class="text-sm font-bold text-emerald-950">{teacher.rating}</span>
              </div>
              <span class="text-xs text-emerald-700/70 font-bold uppercase tracking-wider">
                {teacher.students} Students
              </span>
            </div>

            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <h3 class="text-2xl font-bold text-emerald-950">{teacher.name}</h3>
                <span class="px-2.5 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold uppercase tracking-wider rounded-md border border-emerald-100">
                  {teacher.gender} Tutor
                </span>
              </div>

              <p class="text-emerald-700 font-bold text-sm mb-4">
                {teacher.title} &nbsp;·&nbsp; {teacher.experience}
              </p>
              <p class="text-emerald-900/80 text-sm font-medium leading-relaxed mb-6">
                "{teacher.bio}"
              </p>

              <div class="space-y-3">
                <div class="flex items-start gap-2">
                  <span class="text-xs font-bold text-emerald-950 uppercase tracking-wider w-20 shrink-0 pt-0.5">
                    Focus:
                  </span>
                  <div class="flex flex-wrap gap-2">
                    {teacher.specialties.map((spec) => (
                      <span class="bg-cream-50 border border-emerald-100 text-emerald-800 text-xs px-2.5 py-1 rounded-full font-medium shadow-sm">
                        {spec}
                      </span>
                    ))}
                  </div>
                </div>
                <div class="flex items-start gap-2">
                  <span class="text-xs font-bold text-emerald-950 uppercase tracking-wider w-20 shrink-0 pt-0.5">
                    Speaks:
                  </span>
                  <div class="flex flex-wrap gap-2">
                    {teacher.languages.map((lang) => (
                      <span class="text-emerald-800/80 text-xs font-medium bg-white border border-emerald-50 px-2 py-0.5 rounded-md shadow-sm">
                        {lang}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Section>
