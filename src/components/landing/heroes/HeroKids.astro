---
// src/components/landing/heroes/HeroKids.astro
import Button from '../../ui/Button.astro';

interface Props {
  intent: 'quran-classes' | 'quran-teacher';
  h1: string;
  highlightWord?: string;
  subhead: string;
}

const { intent, h1, highlightWord, subhead } = Astro.props;
---

<section class="relative overflow-hidden border-b border-emerald-100">
  <!-- Dot grid -->
  <div
    class="absolute inset-0 bg-[radial-gradient(#d1fae5_1px,transparent_1px)] [background-size:20px_20px] opacity-50 pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <!-- Glow blob -->
  <div
    class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[500px] bg-emerald-400/10 blur-[140px] rounded-full pointer-events-none"
    aria-hidden="true"
  >
  </div>

  <div class="quranific-container relative z-10 py-8">
    <!-- Minimal ad-lander header: logo only, no nav -->
    <header class="mb-14 md:mb-20 flex items-center justify-between">
      <a
        href="/"
        class="inline-flex items-center hover:opacity-80 transition-opacity focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 rounded-lg"
      >
        <img
          src="/images/quranific-logo-green.svg"
          alt="Quranific Logo"
          class="h-8 md:h-9 w-auto object-contain"
          loading="eager"
          decoding="async"
        />
      </a>
    </header>

    <div class="grid lg:grid-cols-2 gap-12 xl:gap-20 items-center pb-16 sm:pb-20 lg:pb-24">
      <!-- Left: headline + CTAs -->
      <div>
        <div
          class="inline-flex items-center px-3.5 py-1 rounded-full text-sm font-semibold bg-emerald-500/10 text-emerald-700 ring-1 ring-inset ring-emerald-500/20 mb-6"
        >
          Specially Designed for Kids
        </div>

        <!-- Dynamic H1 -->
        <h1
          class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mb-5 leading-[1.15] text-emerald-950 text-balance"
        >
          {h1}
          {
            highlightWord && (
              <span class="bg-gradient-to-r from-emerald-600 to-gold-500 bg-clip-text text-transparent">
                {highlightWord}
              </span>
            )
          }
        </h1>

        <!-- Dynamic Subhead -->
        <p
          class="text-xl md:text-2xl text-emerald-800/75 font-medium leading-relaxed mb-8 max-w-xl"
        >
          {subhead}
        </p>

        <!-- CTAs: Hero = variant="emerald" per funnel mapping -->
        <div class="flex flex-col sm:flex-row gap-3 mb-8">
          <Button
            href={`/enroll/step-1?intent=${intent}`}
            data-track-cta
            variant="emerald"
            fullWidthOnMobile
          >
            Book Your Child's Free Class
          </Button>
        </div>

        <!-- Edge UI Trust Pills (Light Theme - Crisp White Elevation) -->
        <ul
          class="grid grid-cols-2 lg:flex lg:flex-wrap lg:justify-start gap-2 md:gap-2.5 mt-6 w-full"
        >
          <li
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-[13px] font-semibold bg-white text-emerald-950 border border-emerald-900/10 shadow-xs w-full justify-center lg:w-auto lg:justify-start"
          >
            <!-- SVG: Credit Card -->
            <svg
              class="w-3.5 h-3.5 text-emerald-600 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="20" height="14" x="2" y="5" rx="2"></rect>
              <line x1="2" x2="22" y1="10" y2="10"></line>
            </svg>
            No credit card
          </li>
          <li
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-[13px] font-semibold bg-white text-emerald-950 border border-emerald-900/10 shadow-xs w-full justify-center lg:w-auto lg:justify-start"
          >
            <!-- SVG: Calendar -->
            <svg
              class="w-3.5 h-3.5 text-emerald-600 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
              <line x1="16" x2="16" y1="2" y2="6"></line>
              <line x1="8" x2="8" y1="2" y2="6"></line>
              <line x1="3" x2="21" y1="10" y2="10"></line>
            </svg>
            Cancel anytime
          </li>
          <li
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-[13px] font-semibold bg-white text-emerald-950 border border-emerald-900/10 shadow-xs w-full justify-center lg:w-auto lg:justify-start"
          >
            <!-- SVG: Shield Check -->
            <svg
              class="w-3.5 h-3.5 text-emerald-600 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
            Full-month refund
          </li>
          <li
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-[13px] font-semibold bg-white text-emerald-950 border border-emerald-900/10 shadow-xs w-full justify-center lg:w-auto lg:justify-start"
          >
            <!-- SVG: User Check -->
            <svg
              class="w-3.5 h-3.5 text-emerald-600 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <polyline points="16 11 18 13 22 9"></polyline>
            </svg>
            Vetted teachers
          </li>
        </ul>
      </div>

      <!-- Right: Hero Image -->
      <div class="w-full mt-10 lg:mt-0 relative overflow-hidden rounded-[2rem] lg:rounded-[2.5rem]">
        <img
          src="/images/quran-classes-for-kids.webp"
          alt="Quran Classes for Kids"
          class="w-full h-auto object-cover"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>
