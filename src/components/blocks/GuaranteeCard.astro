---
// src/components/blocks/GuaranteeCard.astro
// Reusable compact guarantee card — used inside FAQ left columns, sidebar CTAs,
// and any surface that needs the guarantee promise at card-scale.
// For the full dark-section guarantee layout, use GuaranteeSection.astro.

interface Props {
  title?: string;
  body?: string;
  class?: string;
}

const {
  title = 'Our Full-Month Guarantee',
  body = 'If after your first full paid month you are not completely satisfied — for any reason — we will refund you in full. No questions, no forms, no chasing. Just send one email.',
  class: className = '',
} = Astro.props;
---

<div
  class:list={[
    'bg-white border border-emerald-100 rounded-3xl p-6 sm:p-8 shadow-xl shadow-emerald-900/5',
    className,
  ]}
>
  <div
    class="w-12 h-12 bg-emerald-50 rounded-xl flex items-center justify-center text-emerald-700 mb-6 border border-emerald-100/50"
  >
    <svg
      class="w-6 h-6"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
      ></path>
    </svg>
  </div>
  <h3 class="font-bold text-xl text-emerald-950 mb-3">{title}</h3>
  <p class="text-[15px] text-emerald-900/80 font-medium leading-relaxed" set:html={body} />
</div>
