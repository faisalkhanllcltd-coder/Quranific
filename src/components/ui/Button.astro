---
// src/components/ui/Button.astro
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'>, Omit<HTMLAttributes<'a'>, 'type'> {
  href?: string;
  variant?:
    | 'green'
    | 'orange'
    | 'whatsapp'
    | 'white'
    | 'emerald'
    | 'gold'
    | 'primary'
    | 'secondary'
    | 'ghost';
  fullWidthOnMobile?: boolean;
}

const {
  href,
  variant = 'green',
  class: className,
  type = 'button',
  fullWidthOnMobile = false,
  ...rest
} = Astro.props;

// Extracted exact colors, shadows, and hover transforms from global UI logic
const variants: Record<string, string> = {
  green:
    'bg-emerald-700 text-white hover:bg-emerald-800 shadow-lg shadow-emerald-900/10 hover:shadow-emerald-900/20 hover:-translate-y-0.5',
  orange:
    'bg-orange-500 text-white hover:bg-orange-600 shadow-lg shadow-orange-500/10 hover:shadow-orange-500/30 hover:-translate-y-0.5',
  whatsapp:
    'bg-transparent text-white border-2 border-white/40 hover:bg-white/10 hover:-translate-y-0.5',
  white:
    'bg-white text-emerald-950 border-2 border-emerald-200/80 hover:border-emerald-300 hover:bg-emerald-50/50 hover:-translate-y-0.5',
  // Backward-compatible aliases
  emerald:
    'bg-emerald-700 text-white hover:bg-emerald-800 shadow-lg shadow-emerald-900/10 hover:shadow-emerald-900/20 hover:-translate-y-0.5',
  gold: 'bg-orange-500 text-white hover:bg-orange-600 shadow-lg shadow-orange-500/10 hover:shadow-orange-500/30 hover:-translate-y-0.5',
  primary:
    'bg-emerald-700 text-white hover:bg-emerald-800 shadow-lg shadow-emerald-900/10 hover:shadow-emerald-900/20 hover:-translate-y-0.5',
  secondary:
    'bg-orange-500 text-white hover:bg-orange-600 shadow-lg shadow-orange-500/10 hover:shadow-orange-500/30 hover:-translate-y-0.5',
  ghost:
    'bg-transparent text-emerald-950 border-2 border-emerald-100 hover:border-emerald-200 hover:bg-emerald-50',
};

// Extracted exact structural DNA from HomeHero CTAs
const baseStyle =
  'inline-flex justify-center items-center px-4 py-2.5 text-sm font-semibold rounded-lg transition-all duration-300 active:scale-95 min-h-[44px]';

// Optional layout wrapper to mimic HomeHero mobile responsiveness without breaking global usage
const widthStyle = fullWidthOnMobile ? 'w-full sm:w-auto' : '';
---

{
  href ? (
    <a
      href={href}
      class:list={[baseStyle, widthStyle, variants[variant] || variants.green, className]}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button
      type={type as 'button' | 'submit' | 'reset'}
      class:list={[baseStyle, widthStyle, variants[variant] || variants.green, className]}
      {...rest}
    >
      <slot />
    </button>
  )
}
