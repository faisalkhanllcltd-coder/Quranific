---
// src/components/landing/heroes/HeroKids.astro
import Button from '../../ui/Button.astro';

interface Props {
  intent: 'quran-classes' | 'quran-teacher';
  h1: string;
  highlightWord?: string;
  subhead: string;
}

const { intent, h1, highlightWord, subhead } = Astro.props;
---

<section class="relative overflow-hidden border-b border-emerald-100">
  <!-- Dot grid -->
  <div
    class="absolute inset-0 bg-[radial-gradient(#d1fae5_1px,transparent_1px)] [background-size:20px_20px] opacity-50 pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <!-- Glow blob -->
  <div
    class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[500px] bg-emerald-400/10 blur-[140px] rounded-full pointer-events-none"
    aria-hidden="true"
  >
  </div>

  <div class="quranific-container relative z-10 py-8">
    <!-- Minimal ad-lander header: logo only, no nav -->
    <header class="mb-14 md:mb-20 flex items-center justify-between">
      <a
        href="/"
        class="inline-flex items-center hover:opacity-80 transition-opacity focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 rounded-lg"
      >
        <img
          src="/images/quranific-logo-green.svg"
          alt="Quranific Logo"
          class="h-8 md:h-9 w-auto object-contain"
          loading="eager"
          decoding="async"
        />
      </a>
    </header>

    <div class="grid lg:grid-cols-2 gap-12 xl:gap-20 items-center pb-16 sm:pb-20 lg:pb-24">
      <!-- Left: headline + CTAs -->
      <div>
        <div
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-emerald-100 shadow-sm mb-6"
        >
          <svg
            class="w-3.5 h-3.5 text-gold-500"
            fill="currentColor"
            viewBox="0 0 20 20"
            aria-hidden="true"
          >
            <path
              d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
            ></path>
          </svg>
          <span class="text-xs font-bold text-emerald-950 tracking-wide"
            >Trusted by families across the UK, US, and UAE</span
          >
        </div>

        <!-- Dynamic H1 -->
        <h1
          class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mb-5 leading-[1.15] text-emerald-950 text-balance"
        >
          {h1}
          {
            highlightWord && (
              <span class="bg-gradient-to-r from-emerald-600 to-gold-500 bg-clip-text text-transparent">
                {highlightWord}
              </span>
            )
          }
        </h1>

        <!-- Dynamic Subhead -->
        <p
          class="text-xl md:text-2xl text-emerald-800/75 font-medium leading-relaxed mb-8 max-w-xl"
        >
          {subhead}
        </p>

        <!-- CTAs: Hero = variant="emerald" per funnel mapping -->
        <div class="flex flex-col sm:flex-row gap-3">
          <Button
            href={`/enroll/step-1?intent=${intent}`}
            data-track-cta
            variant="emerald"
            fullWidthOnMobile
          >
            Book Your Child's Free Class
          </Button>
        </div>

        <!-- Clean Friction Killers -->
        <div class="mt-5 flex flex-wrap items-center gap-4 text-sm font-medium text-emerald-800/80">
          <span class="flex items-center gap-1.5">
            <svg
              class="w-4 h-4 text-emerald-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
            </svg>
            No credit card required
          </span>
          <span class="flex items-center gap-1.5">
            <svg
              class="w-4 h-4 text-emerald-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
            </svg>
            100% Free Trial
          </span>
        </div>
      </div>

      <!-- Right: Hero Image -->
      <div class="w-full mt-10 lg:mt-0 relative overflow-hidden rounded-[2rem] lg:rounded-[2.5rem]">
        <img
          src="/images/quran-classes-for-kids.webp"
          alt="Quran Classes for Kids"
          class="w-full h-auto object-cover"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>
