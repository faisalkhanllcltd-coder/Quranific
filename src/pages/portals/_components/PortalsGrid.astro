---
// src/pages/portals/_components/PortalsGrid.astro
const Icons = {
  student: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" /></svg>`,
  teacher: `<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
};

const PORTALS = [
  {
    id: 'student',
    title: 'Student Portal',
    desc: 'Access your virtual classroom, track your learning progress, and manage your schedule.',
    icon: Icons.student,
    signInLink: 'https://app.quranific.com/login',
    signUpLink: '/getting-started/signup',
    signUpText: 'New student? Create an account',
  },
  {
    id: 'teacher',
    title: 'Teacher Portal',
    desc: 'Access your teaching dashboard, manage global student sessions, and review lesson notes.',
    icon: Icons.teacher,
    signInLink: 'https://app.quranific.com/login',
    signUpLink: '/teachers/apply',
    signUpText: 'Want to teach with us? Apply now',
  },
];
---

<div class="max-w-4xl mx-auto px-4 sm:px-6 w-full relative z-10">
  <div class="text-center mb-12 animate-in fade-in slide-in-from-bottom-4 duration-700">
    <h1 class="text-3xl lg:text-4xl font-black text-emerald-950 mb-3 tracking-tight">
      Select Your Portal
    </h1>
    <p class="text-lg text-emerald-800/80 font-medium">
      Log in to your secure Quranific dashboard.
    </p>
  </div>

  <div
    class="grid md:grid-cols-2 gap-6 md:gap-8 animate-in fade-in slide-in-from-bottom-8 duration-700 delay-150"
  >
    {
      PORTALS.map((portal) => (
        <div class="bg-white rounded-[2rem] p-8 lg:p-10 border border-emerald-100 shadow-sm hover:shadow-xl transition-shadow duration-300 relative flex flex-col">
          {/* Header */}
          <div class="flex flex-col items-center text-center mb-8">
            <div
              class="w-16 h-16 rounded-2xl flex items-center justify-center mb-5 bg-emerald-50 text-emerald-700"
              aria-hidden="true"
            >
              <span set:html={portal.icon} />
            </div>
            <h3 class="text-2xl font-bold text-emerald-950 mb-2">{portal.title}</h3>
            <p class="text-emerald-800/70 text-[15px] font-medium leading-relaxed max-w-sm">
              {portal.desc}
            </p>
          </div>

          {/* Actions */}
          <div class="flex flex-col gap-3 mt-auto w-full max-w-xs mx-auto">
            <a
              href={portal.signInLink}
              class="flex items-center justify-center gap-2 w-full py-3.5 bg-emerald-700 text-white rounded-xl text-[15px] font-bold hover:bg-emerald-800 transition-colors duration-300 shadow-md shadow-emerald-900/10"
            >
              Sign In
              <span aria-hidden="true">→</span>
            </a>
          </div>

          {/* Footer/Signup Link */}
          <div class="mt-8 pt-6 border-t border-emerald-900/10 text-center w-full">
            <a
              href={portal.signUpLink}
              class="text-[14px] text-emerald-700 font-bold hover:text-emerald-900 transition-colors"
            >
              {portal.signUpText}
            </a>
          </div>
        </div>
      ))
    }
  </div>

  <div class="text-center mt-12 animate-in fade-in duration-700 delay-300">
    <p class="text-sm text-emerald-700/70 font-medium">
      Having trouble logging in? <a
        href="/contact"
        class="text-emerald-700 font-bold hover:underline">Contact Support</a
      >
    </p>
  </div>
</div>
