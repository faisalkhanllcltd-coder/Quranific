---
// src/pages/courses/index.astro
import Base from '../../layouts/Base.astro';
import Header from '../../components/global/Header.astro';
import Footer from '../../components/global/Footer.astro';
import PageHero from '../../components/blocks/PageHero.astro';
import FinalCTA from '../../components/blocks/FinalCTA.astro';

// Course-specific components
import CourseGrid from '../../components/blocks/CourseGrid.astro';
import TeacherTeaserBanner from '../../components/blocks/TeacherTeaserBanner.astro';
import CoursesFAQ from '../../components/blocks/CoursesFAQ.astro';
import Note from '../../components/ui/Note.astro';

// Data
import { courses } from '../../constants/courses';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Quranific Courses',
  description:
    'Explore our comprehensive online Quran courses for children and adults. From Basic Qaida to Advanced Tajweed Ijazah and Full Hifz programmes.',
  itemListElement: courses.map((course, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: course.title,
    url: `https://quranific.com/courses/${course.slug}`,
  })),
};
---

<Base
  title="Courses — Quranific | Find the Perfect Quran Programme for Your Child"
  description="Not every child starts in the same place. Find the perfect 1-on-1 online Quran course for your child or yourself. Basic Qaida, Tajweed, Hifz, Tafsir, Ijazah, and Arabic Language."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" is:inline />

  <Header />

  <main class="bg-cream-50 selection:bg-emerald-200 selection:text-emerald-950 font-sans">
    <!-- ─── HERO ────────────────────────────────────────────────────────────── -->
    <PageHero
      eyebrow="All programmes · Ages 4 to adult"
      title="Find the programme that fits "
      highlightWord="your child exactly."
      subtitle="Not every child starts in the same place. Not every family has the same goal. Every Quranific path is built around one learner — yours — with a dedicated teacher moving at their pace."
      primaryCtaText="Book Free Trial Class"
      primaryCtaLink="/funnel/signup"
    />

    <!-- ─── COURSES GRID ─────────────────────────────────────────────────────── -->
    <section class="py-16 md:py-20 lg:py-24 content-visibility-auto" id="courses-grid">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Section header with reusable Note -->
        <div class="text-center mb-12">
          <h2 class="text-4xl lg:text-5xl font-bold text-emerald-950 mb-4 tracking-tight">
            Find the perfect path.
          </h2>
          <p class="text-lg text-emerald-900/80 font-medium max-w-2xl mx-auto mb-8">
            Every one is 1-on-1, taught by a certified teacher, with on-demand progress reports and
            a guaranteed make-up for every missed session.
          </p>
          <Note />
        </div>

        <!-- Data-driven course cards (filters removed) -->
        <CourseGrid />
      </div>
    </section>

    <!-- ─── COURSE FEATURES GRID (Moved Below Grid) ────────────────────────── -->
    <section class="py-16 bg-white relative z-20 border-y border-emerald-100/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Feature 1: Child-Friendly Tutors -->
          <div
            class="flex flex-col p-6 rounded-2xl bg-cream-50/50 border border-emerald-100 shadow-sm hover:shadow-md transition-shadow duration-300 group"
          >
            <div
              class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-6 h-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"
                ></path>
              </svg>
            </div>
            <h3 class="text-emerald-950 font-bold text-lg mb-2">Child-Friendly Tutors</h3>
            <p class="text-emerald-900/70 text-sm leading-relaxed font-medium">
              Patient, highly qualified instructors who make learning enjoyable and engaging for
              beginners.
            </p>
          </div>

          <!-- Feature 2: Tajweed Focus -->
          <div
            class="flex flex-col p-6 rounded-2xl bg-cream-50/50 border border-emerald-100 shadow-sm hover:shadow-md transition-shadow duration-300 group"
          >
            <div
              class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-6 h-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                ></path>
              </svg>
            </div>
            <h3 class="text-emerald-950 font-bold text-lg mb-2">Tajweed Focus</h3>
            <p class="text-emerald-900/70 text-sm leading-relaxed font-medium">
              Master proper pronunciation and build a foundation for beautiful recitation from day
              one.
            </p>
          </div>

          <!-- Feature 3: Proven Results -->
          <div
            class="flex flex-col p-6 rounded-2xl bg-cream-50/50 border border-emerald-100 shadow-sm hover:shadow-md transition-shadow duration-300 group"
          >
            <div
              class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-6 h-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
              </svg>
            </div>
            <h3 class="text-emerald-950 font-bold text-lg mb-2">Proven Results</h3>
            <p class="text-emerald-900/70 text-sm leading-relaxed font-medium">
              Structured, clear learning paths designed to build your child's confidence and
              excellence.
            </p>
          </div>

          <!-- Feature 4: 1-on-1 Attention -->
          <div
            class="flex flex-col p-6 rounded-2xl bg-cream-50/50 border border-emerald-100 shadow-sm hover:shadow-md transition-shadow duration-300 group"
          >
            <div
              class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300"
            >
              <svg
                class="w-6 h-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
                ></path>
              </svg>
            </div>
            <h3 class="text-emerald-950 font-bold text-lg mb-2">1-on-1 Attention</h3>
            <p class="text-emerald-900/70 text-sm leading-relaxed font-medium">
              Completely private Quranic sessions tailored exclusively to your child's learning
              pace.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── TEACHER TEASER ───────────────────────────────────────────────────── -->
    <TeacherTeaserBanner />

    <!-- ─── COURSES FAQ ──────────────────────────────────────────────────────── -->
    <CoursesFAQ />

    <!-- ─── FINAL CTA ────────────────────────────────────────────────────────── -->
    <FinalCTA />
  </main>

  <Footer />
</Base>
