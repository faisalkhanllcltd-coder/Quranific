---
import { env } from 'cloudflare:workers';
import { courses } from '../../constants/courses';
import Page from '../../layouts/Page.astro';
import Breadcrumb from '../../components/seo/Breadcrumb.astro';
import PricingCalculator from '../../components/blocks/PricingCalculator.svelte';
import TeacherTeaserBanner from '../../components/blocks/TeacherTeaserBanner.astro';
import CoursesFAQ from '../../components/blocks/CoursesFAQ.astro';
import FAQAccordion from '../../components/blocks/FAQAccordion.astro';
import FinalCTA from '../../components/blocks/FinalCTA.astro';
import Button from '../../components/ui/Button.astro';

const { slug } = Astro.params;
const course = courses.find((c) => c.slug === slug);

if (!course) {
  return Astro.redirect('/404');
}

// Fetch live rates safely for SSR
let liveRates: Record<string, number> | null = null;
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const FX_RATES = (env as any)?.FX_RATES;
if (FX_RATES) {
  try {
    const raw = await FX_RATES.get('LATEST_RATES');
    if (raw) liveRates = JSON.parse(raw).rates;
  } catch (e) {
    console.error('KV FX fetch error:', e);
  }
}

// UNIFIED EDGE UI: Absolute consistency across the platform
const gradient = 'from-emerald-800 to-emerald-600';

// Dynamic routing for optimized background image
const imageSrc = `/images/${course.slug}.webp`;
const testFallback = '/images/basic-qaida.webp';

// Generate JSON-LD Schema
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: course.title,
  description: course.longDesc,
  provider: {
    '@type': 'Organization',
    name: 'Quranific',
    sameAs: 'https://quranific.com',
  },
  typicalAgeRange: course.ageRange,
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'Online',
    courseWorkload: course.duration,
    offers: {
      '@type': 'Offer',
      availability: 'https://schema.org/InStock',
      url: 'https://quranific.com/tuition-fee',
    },
  },
};
---

<Page description={course.shortDesc} title={`${course.title} | Quranific`} image={imageSrc}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />

  <!-- DYNAMIC HERO SECTION (Unified Emerald Overlay Engine) -->
  <!-- Note: pb-24 or pb-28 creates room for the overlapping Bento grid -->
  <section
    class="relative bg-slate-950 pt-6 pb-24 md:pt-12 md:pb-28 overflow-hidden w-full max-w-[100vw]"
  >
    <!-- DYNAMIC BACKGROUND IMAGE LAYER -->
    <div class={`absolute inset-0 z-0 bg-gradient-to-br ${gradient}`}>
      <img
        src={imageSrc}
        onerror={`this.onerror=null;this.src='${testFallback}';`}
        alt=""
        class="w-full h-full object-cover object-center grayscale mix-blend-overlay opacity-25"
        aria-hidden="true"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
      <!-- Slate Cinematic Guardrail -->
      <div
        class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/40 to-transparent"
      >
      </div>
    </div>

    <!-- FOREGROUND CONTENT -->
    <div
      class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10 text-center flex flex-col items-center"
    >
      <!-- Anchored Breadcrumbs -->
      <div
        class="mb-4 flex justify-center w-full overflow-hidden [&_nav_ol_li_a]:text-white/70 [&_nav_ol_li_a:hover]:text-white [&_nav_ol_li_span]:text-white/40 [&_nav_ol_li_span[aria-current]]:text-white/90"
      >
        <Breadcrumb />
      </div>

      <!-- Highlight Badge -->
      {
        course.highlight && (
          <span class="inline-block bg-white/10 backdrop-blur-sm border border-white/20 text-white text-[11px] sm:text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-wider mb-4 shadow-sm">
            ★ {course.highlight}
          </span>
        )
      }

      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-bold text-white tracking-tight max-w-4xl mx-auto drop-shadow-lg text-balance leading-tight mb-4"
      >
        {course.title}
      </h1>

      <p
        class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto leading-relaxed drop-shadow-sm font-medium text-balance mb-8"
      >
        {course.longDesc}
      </p>

      <!-- CTA Stack -->
      <div
        class="w-full sm:w-auto px-4 sm:px-0 flex flex-col sm:flex-row justify-center items-center gap-3"
      >
        <Button
          href={`/funnel/signup?course=${course.slug}`}
          variant="primaryDark"
          class="w-full sm:w-auto text-[15px] !px-8 !py-3.5 !bg-amber-500 hover:!bg-amber-600 !text-white !border-none shadow-xl shadow-amber-500/20"
        >
          Start Free Trial
        </Button>
        <Button
          href="https://wa.me/message/FF4LDK3JR2GPN1"
          variant="ghostDark"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto text-[15px] !px-8 !py-3.5 backdrop-blur-md !bg-white/10 hover:!bg-white/20 !border-white/20 shadow-sm"
        >
          <svg
            class="w-5 h-5 mr-2 text-[#25D366]"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
            ></path>
          </svg>
          Ask a Question
        </Button>
      </div>
    </div>
  </section>

  <!-- BENTO QUICK FACTS (Overlaps the Hero) -->
  <section class="relative z-20 -mt-10 md:-mt-12 px-4 sm:px-6 max-w-5xl mx-auto mb-16">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
      <!-- Age Group -->
      <div
        class="bg-white rounded-2xl p-4 sm:p-5 shadow-sm border border-emerald-100 flex flex-col xl:flex-row xl:items-center gap-3 xl:gap-4 hover:-translate-y-1 transition-transform duration-300"
      >
        <div
          class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
            ></path>
          </svg>
        </div>
        <div>
          <p
            class="text-[10px] sm:text-[11px] uppercase tracking-widest text-emerald-900/50 font-bold mb-0.5"
          >
            Age Group
          </p>
          <p class="text-sm sm:text-[15px] font-bold text-emerald-950">{course.ageRange}</p>
        </div>
      </div>

      <!-- Pacing -->
      <div
        class="bg-white rounded-2xl p-4 sm:p-5 shadow-sm border border-emerald-100 flex flex-col xl:flex-row xl:items-center gap-3 xl:gap-4 hover:-translate-y-1 transition-transform duration-300"
      >
        <div
          class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <div>
          <p
            class="text-[10px] sm:text-[11px] uppercase tracking-widest text-emerald-900/50 font-bold mb-0.5"
          >
            Pacing
          </p>
          <p class="text-sm sm:text-[15px] font-bold text-emerald-950">{course.duration}</p>
        </div>
      </div>

      <!-- Group Size -->
      <div
        class="bg-white rounded-2xl p-4 sm:p-5 shadow-sm border border-emerald-100 flex flex-col xl:flex-row xl:items-center gap-3 xl:gap-4 hover:-translate-y-1 transition-transform duration-300"
      >
        <div
          class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
        </div>
        <div>
          <p
            class="text-[10px] sm:text-[11px] uppercase tracking-widest text-emerald-900/50 font-bold mb-0.5"
          >
            Group Size
          </p>
          <p class="text-sm sm:text-[15px] font-bold text-emerald-950">{course.groupSize}</p>
        </div>
      </div>

      <!-- Language -->
      <div
        class="bg-white rounded-2xl p-4 sm:p-5 shadow-sm border border-emerald-100 flex flex-col xl:flex-row xl:items-center gap-3 xl:gap-4 hover:-translate-y-1 transition-transform duration-300"
      >
        <div
          class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"
            ></path>
          </svg>
        </div>
        <div>
          <p
            class="text-[10px] sm:text-[11px] uppercase tracking-widest text-emerald-900/50 font-bold mb-0.5"
          >
            Language
          </p>
          <p class="text-sm sm:text-[15px] font-bold text-emerald-950">
            {course.instructionLanguage.join(' / ')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- RICH CONTENT: WHY & WHO -->
  <section class="py-12 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-8 md:gap-12 items-stretch">
      <!-- Why This Course? Box -->
      <div
        class="bg-cream-50 rounded-3xl p-8 border border-emerald-100 flex flex-col justify-between"
      >
        <div>
          <!-- Outcome Standalone Highlight Statement -->
          {
            course.outcome && (
              <div class="text-lg font-bold text-emerald-800 bg-emerald-100/60 p-5 rounded-2xl mb-8 border border-emerald-200 shadow-sm leading-snug">
                <span class="block text-[11px] font-bold text-emerald-900/50 uppercase tracking-widest mb-1.5">
                  Target Outcome
                </span>
                {course.outcome}
              </div>
            )
          }

          <h2 class="text-2xl font-bold text-emerald-950 mb-4">Why This Course?</h2>
          <p class="text-emerald-800/80 leading-relaxed text-[15px] md:text-base">
            {course.whyThisCourse}
          </p>
        </div>

        <!-- Integrated Testimonial Quote -->
        {
          course.quote && (
            <div class="mt-8 pt-6 border-t border-emerald-200/60 relative">
              <svg
                class="absolute top-4 left-0 w-8 h-8 text-emerald-900/5 -translate-y-1/2 -translate-x-2"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
              </svg>
              <blockquote class="relative z-10 text-[15px] md:text-base text-emerald-900 font-medium italic leading-relaxed">
                "{course.quote}"
              </blockquote>
              {course.quoteAuthor && (
                <p class="text-[11px] uppercase tracking-wider font-bold text-emerald-700 mt-3">
                  — {course.quoteAuthor}
                </p>
              )}
            </div>
          )
        }
      </div>

      <!-- Who is it for? Box -->
      <div
        class="bg-emerald-950 text-white rounded-3xl p-8 shadow-lg flex flex-col justify-between"
      >
        <div>
          <h2 class="text-2xl font-bold mb-4">Who is it for?</h2>
          <p class="text-emerald-100/80 leading-relaxed mb-8 text-[15px] md:text-base">
            {course.whoItsFor}
          </p>

          {
            course.idealFor && course.idealFor.length > 0 ? (
              <>
                <div class="mb-8">
                  <h3 class="text-[11px] font-bold uppercase tracking-widest text-emerald-400 mb-4">
                    Ideal For
                  </h3>
                  <ul class="space-y-3">
                    {course.idealFor.map((item: string) => (
                      <li class="flex items-start text-sm sm:text-[15px] text-emerald-50">
                        <svg
                          class="w-5 h-5 text-emerald-400 mr-3 flex-shrink-0 mt-0.5"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2.5"
                          aria-hidden="true"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                {course.notFor && course.notFor.length > 0 && (
                  <div class="pt-6 border-t border-emerald-900/60">
                    <h3 class="text-[11px] font-bold uppercase tracking-widest text-amber-400 mb-4">
                      Not For
                    </h3>
                    <ul class="space-y-3">
                      {course.notFor.map((item) => (
                        <li class="flex items-start text-sm sm:text-[15px] text-emerald-100/80">
                          <svg
                            class="w-5 h-5 text-amber-400 mr-3 flex-shrink-0 mt-0.5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2.5"
                            aria-hidden="true"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M6 18L18 6M6 6l12 12"
                            />
                          </svg>
                          <span>
                            {item.text}{' '}
                            {item.linkText && item.linkUrl && (
                              <a
                                href={item.linkUrl}
                                class="text-amber-400 hover:text-amber-300 font-bold underline underline-offset-4 transition-colors ml-1"
                              >
                                {item.linkText} →
                              </a>
                            )}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </>
            ) : (
              <div>
                <h3 class="text-lg font-bold mt-8 mb-4 text-emerald-300">Prerequisites</h3>
                <ul class="space-y-3">
                  {course.prerequisites?.map((req: string) => (
                    <li class="flex items-start text-sm sm:text-[15px] text-emerald-100/80">
                      <svg
                        class="w-5 h-5 text-emerald-400 mr-3 flex-shrink-0 mt-0.5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2.5"
                        aria-hidden="true"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{req}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- CURRICULUM & FEATURES -->
  <section class="py-20 bg-cream-50 border-y border-emerald-100">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-emerald-950">Curriculum Structure</h2>
        <p class="mt-4 text-emerald-800/80 text-lg">A clear, step-by-step pathway to mastery.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-12 max-w-5xl mx-auto">
        <!-- Core Modules -->
        <div class="space-y-6">
          {
            course.curriculum.map((mod: { title: string; desc: string }, i: number) => (
              <div class="flex gap-4">
                <div class="flex-shrink-0 w-8 h-8 mt-1 rounded-full bg-emerald-100 text-emerald-700 font-bold flex items-center justify-center text-sm shadow-sm border border-emerald-200">
                  {i + 1}
                </div>
                <div class="pt-1">
                  <h3 class="text-lg font-bold text-emerald-950">{mod.title}</h3>
                  <p class="text-emerald-800/80 text-[15px] mt-1 leading-relaxed">{mod.desc}</p>
                </div>
              </div>
            ))
          }
        </div>

        <!-- Platform Features -->
        <div class="bg-white rounded-3xl p-8 shadow-sm border border-emerald-100">
          <h3 class="text-xl font-bold text-emerald-950 mb-6">What's Included</h3>
          <ul class="space-y-4">
            {
              course.features.map((feature: string) => (
                <li class="flex items-start">
                  <svg
                    class="w-5 h-5 text-emerald-600 mr-3 flex-shrink-0 mt-0.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="text-[15px] text-emerald-900 font-medium">{feature}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICING ISLAND -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <!-- Left Side: Sticky Title & Value Prop -->
        <div class="lg:col-span-5 lg:sticky lg:top-32 text-left">
          <h2
            id={`calc-heading-${course.slug}`}
            class="text-3xl md:text-4xl font-bold text-emerald-950 mb-4 leading-tight text-balance"
          >
            Calculate Your Monthly Fee
          </h2>
          <p class="text-emerald-800/80 text-lg mb-8 text-balance">
            Transparent pricing. No contracts. Cancel anytime.
          </p>
        </div>

        <!-- Right Side: The Calculator Component -->
        <div class="lg:col-span-7 w-full">
          <PricingCalculator client:visible liveRates={liveRates} />
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST (TEACHER) BANNER - Moved above FAQ, CTAs hidden via prop -->
  <TeacherTeaserBanner hideCta={true} />

  <!-- FAQ SECTION (Course Specific or Global Fallback) -->
  {
    course.courseFaqs && course.courseFaqs.length > 0 ? (
      <FAQAccordion
        questions={course.courseFaqs}
        eyebrow="COURSE QUESTIONS"
        title={`Frequently Asked Questions about ${course.shortTitle || course.title}`}
        subtitle="Everything you need to know about this course and how lessons work."
      />
    ) : (
      <CoursesFAQ />
    )
  }

  <FinalCTA />
</Page>
