---
// src/pages/teachers/_components/TeachersGenderPrivacy.astro
import Section from '../../../components/ui/Section.astro';

const Icons = {
  checkCircle: `<svg class="w-5 h-5 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>`,
  privacy: `<svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" /></svg>`,
};
---

<Section height={600} class="py-10 md:py-20 px-4 sm:px-6 border-b border-emerald-100">
  <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
    <div>
      <span class="text-emerald-700 font-bold tracking-widest uppercase text-sm mb-2 block"
        >Safe & Comfortable</span
      >
      <h2 class="text-3xl lg:text-4xl font-black text-emerald-950 mb-6 tracking-tight">
        Dedicated Male & Female Instructors
      </h2>

      <p class="text-lg text-emerald-900/80 leading-relaxed font-medium mb-8">
        We understand the importance of modesty and comfort in Islamic education. You have the
        absolute freedom to request specifically male or female tutors.
      </p>
      <div class="space-y-6">
        <div class="flex items-start gap-4">
          <div
            class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center shrink-0 mt-1"
            aria-hidden="true"
          >
            <span set:html={Icons.checkCircle} />
          </div>
          <div>
            <h4 class="font-bold text-emerald-950">Female Tutors for Sisters & Kids</h4>
            <p class="text-emerald-800/80 text-sm font-medium mt-1">
              Nurturing, patient environments ensuring absolute privacy for women and a gentle
              approach for young children.
            </p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div
            class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center shrink-0 mt-1"
            aria-hidden="true"
          >
            <span set:html={Icons.checkCircle} />
          </div>
          <div>
            <h4 class="font-bold text-emerald-950">Male Tutors for Brothers</h4>
            <p class="text-emerald-800/80 text-sm font-medium mt-1">
              Expert scholars and Hafiz-e-Quran providing rigorous, focused academic mentorship for
              boys and men.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div
      class="bg-gradient-to-br from-emerald-50 to-white rounded-[3rem] p-8 border border-emerald-100 shadow-xl relative aspect-square max-w-md mx-auto flex flex-col justify-center items-center text-center"
    >
      <div class="absolute inset-0 bg-emerald-200/20 rounded-[3rem] blur-2xl" aria-hidden="true">
      </div>
      <div class="relative z-10">
        <div
          class="w-20 h-20 bg-white rounded-2xl shadow-sm border border-emerald-50 flex items-center justify-center mx-auto mb-6 text-emerald-700"
          aria-hidden="true"
        >
          <span set:html={Icons.privacy} />
        </div>
        <h3 class="text-2xl font-black text-emerald-950 mb-2">100% Privacy</h3>
        <p class="text-emerald-800/80 font-medium">
          1-on-1 private video links, end-to-end encryption, and strictly vetted staff.
        </p>
      </div>
    </div>
  </div>
</Section>
